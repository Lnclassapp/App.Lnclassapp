#!/usr/bin/env bash
# Charge le jeu de test standard en une commande (chantier standard-de-test, ADR standard-de-test §4) : référentiel,
# établissements, classes, comptes, leçons publiées. Le grand établissement est toujours chargé (décision du porteur).
#
#   bin/jeu-standard                       # charge le jeu sur la base courante ; rejoué, ne double rien
#   bin/jeu-standard --reset               # vide d'abord la base locale (db:reset), puis recharge
#   bin/jeu-standard --reset --confirmer=<environnement>
#                                          # seul moyen de vider une base quand RAILWAY_ENVIRONMENT_NAME est posée ;
#                                          # la valeur doit être le nom exact de l'environnement
# Variables : STANDARD_TEAM_PIN (PIN des comptes équipe), STANDARD_LESSONS_LIMIT=N (seulement N leçons, pour itérer vite).
set -euo pipefail

cd "$(dirname "$0")/.."

reset=0 confirm=""
for arg in "$@"; do
  case "$arg" in
    --reset) reset=1 ;;
    --confirmer=*) confirm="${arg#--confirmer=}" ;;
    *) echo "Usage : bin/jeu-standard [--reset] [--confirmer=<environnement>]" >&2; exit 1 ;;
  esac
done

remote="${RAILWAY_ENVIRONMENT_NAME:-}"
if [ "$reset" = 1 ] && [ -n "$remote" ] && [ "$confirm" != "$remote" ]; then
  echo "Refus : --reset viderait la base de l'environnement distant « $remote »." >&2
  echo "Si c'est voulu, relance avec --confirmer=$remote. Rien n'a été supprimé." >&2
  exit 1
fi

start=$SECONDS
if [ "$reset" = 1 ]; then
  bin/rails db:reset
else
  bin/rails db:prepare
fi
bin/rails db:seed
bin/rails runner db/seeds/standard.rb
echo "bin/jeu-standard : $((SECONDS - start)) s au total."
