#!/usr/bin/env bash
# Puts a pull request, or a branch, on the owner's machine to try it (chantier tester-pr-en-local): the code as it is on
# origin, the dependencies and the migrations of that code, the fictitious accounts of db/seeds/development.rb, then
# bin/dev. The code is checked out detached, so no local branch is left behind; `git switch -` comes back.
#
#   bin/tester-pr 275                  # the pull request no. 275
#   bin/tester-pr feature/messagerie   # a branch
#   bin/tester-pr 275 --telephone      # open to the local network: a phone on the same Wi-Fi reaches it
#   bin/tester-pr 275 --reset          # the development database recreated (fictitious data only)
#   bin/tester-pr 275 --demo           # plus three test schools: db/seeds/demo/trois_etablissements.rb (63 classrooms,
#                                      # 35 to 45 students each, bivalent and multi-school teachers; seconds, idempotent)
#   bin/tester-pr 275 --activite       # plus a school whose students already worked: db/seeds/demo/saint_michel.rb
#                                      # (about 20 minutes the first time, then idempotent)
set -euo pipefail

# The whole script is read before it runs: checking out another commit may change this very file.
main() {
  cd "$(dirname "$0")/.."

  local target="" telephone=0 reset=0 demo=0 activity=0
  for arg in "$@"; do
    case "$arg" in
      --telephone) telephone=1 ;;
      --reset) reset=1 ;;
      --demo) demo=1 ;;
      --activite) activity=1 ;;
      -*) usage ;;
      *) [ -z "$target" ] || usage; target="$arg" ;;
    esac
  done
  [ -n "$target" ] || usage

  if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "Des modifications ne sont pas commitées : commite-les ou mets-les de côté (git stash), puis relance." >&2
    git status --short --untracked-files=no >&2
    exit 1
  fi

  local ref label
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    ref="pull/$target/head" label="PR n° $target"
  else
    ref="$target" label="branche $target"
  fi
  git fetch --quiet origin "$ref" || { echo "Introuvable sur origin : $label." >&2; exit 1; }
  git switch --quiet --detach FETCH_HEAD
  echo "== $label : $(git log -1 --format='%h %s')"

  if [ "$reset" = 1 ]; then bin/setup --skip-server --reset; else bin/setup --skip-server; fi
  # Idempotent: the fictitious accounts exist whatever the database held, and the TOTP code of the team prints.
  bin/rails db:seed
  [ "$demo" = 0 ] || bin/rails runner db/seeds/demo/trois_etablissements.rb
  [ "$activity" = 0 ] || bin/rails runner db/seeds/demo/saint_michel.rb

  local port="${PORT:-3000}"
  echo
  echo "Ordinateur : http://localhost:$port"
  if [ "$telephone" = 1 ]; then
    local ip
    ip="$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || hostname -I 2>/dev/null | awk '{print $1}' || true)"
    echo "Téléphone (même Wi-Fi) : http://${ip:-<IP-de-l-ordinateur>}:$port"
    export BINDING=0.0.0.0
  fi
  echo "Comptes fictifs, PIN 2468 : enseignant 0500000001, élève 0100000001, équipe 0700000000 (code TOTP ci-dessus)."
  if [ "$demo" = 1 ]; then
    echo "3 établissements de test, PIN 2468 : direction 0731000001 à 0733000001, enseignants 0531000001…, 0532000001…,"
    echo "  0533000001…, élèves 013S00CCEE (ex. 0131000101 : établissement 1, 1re classe, 1er élève)."
  fi
  if [ "$activity" = 1 ]; then
    echo "Collège Saint Michel, PIN 2468 : direction 0710000001 et 0710000002, enseignants de la Tle D 1 0510000001 à 0510000006,"
    echo "  élèves de la Tle D 1 0110000001 à 0110000020."
  fi
  echo "Pour revenir à ta branche ensuite : git switch -"
  echo
  exec bin/dev
}

usage() {
  echo "Usage : bin/tester-pr <numéro-de-PR | branche> [--telephone] [--reset] [--demo] [--activite]" >&2
  exit 1
}

main "$@"
