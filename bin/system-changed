#!/usr/bin/env ruby
# bin/system-changed — joue en local les seuls tests système que la branche touche ; la suite complète tourne en CI,
# en trois parts (config/ci.rb). Sur un poste de 4 cœurs, la suite complète met 15 à 25 min et dépasse ses délais
# quand la machine sature : chaque processus y lance son Chrome, son serveur et ses requêtes (docs/guide/onboarding.md §4).
#
#   bin/system-changed             tests système liés aux fichiers changés depuis origin/Develop
#   bin/system-changed --list      la même sélection, affichée sans rien lancer
#   bin/system-changed --all       toute la suite système, sur 2 processus au lieu d'un par cœur
#   BASE=origin/main bin/system-changed
#
# Sélection (script/ci/system_scope.rb, ADR-0107 amendé) : un test système modifié ; un test système qui visite la ressource
# d'une vue ou d'un contrôleur modifié par son helper de route exact ; les parcours transverses de COMMON si un fichier
# commun change ; et les tests que la carte (script/ci/system_map.yml) dit avoir exécuté un fichier modifié — une feuille
# de style par ses classes, un contrôleur Stimulus par son identifiant, une locale par son dossier. Au-delà de 240 s
# enregistrées, les tests les moins touchés partent au train, nommés.
#
#   HEAD_REF=<commit> BASE=<commit> bin/system-changed --list   rejoue la sélection d'une PR passée (sans l'arbre de travail)
#   SYSTEM_SCOPE=former bin/system-changed --list               la sélection sans la carte, celle d'avant le chantier
require "open3"
require_relative "../script/ci/system_scope"

base = ENV.fetch("BASE", "origin/Develop")
head = ENV.fetch("HEAD_REF", "HEAD")
all = ARGV.include?("--all")
list = ARGV.include?("--list")

def git(*args) = Open3.capture2("git", *args, err: File::NULL).first

def changed_files(base, head)
  merge_base, status = Open3.capture2("git", "merge-base", base, head)
  abort "❌ Impossible de comparer à #{base} (git fetch ?)" unless status.success?

  committed = git("diff", "--name-only", merge_base.strip, head).lines
  pending = head == "HEAD" ? git("diff", "--name-only", "HEAD").lines + git("ls-files", "--others", "--exclude-standard").lines : []
  [ merge_base.strip, (committed + pending).map(&:strip).uniq ]
end

tests =
  if all
    [ "test/system" ]
  else
    merge_base, files = changed_files(base, head)
    at_head = head == "HEAD" ? ->(path) { File.read(path) if File.exist?(path) } : ->(path) { git("show", "#{head}:#{path}") }
    selection = SystemScope.new(
      changed: files, test_files: Dir["test/system/**/*_test.rb"], map: SystemScope.load_map, timings: SystemScope.load_timings,
      read: at_head, read_base: ->(path) { git("show", "#{merge_base}:#{path}") },
      diff: ->(path) { git("diff", "-U0", merge_base, *([ head ] unless head == "HEAD"), "--", path) }
    ).then { ENV["SYSTEM_SCOPE"] == "former" ? it.former : it.select }
    unless selection.deferred.empty?
      puts "⏭️  #{selection.deferred.size} test(s) système touché(s) de loin, laissé(s) au train (budget #{SystemScope::BUDGET.round} s) :"
      selection.deferred.each { puts "   #{it}" }
    end
    puts "ℹ️  Hors carte (règles d'avant seulement) : #{selection.unmapped.join(', ')}" if list && selection.unmapped.any?
    selection.tests
  end

if tests.empty?
  puts "ℹ️  Aucun test système lié aux fichiers changés depuis #{base}."
  exit 0
end
puts "🧭 #{all ? 'Toute la suite système' : "#{tests.size} fichier(s) de tests système"} :"
tests.each { puts "   #{it}" } unless all
exit 0 if list

# Machine déjà chargée (éditeur, serveur de dev, autre suite) : les tests dépasseront leurs délais.
load = File.read("/proc/loadavg").split.first.to_f rescue 0
cores = Integer(`nproc`.strip, exception: false) || 1
if load > cores
  warn "⚠️  Charge #{load} pour #{cores} cœurs : ferme VS Code, arrête bin/dev et toute autre suite, sinon les tests " \
       "dépasseront leurs délais (faux échecs)."
end

# Chromium en snap (poste Ubuntu) : trouvé sans configuration, comme le pose docs/guide/configuration.md §4.3.
env = { "COVERAGE" => "0", "PARALLEL_WORKERS" => ENV.fetch("PARALLEL_WORKERS", "2") }
snap_chrome = "/snap/chromium/current/usr/lib/chromium-browser/chrome"
if ENV["CHROME_BIN"].to_s.empty? && File.executable?(snap_chrome)
  env["CHROME_BIN"] = snap_chrome
  env["CHROMEDRIVER_PATH"] = "/snap/bin/chromium.chromedriver"
end

exec(env, "bin/rails", "test", *tests)
