#!/usr/bin/env bash
# Installs the service that re-runs the CI runs GitHub failed after 24 hours without a runner (ADR-0068): a pull
# request then waits up to 48 hours for the owner's machine. Run once, as root, after script/ci/runner/install:
#
#   sudo script/ci/runner/install_rerun
#
# It asks for a GitHub token (fine-grained, repository Lnclassapp/App.Lnclassapp only, permissions « Actions: read and
# write », « Pull requests: read », « Contents: read »). The token is read from the keyboard, never from the command
# line, checked against the GitHub API, and kept in /etc/lnclass-ci-rerun.env, readable by root only.
# The service runs at boot, then every 15 minutes, as a throwaway systemd user (DynamicUser), not as github-runner:
# the code of a job must not read the token from the service's process, nor replace its script, which lives in
# /usr/local/lib/lnclass-ci, owned by root. Its log: journalctl -u lnclass-ci-rerun
set -euo pipefail

REPOSITORY="Lnclassapp/App.Lnclassapp"
TARGET="/usr/local/lib/lnclass-ci/rerun_expired"
ENV_FILE="/etc/lnclass-ci-rerun.env"

[ "$(id -u)" -eq 0 ] || { echo "❌ Lancer avec sudo." >&2; exit 1; }
command -v ruby >/dev/null && command -v gh >/dev/null || { echo "❌ ruby et gh manquants : script/ci/runner/install." >&2; exit 1; }

install -D -o root -g root -m 755 "$(dirname "$0")/rerun_expired" "$TARGET"

if [ ! -s "$ENV_FILE" ] || [ "${1:-}" = "--new-token" ]; then
  read -rsp "Jeton GitHub (Actions en écriture, sur ce dépôt seulement) : " token; echo
  [ -n "$token" ] || { echo "❌ Jeton vide." >&2; exit 1; }
  GH_TOKEN="$token" gh api "repos/$REPOSITORY/actions/runs?per_page=1" --silent \
    || { echo "❌ Ce jeton ne lit pas les runs de $REPOSITORY : vérifier le dépôt et les permissions." >&2; exit 1; }
  umask 077
  printf 'GH_TOKEN=%s\nGITHUB_REPOSITORY=%s\n' "$token" "$REPOSITORY" > "$ENV_FILE"
fi
chown root:root "$ENV_FILE"
chmod 600 "$ENV_FILE"

cat > /etc/systemd/system/lnclass-ci-rerun.service <<UNIT
[Unit]
Description=Lnclass CI : relance des runs expirés faute de runner (ADR-0068)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=lnclass-ci-rerun
Environment=HOME=/var/lib/lnclass-ci-rerun
EnvironmentFile=$ENV_FILE
ExecStart=/usr/bin/env ruby $TARGET
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectProc=invisible
UNIT

cat > /etc/systemd/system/lnclass-ci-rerun.timer <<UNIT
[Unit]
Description=Lnclass CI : relance des runs expirés, au démarrage puis toutes les 15 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
systemctl enable lnclass-ci-rerun.timer >/dev/null
echo "== Premier passage"
if systemctl start lnclass-ci-rerun.service; then
  journalctl -u lnclass-ci-rerun -n 5 --no-pager
  systemctl start lnclass-ci-rerun.timer
  echo "✅ Relance installée : au démarrage, puis toutes les 15 minutes."
else
  journalctl -u lnclass-ci-rerun -n 20 --no-pager
  echo "❌ Le premier passage a échoué : la minuterie n'est pas démarrée." >&2
  exit 1
fi
