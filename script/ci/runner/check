#!/usr/bin/env bash
# Tells whether the self-hosted runner of Lnclass can take a job (ADR-0068). Prints every piece of the list, then
# exits 1 if one is missing. Run it as root (it reads /opt/github-runner, closed to other users):
#
#   sudo script/ci/runner/check
set -uo pipefail

RUNNER_USER="github-runner"
RUNNER_HOME="/opt/github-runner"
TOOL_CACHE="/opt/hostedtoolcache"
failures=0

ok() { echo "✅ $*"; }
ko() { echo "❌ $*"; failures=$((failures + 1)); }
check() { local label="$1"; shift; if "$@" >/dev/null 2>&1; then ok "$label"; else ko "$label"; fi; }

[ "$(id -u)" -eq 0 ] || { echo "❌ Lancer avec sudo : /opt/github-runner est fermé aux autres utilisateurs." >&2; exit 1; }

check "utilisateur $RUNNER_USER" id "$RUNNER_USER"
if id -nG "$RUNNER_USER" 2>/dev/null | grep -qw sudo; then ko "$RUNNER_USER est dans le groupe sudo"; else ok "$RUNNER_USER sans sudo"; fi
if id -nG "$RUNNER_USER" 2>/dev/null | grep -qw docker; then ok "$RUNNER_USER dans le groupe docker"; else ko "$RUNNER_USER hors du groupe docker"; fi
check "Docker joignable par $RUNNER_USER" sudo -u "$RUNNER_USER" docker info

for tool in google-chrome gh jq git ruby; do
  if command -v "$tool" >/dev/null; then ok "$tool : $("$tool" --version 2>/dev/null | head -1)"; else ko "$tool manquant"; fi
done
check "libpq-dev" dpkg -s libpq-dev
if [ -d "$TOOL_CACHE" ] && [ "$(stat -c %U "$TOOL_CACHE")" = "$RUNNER_USER" ]; then ok "$TOOL_CACHE"; else ko "$TOOL_CACHE absent ou pas à $RUNNER_USER"; fi

while IFS=: read -r name _ uid _ _ home _; do
  if [ "$uid" -ge 1000 ] && [ "$uid" -lt 60000 ] && [ -d "$home" ] && [ "$name" != "$RUNNER_USER" ]; then
    if [ $(( 0$(stat -c %a "$home") & 07 )) -eq 0 ]; then ok "$home fermé aux autres utilisateurs"; else ko "$home lisible par $RUNNER_USER"; fi
  fi
done < /etc/passwd

instances=0
for dir in "$RUNNER_HOME"/runner-*; do
  [ -d "$dir" ] || continue
  instances=$((instances + 1))
  unit="lnclass-runner-${dir##*-}.service"
  if systemctl is-active --quiet "$unit"; then ok "$unit actif"; else ko "$unit inactif : sudo systemctl restart $unit"; fi

  # A service can be active while GitHub refuses the runner (token revoked, runner removed, version too old):
  # only the runner's own log says it is connected and waiting for jobs.
  log=$(find "$dir/_diag" -name 'Runner_*.log' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
  if [ -n "$log" ] && grep -q "Listening for Jobs" "$log"; then ok "${dir##*/} connecté à GitHub, en attente de jobs"
  else ko "${dir##*/} non connecté à GitHub (voir $dir/_diag) : relancer script/ci/runner/install"; fi
done
[ "$instances" -gt 0 ] || ko "aucune instance du runner dans $RUNNER_HOME : lancer script/ci/runner/install"

echo "ℹ️  $(nproc) cœurs, $(free -g | awk '/^Mem:/ { print $2 }') Go de mémoire, $instances instance(s)"

if [ "$failures" -eq 0 ]; then echo "Le runner peut prendre un job."; else echo "$failures point(s) à corriger."; exit 1; fi
