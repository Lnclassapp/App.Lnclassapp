#!/usr/bin/env ruby
# Re-runs the CI runs GitHub gave up on while the owner's machine was off (ADR-0068, chantier ci-quota).
# GitHub fails a job that waited 24 hours for a self-hosted runner. This script, started by a systemd timer on the
# machine (script/ci/runner/install_rerun), re-runs such a run once, so that a pull request waits up to 48 hours.
#
#   script/ci/runner/rerun_expired            # GITHUB_REPOSITORY (default Lnclassapp/App.Lnclassapp), GH_TOKEN
#   script/ci/runner/rerun_expired --dry-run  # tells what it would re-run
#
# It runs on the machine's system Ruby (Ubuntu 22.04: Ruby 3.0), before any setup-ruby: no newer syntax here.
#
# A run is re-run only when all of this holds:
#   - it is a first attempt of ci.yml, created less than 48 hours ago, and it ended cancelled or failed;
#   - one of its jobs never got a runner (no runner name) after waiting at least 23 hours: a timeout, and no job that
#     played the checks failed on a runner (a red test is never re-run; the verdict « ci » may be red, it only reports);
#   - what it tested is still current: the pull request is open with the same head, or the branch has not moved.
#
# An unreadable answer from GitHub (expired token, network down, rate limit) is not « nothing to re-run »: the script
# says so on stderr and exits 1, so that the systemd unit turns red.
require "json"
require "open3"
require "time"

class RerunExpired
  class Unreadable < StandardError; end

  WINDOW = 48 * 3600
  QUEUE_TIMEOUT = 23 * 3600
  WORKFLOW = "ci.yml"

  # api: callable(path) → parsed JSON or nil. rerun: callable(run_id) → true when GitHub accepted the re-run.
  def initialize(repository:, api:, rerun:, now: Time.now)
    @repository = repository
    @api = api
    @rerun = rerun
    @now = now
  end

  def candidates
    since = (@now - WINDOW).utc.iso8601
    runs = read("repos/#{@repository}/actions/workflows/#{WORKFLOW}/runs?status=completed&created=>=#{since}&per_page=100")
    listed = runs["workflow_runs"]
    raise Unreadable, "liste des runs illisible" unless listed.is_a?(Array)

    listed.select { |run| expired?(run) && current?(run) }
  end

  def call(dry_run: false)
    candidates.map do |run|
      status = if dry_run then :would_rerun
      elsif @rerun.call(run["id"]) then :rerun
      else :refused
      end
      { id: run["id"], branch: run["head_branch"], status: status }
    end
  end

  private

  def expired?(run)
    return false unless run["run_attempt"] == 1 && %w[cancelled failure].include?(run["conclusion"])
    return false unless @now - Time.parse(run["created_at"]) < WINDOW

    jobs = read("repos/#{@repository}/actions/runs/#{run['id']}/jobs?per_page=100")["jobs"]
    raise Unreadable, "jobs du run #{run['id']} illisibles" unless jobs.is_a?(Array)

    timed_out = jobs.any? do |job|
      job["runner_name"].to_s.empty? && job["completed_at"] &&
        Time.parse(job["completed_at"]) - Time.parse(job["created_at"]) >= QUEUE_TIMEOUT
    end
    red = jobs.any? { |job| job["name"] != "ci" && !job["runner_name"].to_s.empty? && job["conclusion"] == "failure" }
    timed_out && !red
  end

  def read(path)
    @api.call(path) or raise Unreadable, "réponse illisible : #{path}"
  end

  def current?(run)
    if run["event"] == "pull_request"
      numbers = Array(run["pull_requests"]).map { |pull| pull["number"] }
      numbers.any? do |number|
        pull = read("repos/#{@repository}/pulls/#{number}")
        pull["state"] == "open" && pull.dig("head", "sha") == run["head_sha"]
      end
    else
      read("repos/#{@repository}/branches/#{run['head_branch']}").dig("commit", "sha") == run["head_sha"]
    end
  end
end

if $PROGRAM_NAME == __FILE__
  repository = ENV.fetch("GITHUB_REPOSITORY", "Lnclassapp/App.Lnclassapp")
  api = lambda do |path|
    out, status = Open3.capture2("gh", "api", path)
    status.success? ? JSON.parse(out) : nil
  rescue JSON::ParserError, SystemCallError
    nil
  end
  rerun = ->(id) { system("gh", "run", "rerun", id.to_s, "--repo", repository, out: File::NULL) }

  begin
    results = RerunExpired.new(repository: repository, api: api, rerun: rerun).call(dry_run: ARGV.include?("--dry-run"))
  rescue RerunExpired::Unreadable => error
    warn "❌ #{error.message} (gh api) : rien n'a été relancé."
    exit 1
  end
  puts "Aucun run expiré à relancer." if results.empty?
  labels = { would_rerun: "à relancer", rerun: "relancé", refused: "refusé par GitHub" }
  results.each { |result| puts "#{labels.fetch(result[:status])} : run #{result[:id]} (#{result[:branch]})" }
  exit(results.none? { |result| result[:status] == :refused } ? 0 : 1)
end
