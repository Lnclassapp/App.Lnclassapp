#!/usr/bin/env ruby
# Rebuilds script/ci/test_timings.yml from the verbose output (-v) of test runs, locally or from GitHub logs:
#
#   script/ci/record_timings tmp/system.log [more.log …]
#   gh run view <run-id> --log | script/ci/record_timings
#
# Each test's duration (script/ci/timing_log.rb) adds to the file that defines its class.
# The files not seen in the logs keep their previous timing; the split (script/ci/plan.rb) reads this file.
require "yaml"
require_relative "plan"
require_relative "timing_log"

root = CiPlan::ROOT
# A class nested in `module Finitions` prints as Finitions::X: both spellings point to the file.
classes = CiPlan.files("test/**/*_test.rb").each_with_object({}) do |file, map|
  modules = []
  File.foreach(File.join(root, file)) do |line|
    modules << $1 if line =~ /^\s*module\s+([\w:]+)\s*$/
    next unless line =~ /^\s*class\s+([\w:]+)\s*</

    map[$1] = file
    map[[ *modules, $1 ].join("::")] = file
  end
end

durations = TimingLog.parse(ARGF.each_line).each_with_object(Hash.new(0.0)) do |(name, seconds), by_file|
  file = classes[name] and by_file[file] += seconds
end
abort "Aucune durée lue : lancez les tests avec -v (TESTOPTS=-v)." if durations.empty?

# A file that left the repository leaves the timings with it.
timings = CiPlan.timings.merge(durations.transform_values { it.round(1) }).select { |file, _| File.exist?(File.join(root, file)) }
File.write(CiPlan::TIMINGS, <<~YAML + timings.sort.to_h.to_yaml.delete_prefix("---\n"))
  # Seconds per test file, summed from `-v` runs. Written by script/ci/record_timings, read by script/ci/plan.rb
  # to balance the parts of a sharded group, and by script/ci/system_budget.rb: a chantier adds at most 15 s to
  # test/system (ADR-0069 §9). Stale values only unbalance the parts; they never skip a test.
YAML
puts "#{durations.size} fichiers mis à jour dans #{CiPlan::TIMINGS.delete_prefix("#{root}/")}"
