{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Import des cours complets, version 1 (ADR-0039, UDR-0038)",
  "description": "Enveloppe { format, version, courses[] }. Chaque cours porte toute sa descendance : essentials[] → exercises[] → questions[] → answers[]. Les clés de l'ancienne application sont acceptées ; la présence des noms, le référentiel et la structure des questions sont vérifiés par l'adaptateur, pour que l'erreur soit notée à la clé canonique. La clé status est ignorée : tout naît en brouillon.",
  "type": "object",
  "required": ["format", "version", "courses"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "lnclass.course-tree" },
    "version": { "const": 1 },
    "courses": {
      "type": "array",
      "items": { "$ref": "#/$defs/course" }
    }
  },
  "$defs": {
    "text": { "type": ["string", "null"] },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "nom": { "$ref": "#/$defs/text" },
        "subtitle": { "$ref": "#/$defs/text" },
        "sous_titre": { "$ref": "#/$defs/text" },
        "content": { "$ref": "#/$defs/text" },
        "level_name": { "$ref": "#/$defs/text" },
        "material_name": { "$ref": "#/$defs/text" },
        "series_name": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "statut": { "$ref": "#/$defs/text" },
        "essentials": {
          "type": "array",
          "items": { "$ref": "#/$defs/essential" }
        }
      }
    },
    "essential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "subtitle": { "$ref": "#/$defs/text" },
        "content": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "exercises": {
          "type": "array",
          "items": { "$ref": "#/$defs/exercise" }
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "description": { "$ref": "#/$defs/text" },
        "exercise_type": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/text" },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/question" }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": { "$ref": "#/$defs/text" },
        "question_type": { "$ref": "#/$defs/text" },
        "explanation": { "$ref": "#/$defs/text" },
        "answers": {
          "type": "array",
          "items": { "$ref": "#/$defs/answer" }
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": { "type": ["string", "null"], "maxLength": 500 },
        "correct": { "type": ["boolean", "null"] },
        "is_correct": { "type": ["boolean", "null"] }
      }
    }
  }
}
