{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Import des leçons, version 3 : fiche de révision par notion et figures paramétrées (ADR-XXXX, ADR-0039, UDR-XXXX)",
  "description": "Enveloppe { format, version: 3, courses[] }. Une leçon porte ses figures (0 à 12), ses notions (1 à 12, chacune avec sa fiche au gabarit fixe et son exercice) et ses quatre problèmes. Les règles qui comparent deux éléments (example.steps autant que method, noms de notions uniques, clés de figures uniques et citées) sont vérifiées par les entités, pour noter l'erreur à sa raison propre. Aucune URL, aucun HTML. La clé status n'existe plus : tout naît en brouillon.",
  "type": "object",
  "required": [
    "format",
    "version",
    "courses"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "lnclass.course-tree"
    },
    "version": {
      "const": 3
    },
    "courses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/course"
      }
    }
  },
  "$defs": {
    "text": {
      "type": [
        "string",
        "null"
      ]
    },
    "figure_key": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "level_name",
        "material_name",
        "notions",
        "exercises"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subtitle": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "level_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "material_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "series_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "theme": {
          "description": "Habillage cahier (UDR-0137) ; absent : blue.",
          "enum": [
            "blue",
            "teal",
            "burgundy"
          ]
        },
        "figures": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/figure"
          }
        },
        "notions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/notion"
          }
        },
        "exercises": {
          "description": "Les problèmes de toute la leçon : exactement quatre.",
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/exercise"
          }
        }
      }
    },
    "figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "kind",
        "description",
        "params"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
        },
        "kind": {
          "enum": [
            "geometry",
            "coordinate_plane",
            "number_line",
            "stat_chart",
            "solid"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 150,
          "maxLength": 600
        },
        "params": {
          "type": "object"
        },
        "controls": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/control"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "geometry"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/geometry_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "coordinate_plane"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/coordinate_plane_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "number_line"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/number_line_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "stat_chart"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/stat_chart_params"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "solid"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "params": {
                "$ref": "#/$defs/solid_params"
              }
            }
          }
        }
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "param",
        "min",
        "max",
        "step",
        "label"
      ],
      "properties": {
        "param": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,29}$"
        },
        "min": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "max": {
          "type": "number",
          "minimum": -1000,
          "maximum": 1000
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2000
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "notion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "remember",
        "method",
        "example",
        "pitfall",
        "exercise"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "remember": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "method": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "example": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statement",
            "steps"
          ],
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1200
            },
            "steps": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        },
        "pitfall": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "figure": {
          "$ref": "#/$defs/figure_key"
        },
        "exercise": {
          "$ref": "#/$defs/exercise"
        }
      }
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "statement",
        "exercise_type",
        "questions"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "exercise_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "figure": {
          "$ref": "#/$defs/figure_key"
        },
        "statement_blocks": {
          "description": "Le sujet en blocs (ADR-0115) : dix blocs au plus, objets ; leurs types et leurs textes sont vérifiés par l'adaptateur (paragraph, box, table).",
          "type": [
            "array",
            "null"
          ],
          "maxItems": 10,
          "items": {
            "type": "object"
          }
        },
        "questions": {
          "description": "Cinq à trente questions par exercice (ADR-XXXX §4.1).",
          "type": "array",
          "minItems": 5,
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "question_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "explanation": {
          "description": "La correction rédigée, obligatoire pour toute question (ADR-XXXX §4.1) : 20 à 2 000 caractères.",
          "type": "string",
          "minLength": 20,
          "maxLength": 2000
        },
        "points": {
          "description": "Points de la question (ADR-0115) : de 0,5 à 20, par demi-point ; 1 sans la clé.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0.5,
          "maximum": 20,
          "multipleOf": 0.5
        },
        "unit": {
          "description": "Unité d'une question numeric : 10 caractères au plus.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 10
        },
        "starter": {
          "description": "Début de phrase d'une question written : 150 caractères au plus.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 150
        },
        "criteria": {
          "description": "Grille de vérification d'une question written : huit critères de 150 caractères au plus.",
          "type": [
            "array",
            "null"
          ],
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 150
          }
        },
        "answers": {
          "description": "Dix propositions au plus par question.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/answer"
          }
        },
        "image": {
          "$ref": "#/$defs/question_image"
        },
        "tolerance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 99999999.9999
        }
      },
      "required": [
        "content",
        "question_type",
        "explanation",
        "answers"
      ]
    },
    "question_image": {
      "description": "ADR-0105 §4.6 : l'image annoncée d'une question, jamais l'image. Facultative ; un fichier sans elle reste valide.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        }
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "is_correct": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "match": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "geometry_item": {
      "description": "Élément de liste de geometry : nombre, texte, tableau de 4 valeurs au plus ou objet de valeurs simples.",
      "oneOf": [
        {
          "type": "number",
          "minimum": -20,
          "maximum": 20
        },
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "array",
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": -20,
                "maximum": 20
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        {
          "type": "object",
          "maxProperties": 12,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": -20,
                "maximum": 20
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "geometry_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "points": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/geometry_item"
          }
        },
        "segments": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/geometry_item"
          }
        },
        "lines": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/geometry_item"
          }
        },
        "circles": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/geometry_item"
          }
        },
        "angles": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/geometry_item"
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/geometry_item"
          }
        },
        "constraints": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/geometry_item"
          }
        }
      }
    },
    "coordinate_plane_item": {
      "description": "Élément de liste de coordinate_plane : nombre, texte, tableau de 4 valeurs au plus ou objet de valeurs simples.",
      "oneOf": [
        {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "array",
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": -50,
                "maximum": 50
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        {
          "type": "object",
          "maxProperties": 12,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": -50,
                "maximum": 50
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "coordinate_plane_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xmin": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "xmax": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "ymin": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "ymax": {
          "type": "number",
          "minimum": -50,
          "maximum": 50
        },
        "points": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/coordinate_plane_item"
          }
        },
        "vectors": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/coordinate_plane_item"
          }
        },
        "lines": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/coordinate_plane_item"
          }
        },
        "segments": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/coordinate_plane_item"
          }
        }
      }
    },
    "number_line_item": {
      "description": "Élément de liste de number_line : nombre, texte, tableau de 4 valeurs au plus ou objet de valeurs simples.",
      "oneOf": [
        {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "array",
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        {
          "type": "object",
          "maxProperties": 12,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": -100,
                "maximum": 100
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "number_line_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "max": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "step": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 50
        },
        "points": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/number_line_item"
          }
        },
        "intervals": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/number_line_item"
          }
        }
      }
    },
    "stat_chart_item": {
      "description": "Élément de liste de stat_chart : nombre, texte, tableau de 4 valeurs au plus ou objet de valeurs simples.",
      "oneOf": [
        {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "array",
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        {
          "type": "object",
          "maxProperties": 12,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": -1000000,
                "maximum": 1000000
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "stat_chart_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chart": {
          "enum": [
            "bars",
            "histogram",
            "pie"
          ]
        },
        "series": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/stat_chart_item"
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/stat_chart_item"
          }
        }
      }
    },
    "solid_item": {
      "description": "Élément de liste de solid : nombre, texte, tableau de 4 valeurs au plus ou objet de valeurs simples.",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50
        },
        {
          "type": "string",
          "maxLength": 60
        },
        {
          "type": "array",
          "maxItems": 4,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": 0.5,
                "maximum": 50
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        {
          "type": "object",
          "maxProperties": 12,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "number",
                "minimum": 0.5,
                "maximum": 50
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      ]
    },
    "solid_params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shape": {
          "enum": [
            "pyramid",
            "cone"
          ]
        },
        "base": {
          "enum": [
            "square",
            "rectangular",
            "triangular"
          ]
        },
        "height": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50
        },
        "side": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50
        },
        "width": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50
        },
        "depth": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50
        },
        "radius": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 50
        }
      }
    }
  }
}
