<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de démarrage de l'app élèves (UDR-0080 §3.3) : l'icône sur le bleu de marque. Theme.Lnclass vient du socle. -->
<resources>
    <style name="Theme.Lnclass.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Lnclass</item>
    </style>
</resources>
