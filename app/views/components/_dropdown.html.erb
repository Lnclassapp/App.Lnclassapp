<%# 🌐 UI · components/_dropdown — menu déroulant accessible, appelé par ui_dropdown %>
<%# Rôle : bouton aria-haspopup/aria-controls, flèches, Échap, clic extérieur ; fixed → menu en position fixe qui suit le défilement %>
<%# UDR  : 0005, 0042 · Stimulus : dropdown %>
<%# Sans indentation : un menu par ligne de tableau la répète autant de fois (« Enseignants » : 60, ADR-0067). Entre ces
    éléments, aucun espace ne se voit : bouton en grille ou en flex, menu en bloc. %>
<%# Lot E6 (politique-cache) : clic extérieur, cache Turbo, défilement et redimensionnement sont écoutés par le contrôleur,
    menu ouvert seulement, et non plus déclarés sur chaque menu de la page. %>
<div class="relative inline-block" data-controller="dropdown" <%= "data-dropdown-fixed-value=true" if fixed %> data-action="keydown->dropdown#keydown">
<% if trigger %>
<button type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="<%= id %>" aria-label="<%= label %>"
data-dropdown-target="button" data-action="dropdown#toggle"
class="flex min-h-tap cursor-pointer items-center gap-2 rounded-full py-1 pr-3 pl-1 transition hover:bg-ink/5 focus-visible:outline-2 focus-visible:outline-brand">
<%= trigger %>
<%= ui_icon "chevron-down", variant: :mini, size: :sm, class: "text-mute" %>
</button>
<% else %>
<button type="button" aria-haspopup="menu" aria-expanded="false" aria-controls="<%= id %>" aria-label="<%= label %>"
data-dropdown-target="button" data-action="dropdown#toggle"
class="ui-icon-button">
<%= ui_icon icon %>
</button>
<% end %>
<div id="<%= id %>" role="menu" aria-label="<%= label %>" data-dropdown-target="menu" hidden
class="ui-menu <%= fixed ? "z-50" : "z-30" %> <%= align_class %>">
<%= items %>
</div>
</div>
