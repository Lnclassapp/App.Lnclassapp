<%# 🌐 UI · components/_info_tip — infobulle native (<details>), appelée par ui_info_tip %>
<%# Rôle : aide lisible au toucher et au clavier (pas de title=, pas de popover : Safari 16.4) ; panneau dans le flux %>
<%# UDR  : 0054 (§3.4) · aucun contrôleur %>
<details class="group inline-block align-middle">
  <summary class="summary-plain inline-grid size-tap cursor-pointer place-items-center rounded-full text-mute transition hover:bg-ink/5 hover:text-ink focus-visible:outline-2 focus-visible:outline-brand">
    <%= ui_icon "information-circle", size: :sm %>
    <span class="sr-only"><%= t("components.info_tip.label", label:) %></span>
  </summary>
  <div class="mt-2 max-w-form rounded-ln bg-mist px-4 py-3 text-left text-sm font-normal text-ink"><%= text %></div>
</details>
