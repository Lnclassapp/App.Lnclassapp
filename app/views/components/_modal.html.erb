<%# 🌐 UI · components/_modal — <dialog> native, déclencheur facultatif, appelée par ui_modal %>
<%# Rôle : piège du focus, Échap et fond cliquable fournis par le navigateur ; feuille basse sur mobile %>
<%# UDR  : 0005, 0006, 0054 · Stimulus : modal, autofocus · se charge aussi dans le frame « modal » du layout %>
<%# Servie ouverte (open: true), la <dialog> porte `open` dès le HTML : lisible sans JavaScript, que le contrôleur
    rouvre en vraie modale. UDR-0054 : `document_title` nomme l'onglet tant qu'elle est ouverte ; à l'ouverture, le
    contrôleur autofocus vise le premier champ, sinon le bouton de fermeture du pied (jamais la croix). %>
<%= tag.div data: { controller: "modal", modal_open_value: open, modal_document_title_value: document_title,
                    action: "turbo:before-cache@document->modal#close" } do %>
  <% if trigger %>
    <%= ui_button trigger, variant: trigger_variant, icon: trigger_icon,
          data: { action: "modal#open" }, "aria-haspopup": "dialog", "aria-controls": id %>
  <% end %>
  <dialog id="<%= id %>" <%= "open" if open %> aria-labelledby="<%= id %>-title" data-modal-target="dialog" data-action="click->modal#backdrop close->modal#closed turbo:submit-end->modal#submitEnd modal:opened->autofocus#focus"
          data-controller="autofocus" data-autofocus-mode-value="dialog"
          class="m-auto w-full max-w-none rounded-sheet bg-white p-0 text-ink shadow-pop backdrop:bg-ink/50 open:animate-slide-up max-sm:mb-0 max-sm:rounded-b-none <%= size_class %>">
    <div class="flex items-start justify-between gap-4 px-6 pt-6">
      <h2 id="<%= id %>-title" class="font-display text-xl font-extrabold"><%= title %></h2>
      <button type="button" data-action="modal#close" aria-label="<%= t(".close") %>"
              class="-mt-2 -mr-2 grid size-tap shrink-0 cursor-pointer place-items-center rounded-full text-mute transition hover:bg-ink/5 hover:text-ink focus-visible:outline-2 focus-visible:outline-brand">
        <%= ui_icon "x-mark" %>
      </button>
    </div>
    <div class="px-6 py-4"><%= body %></div>
    <% if slots[:footer] %>
      <div data-autofocus-footer class="flex flex-col-reverse gap-3 border-t border-line px-6 py-4 sm:flex-row sm:justify-end"><%= slots[:footer] %></div>
    <% end %>
  </dialog>
<% end %>
