<%# 🌐 UI · layouts/application — document HTML commun (pages publiques et shell) %>
<%# Rôle : en-tête HTML, feuille et script uniques, région des toasts ; le shell y injecte :body %>
<%# UDR  : 0005, 0006 · ADR : 0049, 0051 %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Lnclass" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Lnclass">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Un turbo_stream.refresh re-demande la page courante et la fusionne, sans recharger la fenêtre %>
    <% turbo_refreshes_with method: :morph, scroll: :preserve %>
    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# Icônes générées depuis app/assets/images/logo/lnclass.jpeg %>
    <link rel="icon" href="/favicon.ico" sizes="48x48">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%= preload_link_tag "dm-sans-latin-wght-normal.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= debugbar_head if defined?(Debugbar) %>
  </head>

  <body>
    <%# ADR-0051 : navigateur hors liste — on prévient sans bloquer (@outdated_browser posé par allow_browser) %>
    <% if @outdated_browser %><div class="outdated-browser" role="status"><%= t("layouts.outdated_browser") %></div><% end %>
    <%= render "shared/toasts" %>
    <%# UDR-0006 : cible des modales CRUD (lien data-turbo-frame="modal"), vidée à la fermeture %>
    <%= turbo_frame_tag "modal" %>
    <%= content_for?(:body) ? yield(:body) : yield %>
    <%= debugbar_body(nonce: content_security_policy_nonce) if defined?(Debugbar) %>
  </body>
</html>
