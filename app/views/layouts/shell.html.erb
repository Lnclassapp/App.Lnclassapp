<%# 🌐 UI · layouts/shell — shell applicatif unique des espaces connectés, paramétré par le rôle %>
<%# Rôle : en-tête, barre latérale (lg+), barre basse (mobile, direction et équipe seulement) ; coque Android ou mode concentré : le contenu seul %>
<%# UDR  : 0006, 0080 (§3.3), 0084 (§3.3), 0087 (§3.2, content_for :focus), XXXX écrans enseignant §3.3, XXXX accueil élève §3.1 (content_for :home_band, fond mist dès lg) · ADR : 0084 (§4.2), 0086 (§4.2) ; exige helper_method :shell_user %>
<% in_app = lnclass_app? %>
<%# UDR-0087 §3.2 : une page qui pose content_for :focus (la séance d'exercice) n'a ni en-tête, ni menus, ni barre du bas,
    pour tous les rôles ; elle rend elle-même tout son cadre, sans le conteneur de page. %>
<% focus = content_for?(:focus) %>
<%# UDR-0084 §3.3, UDR enseignant §3.3 : l'élève et l'enseignant n'ont pas de barre basse (bottom_bar?) ; sans elle, la marge réservée tombe à pb-12. %>
<% bottom_bar = !in_app && !focus && bottom_bar?(shell_user.role) %>
<% content_for :body do %>
  <% if in_app %>
    <%# ADR-0084 §4.2 : la coque porte ses propres barres ; aucune navigation du site, donc ni lien d'évitement ni marge réservée. %>
    <%# ADR-0086 §4.2 : le pont du compte, pour les rôles qui ont une coque ; l'adresse est celle de leur panneau. %>
    <% if account_panel?(shell_user.role) %>
      <%= tag.div hidden: true, data: { controller: "bridge--account",
                                        bridge__account_initials_value: avatar_initials(shell_user.name),
                                        bridge__account_photo_url_value: shell_user.avatar_url,
                                        bridge__account_menu_url_value: account_panel_page_path(shell_user.role),
                                        bridge__account_help_url_value: help_path } %>
    <% end %>
  <% elsif !focus %>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white"><%= t(".skip") %></a>
    <%# UDR accueil élève §3.1 (ordinateur) : l'élève a le fond bg-mist dès lg, sur tous ses écrans ; un fond fixe derrière la page,
        pour qu'il couvre toute la fenêtre quelle que soit la hauteur du contenu. %>
    <% if shell_user.role.to_sym == :student %><div class="fixed inset-0 -z-10 hidden bg-mist lg:block" aria-hidden="true"></div><% end %>
    <%= render "shared/navigation/header", user: shell_user %>
    <%= render "shared/navigation/sidebar", user: shell_user %>
  <% end %>
  <main id="main" tabindex="-1" class="<%= class_names("focus:outline-none", "pb-28 lg:pb-12" => bottom_bar,
                                                       "pb-12" => !in_app && !focus && !bottom_bar, "lg:pl-rail" => !in_app && !focus) %>">
    <% if focus %>
      <%= yield %>
    <% else %>
      <%# UDR accueil élève §3.1 : le bandeau de l'accueil va bord à bord, au-dessus de la colonne, sous lg seulement ; la coque
          Android a ses propres barres (ADR-0084 §4.2) et n'en montre pas. %>
      <% if content_for?(:home_band) && !in_app %><div class="lg:hidden"><%= yield :home_band %></div><% end %>
      <div class="mx-auto max-w-page px-gutter py-6 lg:px-8 lg:py-8" data-bleed>
        <%= yield %>
      </div>
    <% end %>
  </main>
  <%= render "shared/navigation/bottom_bar", user: shell_user if bottom_bar %>
<% end %>
<%= render template: "layouts/application" %>
