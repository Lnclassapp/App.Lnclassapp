<%# 🌐 UI · catalog/courses/index — catalogue des cours (CA-01), pour tous les rôles connectés %>
<%# Rôle : recherche par nom et filtres (niveau et série sauf pour l'élève, matière) qui visent le frame « courses » ; élève : son niveau seul, épuré ; équipe : création et import %>
<%# ADR  : 0028, 0035, 0076 · UDR : 0006, 0013 (amendements du 2026-10-02 et du 2026-10-05), 0054, 0057, 0069 · grille non plafonnée à 3, par pages de 24 %>
<% page_title t(".page_title") %>
<% content_for :nav_key, "courses" %>
<% team = current_actor.team? %>
<%# UDR-0013, amendement du 2026-10-01 : l'élève ne voit que son niveau ; le filtre par niveau ne lui sert plus. %>
<% student = current_actor.student? %>
<% unless list_frame_request? %>
  <% if team %>
    <%= ui_page_header title: t(".title"), subtitle: t(".subtitle") do %>
      <%= ui_button t(".import"), href: new_teams_import_path(kind: "course_tree"), variant: :secondary, icon: "arrow-up-tray",
                                  data: { turbo_frame: "modal" } %>
      <%= ui_button t(".new_course"), href: new_teams_course_path, icon: "plus", data: { turbo_frame: "modal" } %>
    <% end %>
  <% elsif student %>
    <%# UDR-0013, amendement du 2026-10-02 (UDR-0057 R4) : la portée du catalogue passe du sous-titre à l'infobulle. %>
    <%= ui_page_header title: t(".title") do %>
      <%= ui_info_tip t(".student_scope"), label: t(".student_scope_label") %>
    <% end %>
  <% else %>
    <%= ui_page_header title: t(".title"), subtitle: t(".subtitle") %>
  <% end %>

  <% select_class = class_names(ComponentsHelper::FIELD_INPUT, ComponentsHelper::FIELD_SHAPES[:select], ComponentsHelper::FIELD_STATES[:valid]) %>
  <%# UDR-0069 §3.4 : une série sert plusieurs niveaux ; la liste la donne une fois, par nom. %>
  <% series = filter_options.series_by_level.values.flatten.uniq(&:slug).sort_by(&:name) %>
  <% selects = {
       level: ([ [ t(".filters.all_levels"), "" ], *filter_options.levels.map { [ it.name, it.slug ] } ] unless student),
       series: ([ [ t(".filters.all_series"), "" ], *series.map { [ it.name, it.slug ] } ] unless student),
       material: [ [ t(".filters.all_materials"), "" ], *filter_options.materials.map { [ it.name, it.slug ] } ]
     }.compact %>
  <%# Recherche pendant la frappe (UDR-0054 §3.9) : le champ reste hors du frame ; « Filtrer » sert sans JavaScript. %>
  <%= form_with url: courses_path, method: :get, id: "courses-filters", html: { role: "search", "aria-label": t(".filters.label") },
                data: { turbo_frame: "courses", turbo_action: "advance", controller: "search" },
                class: "mb-6 grid items-end gap-3 rounded-card border border-line bg-white p-4 shadow-card sm:grid-cols-2 lg:grid-cols-4" do |form| %>
    <div class="sm:col-span-2 lg:col-span-4">
      <%= ui_field form, :q, as: :search, label: t(".filters.search"), name: "q", value: @filters[:q], autocomplete: "off",
                             data: { action: "search#queue" } %>
    </div>
    <% selects.each do |name, choices| %>
      <div class="space-y-1.5">
        <%= label_tag "filter_#{name}", t(".filters.#{name}"), class: "block text-sm font-medium text-ink" %>
        <div class="relative">
          <%= select_tag name, options_for_select(choices, @filters[name]), id: "filter_#{name}", class: select_class,
                               data: { action: "change->search#submit" } %>
          <%= ui_icon "chevron-down", variant: :mini, class: "pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-mute" %>
        </div>
      </div>
    <% end %>
    <div class="flex flex-wrap gap-3 sm:col-span-2 lg:col-span-1 lg:justify-end">
      <%= ui_button t(".filters.submit"), type: :submit, icon: "funnel", data: { search_target: "button" } %>
      <%= ui_button t(".filters.reset"), href: courses_path, variant: :ghost %>
    </div>
    <%# UDR-0054 §3.9 : réponse non 2xx → le contrôleur search pose cet état dans le frame. %>
    <template data-search-target="error"><%= ui_error_state retry_href: "#" %></template>
  <% end %>
<% end %>

<%# target _top : une carte ouvre la page du cours, pas le frame. %>
<%= turbo_frame_tag "courses", target: "_top", data: { turbo_action: "advance" }, class: "block transition-opacity aria-busy:opacity-50" do %>
  <p id="courses_total" class="mb-3 text-sm text-mute" aria-live="polite"><%= t(".total", count: @page.total_count) %></p>
  <% if @page.rows.any? %>
    <%# UDR-0013, amendement du 2026-10-05 : 24 cartes, puis la page suivante chargée au défilement (catalog/courses/_page). %>
    <%= render "page", page: @page %>
  <% else %>
    <div id="courses_empty">
      <% if @filters.values.any?(&:present?) %>
        <%= ui_empty_state title: t(".no_match_title"), description: t(student ? ".student_no_match_description" : ".no_match_description"),
                           icon: "magnifying-glass" do %>
          <%= ui_button t(".clear_search"), href: courses_path, variant: :secondary, icon: "x-mark" %>
        <% end %>
      <% elsif student && student_audience.empty? %>
        <%= ui_empty_state title: t(".no_class_title"), description: t(".no_class_description"), icon: "user-group" %>
      <% else %>
        <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "book-open" %>
      <% end %>
    </div>
  <% end %>
<% end %>
