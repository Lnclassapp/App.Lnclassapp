<%# 🌐 UI · catalog/courses/index — catalogue des cours (CA-01), pour tous les rôles connectés %>
<%# Rôle : recherche et filtres (téléphone compris) qui visent le frame « courses » ; élève : son niveau, recherche seule, groupes par matière, vue d'une matière, et sur ordinateur pastilles des matières et leçons en cartes avec leurs fiches ; enseignant : « Cours de Tle D », une de ses matières à la fois (puces), sans menus, une carte par fiche de cours avec ses fiches de révision, sur ordinateur en colonne de 40 rem ; équipe : création et import %>
<%# ADR  : 0028, 0035, 0076, 0090 · UDR : 0006, 0013 (amendements du 2026-10-02 et du 2026-10-05), 0057, 0069, 0077 §3.2 (amendement du 2026-10-06), 0085 (élève), 0126 §3.1 (amendé par XXXX écrans enseignant sans répétition §3.7), XXXX écrans élève sans répétition §3.6 (« Progression DPFC » une fois) et §3.6 bis (Cours par leçons, dès lg), 0144 parcours matière → exercice §3 (carte Prochain exercice) · par pages de 24 %>
<% team = current_actor.team? %>
<%# UDR-0013, amendement du 2026-10-01 : l'élève ne voit que son niveau ; le filtre par niveau ne lui sert plus. %>
<% student = current_actor.student? %>
<%# UDR-0085 §3.1 : la vue d'une matière de l'élève, titrée par la matière. %>
<% material = student_material %>
<%# UDR enseignant §3.7 : « Cours de Tle D » depuis un rond de niveau de l'accueil ; sans niveau dans l'adresse, « Cours ». %>
<% teacher_title = (t(".teacher_title", level: teacher_level_label) if teacher_scope && teacher_level_label) %>
<% page_title(material ? material.name : (teacher_title || t(".page_title"))) %>
<% content_for :nav_key, "courses" %>
<%# UDR-0077 §3.2 : l'enseignant ne lit que sa matière, aux niveaux (et séries) de ses classes de l'année. %>
<% teacher = teacher_scope %>
<%# UDR-0085 §3.1 : l'élève n'a que la recherche ; la matière de sa vue n'est pas un filtre qu'il quitte. %>
<%# UDR enseignant §3.7 : niveau, série et matière viennent du rond et de la puce ; seule la recherche se quitte. %>
<% filtered = (student ? @filters.except(:material) : (teacher ? @filters.slice(:q) : @filters)).values.any?(&:present?) %>
<% reset_path = courses_path(**(teacher ? @filters.slice(:level, :series, :material).compact_blank : { material: material&.slug })) %>
<% total = t(".total", count: @page.total_count) %>
<% total = if student
             t(".student_total", total:)
           elsif teacher_material
             t(".teacher_total", total:, material: teacher_material.shortname.presence || teacher_material.name)
           else
             total
           end %>
<% body = capture do %>
<% unless list_frame_request? %>
  <% if team %>
    <%= ui_page_header title: t(".title"), subtitle: t(".subtitle") do %>
      <%= ui_button t(".import"), href: new_teams_import_path(kind: "course_tree"), variant: :secondary, icon: "arrow-up-tray",
                                  data: { turbo_frame: "modal" } %>
      <%= ui_button t(".new_course"), href: new_teams_course_path, icon: "plus", data: { turbo_frame: "modal" } %>
    <% end %>
  <% elsif material %>
    <%# UDR-0085 §3.1 : l'icône et le nom de la matière ; pas de lien « Tous les cours », on revient par le menu. %>
    <% illustration = subject_illustration(material.slug) %>
    <div id="courses_material_title" class="mb-6 flex items-center gap-3">
      <span class="<%= class_names("grid size-12 shrink-0 place-items-center rounded-full", illustration.tint) %>">
        <%= image_tag illustration.path, alt: "", class: "size-8", "aria-hidden": true %>
      </span>
      <h1 class="min-w-0 font-display text-2xl font-medium tracking-tight text-balance sm:text-3xl"><%= material.name %></h1>
    </div>
    <%# UDR parcours matière → exercice §3 : la carte, sous le titre de la matière, hors du frame de la recherche. %>
    <%= render "catalog/courses/next_exercise", next_exercise: next_exercise_for(material.slug), scope: :material, id: "material_next_exercise" %>
  <% elsif student %>
    <%# UDR-0013, amendement du 2026-10-02 (UDR-0057 R4) : la portée du catalogue en infobulle, collée au titre. UDR-0085
        §3.1 : plus de lien « Accueil », l'élève revient par le menu de l'avatar ou le menu de gauche. %>
    <div class="mb-6 flex flex-wrap items-center gap-x-1">
      <h1 class="font-display text-2xl font-medium tracking-tight text-balance sm:text-3xl"><%= t(".title") %></h1>
      <%= ui_info_tip t(".student_scope"), label: t(".student_scope_label") %>
    </div>
  <% elsif teacher %>
    <%# UDR enseignant §3.7 : « ‹ Accueil », titre, recherche et puces de matière ; rien de commun avec l'élève (ADR-0103 §4.6 :
        sans matière, l'état vide du bas dit quoi faire). %>
    <%= render "catalog/courses/teacher_header", title: teacher_title || t(".title"), teacher: %>
  <% else %>
    <%= ui_page_header title: t(".title"), subtitle: t(".subtitle") %>
  <% end %>

  <% if student %>
    <%# UDR-0085 §3.1 : un seul champ, pleine largeur, cherché pendant la frappe ; « Filtrer » sert sans JavaScript. %>
    <%= form_with url: courses_path, method: :get, id: "courses-filters", html: { role: "search", "aria-label": t(".filters.label") },
                  data: { turbo_frame: "courses", turbo_action: "advance", controller: "search" }, class: "mb-6 flex items-center gap-3" do %>
      <% if material %>
        <%= hidden_field_tag :material, material.slug, id: nil %>
      <% end %>
      <div class="relative min-w-0 flex-1">
        <%= label_tag :q, t(".filters.search"), class: "sr-only" %>
        <%= ui_icon "magnifying-glass", class: "pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-mute" %>
        <%= search_field_tag :q, @filters[:q], id: "q", placeholder: t(".filters.search"), autocomplete: "off",
                                               data: { action: "search#queue" },
                                               class: "block min-h-tap w-full rounded-full border border-line bg-white py-3 pr-4 pl-12 text-base text-ink shadow-card placeholder:text-mute focus:border-brand focus:outline-2 focus:outline-brand" %>
      </div>
      <div data-search-target="button">
        <%= ui_button t(".filters.submit"), type: :submit, icon: "funnel" %>
      </div>
      <template data-search-target="error"><%= ui_error_state retry_href: "#" %></template>
    <% end %>
  <% elsif !teacher %>
    <% select_class = class_names(ComponentsHelper::FIELD_INPUT, ComponentsHelper::FIELD_SHAPES[:select], ComponentsHelper::FIELD_STATES[:valid]) %>
    <%# UDR-0069 §3.4 : une série sert plusieurs niveaux ; la liste la donne une fois, par nom. %>
    <% series = filter_options.series_by_level.values.flatten.uniq(&:slug).sort_by(&:name) %>
    <% levels = filter_options.levels %>
    <% if teacher %>
      <%# UDR-0077 §3.2 : ses niveaux et ses séries seulement ; la liste « Matière » ne propose que ses matières, et seulement
          s'il en a plusieurs (UDR-0126 §3.1). %>
      <% levels = levels.select { |level| teacher.audience.pairs.any? { it.first == level.id } } %>
      <% series = series.select { |one| teacher.audience.pairs.any? { it.last == one.id } } %>
    <% end %>
    <% selects = {
         level: [ [ t(".filters.all_levels"), "" ], *levels.map { [ it.name, it.slug ] } ],
         series: ([ [ t(".filters.all_series"), "" ], *series.map { [ it.name, it.slug ] } ] unless teacher && series.empty?),
         material: (if teacher
                      [ [ t(".filters.all_teacher_materials"), "" ], *teacher.materials.map { [ it.name, it.slug ] } ] if teacher.several_materials?
                    else
                      [ [ t(".filters.all_materials"), "" ], *filter_options.materials.map { [ it.name, it.slug ] } ]
                    end)
       }.compact %>
    <%# Recherche pendant la frappe (UDR-0054 §3.9) : le champ reste hors du frame ; « Filtrer » sert sans JavaScript. %>
    <%# UDR-0077, amendement du 2026-10-06 (décision du porteur) : visible sur téléphone aussi, une colonne sous 640 px. %>
    <%= form_with url: courses_path, method: :get, id: "courses-filters", html: { role: "search", "aria-label": t(".filters.label") },
                  data: { turbo_frame: "courses", turbo_action: "advance", controller: "search" },
                  class: "mb-6 grid items-end gap-3 rounded-card border border-line bg-white p-3 shadow-card sm:grid-cols-2 sm:p-4 lg:grid-cols-4" do |form| %>
      <%# Une seule liste (l'enseignant sans série : « Niveau ») : la recherche la partage avec elle sur une ligne, sur ordinateur. %>
      <div class="<%= class_names("sm:col-span-2", selects.size == 1 ? "lg:col-span-3" : "lg:col-span-4") %>">
        <%= ui_field form, :q, as: :search, label: t(".filters.search"), name: "q", value: @filters[:q], autocomplete: "off",
                               data: { action: "search#queue" } %>
      </div>
      <% selects.each do |name, choices| %>
        <%# UDR-0126 §3.1 : la liste des matières de l'enseignant n'existe que sur ordinateur ; ses groupes font le tri sur téléphone. %>
        <div class="<%= class_names("space-y-1.5", "hidden sm:block" => teacher && name == :material) %>">
          <%= label_tag "filter_#{name}", t(".filters.#{name}"), class: "block text-sm font-medium text-ink" %>
          <div class="relative">
            <%= select_tag name, options_for_select(choices, @filters[name]), id: "filter_#{name}", class: select_class,
                                 data: { action: "change->search#submit" } %>
            <%= ui_icon "chevron-down", variant: :mini, class: "pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-mute" %>
          </div>
        </div>
      <% end %>
      <%# Sans JavaScript, « Filtrer » ; avec, la cellule entière se cache (plus d'« Effacer » seul) : « Tout voir », dans le
          frame, quitte le filtre (UDR-0077, amendement du 2026-10-06). %>
      <div class="flex flex-wrap gap-3 sm:col-span-2 lg:col-span-1 lg:justify-end" data-search-target="button">
        <%= ui_button t(".filters.submit"), type: :submit, icon: "funnel" %>
      </div>
      <%# UDR-0054 §3.9 : réponse non 2xx → le contrôleur search pose cet état dans le frame. %>
      <template data-search-target="error"><%= ui_error_state retry_href: "#" %></template>
    <% end %>
  <% end %>
<% end %>

<%# target _top : une carte ouvre la page du cours, pas le frame. %>
<%= turbo_frame_tag "courses", target: "_top", data: { turbo_action: "advance" }, class: "block transition-opacity aria-busy:opacity-50" do %>
  <div class="mb-3 flex items-center justify-between gap-3">
    <p id="courses_total" class="<%= class_names("text-sm text-mute", "font-medium text-ink" => student) %>" aria-live="polite"><%= total %></p>
    <%# Le seul moyen de quitter les filtres, à toutes les largeurs (UDR-0077, amendement du 2026-10-06) : rendu dans le frame,
        il suit chaque filtrage ; target _top, il recharge aussi la recherche. L'élève : pendant une recherche seulement,
        dans sa matière s'il en regarde une (UDR-0085 §3.1). %>
    <% if filtered %>
      <%= link_to t(".reset"), reset_path, id: "courses_reset",
                  class: "inline-flex min-h-tap items-center px-2 text-sm font-medium text-brand-strong" %>
    <% end %>
  </div>
  <% if @page.rows.any? %>
    <%# UDR-0013, amendement du 2026-10-05 : 24 cartes, puis la page suivante chargée au défilement (catalog/courses/_page). %>
    <%= render "page", page: @page %>
  <% else %>
    <div id="courses_empty">
      <% if filtered %>
        <%= ui_empty_state title: t(".no_match_title"), description: t(student ? ".student_no_match_description" : (teacher ? ".teacher_no_match_description" : ".no_match_description")),
                           icon: "magnifying-glass" do %>
          <%= ui_button t(".clear_search"), href: reset_path, variant: :secondary, icon: "x-mark" %>
        <% end %>
      <% elsif student && student_audience.empty? %>
        <%= ui_empty_state title: t(".no_class_title"), description: t(".no_class_description"), icon: "user-group" %>
      <% elsif teacher&.materials&.empty? %>
        <%# ADR-0103 §4.6 : l'enseignant sans liste dans cet établissement est invité à la faire, jamais laissé devant une page vide. %>
        <%= ui_empty_state title: t(".teacher_no_material_title"), description: t(".teacher_no_material_description"), icon: "book-open" do %>
          <%= ui_button t(".teacher_no_material_action"), href: edit_profile_materials_path, variant: :secondary, icon: "pencil-square",
                                                           data: { turbo_frame: "modal" } %>
        <% end %>
      <% elsif teacher&.audience&.empty? %>
        <%= ui_empty_state title: t(".teacher_no_class_title"), description: t(".teacher_no_class_description"), icon: "user-group" do %>
          <%= ui_button t(".teacher_no_class_action"), href: teacher_classrooms_path, variant: :secondary, icon: "pencil-square" %>
        <% end %>
      <% else %>
        <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "book-open" %>
      <% end %>
    </div>
  <% end %>
<% end %>
<% end %>
<%# UDR-0085 §3.4 : la colonne de l'élève, comme son accueil — pleine, 720 px dès 700 px, 960 px au plus dès 1 024 px. %>
<% if student %>
  <%# UDR écrans élève §3.6 bis : dès lg, Cours par leçons (une matière, ses leçons en cartes) ; sous lg, le Cours de §3.6, inchangé.
      Deux blocs, un seul visible : les ids du bloc ordinateur commencent par « lesson ». %>
  <% lessons = capture do %>
    <% next if list_frame_request? %>
    <% materials = lesson_materials %>
    <% current = lesson_material %>
    <% page = lessons_page %>
    <h1 class="mb-4 font-display text-2xl font-medium tracking-tight text-balance"><%= t(".title") %></h1>
    <% if materials.any? %>
      <%# CA-E15 : les matières de l'élève en pastilles (rond d'icône 32 px, 48 px de haut), la matière affichée pleine. %>
      <nav id="lesson_materials" aria-label="<%= t(".lessons.materials_label") %>" class="mb-4">
        <ul class="flex flex-wrap gap-2">
          <% materials.each do |one| %>
            <% active = one.slug == current.slug %>
            <% illustration = subject_illustration(one.slug) %>
            <li>
              <%= link_to courses_path(material: one.slug), id: "lesson_material_#{one.slug}", "aria-current": ("page" if active),
                          class: class_names("inline-flex min-h-tap items-center gap-2 rounded-full border py-1 pr-4 pl-2 text-sm font-medium focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand",
                                             "border-brand-strong bg-brand-strong text-white" => active,
                                             "border-line-strong bg-white text-ink transition hover:bg-mist" => !active) do %>
                <span class="<%= class_names("grid size-8 shrink-0 place-items-center rounded-full", active ? "bg-white" : illustration.tint) %>">
                  <%= image_tag illustration.path, alt: "", class: "size-5", "aria-hidden": true %>
                </span>
                <%= one.name %>
              <% end %>
            </li>
          <% end %>
        </ul>
      </nav>
      <%= render "catalog/courses/next_exercise", next_exercise: next_exercise_for(current.slug), scope: :material, id: "lesson_material_next_exercise" %>
      <%= form_with url: courses_path, method: :get, id: "lessons-filters", html: { role: "search", "aria-label": t(".filters.label") },
                    data: { turbo_frame: "lessons", turbo_action: "advance", controller: "search" }, class: "mb-4 flex items-center gap-3" do %>
        <%= hidden_field_tag :material, current.slug, id: nil %>
        <div class="relative min-w-0 flex-1">
          <%= label_tag :lesson_q, t(".filters.search"), class: "sr-only" %>
          <%= ui_icon "magnifying-glass", class: "pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-mute" %>
          <%= search_field_tag :q, @filters[:q], id: "lesson_q", placeholder: t(".filters.search"), autocomplete: "off",
                                                 data: { action: "search#queue" },
                                                 class: "block min-h-tap w-full rounded-card border border-line bg-white py-3 pr-4 pl-12 text-base text-ink placeholder:text-mute focus:border-brand focus:outline-2 focus:outline-brand" %>
        </div>
        <div data-search-target="button">
          <%= ui_button t(".filters.submit"), type: :submit, icon: "funnel" %>
        </div>
        <template data-search-target="error"><%= ui_error_state retry_href: "#" %></template>
      <% end %>
    <% end %>
    <%= turbo_frame_tag "lessons", target: "_top", data: { turbo_action: "advance" }, class: "block transition-opacity aria-busy:opacity-50" do %>
      <% if page&.rows&.any? %>
        <div class="mb-3 flex items-center justify-between gap-3">
          <p id="lessons_total" class="text-sm text-mute" aria-live="polite"><%= t(".student_total", total: t(".total", count: page.total_count)) %></p>
          <% if @filters[:q].present? %>
            <%= link_to t(".reset"), courses_path(material: current.slug), id: "lessons_reset",
                        class: "inline-flex min-h-tap items-center px-2 text-sm font-medium text-brand-strong" %>
          <% end %>
        </div>
        <%# Une carte par leçon, deux colonnes, chacune à sa hauteur (items-start) ; les icônes dessinées une fois. %>
        <%= ui_icon_sprite(prefix: "lessons-") do %>
          <ul id="lessons_list" class="grid items-start gap-5 lg:grid-cols-2">
            <%= render partial: "catalog/courses/course_card", collection: page.rows, as: :course,
                       locals: { show_status: false, student: true, lesson_card: true } %>
          </ul>
        <% end %>
      <% else %>
        <div id="lessons_empty">
          <%# Sans classe, pas de matière courante : l'état « sans classe » passe avant la recherche (current est nil). %>
          <% if materials.empty? %>
            <%= ui_empty_state title: t(".no_class_title"), description: t(".no_class_description"), icon: "user-group" %>
          <% elsif @filters[:q].present? %>
            <%= ui_empty_state title: t(".no_match_title"), description: t(".student_no_match_description"), icon: "magnifying-glass" do %>
              <%= ui_button t(".clear_search"), href: courses_path(material: current.slug), variant: :secondary, icon: "x-mark" %>
            <% end %>
          <% else %>
            <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "book-open" %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
  <div id="student_courses" class="mx-auto w-full max-w-180 lg:max-w-240">
    <div class="lg:hidden"><%= body %></div>
    <% if lessons.present? %><div id="student_lessons" class="hidden lg:block"><%= lessons %></div><% end %>
  </div>
<% elsif teacher %>
  <%# UDR enseignant §3.7 (ordinateur) : une colonne de 40 rem, centrée ; sous lg, la page est inchangée. %>
  <div id="teacher_courses" class="lg:mx-auto lg:w-full lg:max-w-160"><%= body %></div>
<% else %>
  <%= body %>
<% end %>
