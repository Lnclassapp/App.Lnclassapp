<%# 🌐 UI · catalog/courses/_role_actions — actions de la page d'un cours selon le rôle %>
<%# Rôle : équipe → panneau de statut (B2) et menu en modales (modifier, nouvelle fiche, import) ; enseignant → assigner (CA-27) %>
<%# ADR  : 0028, 0035 · UDR : 0006, 0013, 0014 %>
<% if status_record %>
  <div class="flex flex-wrap items-center gap-2 lg:shrink-0 lg:justify-end">
    <%= content_status_panel(record: status_record) %>
    <%= ui_dropdown label: t(".menu", name: course.name), id: "course-actions-menu" do %>
      <% { edit: [ edit_teams_course_path(course.slug), "pencil-square" ],
           new_essential: [ new_teams_course_essential_path(course.slug), "document-plus" ],
           import_essentials: [ new_teams_import_path(kind: "essentials", course: course.slug), "arrow-up-tray" ] }.each do |key, (href, icon)| %>
        <%= link_to href, role: "menuitem", tabindex: -1, data: { turbo_frame: "modal" },
                          class: "flex min-h-tap w-full items-center gap-3 rounded-sm px-3 text-sm font-medium text-ink hover:bg-mist focus:bg-mist focus:outline-none" do %>
          <%= ui_icon icon, class: "opacity-70" %><span><%= t(".#{key}") %></span>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% elsif current_actor.teacher? %>
  <div class="lg:shrink-0">
    <%= ui_button t(".assign"), href: course_assignments_path(course.slug), variant: :secondary, icon: "user-group" %>
  </div>
<% end %>
