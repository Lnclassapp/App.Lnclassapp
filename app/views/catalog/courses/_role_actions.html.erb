<%# 🌐 UI · catalog/courses/_role_actions — actions de la page d'un cours selon le rôle %>
<%# Rôle : équipe → badge de statut (B2) et menu ⋮ (modifier en modale, corrigé ; publier, archiver, tout publier) ; rien pour les autres rôles %>
<%# ADR  : 0028, 0035, 0072 · UDR : XXXX-fiche-de-revision-en-quatre-blocs §3.5, 0006, 0013 (un cours ne s'assigne plus), 0014, 0042, 0062 %>
<% if status_record %>
  <div class="flex flex-wrap items-center gap-2 lg:shrink-0 lg:justify-end">
    <%= content_status_panel(record: status_record) %>
    <%= ui_dropdown label: t(".menu", name: course.name), id: "course-actions-menu" do %>
      <%= ui_dropdown_item t(".edit"), href: edit_teams_course_path(course.slug), icon: "pencil-square", frame: "modal" %>
      <%# UDR-XXXX §3.5 : le corrigé s'ouvre en page pleine, avant les transitions. %>
      <%= ui_dropdown_item t("teams.answer_keys.menu"), href: answer_key_teams_course_path(course.slug), icon: "clipboard-document-check" %>
      <%= content_transition_items(record: status_record) %>
      <%= ui_dropdown_item t("catalog.content_status.actions.publish_all"), href: publish_all_teams_course_path(course.slug),
                           method: :patch, icon: "check-badge" %>
    <% end %>
  </div>
<% end %>
