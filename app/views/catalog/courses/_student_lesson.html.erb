<%# 🌐 UI · catalog/courses/_student_lesson — la page d'une leçon de l'élève, style Wave : flèche retour, titre, « Réviser », « Prépare interros », « Prépare devoirs » %>
<%# Rôle : écran intérieur (content_for :inner : ni barre ni menu) ; trois groupes de 3 lignes puis « Voir plus (n) », un groupe sans ligne est absent ; la ligne « Fiche de révision » mène à la fiche, sur sa propre page (course_fiche_path) ; l'ancienne adresse #fiche-de-revision y est menée (hash_redirect) ; plus de carte « Prochain exercice », de « Tous les exercices », de cadre noir ni d'étiquette « PRÉPARE DEVOIRS N°x » %>
<%# ADR  : 0113 (§4.3 : pas de préchargement, l'ouverture retient les lectures), 0121 · UDR : 0173 §3 (leçon), 0139 §3.1, 0149 §3 · locals: (course:, revision:, proposals:, prepare:) -%>
<% content_for :inner, "1" %>
<% content_for :head do %><%= stylesheet_link_tag "prepare_sheet" %><% end %>
<% number = lesson_number(course.subtitle) %>
<% subtitle = [ (t("catalog.courses.lesson_tile.number", number:) if number), course.material_name, [ course.level_name, course.series_name ].compact.join(" ") ].compact_blank.join(" · ") %>
<%# Une ancienne adresse « /courses/<slug>#fiche-de-revision » est menée à la page de la fiche. %>
<div id="student_lesson" class="mx-auto w-full max-w-180 space-y-6 pb-6"
     data-controller="hash-redirect" data-hash-redirect-hash-value="fiche-de-revision" data-hash-redirect-url-value="<%= course_fiche_path(course.slug) %>">
  <%= render "shared/screens/inner_header", title: course.name, subtitle:, back_href: courses_path(material: course.material_slug) %>

  <%# Réviser : la ligne mène à la fiche, sur sa propre page. %>
  <% if revision.kind == :sheet %>
    <%= render layout: "shared/screens/group", locals: { id: "student_lesson_revise", title: t("catalog.courses.student_lesson.revise"), total: 1 } do %>
      <%= render "shared/screens/row", id: "student_lesson_revision_link", title: t("catalog.courses.student_lesson.revision"), href: course_fiche_path(course.slug),
                                       tint: "bg-brand-soft", icon: ui_icon("document-text") %>
    <% end %>
  <% end %>

  <% interros = prepare.interros %>
  <% if interros.any? %>
    <%= render layout: "shared/screens/group", locals: { id: "prepare-interros", title: t("catalog.courses.sheets.interros_section"), total: interros.size } do %>
      <% interros.each_with_index do |sheet, index| %>
        <% label = sheet.kind == :lesson_wide ? t("catalog.courses.show.lesson_wide_title") : sheet.title %>
        <%= render "shared/screens/row", id: sheet.dom_id, title: t("catalog.courses.student_lesson.interro", number: sheet.number, title: label), href: course_sheet_path(course.slug, sheet.dom_id),
                                         detail: t("catalog.courses.student_lesson.questions", count: sheet.exercises.sum { it.questions.size }), tint: "bg-warning-soft",
                                         folded: index >= ComponentsHelper::REVEAL_LIMIT, icon: ui_icon("clipboard-document-check") %>
      <% end %>
    <% end %>
  <% end %>

  <%# Toute notion garde son ancre « notion-<slug> » (liens, 301) : une notion sans exercice n'a pas de ligne, son repère est lu aux seuls lecteurs d'écran. %>
  <% if prepare.bare.any? %>
    <div class="sr-only">
      <% prepare.bare.each do |notion| %>
        <span id="notion-<%= notion.essential_slug %>" tabindex="-1"><%= notion.title %>. <%= t("catalog.courses.show.notion_without_exercise") %></span>
      <% end %>
    </div>
  <% end %>

  <% devoirs = prepare.devoirs %>
  <% if devoirs.any? %>
    <%= render layout: "shared/screens/group", locals: { id: "prepare-devoirs", title: t("catalog.courses.sheets.devoirs_section"), total: devoirs.size } do %>
      <% devoirs.each_with_index do |sheet, index| %>
        <%= render "shared/screens/row", id: sheet.dom_id, title: sheet.title, href: course_sheet_path(course.slug, sheet.dom_id),
                                         detail: t("catalog.courses.sheets.card_exercises", count: sheet.exercises.size), value: "#{sheet.passed}/#{sheet.exercises.size}",
                                         tint: "bg-tint-lilac", folded: index >= ComponentsHelper::REVEAL_LIMIT, icon: ui_icon("pencil-square") %>
      <% end %>
    <% end %>
  <% end %>
</div>
