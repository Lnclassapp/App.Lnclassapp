<%# 🌐 UI · catalog/courses/show — page d'une leçon (CA-04, CA-10), pour tous les rôles connectés %>
<%# Rôle : retour « Cours » (UDR-0054 §3.2), en-tête, actions du rôle, puis trois sections : le bouton « Fiche de révision » (fiche en plein écran), « Prépare interros » et « Prépare devoirs » ; morphing (B2, B4) %>
<%# ADR  : 0028, 0035, 0051, 0090, 0110-fiche-de-cours-en-donnees-importees, 0113 · UDR : 0006, 0007, 0013, 0054, 0139 §3.1, 0145 §3.2 ter %>
<% course = @detail.course %>
<% page_title t(".page_title", name: course.name) %>
<% content_for :nav_key, "courses" %>
<%# UDR-0054 §3.2 : venu du catalogue filtré (?material=…), le retour y ramène avec son filtre. %>
<%= ui_back_link t(".back"), href: back_href(courses_path, from: courses_path) %>

<div id="course_header" class="mb-8">
  <%= ui_card padding: :md do %>
    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0 space-y-3">
        <h1 class="font-display text-2xl font-medium tracking-tight text-balance sm:text-3xl"><%= course.name %></h1>
        <% if course.subtitle.present? %>
          <p class="text-mute"><%= course.subtitle %></p>
        <% end %>
        <div class="flex flex-wrap items-center gap-2">
          <%= ui_subject_badge course.material_name, category: course.material_category %>
          <%= ui_badge [ course.level_name, course.series_name ].compact.join(" ") %>
        </div>
      </div>
      <%= render "role_actions", course:, status_record: @status_record %>
    </div>
  <% end %>
</div>

<%# UDR parcours matière → exercice §3 : l'élève voit d'abord où cliquer ; la fiche de révision garde sa place. %>
<%= render "catalog/courses/next_exercise", next_exercise: @next_exercise, scope: :lesson, id: "lesson_next_exercise" %>

<div class="space-y-10">
  <%# La fiche n'est pas ouverte d'emblée : un bouton l'ouvre en plein écran, entière (sans « Voir plus »). Une adresse vers
      #fiche-de-revision ou vers une notion de la fiche l'ouvre à l'arrivée (catalog--revision-dialog). %>
  <section id="fiche-de-revision" aria-label="<%= t(".revision_title") %>">
    <% if @revision.kind == :empty %>
      <%= render "catalog/courses/revision_sheet", course:, revision: @revision %>
    <% else %>
      <%= tag.div data: { controller: "catalog--revision-dialog" } do %>
        <%= ui_modal id: "revision-sheet", title: t(".revision_title"), placement: :full,
                     trigger: t(".revision_title"), trigger_icon: "document-text" do %>
          <%= render "catalog/courses/revision_sheet", course:, revision: @revision, whole: true %>
        <% end %>
      <% end %>
    <% end %>
  </section>

  <%# Ouvrir la page enregistre la lecture des notions (ADR-XXXX §4.3) : pas de préchargement au survol. %>
  <section id="prepare-interros" aria-labelledby="prepare_title" data-turbo-prefetch="false">
    <h2 id="prepare_title" class="mb-2 font-display text-xl font-medium"><%= t(".prepare_title") %></h2>
    <p class="mb-4 text-mute"><%= t(".prepare_intro") %></p>
    <%= render "catalog/courses/prepare_interros", course:, prepare: @prepare %>
  </section>

  <% if prepare_any?(@prepare, "evaluation") %>
    <section id="prepare-devoirs" aria-labelledby="prepare_devoirs_title" data-turbo-prefetch="false">
      <h2 id="prepare_devoirs_title" class="mb-2 font-display text-xl font-medium"><%= t(".prepare_devoirs_title") %></h2>
      <p class="mb-4 text-mute"><%= t(".prepare_devoirs_intro") %></p>
      <%= render "catalog/courses/prepare_interros", course:, prepare: @prepare, exercise_type: "evaluation" %>
    </section>
  <% end %>
</div>
