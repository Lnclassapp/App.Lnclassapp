<%# 🌐 UI · catalog/courses/sheets/_teacher_bar — la barre de l'enseignant sous un exercice : « Choisir » pour le devoir, puis « Assigner à <classe> », une par classe %>
<%# Rôle : à la place de « Vérifier ma réponse » et « Indice », dans la barre d'actions de la feuille ; la case « Choisir » (role="checkbox", état tenu par Stimulus assignment-batch) et la bascule d'assignation (classroom/assignments/_toggle, mode feuille) ; rend le bandeau d'envoi (_batch_bar) une seule fois par page %>
<%# ADR  : 0048, 0072, sujets-de-devoir (ajout du 2026-10-30) · UDR : XXXX-feuilles-prepare-interros-et-devoirs §3 (Vue enseignant, Devoir composé par l'enseignant) · Stimulus : assignment-batch · %>
<%# locals: (exercise:, targets:, classrooms:) -%>
<% if targets && classrooms.any? %>
  <%# La case n'envoie rien : le bandeau lit les cases par data-batch-choice (l'identifiant public de l'exercice) et garde le choix dans le navigateur. %>
  <%= tag.button t("classroom.assignments.batch.choose"), type: :button, role: "checkbox", class: "ps-btn ps-btn--choose",
                  aria: { checked: false, label: t("classroom.assignments.batch.choose_label", name: exercise.title) },
                  data: { batch_choice: exercise.public_id } %>
  <% classrooms.each do |target| %>
    <% assignment = targets.states[[ target.public_id, exercise.public_id ]] %>
    <%# Les exercices se rendent dans l'ordre de la page : le premier « Assigner » est plein (UDR-0134 §3.13). %>
    <% first_assign = assignment.nil? && !@primary_assign_taken %>
    <% @primary_assign_taken ||= first_assign %>
    <%= render "classroom/assignments/toggle", classroom_public_id: target.public_id, assignable_type: "Exercise",
               assignable_key: exercise.public_id, assignable_name: exercise.title, classroom_name: target.name,
               assignment_public_id: assignment&.assignment_public_id, due_on: assignment&.due_on,
               needs_session_days: target.needs_session_days, sheet: true, primary: first_assign %>
  <% end %>
  <%# Le bandeau est collé au bas de l'écran (position fixe) : où il est rendu dans la page ne compte pas, une fois suffit. %>
  <% unless @batch_bar_rendered %>
    <% @batch_bar_rendered = true %>
    <%= render "catalog/courses/sheets/batch_bar", classrooms: %>
  <% end %>
<% end %>
