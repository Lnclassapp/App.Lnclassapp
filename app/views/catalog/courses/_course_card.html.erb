<%# 🌐 UI · catalog/courses/_course_card — carte-vitrine d'un cours du catalogue (UDR-0001, CA-26) %>
<%# Rôle : toute la carte mène au cours ; matière colorée par sa catégorie, niveau et série, titre, sous-titre ; statut pour l'équipe %>
<%# ADR  : 0035 · UDR : 0001, 0005, 0013 · aucune liste de fiches essentielles sur la carte %>
<li id="course_<%= course.slug %>">
  <%= ui_card href: course_path(course.slug), class: "group h-full" do %>
    <div class="flex h-full flex-col">
      <div class="mb-4 flex flex-wrap items-start justify-between gap-2">
        <%= ui_subject_badge course.material_name, category: course.material_category %>
        <%= ui_badge [ course.level_name, course.series_name ].compact.join(" ") %>
      </div>
      <h2 class="font-display text-lg leading-tight font-extrabold text-balance text-ink"><%= course.name %></h2>
      <% if course.subtitle.present? %>
        <p class="mt-2 line-clamp-2 text-sm text-mute"><%= course.subtitle %></p>
      <% end %>
      <div class="flex-1"></div>
      <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-line pt-4">
        <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-strong">
          <%= t(".open") %><%= ui_icon "arrow-right", variant: :mini, size: :sm, class: "transition group-hover:translate-x-1" %>
        </span>
        <% if show_status %>
          <%= content_status_badge(course.status) %>
        <% end %>
      </div>
    </div>
  <% end %>
</li>
