<%# 🌐 UI · catalog/courses/_course_card — carte-vitrine d'un cours du catalogue (UDR-0001, CA-26) %>
<%# Rôle : toute la carte mène au cours ; matière (sauf filtrée, élève), niveau et série (sauf élève), titre, sous-titre ; statut pour l'équipe, sauf « Publié » %>
<%# ADR  : 0035 · UDR : 0001, 0005, 0013 (amendement du 2026-10-05 : ni pied « Ouvrir le cours », ni statut « Publié »), 0057 · aucune liste de fiches essentielles sur la carte %>
<%# locals: (course:, show_status:, show_level: true, show_material: true) -%>
<%# UDR-0013, amendement du 2026-10-05 : « Publié » est l'état normal, l'équipe ne voit que Brouillon ou Archivé. %>
<% status = (course.status if show_status && course.status != "published") %>
<% badges = [ (ui_badge([ course.level_name, course.series_name ].compact.join(" ")) if show_level), (content_status_badge(status) if status) ].compact %>
<li id="course_<%= course.slug %>">
  <%= ui_card href: course_path(course.slug), class: "h-full" do %>
    <% if show_material || badges.any? %>
      <div class="mb-4 flex flex-wrap items-start justify-between gap-2">
        <% if show_material %>
          <%= ui_subject_badge course.material_name, category: course.material_category %>
        <% end %>
        <% if badges.many? %>
          <span class="flex flex-wrap gap-2"><%= safe_join(badges) %></span>
        <% else %>
          <%= badges.first %>
        <% end %>
      </div>
    <% end %>
    <h2 class="font-display text-lg leading-tight font-extrabold text-balance text-ink"><%= course.name %></h2>
    <% if course.subtitle.present? %>
      <p class="mt-2 line-clamp-2 text-sm text-mute"><%= course.subtitle %></p>
    <% end %>
  <% end %>
</li>
