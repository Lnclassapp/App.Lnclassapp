<%# 🌐 UI · catalog/courses/_course_card — carte-vitrine d'un cours du catalogue (UDR-0001, CA-26) %>
<%# Rôle : toute la carte mène au cours ; matière, niveau et série (sauf élève), titre, sous-titre, pied « Ouvrir le cours → » ; statut pour l'équipe, sauf « Publié » ; élève : ligne compacte entière cliquable, leçon et pastille « En cours » ; élève sur ordinateur (lesson_card) : la carte de la leçon, ses fiches en lignes (3 puis « Voir les N fiches ») ; enseignant : _teacher_course %>
<%# ADR  : 0035, 0090 · UDR : 0001, 0005, 0013 (amendement du 2026-10-05 ter), 0057, 0085 (§3.3 : « Reprendre » rouvre la dernière fiche lue), XXXX écrans élève sans répétition §3.6 et §3.6 bis (exception à UDR-0013 : fiches listées sur la carte de la leçon, élève sur ordinateur seulement) · aucune liste de fiches essentielles sur les autres cartes %>
<%# locals: (course:, show_status:, student: false, lesson_card: false) -%>
<%# UDR enseignant §3.7 : la carte de l'enseignant (lien vers la fiche de cours et ses fiches de révision) vit à part. %>
<% teacher = !student && current_actor.teacher? %>
<%# UDR-0013, amendement du 2026-10-05 : « Publié » est l'état normal, l'équipe ne voit que Brouillon ou Archivé. %>
<% status = (course.status if show_status && course.status != "published") %>
<%# ADR-0113 §4.3 : la notion n'a plus de page ; « Reprendre » rouvre la leçon, dont l'ouverture retient les lectures (pas de
    préchargement au survol, qui la servirait sans l'ouvrir). %>
<% resume = student && course.progress == :started %>
<% href = course_path(course.slug) %>
<% subtitle = if course.subtitle.present?
                # Une année scolaire (« 2026-2027 ») ne se coupe pas à son tiret.
                safe_join(course.subtitle.split(/(\d{4}-\d{4})/).map { it.match?(/\A\d{4}-\d{4}\z/) ? tag.span(it, class: "whitespace-nowrap") : it })
              end %>
<%# UDR écrans élève §3.6 : « Progression DPFC 2026-2027 » est écrit une fois, sous la recherche ; la ligne ne garde que la leçon. %>
<% lesson = (course.subtitle.to_s.split(/\s+[·–—-]\s+/).grep_v(/\AProgression DPFC/i).join(" · ").presence if student) %>
<% if lesson_card %>
  <%# UDR écrans élève §3.6 bis : « LEÇON N », le titre, « En cours », puis les fiches de la leçon en lignes entières cliquables
      (≥ 44 px), 3 puis « Voir les N fiches » (contrôleur reveal, sans requête). Le titre mène à la leçon. %>
  <% essentials = course.essentials %>
  <%= tag.li id: "lesson_#{course.slug}", class: "rounded-card border border-line bg-white shadow-card", data: ui_reveal_data do %>
    <div class="flex items-start justify-between gap-3 px-5 pt-4 pb-3">
      <div class="min-w-0">
        <% if lesson %><p class="text-xs tracking-wide text-mute uppercase"><%= lesson %></p><% end %>
        <h2 class="font-display text-base font-medium text-balance text-ink">
          <%= link_to course.name, course_path(course.slug), class: "hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
        </h2>
      </div>
      <% if course.progress == :started %>
        <%= ui_badge t(".progress.started"), tone: :brand, size: :sm %>
      <% elsif course.progress == :done %>
        <%= ui_icon "check-circle", variant: :solid, size: :sm, class: "text-success" %>
        <span class="sr-only"><%= t(".progress.done") %></span>
      <% end %>
    </div>
    <% if essentials.any? %>
      <ul class="divide-y divide-line border-t border-line">
        <% essentials.each_with_index do |essential, index| %>
          <%= render "catalog/courses/essential_row", essential:, course_slug: course.slug, show_status: false, student: true,
                                                      lesson: true, folded: index >= ComponentsHelper::REVEAL_LIMIT %>
        <% end %>
      </ul>
      <% if essentials.size > ComponentsHelper::REVEAL_LIMIT %>
        <button type="button" data-reveal-target="button" data-action="reveal#more"
                class="flex min-h-tap w-full items-center border-t border-line px-5 text-left text-sm text-brand-strong hover:bg-mist focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand">
          <%= t(".more_essentials", count: essentials.size) %>
        </button>
        <p class="sr-only" role="status" aria-live="polite" data-reveal-target="status"></p>
      <% end %>
    <% end %>
  <% end %>
<% else %>
<li id="course_<%= course.slug %>">
  <% if student %>
    <%# UDR écrans élève §3.6 : la ligne entière est le lien (≥ 44 px) ; titre, leçon et pastille « En cours », chevron. %>
    <%= link_to href, data: ({ turbo_prefetch: false } if resume),
                class: "group flex min-h-tap items-center gap-3 px-4 py-3 transition hover:bg-mist active:bg-mist focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand" do %>
      <div class="min-w-0 flex-1">
        <span class="block text-sm font-medium text-ink"><%= course.name %></span>
        <% if lesson || course.progress != :new %>
          <p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-mute">
            <% if lesson %><span class="min-w-0 text-pretty"><%= lesson %></span><% end %>
            <% if course.progress == :started %>
              <%= ui_badge t(".progress.started"), tone: :brand, size: :sm %>
            <% elsif course.progress == :done %>
              <%# La coche est décorative : « Terminée » est lu par les lecteurs d'écran. %>
              <%= ui_icon "check-circle", variant: :solid, size: :sm, class: "text-success" %>
              <span class="sr-only"><%= t(".progress.done") %></span>
            <% end %>
          </p>
        <% end %>
      </div>
      <%= ui_icon "chevron-right", variant: :mini, class: "shrink-0 text-mute transition group-hover:translate-x-0.5" %>
    <% end %>
  <% elsif teacher %>
    <%= render "catalog/courses/teacher_course", course: %>
  <% else %>
    <%= ui_card href:, class: "group h-full" do %>
      <div class="flex h-full flex-col">
        <div class="mb-4 flex flex-wrap items-start justify-between gap-2">
          <%= ui_subject_badge course.material_name, category: course.material_category %>
          <%= ui_badge [ course.level_name, course.series_name ].compact.join(" ") %>
        </div>
        <h2 class="font-display text-lg leading-tight font-medium text-balance text-ink"><%= course.name %></h2>
        <% if subtitle %>
          <p class="mt-2 line-clamp-2 text-sm text-pretty text-mute"><%= subtitle %></p>
        <% end %>
        <div class="flex-1"></div>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-line pt-4">
          <span class="inline-flex items-center gap-1.5 text-sm font-medium text-brand-strong">
            <%= t(".open") %><%= ui_icon "arrow-right", variant: :mini, size: :sm, class: "transition group-hover:translate-x-1" %>
          </span>
          <% if status %>
            <%= content_status_badge(status) %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</li>
<% end %>
