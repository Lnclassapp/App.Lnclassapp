<%# 🌐 UI · catalog/courses/_course_card — carte-vitrine d'un cours du catalogue (UDR-0001, CA-26) %>
<%# Rôle : toute la carte mène au cours ; matière, niveau et série (sauf élève), titre, sous-titre, pied « Ouvrir le cours → » ; statut pour l'équipe, sauf « Publié » ; élève : sans badge, bouton d'avancement %>
<%# ADR  : 0035, 0090 · UDR : 0001, 0005, 0013 (amendement du 2026-10-05 ter), 0057, 0085 (§3.3 : Commencer, Reprendre, Revoir) · aucune liste de fiches essentielles sur la carte %>
<%# locals: (course:, show_status:, student: false) -%>
<%# UDR-0013, amendement du 2026-10-05 : « Publié » est l'état normal, l'équipe ne voit que Brouillon ou Archivé. %>
<% status = (course.status if show_status && course.status != "published") %>
<%# UDR-0085 §3.3 : « Reprendre » rouvre la dernière fiche lue ; « Commencer » et « Revoir », la page du cours. Ouvrir une
    fiche la retient (ADR-0090) : pas de préchargement au survol, qui la servirait sans l'ouvrir. %>
<% resume = student && course.progress == :started %>
<% href = resume ? course_essential_path(course.slug, course.resume_essential_slug) : course_path(course.slug) %>
<% subtitle = if course.subtitle.present?
                # Une année scolaire (« 2026-2027 ») ne se coupe pas à son tiret.
                safe_join(course.subtitle.split(/(\d{4}-\d{4})/).map { it.match?(/\A\d{4}-\d{4}\z/) ? tag.span(it, class: "whitespace-nowrap") : it })
              end %>
<li id="course_<%= course.slug %>">
  <% if student %>
    <%= ui_card href:, padding: :sm, class: "group h-full", data: ({ turbo_prefetch: false } if resume) do %>
      <div class="flex h-full flex-col">
        <h3 class="font-display text-base leading-tight font-extrabold text-balance text-ink sm:text-lg"><%= course.name %></h3>
        <% if subtitle %>
          <p class="mt-1.5 line-clamp-2 text-sm text-pretty text-mute"><%= subtitle %></p>
        <% end %>
        <div class="flex-1"></div>
        <div class="mt-4 flex items-center justify-between gap-2 border-t border-line pt-3">
          <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-strong">
            <%# La coche est décorative : le libellé « Revoir le cours » suffit (UDR-0085 §3.7). %>
            <% if course.progress == :done %>
              <%= ui_icon "check-circle", variant: :solid, class: "text-success" %>
            <% end %>
            <%= t(".progress.#{course.progress}") %>
          </span>
          <%= ui_icon "arrow-right", variant: :mini, size: :sm, class: "text-brand-strong transition group-hover:translate-x-1" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <%= ui_card href:, class: "group h-full" do %>
      <div class="flex h-full flex-col">
        <div class="mb-4 flex flex-wrap items-start justify-between gap-2">
          <%= ui_subject_badge course.material_name, category: course.material_category %>
          <%= ui_badge [ course.level_name, course.series_name ].compact.join(" ") %>
        </div>
        <h2 class="font-display text-lg leading-tight font-extrabold text-balance text-ink"><%= course.name %></h2>
        <% if subtitle %>
          <p class="mt-2 line-clamp-2 text-sm text-pretty text-mute"><%= subtitle %></p>
        <% end %>
        <div class="flex-1"></div>
        <div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-line pt-4">
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-brand-strong">
            <%= t(".open") %><%= ui_icon "arrow-right", variant: :mini, size: :sm, class: "transition group-hover:translate-x-1" %>
          </span>
          <% if status %>
            <%= content_status_badge(status) %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</li>
