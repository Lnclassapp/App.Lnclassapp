<%# 🌐 UI · catalog/courses/material — la vue d'une matière de l'élève, style Wave : flèche retour, nom de la matière, recherche, leçons en grille de tuiles %>
<%# Rôle : écran intérieur (content_for :inner : ni barre ni menu) ; recherche en champ gris plein, cherchée pendant la frappe (frame « courses ») ; groupe « Progression DPFC 2026-2027 » en carte blanche, 4 colonnes ; plus de pastilles de matières ni de « Prochain exercice » %>
<%# ADR  : 0028, 0035, 0076, 0090 · UDR : 0173 §3 (matière), 0085 §3.1, 0013 (amendement du 2026-10-05), 0133 écrans élève sans répétition §3.6 (« Progression DPFC » une fois) · par pages de 24 %>
<% material = student_material %>
<% page_title(material.name) %>
<% content_for :inner, "1" %>
<div id="student_material" class="mx-auto w-full max-w-180 space-y-4 pb-6">
  <% unless list_frame_request? %>
  <%= render "shared/screens/inner_header", title: material.name, back_href: student_home_path %>
  <%# Un seul champ gris plein, pleine largeur ; « Filtrer » ne sert que sans JavaScript (le contrôleur search le cache). %>
  <%= form_with url: courses_path, method: :get, id: "courses-filters", html: { role: "search", "aria-label": t("catalog.courses.index.filters.label") },
                data: { turbo_frame: "courses", turbo_action: "advance", controller: "search" }, class: "flex items-center gap-3" do %>
    <%= hidden_field_tag :material, material.slug, id: nil %>
    <div class="relative min-w-0 flex-1">
      <%= label_tag :q, t("catalog.courses.material.search"), class: "sr-only" %>
      <%= ui_icon "magnifying-glass", class: "pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-mute" %>
      <%= search_field_tag :q, @filters[:q], id: "q", placeholder: t("catalog.courses.material.search"), autocomplete: "off",
                                             data: { action: "search#queue" },
                                             class: "block min-h-tap w-full rounded-ln border-0 bg-line py-3 pr-4 pl-12 text-base text-ink placeholder:text-mute focus:outline-2 focus:outline-brand" %>
    </div>
    <div data-search-target="button">
      <%= ui_button t("catalog.courses.index.filters.submit"), type: :submit, icon: "funnel" %>
    </div>
    <template data-search-target="error"><%= ui_error_state retry_href: "#" %></template>
  <% end %>
  <% end %>

  <%# target _top : une tuile ouvre la leçon, pas le frame. %>
  <%= turbo_frame_tag "courses", target: "_top", data: { turbo_action: "advance" }, class: "block transition-opacity aria-busy:opacity-50" do %>
    <% if @page.rows.any? %>
      <% progression = lesson_progression(@page.rows.first.subtitle) %>
      <section id="student_lessons" aria-labelledby="student_lessons_title">
        <h2 id="student_lessons_title" class="px-1 pb-2 text-sm font-semibold text-mute"><%= progression || t(".lessons") %></h2>
        <div class="overflow-hidden rounded-card bg-white">
          <%= render "catalog/courses/lesson_tiles", page: @page %>
        </div>
        <p id="courses_total" class="sr-only" aria-live="polite"><%= t("catalog.courses.index.total", count: @page.total_count) %></p>
      </section>
    <% else %>
      <div id="courses_empty">
        <% if @filters[:q].present? %>
          <%= ui_empty_state title: t("catalog.courses.index.no_match_title"), description: t("catalog.courses.index.student_no_match_description"), icon: "magnifying-glass" do %>
            <%= ui_button t("catalog.courses.index.clear_search"), href: courses_path(material: material.slug), variant: :secondary, icon: "x-mark" %>
          <% end %>
        <% else %>
          <%= ui_empty_state title: t("catalog.courses.index.empty_title"), description: t("catalog.courses.index.empty_description"), icon: "book-open" %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
