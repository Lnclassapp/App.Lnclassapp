<%# 🌐 UI · catalog/courses/_essential_row — une notion de la leçon dans une liste (carte de l'enseignant, carte de leçon de l'élève) %>
<%# Rôle : lien vers la leçon, ancré sur la notion dans « Prépare interros » (la notion n'a plus de page) ; enseignant : ligne de 44 px ; élève sur ordinateur (lesson) : ligne d'une carte de leçon, « À revoir » si une lacune est en attente %>
<%# ADR  : 0035, 0113 (§4) · UDR : 0007, 0013, 0057, 0139 (§3.7), XXXX écrans enseignant sans répétition §3.7, XXXX écrans élève sans répétition §3.6 bis %>
<%# locals: (essential:, course_slug:, show_status:, student: false, folded: false, teacher: false, lesson: false) -%>
<% href = course_path(course_slug, anchor: "notion-#{essential.slug}") %>
<% if teacher %>
  <%# Titre et chevron, la ligne entière est le lien (≥ 44 px) ; l'« Assigner » est sur la leçon (UDR enseignant §3.13). %>
  <li>
    <%= link_to href,
                class: "group flex min-h-tap items-center gap-3 rounded-ln px-2 transition hover:bg-mist active:bg-mist focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand" do %>
      <span class="line-clamp-2 min-w-0 flex-1 text-sm font-medium text-ink"><%= essential.name %></span>
      <%= ui_icon "chevron-right", variant: :mini, class: "shrink-0 text-mute transition group-hover:translate-x-0.5" %>
    <% end %>
  </li>
<% else %>
  <%# La ligne entière est le lien (≥ 44 px) ; l'étiquette dit « À revoir » (essential.review, propre à l'élève connecté). %>
  <%= tag.li id: "lesson_essential_#{essential.slug}", hidden: folded, data: { reveal_target: "item" } do %>
    <%= link_to href,
                class: "group flex min-h-tap items-center gap-3 px-5 py-2 transition hover:bg-mist active:bg-mist focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand" do %>
      <span class="min-w-0 flex-1 text-sm text-pretty text-ink"><%= essential.name %></span>
      <% if essential.review %><%= ui_badge t(".review"), tone: :brand, size: :sm %><% end %>
      <%= ui_icon "chevron-right", variant: :mini, class: "text-mute transition group-hover:translate-x-0.5" %>
    <% end %>
  <% end %>
<% end %>
