<%# 🌐 UI · catalog/courses/_exercise_row — un exercice de « Prépare interros », en carte %>
<%# Rôle : la carte d'exercice commune (titre, type, questions, état de l'élève ou statut de l'équipe, verbe) ; enseignant : une bascule d'assignation par classe sous la carte %>
<%# ADR  : 0113 · UDR : 0145 (§3.1, §3.2), 0139 §3.4, 0134 (§3.13) · locals: (exercise:, targets:, classrooms:, material_slug:, team: false) %>
<% card = exercise_card_for_lesson(exercise, material_slug:, team: team.present?, student: current_actor&.student? || false) %>
<% extra = capture do %>
  <% if exercise.status == "published" && classrooms.any? %>
    <ul class="divide-y divide-line rounded-ln border border-line">
      <% classrooms.each do |target| %>
        <% assignment = targets.states[[ target.public_id, exercise.public_id ]] %>
        <% first_assign = assignment.nil? && !@primary_assign_taken %>
        <% @primary_assign_taken ||= first_assign %>
        <li>
          <%= render "classroom/assignments/toggle", classroom_public_id: target.public_id, assignable_type: "Exercise",
                     assignable_key: exercise.public_id, assignable_name: exercise.title, classroom_name: target.name,
                     assignment_public_id: assignment&.assignment_public_id, due_on: assignment&.due_on,
                     needs_session_days: target.needs_session_days, compact: true, primary: first_assign %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
<%= render "assessment/exercises/card", card:, extra: %>
