<%# 🌐 UI · catalog/prepare_sheets/show — le sujet d'une feuille de la leçon, à lire avant de commencer %>
<%# Rôle : retour à la case de la leçon, la feuille en lecture (champs désactivés), puis « Commencer » / « Continuer » ; l'enseignant garde ses bascules d'envoi et le bandeau, sans bouton %>
<%# ADR  : 0121 · UDR : feuilles-en-cases-lues-avant-de-commencer §3 · Stimulus : math %>
<% course = @detail.course %>
<% targets = @prepare.targets %>
<% classrooms = targets ? targets.classrooms : [] %>
<% fillable = %i[student visitor].include?(sheet_mode) %>
<% kind = @sheet.kind == :subject ? :devoirs : :interros %>
<% number = t("catalog.courses.sheets.numbered_title.#{kind}", number: @sheet.number) %>
<% page_title t("catalog.courses.sheets.page_title", title: number, course: course.name) %>
<% content_for :nav_key, "courses" %>
<% content_for :head do %><%= stylesheet_link_tag "prepare_sheet" %><% end %>
<% @primary_assign_taken = false %>
<div data-turbo-prefetch="false"><%= ui_back_link course.name, href: course_path(course.slug, anchor: @sheet.dom_id) %></div>
<div class="ps-page">
  <%= render "catalog/prepare_sheets/sheet", prepare: @prepare, sheet: @sheet, mode: (fillable ? :reading : sheet_mode), targets:, classrooms:, heading: :h1 %>
  <% if fillable %>
    <% started = @sheet.exercises.any?(&:copy) %>
    <%= link_to t("catalog.courses.sheets.#{started ? :resume : :start}.#{kind}"), fill_course_sheet_path(course.slug, @sheet.dom_id), class: "ps-start" %>
  <% end %>
</div>
