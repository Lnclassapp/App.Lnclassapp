<%# 🌐 UI · catalog/course_sheets/_page — une page de la fiche : en-tête facultatif, sections numérotées de bout en bout, pied « n / total » %>
<%# Rôle : `page` (Hash du document), `number`, `total`, `section_offset` (sections des pages d'avant) ; la 1re page porte « Lexique » et « Explications simples » ; `cut` : ce qui suit la coupe est la cible `rest` ; `embedded` : titres sous le h2 de la page de la leçon %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees, 0113 · UDR : 0137-fiche-de-cours-a-l-identique-des-maquettes, 0139 §3.2 %>
<% header = page["header"] %>
<% cut = local_assigns[:cut] %>
<% embedded = local_assigns.fetch(:embedded, false) %>
<%# La coupe ne marque que le plus haut niveau entièrement après elle : la page, sinon la section, sinon le bloc. %>
<% rest_data = { catalog__revision_more_target: "rest" } %>
<% page_rest = cut&.rest?(number - 1) %>
<%= tag.div class: "sheet-page", data: { screen_label: t("catalog.course_sheets.page_label", number:), **(page_rest ? rest_data : {}) } do %>
  <div class="sheet-page-body">
    <% if header || number == 1 %>
      <header class="sheet-header">
        <% if header %>
          <div class="sheet-eyebrow">
            <span><%= header["eyebrow_left"] %></span><span><%= header["eyebrow_right"] %></span>
          </div>
          <%= content_tag embedded ? "h3" : "h1", header["title"], class: "sheet-h1" %>
          <div class="sheet-rule"></div>
          <div class="sheet-rule-thin"></div>
          <p class="sheet-intro"><%= sheet_text(header["intro"], glossary: @sheet.glossary) %></p>
        <% end %>
        <% if number == 1 %>
          <div class="sheet-toolbar">
            <%# La phrase entière ouvre l'aide : le libellé est une valeur de locale d'un seul tenant. %>
            <span class="sheet-text">
              <button type="button" class="sheet-word" data-action="course-sheet--glossary#open"
                      data-course-sheet--glossary-key-param="-help"><%= t("catalog.course_sheets.glossary.hint") %></button>
            </span>
            <div class="sheet-toolbar-actions">
              <button type="button" class="sheet-toggle" aria-pressed="true" data-action="course-sheet--simple-toggle#toggle"
                      data-course-sheet--simple-toggle-target="button"><%= t("catalog.course_sheets.simple.label_on") %></button>
              <button type="button" class="sheet-toggle" data-action="course-sheet--glossary#open"
                      data-course-sheet--glossary-key-param="-list"><%= t("catalog.course_sheets.glossary.button") %></button>
            </div>
          </div>
        <% end %>
      </header>
    <% end %>

    <% page.fetch("sections", []).each_with_index do |section, index| %>
      <% section_rest = !page_rest && cut&.rest?(number - 1, index) %>
      <%= tag.section class: "sheet-section", data: (section_rest ? rest_data : {}) do %>
        <%= content_tag embedded ? "h3" : "h2", class: "sheet-h2" do %><span class="sheet-h2-number"><%= section_offset + index + 1 %>.</span> <%= sheet_text(section["title"], glossary: @sheet.glossary) %><% end %>
        <% section.fetch("blocks", []).each_with_index do |block, block_index| %>
          <%= render "catalog/course_sheets/block", block:, rest: !page_rest && !section_rest && cut&.rest?(number - 1, index, block_index) %>
        <% end %>
      <% end %>
    <% end %>

    <footer class="sheet-page-footer"><%= t("catalog.course_sheets.page_counter", number:, total:) %></footer>
  </div>
<% end %>
