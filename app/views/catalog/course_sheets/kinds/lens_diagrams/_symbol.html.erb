<%# 🌐 UI · catalog/course_sheets/kinds/lens_diagrams/_symbol — le symbole d'une lentille : un trait et deux pointes, vers l'extérieur (convergente) ou l'intérieur (divergente) %>
<%# Rôle : locals x (abscisse), top, bottom (ordonnées des deux extrémités), kind (:convergent par défaut) ; partagé par les figures fixes, le simulateur et l'entraînement %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees (chantier contenu-en-blocs, 318) · formes de la maquette Fiche Lentilles.dc.html %>
<% inward = local_assigns[:kind] == :divergent %>
<% tip = inward ? [ top + 10, bottom - 10 ] : [ top, bottom ] %>
<% base = inward ? [ top, bottom ] : [ top + 10, bottom - 10 ] %>
<g class="sheet-lens-symbol">
  <line x1="<%= x %>" y1="<%= top %>" x2="<%= x %>" y2="<%= bottom %>"></line>
  <polyline points="<%= x - 7 %>,<%= base[0] %> <%= x %>,<%= tip[0] %> <%= x + 7 %>,<%= base[0] %>"></polyline>
  <polyline points="<%= x - 7 %>,<%= base[1] %> <%= x %>,<%= tip[1] %> <%= x + 7 %>,<%= base[1] %>"></polyline>
</g>
