<%# 🌐 UI · catalog/course_sheets/kinds/lens_diagrams/_ametropia — les défauts de l'œil : myopie, hypermétropie, presbytie, chacun avec son dessin et sa correction %>
<%# Rôle : trois cartes (titre du lexique, dessin des rayons, texte, lentille correctrice) ; trois colonnes, une seule sous 520 px %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees (chantier contenu-en-blocs, 318) · formes de la maquette Fiche Lentilles.dc.html (§ 5) ; l'écran (la rétine) est en x = 160 %>
<% cards = [ [ "myopia", "divergent", [ { points: "0,20 40,20 160,57.5" }, { points: "0,70 40,70 160,32.5" } ], [] ],
             [ "hyperopia", "convergent", [ { points: "0,20 40,20 160,38.75" }, { points: "0,70 40,70 160,51.25" } ],
               [ "160,38.75 198,45", "160,51.25 198,45" ] ],
             [ "presbyopia", "convergent", [ { points: "4,45 40,20 160,38.75" }, { points: "4,45 40,70 160,51.25" } ],
               [ "160,38.75 198,45", "160,51.25 198,45" ] ] ] %>
<%= tag.figure class: "sheet-figure sheet-lens-diagram", data: { diagram: "ametropia" }, role: "group", "aria-label": t(".myopia_label") + ". " + t(".hyperopia_label") + ". " + t(".presbyopia_label") do %>
  <div class="sheet-lens-cards" data-columns="3">
    <% cards.each do |name, fix, rays, prolongations| %>
      <div class="sheet-lens-card" data-card="<%= name %>">
        <div class="sheet-lens-card-title"><%= sheet_text(t(".#{name}_title"), glossary: @sheet.glossary) %></div>
        <svg viewBox="0 0 200 90" aria-hidden="true" focusable="false">
          <line class="sheet-lens-axis" x1="0" y1="45" x2="200" y2="45"></line>
          <% rays.each do |ray| %>
            <polyline class="sheet-lens-ray" data-ray="1" data-virtual="false" points="<%= ray[:points] %>"></polyline>
          <% end %>
          <% prolongations.each do |points| %>
            <polyline class="sheet-lens-ray" data-ray="1" data-virtual="true" points="<%= points %>"></polyline>
          <% end %>
          <line class="sheet-lens-symbol-line" x1="40" y1="10" x2="40" y2="80"></line>
          <rect class="sheet-lens-screen" x="160" y="8" width="5" height="74"></rect>
          <% if name == "myopia" %>
            <circle class="sheet-lens-focus" data-tone="accent" cx="120" cy="45" r="3.5"></circle>
          <% elsif name == "hyperopia" %>
            <circle class="sheet-lens-focus" data-tone="accent" cx="196" cy="45" r="3.5"></circle>
          <% else %>
            <circle class="sheet-lens-focus" data-tone="primary" cx="4" cy="45" r="3.5"></circle>
          <% end %>
        </svg>
        <span class="sheet-lens-card-text">
          <%= sheet_text(t(".#{name}_text"), glossary: @sheet.glossary) %>
          <%= t(".fix_html", lens: fix, word: t(".word_#{fix}")) %>
        </span>
      </div>
    <% end %>
  </div>
  <% if block["caption"].present? %><figcaption class="sheet-muted"><%= block["caption"] %></figcaption><% end %>
<% end %>
