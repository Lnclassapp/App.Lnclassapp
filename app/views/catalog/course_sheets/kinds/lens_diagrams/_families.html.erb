<%# 🌐 UI · catalog/course_sheets/kinds/lens_diagrams/_families — les deux familles de lentilles : convergente et divergente, de profil et en symbole %>
<%# Rôle : deux cartes (titre cliquable du lexique, dessin, trois points) ; les textes sont dans le fichier de langue du kind %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees (chantier contenu-en-blocs, 318) · formes de la maquette Fiche Lentilles.dc.html (§ 1) %>
<% glass = { convergent: "M45,10 Q75,50 45,90 Q15,50 45,10", divergent: "M30,10 L60,10 Q47,50 60,90 L30,90 Q43,50 30,10" } %>
<%= tag.figure class: "sheet-figure sheet-lens-diagram", data: { diagram: "families" }, role: "group", "aria-label": t(".label") do %>
  <div class="sheet-lens-cards" data-columns="2">
    <% glass.each do |kind, path| %>
      <%= tag.div class: "sheet-lens-card", data: { lens: kind } do %>
        <div class="sheet-lens-card-title"><%= sheet_text(t(".#{kind}_title"), glossary: @sheet.glossary) %></div>
        <svg viewBox="0 0 170 112" aria-hidden="true" focusable="false">
          <path class="sheet-lens-glass" d="<%= path %>"></path>
          <%= render "catalog/course_sheets/kinds/lens_diagrams/symbol", x: 125, top: 10, bottom: 90, kind: kind %>
          <text class="sheet-lens-caption" x="45" y="107" text-anchor="middle"><%= t(".profile") %></text>
          <text class="sheet-lens-caption" x="125" y="107" text-anchor="middle"><%= t(".symbol") %></text>
        </svg>
        <ul class="sheet-lens-points">
          <% t(".#{kind}_points").each do |point| %>
            <li><%= sheet_text(point, glossary: @sheet.glossary) %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
  </div>
  <% if block["caption"].present? %><figcaption class="sheet-muted"><%= block["caption"] %></figcaption><% end %>
<% end %>
