<%# 🌐 UI · catalog/course_sheets/kinds/lens_diagrams/_focal — quatre rayons parallèles à l'axe qui traversent une lentille convergente, sur un quadrillage : on lit la distance focale (exercice 5) %>
<%# Rôle : un dessin à l'échelle (1 carreau = 1 cm = 20 unités) ; le foyer n'est pas marqué : c'est la question %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees (chantier contenu-en-blocs, 318) · formes de la maquette Fiche Lentilles.dc.html (§ 7) %>
<% rays = [ "0,40 60,40 220,160", "0,80 60,80 220,120", "0,120 60,120 220,80", "0,160 60,160 220,40" ] %>
<%= tag.figure class: "sheet-figure sheet-lens-diagram", data: { diagram: "focal" }, role: "group", "aria-label": t(".label") do %>
  <svg class="sheet-lens-focal" viewBox="0 0 240 200" aria-hidden="true" focusable="false">
    <path class="sheet-lens-grid-line" d="<%= (0..240).step(20).map { "M#{it},0V200" }.join %><%= (0..200).step(20).map { "M0,#{it}H240" }.join %>"></path>
    <line class="sheet-lens-axis" x1="0" y1="100" x2="240" y2="100"></line>
    <% rays.each do |points| %>
      <polyline class="sheet-lens-ray" data-ray="1" data-virtual="false" points="<%= points %>"></polyline>
    <% end %>
    <%= render "catalog/course_sheets/kinds/lens_diagrams/symbol", x: 60, top: 20, bottom: 180 %>
    <text class="sheet-lens-name" data-tone="ink" x="64" y="116">O</text>
    <text class="sheet-lens-caption" x="236" y="196" text-anchor="end"><%= t(".scale") %></text>
  </svg>
  <% if block["caption"].present? %><figcaption class="sheet-muted"><%= block["caption"] %></figcaption><% end %>
<% end %>
