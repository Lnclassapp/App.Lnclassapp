<%# 🌐 UI · catalog/course_sheets/kinds/_argument_highlighter — le texte à analyser : cinq surligneurs, un passage coloré s'explique au clic %>
<%# Rôle : `block` {kind: argument_highlighter, caption?, params: text_1…text_12} ; chaque `text_n` écrit ses passages en {T}…{/T} (T thèse, R thèse adverse, A argument, E exemple, C connecteur), le reste est du texte brut ; surlignage et explication : lib/course_sheet/argument_highlighter (sans lui, le texte se lit non surligné) %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees, 0114 (budget du JS commun) · UDR : 0137-fiche-de-cours-a-l-identique-des-maquettes · aucun HTML dans les données : tout est échappé, pas d'attribut style %>
<%
  i18n = "catalog.course_sheets.kinds.argument_highlighter"
  kinds = { "T" => "thesis", "R" => "counter", "A" => "argument", "E" => "example", "C" => "connector" }
  params = block["params"].is_a?(Hash) ? block["params"] : {}
  pattern = %r{\{([TRAEC])\}(.*?)\{/\1\}}m
  # Les morceaux de texte, dans l'ordre de leur numéro ; une valeur qui n'est pas une chaîne ne compte pas.
  pieces = params.select { |key, value| key.to_s.match?(/\Atext_\d{1,2}\z/) && value.is_a?(String) }
                 .sort_by { |key, _| key.delete_prefix("text_").to_i }.map(&:last)
  segments = pieces.each_with_index.flat_map do |piece, index|
    tokens = index.zero? ? [] : [ [ nil, " " ] ]
    rest = piece
    while (match = pattern.match(rest))
      tokens << [ nil, match.pre_match ] unless match.pre_match.empty?
      tokens << [ kinds.fetch(match[1]), match[2] ]
      rest = match.post_match
    end
    tokens << [ nil, rest ] unless rest.empty?
    tokens
  end
  present = kinds.values.select { |name| segments.any? { |kind, _| kind == name } }
%>
<% if present.empty? %>
  <p class="sheet-muted"><%= t("#{i18n}.empty") %></p>
<% else %>
  <div class="sheet-hl" role="group" aria-label="<%= t("#{i18n}.label") %>" data-controller="course-sheet--argument-highlighter">
    <div class="sheet-hl-buttons" role="group" aria-label="<%= t("#{i18n}.group_label") %>">
      <% present.each do |name| %>
        <%= tag.button t("#{i18n}.categories.#{name}.name"), type: "button", class: "sheet-hl-btn", "aria-pressed": "false",
                                                              data: { kind: name, why: t("#{i18n}.categories.#{name}.why") } %>
      <% end %>
      <%= tag.button t("#{i18n}.all_on"), type: "button", class: "sheet-hl-all", "aria-pressed": "false",
                                          data: { label_on: t("#{i18n}.all_on"), label_off: t("#{i18n}.all_off") } %>
    </div>
    <p class="sheet-hl-text"><%= safe_join(segments.map { |kind, text| kind ? tag.span(text, class: "sheet-hl-seg", data: { kind: }) : text }) %></p>
    <div class="sheet-hl-info" role="status" aria-live="polite"><b data-role="title"></b> <span data-role="text"><%= t("#{i18n}.idle") %></span></div>
    <% if block["caption"].present? %><p class="sheet-hl-credit"><%= sheet_text(block["caption"], glossary: @sheet&.glossary || {}) %></p><% end %>
  </div>
<% end %>
