<%# 🌐 UI · catalog/course_sheets/show — la fiche de cours d'une leçon sur sa propre page : 3 pages de cahier, lexique en bulle, explications simples (CA-4 à CA-6) %>
<%# Rôle : titre de la page, feuille de style à part (course_sheet.css) puis l'écran de la fiche (_sheet) ; la page de la leçon le rend aussi, coupé (UDR-0139) %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees · UDR : 0137-fiche-de-cours-a-l-identique-des-maquettes, 0139 §3.2 %>
<% course = @sheet.course %>
<% page_title "#{t(".title")} · #{course.name}" %>
<% content_for :nav_key, "courses" %>
<% content_for :head do %><%= stylesheet_link_tag "course_sheet" %><% end %>
<%= ui_back_link course.name, href: course_path(course.slug) %>

<%= render "catalog/course_sheets/sheet", sheet: @sheet %>
