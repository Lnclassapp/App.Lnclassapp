<%# 🌐 UI · catalog/course_sheets/_block — aiguillage gelé d'un bloc de la fiche de cours vers son partial (Lot 0) %>
<%# Rôle : `block` (Hash du document validé) → blocks/_<type>, ou kinds/_<kind> pour figure et media ; hors liste fermée, rien n'est rendu ; `rest` : le bloc suit la coupe de la fiche de révision %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees, 0113 · UDR : 0137-fiche-de-cours-a-l-identique-des-maquettes, 0139 §3.2 %>
<% sheet = Entities::Catalog::SheetDocument %>
<% type = block["type"] %>
<% kind = block["kind"] %>
<% partial = if %w[figure media].include?(type) && (type == "figure" ? sheet::FIGURE_KINDS : sheet::MEDIA_KINDS).include?(kind)
                "catalog/course_sheets/kinds/#{kind}"
              elsif (sheet::BLOCK_TYPES - %w[figure media]).include?(type)
                "catalog/course_sheets/blocks/#{type}"
              end %>
<%# Un kind de la liste fermée dont le lot n'est pas encore livré : le message, pas une erreur %>
<% rendered = if partial && lookup_context.exists?(partial, [], true)
                render partial, block: block
              else
                tag.p(t(".unavailable"), class: "sheet-muted")
              end %>
<%# Le serveur ne pose jamais `hidden` : c'est le contrôleur de la page qui masque la suite (sans JavaScript, tout se lit). %>
<% if local_assigns[:rest] %>
  <%= tag.div rendered, data: { catalog__revision_more_target: "rest" } %>
<% else %>
  <%= rendered %>
<% end %>
