<%# 🌐 UI · catalog/course_sheets/blocks/_simple — une « explication simple » (reformulation), masquée par la bascule violette %>
<%# Rôle : `block` {text} ; masquée par `[data-simple="false"]` de l'écran, visible sans JavaScript %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees · UDR : 0137-fiche-de-cours-a-l-identique-des-maquettes %>
<div class="sheet-simple">
  <span class="sheet-simple-label"><%= t("catalog.course_sheets.simple.heading") %></span>
  <span><%= sheet_text(block["text"], glossary: @sheet.glossary) %></span>
</div>
