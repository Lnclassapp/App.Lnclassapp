<%# 🌐 UI · catalog/course_sheets/blocks/_box — un encadré à étiquette : propriété (accent), à retenir (vert), méthode (violet) %>
<%# Rôle : `block` {label, tone?, paragraphs[]} ; le ton par défaut est « property » %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees · UDR : 0137-fiche-de-cours-a-l-identique-des-maquettes %>
<%= tag.div class: "sheet-box", data: { tone: block["tone"].presence || "property" } do %>
  <span class="sheet-box-label"><%= block["label"] %></span>
  <% block.fetch("paragraphs", []).each do |paragraph| %>
    <p class="sheet-text"><%= sheet_text(paragraph, glossary: @sheet.glossary) %></p>
  <% end %>
<% end %>
