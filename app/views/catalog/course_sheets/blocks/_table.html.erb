<%# 🌐 UI · catalog/course_sheets/blocks/_table — un tableau de la fiche : légende facultative, en-têtes, lignes %>
<%# Rôle : `block` {caption?, headers[], rows[][]} ; le Lot G le passe en cartes sous 1 000 px %>
<%# ADR  : XXXX-fiche-de-cours-en-donnees-importees · UDR : XXXX-fiche-de-cours-a-l-identique-des-maquettes %>
<table class="sheet-table">
  <% if block["caption"].present? %><caption class="sheet-caption"><%= block["caption"] %></caption><% end %>
  <thead>
    <tr>
      <% block.fetch("headers", []).each do |header| %><th scope="col"><%= header %></th><% end %>
    </tr>
  </thead>
  <tbody>
    <% block.fetch("rows", []).each do |row| %>
      <tr>
        <% row.each do |cell| %><td><%= sheet_text(cell, glossary: @sheet.glossary) %></td><% end %>
      </tr>
    <% end %>
  </tbody>
</table>
