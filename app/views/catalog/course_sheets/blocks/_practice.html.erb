<%# 🌐 UI · catalog/course_sheets/blocks/_practice — « Je m'entraîne » : un énoncé tiré d'une banque (ou du générateur du kind), Vérifier, solution, score %>
<%# Rôle : `block` (practice{kind, title, bank[]?}) rendu comme la maquette ; course_sheet/practice_controller tire l'énoncé, juge et compte une fois par énoncé %>
<%# ADR  : 0110-fiche-de-cours-en-donnees-importees · UDR : 0137-fiche-de-cours-a-l-identique-des-maquettes %>
<% ctrl = "course-sheet--practice" %>
<% uid = "sheet-pr-#{block.object_id}" %>
<% i18n = "catalog.course_sheets.practice" %>
<% exercise_i18n = "catalog.course_sheets.exercise" %>
<section class="sheet-practice" data-controller="<%= ctrl %>" data-<%= ctrl %>-kind-value="<%= block["kind"] %>"
         <% if block["bank"] %>data-<%= ctrl %>-bank-value="<%= block["bank"].to_json %>"<% end %>
         data-<%= ctrl %>-tolerance-value="<%= Entities::Catalog::NumericAnswer::TOLERANCE %>"
         data-<%= ctrl %>-score-template-value="<%= t("#{i18n}.score", ok: "{ok}", total: "{total}") %>"
         data-<%= ctrl %>-incomplete-value="<%= t("#{exercise_i18n}.incomplete") %>" data-<%= ctrl %>-correct-value="<%= t("#{exercise_i18n}.correct") %>"
         data-<%= ctrl %>-wrong-value="<%= t("#{exercise_i18n}.wrong") %>">
  <span class="sheet-practice-badge"><%= block["title"] %></span>
  <div class="sheet-practice-head">
    <b class="sheet-score" role="status" aria-live="polite" data-<%= ctrl %>-target="score"><%= t("#{i18n}.score", ok: 0, total: 0) %></b>
  </div>
  <p class="sheet-practice-prompt" id="<%= uid %>-prompt" data-<%= ctrl %>-target="prompt"></p>
  <div class="sheet-fields">
    <label class="sheet-field">
      <span data-<%= ctrl %>-target="ask"></span>
      <input type="text" class="sheet-input sheet-input-wide" inputmode="decimal" autocomplete="off" aria-labelledby="<%= uid %>-prompt"
             data-<%= ctrl %>-target="input" data-action="input-><%= ctrl %>#edit keydown.enter-><%= ctrl %>#check">
      <span data-<%= ctrl %>-target="unit"></span>
    </label>
    <button type="button" class="sheet-btn" data-variant="primary" data-action="click-><%= ctrl %>#check"><%= t("#{i18n}.check") %></button>
    <button type="button" class="sheet-btn" aria-expanded="false" aria-controls="<%= uid %>-solution" data-<%= ctrl %>-target="solutionButton" data-action="click-><%= ctrl %>#toggleSolution"><%= t("#{i18n}.solution") %></button>
    <button type="button" class="sheet-btn" data-action="click-><%= ctrl %>#next"><%= t("#{i18n}.next") %></button>
  </div>
  <div class="sheet-message" role="status" aria-live="polite" data-<%= ctrl %>-target="result"></div>
  <div class="sheet-correction" id="<%= uid %>-solution" hidden data-<%= ctrl %>-target="solution"></div>
</section>
