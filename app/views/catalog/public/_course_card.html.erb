<%# 🌐 UI · catalog/public/_course_card — carte d'un cours publié sur une page publique : son nom et sa description, rien d'autre %>
<%# Rôle : aucun lien, aucun bouton, aucun statut : la vitrine ne mène à aucun contenu (ADR-0099 §4.1) %>
<%# UDR  : 0113 (§3.1) %>
<%# locals: (card:) -%>
<li>
  <article class="h-full rounded-card border border-line bg-white p-4 shadow-card">
    <h3 class="font-display text-base font-bold text-balance text-ink"><%= card.name %></h3>
    <% if card.subtitle.present? %>
      <p class="mt-1 line-clamp-2 text-sm text-mute"><%= card.subtitle %></p>
    <% end %>
  </article>
</li>
