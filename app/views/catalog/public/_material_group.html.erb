<%# 🌐 UI · catalog/public/_material_group — une matière d'un niveau (ou d'un niveau et d'une série) : titre, 6 cartes, « Voir les N cours » %>
<%# Rôle : locals group: (PublicCourses::Group), href: (la page matière filtrée) ; le titre entier mène à href, le lien « Voir les N cours » aussi au-delà de 6 %>
<%# UDR  : 0113 (§3.1, §3.3, §3.8), 0115 (§3.2) %>
<%# locals: (group:, href:) -%>
<% material = group.material %>
<% illustration = subject_illustration(material.slug) %>
<section id="group_<%= material.slug %>" aria-labelledby="group_<%= material.slug %>_title">
  <h2 id="group_<%= material.slug %>_title">
    <%= link_to href, "aria-label": t(".label", material: material.name, courses: t("catalog.public.courses_count", count: group.count)),
          class: "group flex min-h-tap items-center gap-3 rounded-ln text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" do %>
      <span class="<%= class_names("grid size-10 shrink-0 place-items-center rounded-full", illustration.tint) %>">
        <%= image_tag illustration.path, alt: "", class: "size-7", "aria-hidden": true, loading: "lazy" %>
      </span>
      <span class="min-w-0 truncate font-display text-xl leading-tight font-medium"><%= material.name %></span>
      <%= ui_badge t("catalog.public.courses_count", count: group.count), tone: :brand, size: :sm %>
      <%= ui_icon "chevron-right", variant: :mini, size: :sm, class: "ml-auto text-mute transition group-hover:translate-x-0.5" %>
    <% end %>
  </h2>
  <ul class="mt-3 grid grid-cols-1 gap-3 min-[700px]:grid-cols-2 lg:grid-cols-3">
    <%= render partial: "catalog/public/course_card", collection: group.cards, as: :card %>
  </ul>
  <% if group.count > Queries::Catalog::PublicCourses::PER_GROUP %>
    <%= link_to t("catalog.public.see_all", count: group.count), href, id: "group_#{material.slug}_more",
          class: "mt-2 inline-flex min-h-tap items-center gap-1 text-sm font-medium text-brand-strong hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
  <% end %>
</section>
