<%# 🌐 UI · catalog/essentials/_exercise_progress — un exercice de la fiche, selon le rôle %>
<%# Rôle : élève → lien étiré, « Type · Assigné par ton enseignant », « Commencer », « Refaire » ou « Reprendre » ; autres → « Type · N questions », statut (équipe), une ligne par classe (enseignant) : le premier « Assigner » de la page est plein, « Modifier les jours de la … » une fois par classe %>
<%# ADR  : 0028, 0033, 0054, 0072 · UDR : 0007, 0015, 0057, 0062 (§3.4), 0069 (§3.8), 0077 (§3.3), 0134 (§3.13 ; stacked : colonne « Exercices » de 380 px ≥ lg, tout s'empile) · tout exercice publié se démarre, assigné ou non %>
<%# locals: (exercise:, student:, team:, targets: nil, primary: false, folded: false, stacked: false) -%>
<% if student %>
  <%# UDR-0015, amendement du 2026-10-02 : badge, score et maîtrise sont sur la page de l'exercice, à un tap. Amendement du
      2026-10-06 : sous 640 px, le bouton passe sous le titre, qui tient sur 2 lignes au lieu d'être tronqué. %>
  <%= tag.li id: "essential_exercise_#{exercise.public_id}",
             class: "relative flex flex-col items-start gap-3 px-4 py-4 active:bg-mist sm:flex-row sm:items-center sm:px-6",
             hidden: folded, data: { reveal_target: "item" } do %>
    <div class="min-w-0 self-stretch sm:flex-1">
      <%= link_to exercise.title, exercise_path(exercise.public_id),
                  class: "line-clamp-2 font-medium text-ink after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-brand" %>
      <p class="mt-0.5 text-sm text-mute">
        <%= safe_join([ t(".exercise_types.#{exercise.exercise_type}"), (t(".assigned") if exercise.assigned_to_my_classroom) ].compact, " · ") %>
      </p>
    </div>
    <%# Au-dessus du lien étiré ; seule la première ligne de la liste est « primary » (R1). %>
    <div class="relative shrink-0">
      <% variant = primary ? :primary : :secondary %>
      <% if exercise.started_session_public_id %>
        <%= ui_button t(".resume"), href: exercise_session_path(exercise.started_session_public_id), variant:, size: :sm,
                      icon: "arrow-path", "aria-label": t(".resume_label", title: exercise.title) %>
      <% else %>
        <%# UDR-0015, amendement du 2026-10-06 : un exercice déjà terminé se « Refait ». %>
        <% action = exercise.best_score_percent ? "redo" : "start" %>
        <%= button_to exercise_sessions_path(exercise.public_id), form_class: "contents",
                      class: class_names(ComponentsHelper::BUTTON_BASE, ComponentsHelper::BUTTON_SIZES[:sm],
                                         ComponentsHelper::BUTTON_VARIANTS[variant]),
                      "aria-label": t(".#{action}_label", title: exercise.title) do %>
          <%= ui_icon action == "redo" ? "arrow-path" : "play", size: :sm %><%= t(".#{action}") %>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% else %>
  <li id="essential_exercise_<%= exercise.public_id %>"
      class="<%= class_names("flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:gap-4 sm:px-6",
                             "lg:flex-col lg:items-stretch lg:gap-3" => stacked) %>">
    <div class="min-w-0 flex-1 space-y-1.5">
      <%= link_to exercise.title, exercise_path(exercise.public_id),
                  class: "text-sm font-medium text-ink underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
      <% if exercise.description.present? %>
        <p class="line-clamp-2 text-sm text-mute"><%= exercise.description %></p>
      <% end %>
      <%# UDR-0077 §3.3 : type et nombre de questions en une ligne de texte ; le statut de l'équipe reste un badge. %>
      <div class="flex flex-wrap items-center gap-2">
        <p class="text-meta text-mute"><%= t(".exercise_types.#{exercise.exercise_type}") %> · <%= t(".questions", count: exercise.questions_count) %></p>
        <% if team %>
          <%= content_status_badge(exercise.status) %>
        <% end %>
      </div>
    </div>
    <% if targets&.classrooms&.any? && exercise.status == "published" %>
      <%# UDR-0077 §3.3, enseignant §3.13 : une ligne par classe (nom, échéance dessous, « Assigné » et ✕), sous le titre sur
          téléphone. Le premier « Assigner » de la page est plein (@primary_assign_taken : les lignes sont rendues dans l'ordre
          de la page) ; « Modifier les jours de la … » ne paraît qu'une fois par classe, sous sa première ligne assignée. %>
      <% @days_links_shown ||= [] %>
      <% days_links = [] %>
      <div class="<%= class_names("mt-3 sm:mt-0 sm:w-72 sm:shrink-0", "lg:mt-0 lg:w-auto" => stacked) %>">
        <ul class="divide-y divide-line rounded-ln border border-line" aria-label="<%= t(".assign_targets", title: exercise.title) %>">
          <% targets.classrooms.each do |target| %>
            <% state = targets.states[[ target.public_id, exercise.public_id ]] %>
            <% first_assign = state.nil? && !@primary_assign_taken %>
            <% @primary_assign_taken ||= first_assign %>
            <% if state && !target.needs_session_days && @days_links_shown.exclude?(target.public_id) %>
              <% @days_links_shown << target.public_id %>
              <% days_links << target %>
            <% end %>
            <li>
              <%= render "classroom/assignments/toggle", classroom_public_id: target.public_id, assignable_type: "Exercise",
                         assignable_key: exercise.public_id, assignable_name: exercise.title, classroom_name: target.name,
                         assignment_public_id: state&.assignment_public_id, due_on: state&.due_on,
                         needs_session_days: target.needs_session_days, compact: true, primary: first_assign %>
            </li>
          <% end %>
        </ul>
        <% days_links.each do |target| %>
          <%= link_to t("classroom.session_days.edit_link", classroom: target.name), edit_classroom_session_days_path(target.public_id),
                      data: { turbo_frame: "modal" },
                      class: "flex min-h-tap items-center text-meta font-medium text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
        <% end %>
      </div>
    <% end %>
    <%# Sur téléphone, le titre est déjà un lien : « Ouvrir » ne se montre qu'à partir de 640 px (UDR-0077 §3.3). %>
    <div class="<%= class_names("hidden shrink-0 sm:block sm:self-center", "lg:hidden" => stacked) %>">
      <%= ui_button t(".open"), href: exercise_path(exercise.public_id), variant: :secondary, size: :sm, icon_end: "arrow-right",
                    class: "hidden sm:inline-flex", "aria-label": t(".open_label", title: exercise.title) %>
    </div>
  </li>
<% end %>
