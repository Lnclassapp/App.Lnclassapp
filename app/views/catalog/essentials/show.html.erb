<%# 🌐 UI · catalog/essentials/show — page d'une fiche essentielle (CA-11, AS-37), pour l'élève, l'enseignant et l'équipe %>
<%# Rôle : en-tête et contenu (Action Text, KaTeX) ; équipe : statut, menu ⋮ ; lacune de l'élève et son exercice ; exercices (élève : 3 puis « Voir plus » ; enseignant : bascules) %>
<%# ADR  : 0028, 0033, 0035, 0043, 0072 · UDR : 0006, 0007, 0015, 0042, 0054, 0057, 0062, 0069 · rafraîchie par les streams et le morphing %>
<% essential = @detail.essential %>
<% course = @detail.course %>
<% exercises = @detail.exercises %>
<% page_title t(".page_title", name: essential.name) %>
<% content_for :nav_key, "courses" %>
<div id="essential_header" class="mb-8">
  <%= ui_back_link course.name, href: course_path(course.slug) %>
  <%= ui_card padding: :md do %>
    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0 space-y-3">
        <%# Élève (UDR-0015, amendement du 2026-10-02, R6) : le retour nomme déjà le cours. %>
        <p class="text-sm text-mute"><%= @student ? t(".student_eyebrow") : t(".eyebrow", course: course.name) %></p>
        <h1 class="font-display text-2xl font-extrabold tracking-tight text-balance sm:text-3xl"><%= essential.name %></h1>
        <% if essential.subtitle.present? %>
          <p id="essential_subtitle" class="text-mute"><%= essential.subtitle %></p>
        <% end %>
        <div class="flex flex-wrap items-center gap-2">
          <%= ui_subject_badge course.material_name, category: course.material_category %>
          <%= ui_badge [ course.level_name, course.series_name ].compact.join(" ") %>
        </div>
      </div>
      <% if @status_record %>
        <div id="essential_team_actions" role="group" aria-label="<%= t(".team_actions") %>"
             class="flex flex-wrap items-center gap-2 lg:max-w-md lg:shrink-0 lg:justify-end">
          <%= content_status_panel(record: @status_record) %>
          <%= ui_dropdown label: t(".actions", name: essential.name), id: "essential-actions-menu", fixed: true do %>
            <%= ui_dropdown_item t(".edit"), href: edit_teams_essential_path(essential.slug), icon: "pencil-square", frame: "modal" %>
            <%= ui_dropdown_item t(".new_exercise"), href: new_teams_essential_exercise_path(essential.slug), icon: "plus", frame: "modal" %>
            <%= ui_dropdown_item t(".import_exercises"), href: new_teams_import_path(kind: "exercises", essential: essential.slug),
                                 icon: "arrow-up-tray", frame: "modal" %>
            <%= content_transition_items(record: @status_record) %>
            <%= ui_dropdown_item t("catalog.content_status.actions.publish_all"), href: publish_all_teams_essential_path(essential.slug),
                                 method: :patch, icon: "check-badge" %>
          <% end %>
        </div>
      <% end %>
    </div>
    <div id="essential_content" class="mt-6 max-w-prose border-t border-line pt-6" data-controller="math">
      <% if essential.content.present? %>
        <%= essential.content %>
      <% else %>
        <p class="text-mute"><%= t(".no_content") %></p>
      <% end %>
    </div>
  <% end %>
</div>

<div class="space-y-8">
  <% if (gap = @detail.pending_gap) %>
    <section id="essential_gap" aria-labelledby="essential_gap_title"
             class="flex gap-4 rounded-card border border-warning/30 bg-warning-soft p-5 sm:p-6">
      <%= ui_icon "light-bulb", class: "text-warning" %>
      <div class="min-w-0 space-y-1">
        <%# UDR-0057 R4 : la règle pour lever la lacune passe dans l'infobulle du titre. %>
        <div class="flex items-center gap-1">
          <h2 id="essential_gap_title" class="font-display text-lg font-extrabold"><%= t(".gap_title") %></h2>
          <%= ui_info_tip t(".gap_body", threshold: Entities::Assessment::Grading::REMEDIATION_THRESHOLD), label: t(".gap_title") %>
        </div>
        <p class="text-sm text-mute"><%= t(".gap_since", date: l(gap.opened_at.to_date, format: :long)) %></p>
        <%# Chantier ux-pages-eleve : l'encart mène au premier exercice de la fiche, où la lacune se lève. %>
        <% if exercises.any? %>
          <div class="pt-2">
            <%= ui_button t(".gap_action"), href: exercise_path(exercises.first.public_id), variant: :secondary, size: :sm,
                                            icon_end: "arrow-right", id: "essential_gap_action" %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <%= ui_card title: t(".exercises_title"), icon: "academic-cap", id: "essential_exercises" do |card| %>
    <% card.actions do %>
      <%= ui_badge t(".exercises_count", count: exercises.size), tone: :brand, size: :sm %>
    <% end %>
    <% if exercises.empty? %>
      <% if @status_record %>
        <%= ui_empty_state title: t(".team_empty_title"), description: t(".team_empty_description"), icon: "academic-cap" %>
      <% else %>
        <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "academic-cap" %>
      <% end %>
    <% else %>
      <%# Élève (UDR-0015, amendement du 2026-10-02) : 3 lignes puis « Voir plus » (R3), un seul bouton « primary » (R1). %>
      <%= tag.div(class: "space-y-3", data: (ui_reveal_data if @student)) do %>
        <% if @targets && @targets.classrooms.empty? %>
          <p id="assign_targets_none" class="text-sm text-mute"><%= t(".assign_targets_none", level: @targets.scope_label) %></p>
        <% end %>
        <ul class="-mx-4 divide-y divide-line border-t border-line sm:-mx-6" data-controller="math">
          <% exercises.each_with_index do |exercise, index| %>
            <%= render "exercise_progress", exercise:, student: @student, team: @status_record.present?, targets: @targets,
                                            primary: @student && index.zero?,
                                            folded: @student && index >= ComponentsHelper::REVEAL_LIMIT %>
          <% end %>
        </ul>
        <%= ui_reveal_more exercises.size if @student %>
      <% end %>
    <% end %>
  <% end %>
</div>
