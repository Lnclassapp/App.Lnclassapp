<%# 🌐 UI · assessment/comprehension/_section — rapport d'un exercice assigné sous l'en-tête, enseignant et équipe %>
<%# Rôle : « 20 / 27 faits » et retard, cinq cases par badge en liens d'un Turbo Frame (?badge=), prochain geste, questions (« 1. énoncé · 18 / 20 justes ») ; à droite (≥ lg) les élèves, du meilleur score au plus faible, puis ceux qui ne l'ont pas fait %>
<%# ADR  : 0051, 0079, 0097 (§4.6) · UDR : 0072 (§3.5, §3.6), 0109, enseignant (§3.1, §3.8) · Stimulus : math · sans JavaScript, un lien de case recharge la page entière %>
<%# late : élèves qui n'ont pas fait l'exercice la date limite passée, nil avant la date ou sans date limite (pastille cachée), 0 aussi %>
<%# pending : les élèves qui n'ont pas fait l'exercice (PendingStudent), listés sans filtre seulement ; overdue : la date limite est passée %>
<%# locals: (comprehension:, classroom:, assignment_public_id:, late: nil, pending: [], overdue: false) -%>
<% pending = comprehension.selected.nil? ? pending : [] %>
<section id="comprehension" aria-label="<%= t(".title") %>" class="mb-8">
  <%= turbo_frame_tag "comprehension_frame", data: { turbo_action: "advance" }, class: "block transition-opacity aria-busy:opacity-50" do %>
    <div class="space-y-6 lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-8 lg:space-y-0">
      <div class="min-w-0 space-y-6">
        <div id="follow_up_progress" class="space-y-3">
          <div class="flex items-center gap-3">
            <div class="min-w-0 flex-1">
              <%= ui_progress done: comprehension.done, total: comprehension.present, role: :teacher,
                              label: t("assessment.comprehension.progress.label") %>
            </div>
            <span class="shrink-0 text-sm text-ink tabular-nums">
              <%= t("assessment.comprehension.progress.done", count: comprehension.done, total: comprehension.present) %>
            </span>
          </div>
          <% if late&.positive? %>
            <p><%= ui_badge t("assessment.comprehension.progress.late", count: late), tone: :warning, dot: true %></p>
          <% end %>
        </div>

        <% if comprehension.done.zero? %>
          <%= ui_empty_state title: t("assessment.comprehension.empty.title"), description: t("assessment.comprehension.empty.description"),
                             icon: "chart-pie" %>
        <% else %>
          <%= render "assessment/comprehension/badge_boxes", counts: comprehension.badge_counts, selected: comprehension.selected,
                                                             classroom:, assignment_public_id: %>

          <%# UDR-0109 §3.2 (AS-23) : le geste est choisi par le domaine (Entities::Assessment::NextStep) ; la vue le traduit. %>
          <% step, options = comprehension_next_step(comprehension) %>
          <% if step %>
            <div id="comprehension_next_step" class="rounded-card bg-brand-soft p-4">
              <p class="text-xs tracking-wide text-brand-strong uppercase"><%= t("assessment.comprehension.next_step.label") %></p>
              <p class="mt-1 text-sm text-ink"><%= t("assessment.comprehension.next_step.#{step}", **options) %></p>
            </div>
          <% end %>

          <% if comprehension.students.any? %>
            <section id="comprehension_questions" aria-labelledby="comprehension_questions_title">
              <h3 id="comprehension_questions_title" class="mb-3 font-display text-lg font-medium"><%= t(".questions_title") %></h3>
              <%# ADR-0051 : $…$ et $$…$$ des énoncés sont rendus par KaTeX ; le texte brut garde ses délimiteurs. %>
              <ol class="divide-y divide-line border-b border-line" data-controller="math">
                <% comprehension.questions.each do |question| %>
                  <li class="py-3">
                    <div class="flex items-baseline justify-between gap-3">
                      <div class="flex min-w-0 flex-1 items-baseline gap-1.5 text-sm text-ink">
                        <span class="shrink-0 tabular-nums"><%= t(".question_number", number: question.number) %></span>
                        <p class="min-w-0 line-clamp-2"><%= strip_tags(question.content) %></p>
                      </div>
                      <span class="shrink-0 text-sm text-mute tabular-nums">
                        <%= question.rate.nil? ? t(".no_attempt") : t(".correct_of", count: question.correct, answered: question.answered) %>
                      </span>
                    </div>
                    <%# Pas d'attribut style (UDR-0005) : la largeur du remplissage est l'attribut width d'un svg vide. %>
                    <% unless question.rate.nil? %>
                      <span class="mt-2 block h-2 overflow-hidden rounded-full bg-line" aria-hidden="true">
                        <svg width="<%= question.rate %>%" focusable="false" class="h-full rounded-full bg-teacher"></svg>
                      </span>
                    <% end %>
                  </li>
                <% end %>
              </ol>
            </section>
          <% end %>
        <% end %>
      </div>

      <% if comprehension.done.positive? || pending.any? %>
        <div id="comprehension_panel" class="mt-6 min-w-0 lg:mt-0">
          <% if comprehension.students.empty? && pending.empty? %>
            <%= ui_empty_state title: t("assessment.comprehension.empty_category"), icon: "user-group" %>
          <% else %>
            <section aria-labelledby="comprehension_students_title">
              <h3 id="comprehension_students_title" class="mb-3 font-display text-lg font-medium"><%= t(".students_title") %></h3>
              <ul class="divide-y divide-line border-b border-line">
                <% comprehension.students.each do |student| %>
                  <%= render "assessment/comprehension/student_row", student:, classroom:, pill: comprehension_grade_badge(student),
                        caption: t("assessment.comprehension.student.done_on", date: l(student.done_on, format: t("assessment.comprehension.student.done_format"))) %>
                <% end %>
                <% pending.each do |student| %>
                  <%= render "assessment/comprehension/student_row", student:, classroom:, pill: comprehension_late_badge(overdue),
                                                                     caption: t("assessment.comprehension.student.pending") %>
                <% end %>
              </ul>
            </section>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
