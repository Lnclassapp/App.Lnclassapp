<%# 🌐 UI · assessment/session_results/_badge — palier obtenu par la session : Bronze, Argent, Or, Diamant ou « Non acquis » %>
<%# Rôle : médaillon et nom du palier, nommé en toutes lettres pour les lecteurs d'écran ; « Nouveau badge ! » si earned_now %>
<%# ADR  : 0033 · UDR : 0007, 0023 %>
<% name = badge_label(level) %>
<div id="session_badge" role="group" aria-label="<%= level ? t(".label", level: name) : name %>"
     class="flex flex-col items-center gap-2 animate-slide-up">
  <span class="grid size-24 place-items-center rounded-full border-4 border-white shadow-lift <%= ComponentsHelper::BADGE_TONES.fetch(badge_tone(level))[:chip] %>"
        aria-hidden="true">
    <%= ui_icon level ? "trophy" : "lock-closed", variant: :solid, size: :xl %>
  </span>
  <span class="font-display text-sm font-extrabold tracking-wide uppercase"><%= name %></span>
  <% if earned_now %>
    <%= ui_badge t(".new"), tone: :brand, icon: "sparkles" %>
  <% end %>
</div>
