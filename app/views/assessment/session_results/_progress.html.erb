<%# 🌐 UI · assessment/session_results/_progress — phrase de progrès de l'élève, sous sa médaille %>
<%# Rôle : où il en est par rapport à ses sessions précédentes, et quoi faire ensuite ; jamais « stagne » ni « baisse » %>
<%# ADR  : 0033, 0079 · UDR : 0007, 0023, 0073, 0087 §3.6 · propriétaire seul · vert pour le progrès et le stable, neutre sinon %>
<%# locals: (progress:) -%>
<% icon, tone = { progress: %w[arrow-trending-up text-success], stable: %w[check-circle text-success] }
                  .fetch(progress.trend, %w[book-open text-mute]) %>
<p id="session_progress" class="flex items-start gap-3 rounded-card bg-info-soft px-4 py-4 text-sm text-ink">
  <%= ui_icon icon, variant: :mini, size: :sm, class: "mt-0.5 #{tone}" %>
  <span><%= t(".#{progress.trend}", first: badge_label(progress.first_medal), best: badge_label(progress.best_medal), current: badge_label(progress.current_medal)) %></span>
</p>
