<%# 🌐 UI · assessment/session_results/kinds/_fill_blank_review — « Ta réponse » d'un texte à trous, dans la correction %>
<%# Rôle : le texte saisi ; avec reveal seulement (enseignant, équipe), les réponses acceptées %>
<%# ADR  : 0091 §4.4 · UDR : 0023, 0087 §3.6 %>
<%# locals: (question:, reveal:) -%>
<%# Plusieurs cases (XXXX-questions-a-plusieurs-cases-et-indice §4) : la phrase et un verdict par case. %>
<% if question.multi_blank? %>
  <%= render "assessment/session_results/kinds/blanks_review", question:, reveal: %>
<% else %>
<% if question.response_text %>
  <p class="text-sm text-mute"><%= t("assessment.session_results.question_review.selected") %> : <strong class="text-ink"><%= question.response_text %></strong></p>
<% end %>
<% if reveal && question.solution.any? %>
  <p class="mt-1 text-sm text-success" data-correct>
    <%= t("assessment.session_results.question_review.accepted") %> : <strong><%= safe_join(question.solution, " ; ") %></strong>
  </p>
<% end %>
<% end %>
