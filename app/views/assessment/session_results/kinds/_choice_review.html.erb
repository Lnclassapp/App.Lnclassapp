<%# 🌐 UI · assessment/session_results/kinds/_choice_review — « Ta réponse » d'une question à cocher, dans la correction %>
<%# Rôle : sans reveal, les seules propositions cochées ; avec reveal, toutes, correctes et choix de l'élève marqués %>
<%# ADR  : 0028, 0054 · UDR : 0022, 0023, 0087 §3.6 · le contenu dans un span : un `li.flex` ferait de chaque formule KaTeX une colonne %>
<%# locals: (question:, reveal:) -%>
<% if reveal %>
  <ul class="space-y-2" aria-label="<%= t("assessment.session_results.question_review.answers") %>">
    <% question.answers.each do |answer| %>
      <% if answer.correct %>
        <li class="flex min-h-tap items-center gap-3 rounded-ln border border-success bg-success-soft px-4 py-2" data-correct
            <%= "data-selected" if answer.selected %>>
          <%= ui_icon "check-circle", variant: :mini, class: "text-success" %>
          <span class="min-w-0 flex-1 font-medium text-ink"><%= answer.content %></span>
          <%= ui_badge t("assessment.session_results.question_review.correct"), tone: :success, size: :sm %>
          <% if answer.selected %><%= ui_badge t("assessment.session_results.question_review.student_choice"), tone: :neutral, size: :sm %><% end %>
        </li>
      <% elsif answer.selected %>
        <li class="flex min-h-tap items-center gap-3 rounded-ln border border-error bg-error-soft px-4 py-2" data-selected>
          <%= ui_icon "x-circle", variant: :mini, class: "text-error" %>
          <span class="min-w-0 flex-1 font-medium text-ink"><%= answer.content %></span>
          <%= ui_badge t("assessment.session_results.question_review.student_choice"), tone: :neutral, size: :sm %>
        </li>
      <% else %>
        <li class="flex min-h-tap items-center gap-3 rounded-ln border border-line px-4 py-2">
          <span class="size-4 shrink-0 rounded-full border-2 border-line" aria-hidden="true"></span>
          <span class="min-w-0 flex-1 text-mute"><%= answer.content %></span>
        </li>
      <% end %>
    <% end %>
  </ul>
<% elsif question.answers.any? %>
  <p class="text-sm text-mute">
    <%= t("assessment.session_results.question_review.selected") %> :
    <%= safe_join(question.answers.map { tag.strong(tag.span(it.content), class: "text-ink") }, " ; ") %>
  </p>
<% end %>
