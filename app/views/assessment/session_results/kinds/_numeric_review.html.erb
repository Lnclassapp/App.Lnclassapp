<%# 🌐 UI · assessment/session_results/kinds/_numeric_review — « Ta réponse » d'une réponse en nombre, dans la correction %>
<%# Rôle : la saisie de l'élève ; avec reveal, la valeur attendue suivie de son unité, et sa marge %>
<%# ADR  : 0091 §4.4, 0115 · UDR : 0023, 0087 §3.6, 0140 %>
<%# locals: (question:, reveal:) -%>
<%# Plusieurs cases (XXXX-questions-a-plusieurs-cases-et-indice §4) : la phrase et un verdict par case. %>
<% if question.multi_blank? %>
  <%= render "assessment/session_results/kinds/blanks_review", question:, reveal:, unit: question.unit %>
<% else %>
<% if question.response_text %>
  <p class="text-sm text-mute"><%= t("assessment.session_results.question_review.selected") %> : <strong class="text-ink"><%= question.response_text %></strong></p>
<% end %>
<% if reveal && question.solution.any? %>
  <p class="mt-1 text-sm text-success" data-correct>
    <%= t("assessment.session_results.question_review.expected") %> : <strong><%= question.solution.first %><%= " #{question.unit}" if question.unit.present? %></strong>
    <% if question.numeric_tolerance&.positive? %>
      <%= t("assessment.exercises.solution.tolerance", tolerance: question.numeric_tolerance.to_s("F").delete_suffix(".0").tr(".", ",")) %>
    <% end %>
  </p>
<% end %>
<% end %>
