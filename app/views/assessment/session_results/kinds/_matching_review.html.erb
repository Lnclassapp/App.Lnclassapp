<%# 🌐 UI · assessment/session_results/kinds/_matching_review — « Ta réponse » d'un relier, dans la correction %>
<%# Rôle : les paires de l'élève ; avec reveal seulement, les bonnes paires %>
<%# ADR  : 0091 §4.4 · UDR : 0023, 0087 §3.6 · sans reveal, aucune paire n'est marquée juste ou fausse %>
<%# locals: (question:, reveal:) -%>
<% if question.pairs.any? %>
  <p class="text-sm text-mute"><%= t("assessment.session_results.question_review.selected") %> :</p>
  <ul class="mt-1 space-y-0.5 text-sm font-medium text-ink">
    <% question.pairs.each do |pair| %><li><span><%= pair.left %></span> → <span><%= pair.right %></span></li><% end %>
  </ul>
<% end %>
<% if reveal && question.solution.any? %>
  <div class="mt-2 text-sm text-success" data-correct>
    <p><%= t("assessment.session_results.question_review.right_pairs") %> :</p>
    <ul class="mt-1 space-y-0.5 font-medium">
      <% question.solution.each do |pair| %><li><%= pair %></li><% end %>
    </ul>
  </div>
<% end %>
