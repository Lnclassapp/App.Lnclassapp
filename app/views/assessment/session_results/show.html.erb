<%# 🌐 UI · assessment/session_results/show — résultat d'une session terminée (AS-11 à AS-13) %>
<%# Rôle : badge, appréciation (« Très bien » à « À retravailler »), note (verte dès 14/20), points, « À revoir », maîtrise, progrès, effet sur la fiche, « Refaire l'exercice » (caché au sans-faute, Grading.perfect?) ou l'heure de reprise, correction complète %>
<%# ADR  : 0033, 0054, 0079, 0091, 0101, 0112, 0113, 0115 · UDR : 0140, 0007, 0023, 0054, 0057, 0073, 0087 §3.6, 0120, 0138 §3.4, XXXX écrans élève sans répétition §3.5 et §3.6 bis · aucun cache : le HTML dépend du rôle · Stimulus : assessment--confetti, reveal %>
<% result = @result %>
<%# UDR-0087 §3.6 : le titre, la couleur de la note et les confettis dès « 14/20 » affiché, la règle de l'historique, de
    « Ma classe » et de l'accueil (68 % s'affiche 14/20). %>
<% grading = Entities::Assessment::Grading %>
<% tone = grading.reaches?(result.score_percent, grading::MASTERY_THRESHOLD) ? :success : :error %>
<% tile = "rounded-ln bg-mist px-3 py-3 text-center" %>
<% label = "text-2xs font-medium tracking-wide text-mute uppercase" %>
<% page_title t(".page_title", title: result.exercise.title) %>
<% lesson_href = course_path(result.course_slug, anchor: (result.essential ? "notion-#{result.essential.slug}" : "toute-la-lecon")) %>
<%# UDR-0087 §3.6 : une colonne de 720 px dès 700 px. UDR écrans élève §3.6 bis (CA-E13) : dès 1 024 px, la note et « Recommencer »
    dans une colonne de 340 px collante à gauche, la correction à droite. %>
<div id="session_result_layout"
     class="mx-auto grid w-full max-w-180 grid-cols-1 gap-6 lg:max-w-none lg:grid-cols-side-main lg:items-start">
  <div id="session_result_side" class="grid grid-cols-1 gap-4 lg:sticky lg:top-sticky-below-bar <%= "lg:row-span-2" if result.exercise.statement_blocks.present? %>">
    <section id="session_result" aria-labelledby="session_result_title"
             class="rounded-card border border-line bg-white p-5 text-center shadow-card sm:p-6"
             <%= tag.attributes(data: { controller: "assessment--confetti" }) if @owner && tone == :success %>>
      <div class="flex flex-col items-center gap-3">
        <%= render "assessment/session_results/badge", level: result.badge_level, earned_now: result.earned_now %>
        <div class="space-y-2">
          <h1 id="session_result_title" class="font-display text-3xl font-medium tracking-tight"><%= t(".headline.#{result.appreciation.level}") %></h1>
          <% if @owner %>
            <% cheers = t(".cheers.#{tone}") %>
            <p class="text-ink text-balance"><%= cheers[result.session_public_id.sum % cheers.size] %></p>
          <% else %>
            <p class="font-medium text-ink"><%= t(".student", name: result.student_name) %></p>
          <% end %>
          <p class="text-sm text-mute"><%= t(".exercise", title: result.exercise.title) %></p>
        </div>
      </div>

      <%# L'élève lit sa note sur 20, forme unique de la note (UDR-0023, 2026-10-02) ; l'enseignant et l'équipe gardent les 4 termes. %>
      <dl class="mt-6 grid grid-cols-2 gap-3 <%= "sm:max-lg:grid-cols-4" unless @owner %>">
        <div class="<%= tile %>">
          <dt class="<%= label %>"><%= t(".grade") %></dt>
          <dd id="session_grade" class="mt-1 whitespace-nowrap font-display text-3xl font-medium tabular-nums <%= "text-success" if tone == :success %>"><%= grade_label(result.score_percent) %></dd>
        </div>
        <% unless @owner %>
          <div class="<%= tile %>">
            <dt class="<%= label %>"><%= t(".score") %></dt>
            <dd class="mt-1 whitespace-nowrap font-display text-2xl font-medium tabular-nums"><%= t(".score_value", score: result.score_percent) %></dd>
          </div>
        <% end %>
        <div class="<%= tile %>">
          <dt class="flex items-center justify-center gap-1"><span class="<%= label %>"><%= t(".mastery") %></span><%= stat_info_tip mastery_tip, label: t(".mastery") %></dt>
          <% mastery = Entities::Assessment::Grading.mastery_for(result.score_percent) %>
          <dd class="mt-2 whitespace-nowrap"><%= ui_badge mastery_label(result.score_percent), size: :sm,
                                        tone: { acquired: :success, fragile: :gold, struggling: :neutral }.fetch(mastery) %></dd>
        </div>
        <% unless @owner %>
          <div class="<%= tile %>">
            <dt class="<%= label %>"><%= t(".correct") %></dt>
            <dd class="mt-1 whitespace-nowrap font-medium tabular-nums">
              <%= t(".correct_value", count: result.correct_count, total: result.question_count) %>
            </dd>
          </div>
        <% end %>
      </dl>
      <%# UDR-0140 §3 : les points, seulement quand l'exercice n'est pas tout à 1 point ; les réponses rédigées et le cahier, à comparer. %>
      <% points = result.points %>
      <% fmt = ->(value) { number_with_precision(value, precision: 1, strip_insignificant_zeros: true) } %>
      <% if points.weighted || points.manual.positive? %>
        <div id="session_points" class="mt-4 space-y-1 text-sm text-mute">
          <% if points.weighted %>
            <p><%= t(".points_graded", count: points.earned, points: fmt.(points.earned), total: fmt.(points.graded)) %></p>
          <% end %>
          <% if points.manual.positive? %>
            <p><%= t(".points_manual", count: points.manual, points: fmt.(points.manual)) %></p>
          <% end %>
        </div>
      <% end %>
    </section>

    <%# UDR-0140 §3 : ce qu'il faut revoir, les questions corrigées automatiquement fausses ou sans réponse. Absent sans faute. %>
    <% appreciation = result.appreciation %>
    <% if appreciation.review? %>
      <% weak = result.review.select { appreciation.weak_numbers.include?(it.number) } %>
      <% links = weak.map { link_to(it.number, "#question_review_#{it.id}", class: "font-medium text-brand underline") } %>
      <% numbers = links.each_with_index.map { |link, rank| rank.zero? ? link : safe_join([ t(rank == links.size - 1 ? "support.array.last_word_connector" : "support.array.words_connector"), link ]) } %>
      <% questions = t(".review_questions_html", count: weak.size, numbers: safe_join(numbers)) %>
      <section id="session_to_review" class="rounded-card border border-line bg-white p-4 text-left">
        <% if appreciation.scope == :essential %>
          <p class="text-ink"><%= t(".to_review_essential_html", essential: appreciation.essential_name, questions:) %></p>
        <% else %>
          <p class="text-ink"><%= t(".to_review_lesson_html", questions:) %></p>
          <p class="mt-1"><%= link_to t(".whole_lesson"), lesson_href, class: "text-sm font-medium text-brand underline", data: { turbo_prefetch: false } %></p>
        <% end %>
      </section>
    <% end %>

    <%# UDR-0073 : la phrase de progrès parle à l'élève seul, à partir de sa deuxième session. %>
    <%# UDR écrans élève §3.5 : « Tu restes autour de… » n'est plus dit, la correction le dit déjà. %>
    <% if @owner && result.progress && result.progress.trend != :stagnant %>
      <%= render "assessment/session_results/progress", progress: result.progress %>
    <% end %>
    <%# UDR-0120 : l'effet de la session sur sa fiche, à l'élève seul, sous son progrès. %>
    <% if @owner && result.gap_outcome && result.essential %>
      <%= render "assessment/session_results/gap_outcome", outcome: result.gap_outcome, essential: result.essential %>
    <% end %>

    <%# UDR-0138 §3.4 : « Refaire l'exercice » (caché au sans-faute) puis « Retour à la leçon ». UDR-0140 : pendant la pause, l'heure de reprise à sa place. %>
    <% if @resume_at && !grading.perfect?(result.score_percent) %>
      <p id="restart_pause" class="text-center text-ink"><%= t(".restart_pause", time: l(@resume_at, format: :hour_minute)) %></p>
    <% elsif @can_restart && !grading.perfect?(result.score_percent) %>
      <%= form_with url: exercise_sessions_path(result.exercise.public_id), method: :post, id: "restart-exercise-form" do %>
        <%= ui_button t("assessment.exercises.show.redo"), type: :submit, variant: :brand, size: :lg, full: true, icon: "arrow-path" %>
      <% end %>
    <% end %>
    <%= ui_button t(".back_to_lesson"), href: lesson_href, variant: :secondary, size: :lg, full: true, data: { turbo_prefetch: false } %>
  </div>

  <%# ADR-0115, CA-25 : le sujet en blocs, rendu au-dessus de la correction pour la lire avec lui. %>
  <% if result.exercise.statement_blocks.present? %>
    <section id="session_statement" aria-labelledby="session_statement_title" data-controller="math"
             class="rounded-card border border-line bg-white p-5 shadow-card sm:p-6 lg:col-start-2">
      <h2 id="session_statement_title" class="mb-3 font-display text-xl font-medium"><%= t("assessment.exercise_sessions.show.statement") %></h2>
      <div class="space-y-4"><%= render "assessment/statement_blocks/blocks", blocks: result.exercise.statement_blocks %></div>
    </section>
  <% end %>

  <%= tag.section id: "session_review", "aria-labelledby": "session_review_title",
                  class: "rounded-card border border-line bg-white p-5 shadow-card sm:p-6 lg:col-start-2",
                  data: (ui_reveal_data(step: 3) if @owner) do %>
    <div class="mb-2">
      <h2 id="session_review_title" class="font-display text-xl font-medium"><%= t(".review_title") %></h2>
      <% unless @owner %>
        <p class="mt-1 text-sm text-mute"><%= @reveal ? t(".review_hint_reveal") : t(".review_hint_student") %></p>
      <% end %>
    </div>
    <ol class="divide-y divide-line" data-controller="math">
      <% result.review.each_with_index do |question, index| %>
        <%= render "assessment/session_results/question_review", question:, reveal: @reveal, owner: @owner, index: %>
      <% end %>
    </ol>
    <% if @owner %>
      <div class="mt-2"><%= ui_reveal_more result.review.size %></div>
    <% end %>
  <% end %>
</div>
