<%# 🌐 UI · assessment/session_results/show — résultat d'une session terminée (AS-11 à AS-13) %>
<%# Rôle : badge, « Félicitations ! » (dès 14/20) ou « Courage ! », note (verte dès 14/20) et maîtrise, progrès, effet sur la fiche, « Recommencer » (caché à 20/20), correction %>
<%# ADR  : 0033, 0054, 0079, 0091, 0101 · UDR : 0007, 0023, 0054, 0057, 0073, 0087 §3.6, 0120 · aucun cache : le HTML dépend du rôle · Stimulus : assessment--confetti, reveal %>
<% result = @result %>
<%# UDR-0087 §3.6 : le titre, la couleur de la note et les confettis dès « 14/20 » affiché, la règle de l'historique, de
    « Ma classe » et de l'accueil (68 % s'affiche 14/20). %>
<% grading = Entities::Assessment::Grading %>
<% tone = grading.reaches?(result.score_percent, grading::MASTERY_THRESHOLD) ? :success : :error %>
<% tile = "rounded-ln bg-mist px-3 py-3 text-center" %>
<% label = "text-2xs font-bold tracking-wide text-mute uppercase" %>
<% page_title t(".page_title", title: result.exercise.title) %>
<%= ui_back_link result.essential.name, href: course_essential_path(result.essential.course_slug, result.essential.slug) %>
<%# UDR-0087 §3.6 : une colonne de 720 px dès 700 px ; dès 1 024 px, la note et les boutons à gauche, la correction à droite. %>
<div class="mx-auto grid w-full max-w-180 grid-cols-1 gap-6 lg:max-w-none lg:grid-cols-2 lg:items-start">
  <div class="grid grid-cols-1 gap-4">
    <section id="session_result" aria-labelledby="session_result_title"
             class="rounded-card border border-line bg-white p-5 text-center shadow-card sm:p-6"
             <%= tag.attributes(data: { controller: "assessment--confetti" }) if @owner && tone == :success %>>
      <div class="flex flex-col items-center gap-3">
        <%= render "assessment/session_results/badge", level: result.badge_level, earned_now: result.earned_now %>
        <div class="space-y-2">
          <h1 id="session_result_title" class="font-display text-3xl font-extrabold tracking-tight"><%= t(".headline.#{tone}") %></h1>
          <% if @owner %>
            <% cheers = t(".cheers.#{tone}") %>
            <p class="text-ink text-balance"><%= cheers[result.session_public_id.sum % cheers.size] %></p>
          <% else %>
            <p class="font-medium text-ink"><%= t(".student", name: result.student_name) %></p>
          <% end %>
          <p class="text-sm text-mute"><%= t(".exercise", title: result.exercise.title) %></p>
        </div>
      </div>

      <%# L'élève lit sa note sur 20, forme unique de la note (UDR-0023, 2026-10-02) ; l'enseignant et l'équipe gardent les 4 termes. %>
      <dl class="mt-6 grid grid-cols-2 gap-3 <%= "sm:grid-cols-4" unless @owner %>">
        <div class="<%= tile %>">
          <dt class="<%= label %>"><%= t(".grade") %></dt>
          <dd id="session_grade" class="mt-1 font-display text-3xl font-extrabold tabular-nums <%= "text-success" if tone == :success %>"><%= grade_label(result.score_percent) %></dd>
        </div>
        <% unless @owner %>
          <div class="<%= tile %>">
            <dt class="<%= label %>"><%= t(".score") %></dt>
            <dd class="mt-1 font-display text-2xl font-extrabold tabular-nums"><%= t(".score_value", score: result.score_percent) %></dd>
          </div>
        <% end %>
        <div class="<%= tile %>">
          <dt class="flex items-center justify-center gap-1"><span class="<%= label %>"><%= t(".mastery") %></span><%= stat_info_tip mastery_tip, label: t(".mastery") %></dt>
          <% mastery = Entities::Assessment::Grading.mastery_for(result.score_percent) %>
          <dd class="mt-2"><%= ui_badge mastery_label(result.score_percent), size: :sm,
                                        tone: { acquired: :success, fragile: :gold, struggling: :neutral }.fetch(mastery) %></dd>
        </div>
        <% unless @owner %>
          <div class="<%= tile %>">
            <dt class="<%= label %>"><%= t(".correct") %></dt>
            <dd class="mt-1 font-medium tabular-nums">
              <%= t(".correct_value", count: result.correct_count, total: result.question_count) %>
            </dd>
          </div>
        <% end %>
      </dl>
    </section>

    <%# UDR-0073 : la phrase de progrès parle à l'élève seul, à partir de sa deuxième session. %>
    <% if @owner && result.progress %>
      <%= render "assessment/session_results/progress", progress: result.progress %>
    <% end %>
    <%# UDR-0120 : l'effet de la session sur sa fiche, à l'élève seul, sous son progrès. %>
    <% if @owner && result.gap_outcome %>
      <%= render "assessment/session_results/gap_outcome", outcome: result.gap_outcome, essential: result.essential %>
    <% end %>

    <div class="grid grid-cols-1 gap-3">
      <% if @can_restart && !grading.perfect?(result.score_percent) %>
        <%= form_with url: exercise_sessions_path(result.exercise.public_id), method: :post, id: "restart-exercise-form" do %>
          <%= ui_button t(".restart"), type: :submit, variant: :brand, size: :lg, full: true, icon: "arrow-path" %>
        <% end %>
      <% end %>
      <%= ui_button t(".exercise_link"), href: exercise_path(result.exercise.public_id), variant: :secondary, size: :lg, full: true %>
    </div>
  </div>

  <%= tag.section id: "session_review", "aria-labelledby": "session_review_title",
                  class: "rounded-card border border-line bg-white p-5 shadow-card sm:p-6",
                  data: (ui_reveal_data(step: 3) if @owner) do %>
    <div class="mb-2">
      <h2 id="session_review_title" class="font-display text-xl font-extrabold"><%= t(".review_title") %></h2>
      <% unless @owner %>
        <p class="mt-1 text-sm text-mute"><%= @reveal ? t(".review_hint_reveal") : t(".review_hint_student") %></p>
      <% end %>
    </div>
    <ol class="divide-y divide-line" data-controller="math">
      <% result.review.each_with_index do |question, index| %>
        <%= render "assessment/session_results/question_review", question:, reveal: @reveal, owner: @owner, index: %>
      <% end %>
    </ol>
    <% if @owner %>
      <div class="mt-2"><%= ui_reveal_more result.review.size %></div>
    <% end %>
  <% end %>
</div>
