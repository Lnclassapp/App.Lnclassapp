<%# 🌐 UI · assessment/session_results/_question_review — correction d'une question dans le résultat %>
<%# Rôle : « Question n » et son verdict (Juste, Faux, Sans réponse : texte et icône, jamais la couleur seule), l'énoncé, « Ton choix » par type (kinds/_<type>_review, absent sans réponse), l'explication %>
<%# ADR  : 0028, 0054, 0091 §4.4, 0112 · UDR : 0007, 0022, 0023, 0057, 0087 §3.6, 0138 §3.4, §3.8 · pour l'élève propriétaire, masquée à partir de la 4e (« Voir plus ») %>
<%# locals: (question:, reveal:, owner:, index:) -%>
<% verdict = question.unanswered || question.correct.nil? ? :unanswered : (question.correct ? :correct : :wrong) %>
<% badge = { correct: [ :success, "check-circle" ], wrong: [ :warning, "x-circle" ], unanswered: [ :neutral, "minus-circle" ] }.fetch(verdict) %>
<li id="question_review_<%= question.id %>" class="py-4 first:pt-2" <%= tag.attributes(ui_reveal_item(index)) if owner %>>
  <div class="flex items-center justify-between gap-3">
    <p class="font-medium text-ink"><%= t(".number", number: question.number) %></p>
    <%# UDR-0087 §3.5 : une mauvaise réponse n'est jamais en rouge. %>
    <%= ui_badge t("assessment.session_results.show.#{verdict}"), tone: badge.first, icon: badge.last, size: :sm %>
  </div>
  <p class="mt-2 whitespace-pre-line text-ink"><%= question.content %></p>
  <div class="mt-2">
    <%= render "assessment/session_results/kinds/#{question.kind_name}_review", question:, reveal: %>
  </div>
  <% if question.explanation.present? %>
    <p class="mt-2 text-sm whitespace-pre-line text-mute"><span class="sr-only"><%= t(".explanation") %> : </span><%= question.explanation %></p>
  <% end %>
</li>
