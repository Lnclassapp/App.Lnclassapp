<%# 🌐 UI · assessment/hints/_hint — l'indice ouvert d'une question de la copie %>
<%# Rôle : le texte de l'indice, sans bouton ; remplace turbo-frame#hint_<id> (Turbo Stream) ou se lit dans la copie rechargée %>
<%# ADR  : 0120-questions-a-plusieurs-cases-et-indice §4 · UDR : 0147-je-m-entraine-dans-la-fiche §3.8 %>
<%# locals: (question_id:, hint:) -%>
<div id="hint_<%= question_id %>" class="rounded-ln bg-mist p-3 text-sm">
  <p class="text-ink"><%= t("assessment.exercise_sessions.show.hint_text", text: hint) %></p>
</div>
