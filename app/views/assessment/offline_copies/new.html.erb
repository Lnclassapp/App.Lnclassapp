<%# 🌐 UI · assessment/offline_copies/new — la copie sur feuille faite hors ligne : la feuille de la copie en ligne, sans session, sans indice, sans bonne réponse %>
<%# Rôle : sujet repliable, compteur « n/T répondues », une carte par question (mêmes partials par type que la copie en ligne), pied collant ; « Vérifier ma copie » corrige sur le téléphone et affiche la note provisoire à la place de la feuille (#copy-sheet) %>
<%# ADR  : hors-connexion pages ouvertes et copies synchronisées (§4.4), 0091 §4.4 (aucune correction, aucun id révélateur), 0115, 0120-questions-a-plusieurs-cases-et-indice §4 · UDR : hors-connexion §3.4, §3.5, 0138 §3.2, 0157-sujets-cahier-noir-blanc, 0087 §3.4 · Stimulus : offline-copy, math (les contrôleurs d'ordre, de relier et de nombre viennent des partials) %>
<%# La feuille reprend la structure de assessment/exercise_sessions/show (dont le rendu en ligne ne bouge pas) ; ses textes sont ceux de assessment.exercise_sessions.show. %>
<% sheet = @sheet %>
<% shown = "assessment.exercise_sessions.show" %>
<% counted = sheet.questions.count(&:counted?) %>
<% page_title t("#{shown}.page_title", title: sheet.exercise_title) %>
<% content_for :nav_key, "courses" %>
<% content_for :head do %><%= stylesheet_link_tag "exam_sheet" %><% end %>
<div class="exam-sheet">
<%= ui_back_link sheet.exercise_title, href: exercise_path(sheet.exercise_public_id) %>
<div id="copy-sheet" class="sheet-cahier mx-auto w-full max-w-180">
  <%# Sans action serveur : offline-copy intercepte l'envoi, corrige avec offline/grader.js et range la copie dans la base du téléphone. %>
  <%= tag.form id: "copy-form", novalidate: true,
               data: { controller: "offline-copy", offline_copy_exercise_value: sheet.exercise_public_id, offline_copy_total_value: counted,
                       offline_copy_counter_value: t("#{shown}.counter", answered: "%{answered}", total: "%{total}"),
                       offline_copy_time_format_value: t("time.formats.hour_minute"),
                       action: "submit->offline-copy#submit input->offline-copy#count change->offline-copy#count" } do %>
    <%# Hors ligne : la note remplace cette feuille (le contenu de #copy-sheet), jamais une nouvelle page. %>
  <header id="exam-header" class="exam-header"><span><%= t("#{shown}.exam_kind") %></span><span class="exam-header-brand"><%= t("#{shown}.exam_brand") %></span></header>
  <h1 class="exam-title"><%= sheet.exercise_title %></h1>
  <p id="exam-instructions" class="exam-instructions mb-4"><%= t("#{shown}.questions", count: sheet.questions.size) %></p>
  <div class="sticky top-0 z-10 flex items-center justify-between gap-3 bg-paper py-3">
    <p id="copy-counter" class="text-sm font-medium text-ink tabular-nums" aria-live="polite" data-offline-copy-target="counter"><%= t("#{shown}.counter", answered: 0, total: counted) %></p>
    <a href="#copy-statement" class="inline-flex min-h-tap items-center gap-1.5 text-sm font-medium text-brand-strong underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-brand">
      <%= ui_icon "document-text", variant: :mini, size: :sm %><%= t("#{shown}.review_statement") %>
    </a>
  </div>

  <%= tag.details id: "copy-statement", open: true, class: "mb-6 rounded-card border border-line bg-white p-5 shadow-card", data: { controller: "math" } do %>
    <summary class="min-h-tap cursor-pointer font-display text-lg font-medium"><%= t("#{shown}.statement") %></summary>
    <div class="mt-3 max-w-prose text-ink"><%= simple_format(sheet.statement) %></div>
    <% if sheet.statement_blocks.present? %>
      <div id="copy-statement-blocks" class="mt-4 space-y-4"><%= render "assessment/statement_blocks/blocks", blocks: sheet.statement_blocks %></div>
    <% end %>
    <% if (figure = sheet.figure) %>
      <div id="copy-statement-figure" class="mt-4"><%= render "catalog/figures/figure", figure:, frame: :app %></div>
    <% end %>
  <% end %>

    <p id="offline-copy-not-saved" role="alert" hidden data-offline-copy-target="notSaved"
       class="mb-6 rounded-card bg-warning-soft px-4 py-3 text-sm font-medium text-warning"><%= t("offline.copy.not_saved") %></p>

    <ol class="list-none space-y-6" data-pausable>
      <% sheet.questions.each do |question| %>
        <% number = question.number %>
        <%# L'énoncé d'un texte à trous, ou d'une liste dont le trou est dans la phrase, est la phrase, qui porte le champ : la légende en est la consigne. %>
        <% legend = if question.kind_name == "fill_blank" || (question.kind_name == "numeric" && question.multi_blank?) then t("assessment.exercise_sessions.kinds.fill_blank.legend")
                    elsif question.kind_name == "select" && question.content.include?(Entities::Assessment::QuestionKinds::FillBlank::MARKER) then t("assessment.exercise_sessions.kinds.select.legend")
                    else question.content end %>
        <li id="question-<%= number %>">
          <%= ui_card data: { offline_copy_target: ("question" if question.counted?), controller: "math" }.compact do %>
            <%= fields_for "copy[answers][#{question.id}]" do |f| %>
              <% if (image = question.image) %>
                <%= tag.img src: question_image_path(image.public_id), alt: image.alt.to_s, width: image.width, height: image.height,
                            loading: "lazy", decoding: "async", class: "mb-4 h-auto max-h-72 w-full rounded-ln bg-mist object-contain" %>
              <% end %>
              <fieldset class="min-w-0 space-y-4">
                <legend class="mb-2">
                  <span class="block text-xs font-medium tracking-wide text-mute uppercase"><%= t("#{shown}.question", number:) %></span>
                  <span class="mt-1 block font-display text-xl font-medium text-balance whitespace-pre-line text-ink"><%= legend %></span>
                </legend>
                <%# UDR hors-connexion §3.4 : aucun indice (il demande le réseau) ; aucune valeur déjà choisie. %>
                <%= render "assessment/exercise_sessions/kinds/#{question.kind_name}", f:, question:, number:, values: {}.with_indifferent_access %>
              </fieldset>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ol>

    <%# Collé en bas, au-dessus de la zone sûre (UDR-0087 §3.2). %>
    <div data-pausable class="sticky bottom-0 z-10 -mx-gutter mt-6 bg-paper px-gutter pt-4 pb-safe-action min-[700px]:mx-0 min-[700px]:px-0">
      <p class="mb-3 text-sm text-mute"><%= t("offline.copy.footer") %></p>
      <%= ui_button t("#{shown}.submit"), type: :submit, variant: :primary, size: :lg, full: true, data: { offline_copy_target: "submitButton" } %>
      <p id="offline-copy-result-failed" role="status" hidden data-offline-copy-target="resultFailed"
         class="mt-3 rounded-card bg-warning-soft px-4 py-3 text-sm font-medium text-warning"><%= t("offline.copy.result_failed") %></p>
    </div>

    <%# Remplacent la feuille quand il y a lieu : la note (UDR §3.5) et la pause de « Recommencer » (3 copies d'affilée, ADR-0115). %>
    <template data-offline-copy-target="result"><%= render "assessment/offline_copies/result", exercise_public_id: sheet.exercise_public_id %></template>
    <template data-offline-copy-target="paused"><p id="exercise_paused" class="text-center text-sm text-mute"><%= t("assessment.exercises.show.paused", time: "%{time}") %></p></template>
  <% end %>
</div>
</div>
