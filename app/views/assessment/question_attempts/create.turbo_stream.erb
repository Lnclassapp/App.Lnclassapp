<%# 🌐 UI · assessment/question_attempts/create — réponse enregistrée, sans rechargement de page %>
<%# Rôle : le frame « question » devient le verdict, avec la question suivante jointe ; la progression et « reprendre à la question N » suivent %>
<%# ADR  : 0054, 0076 · UDR : 0006, 0022, 0076 §3.3, 0087 §3.2–3.3 · un aller-retour par question, aucun cache %>
<%= turbo_stream.replace "question", partial: "assessment/exercise_sessions/feedback_card",
                                     locals: { play: @play, feedback: @play.last_feedback, next_question: @play.next_question } %>
<%= turbo_stream.replace "progress_bar", partial: "assessment/exercise_sessions/progress_bar",
                                         locals: { play: @play, number: @play.last_feedback.number } %>
<%= turbo_stream.replace "quit_resume", partial: "assessment/exercise_sessions/quit_resume", locals: { play: @play } %>
