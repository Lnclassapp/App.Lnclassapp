<%# 🌐 UI · assessment/exercises/show — page d'un exercice (AS-02), pour l'élève, l'enseignant et l'équipe %>
<%# Rôle : élève : présentation, « Ta progression » et aperçu dans le cadre de l'accueil (UDR-0087 §3.1) ; équipe et enseignant : en-tête, statut, menu ⋮, « Assigner », aperçu %>
<%# ADR  : 0028, 0054, 0072, 0091 · UDR : 0006, 0007, 0021, 0042, 0054, 0057, 0062, 0069, 0087 · aucun cache : le HTML dépend du rôle (sécurité n° 29) %>
<% exercise = @detail.exercise %>
<% essential = @detail.essential %>
<% course = @detail.course %>
<% student = @progress.present? %>
<% page_title t(".page_title", title: exercise.title) %>
<% content_for :nav_key, "courses" %>
<% if student %>
  <%# UDR-0087 §3.1 : le cadre de l'accueil ; une colonne de 720 px dès 700 px, deux colonnes dès 1 024 px (la présentation et
      « Ta progression » à gauche, l'aperçu à droite). %>
  <%= ui_back_link essential.name, href: course_essential_path(course.slug, essential.slug) %>
  <div id="exercise_layout" class="mx-auto grid w-full max-w-180 grid-cols-1 gap-6 lg:max-w-none lg:grid-cols-2 lg:items-start">
    <div class="grid grid-cols-1 gap-6">
      <section id="exercise_header" aria-labelledby="exercise_title" class="rounded-card border border-line bg-white p-5 shadow-card sm:p-6">
        <div class="flex items-center gap-3">
          <span class="grid size-12 shrink-0 place-items-center rounded-full bg-tint-indigo text-brand-strong" aria-hidden="true">
            <%= ui_icon ComponentsHelper::SUBJECT_CATEGORIES.fetch(course.material_category.to_s.to_sym, ComponentsHelper::SUBJECT_FALLBACK)[:icon] %>
          </span>
          <p id="exercise_context" class="min-w-0 text-sm text-mute"><%= course.name %></p>
        </div>
        <h1 id="exercise_title" class="mt-4 font-display text-3xl font-medium tracking-tight text-balance"><%= exercise.title %></h1>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <%= ui_badge course.material_name %>
          <%= ui_badge [ course.level_name, course.series_name ].compact.join(" ") %>
          <%= ui_badge t(".exercise_types.#{exercise.exercise_type}") %>
          <%= ui_badge t(".questions", count: @detail.questions.size) %>
        </div>
        <% if exercise.description.present? %>
          <p id="exercise_description" class="mt-4 max-w-prose whitespace-pre-line text-ink"><%= exercise.description %></p>
        <% end %>
      </section>
      <%= render "student_progress", progress: @progress, exercise: %>
    </div>
    <%= render "questions_preview", questions: @detail.questions, reveal: @reveal, student: %>
  </div>
<% else %>
<div id="exercise_header" class="mb-8">
  <%= ui_back_link essential.name, href: course_essential_path(course.slug, essential.slug) %>
  <%= ui_card padding: :md do %>
    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0 space-y-3">
        <p id="exercise_context" class="text-sm text-mute"><%= student ? course.name : t(".context", course: course.name, essential: essential.name) %></p>
        <h1 class="font-display text-2xl font-medium tracking-tight text-balance sm:text-3xl"><%= exercise.title %></h1>
        <div class="flex flex-wrap items-center gap-2">
          <%= ui_subject_badge course.material_name, category: course.material_category %>
          <%= ui_badge [ course.level_name, course.series_name ].compact.join(" ") %>
          <%= ui_badge t(".exercise_types.#{exercise.exercise_type}"), tone: :brand %>
          <%= ui_badge t(".questions", count: @detail.questions.size), icon: "question-mark-circle" %>
        </div>
      </div>
      <% if @status_record %>
        <div class="flex flex-wrap items-center gap-2 lg:shrink-0 lg:justify-end">
          <%= content_status_panel(record: @status_record) %>
          <%= ui_dropdown label: t(".actions", name: exercise.title), id: "exercise-actions-menu", fixed: true do %>
            <%= ui_dropdown_item t(".edit"), href: edit_teams_exercise_path(exercise.public_id), icon: "pencil-square", frame: "modal" %>
            <%= content_transition_items(record: @status_record) %>
          <% end %>
        </div>
      <% end %>
    </div>
    <% if exercise.description.present? %>
      <p id="exercise_description" class="mt-5 max-w-prose whitespace-pre-line text-ink"><%= exercise.description %></p>
    <% end %>
  <% end %>
</div>

<div class="space-y-10">
  <% if @targets %>
    <%= ui_card title: t(".assign_title"), icon: "user-group", id: "exercise_assign" do %>
      <% if @targets.classrooms.any? %>
        <%# UDR-0077 §3.3 : la ligne compacte de la fiche, une par classe. %>
        <ul class="-mx-1 divide-y divide-line rounded-ln border border-line" aria-label="<%= t(".assign_targets", title: exercise.title) %>">
          <% @targets.classrooms.each do |target| %>
            <% state = @targets.states[[ target.public_id, exercise.public_id ]] %>
            <li>
              <%= render "classroom/assignments/toggle", classroom_public_id: target.public_id, assignable_type: "Exercise",
                         assignable_key: exercise.public_id, assignable_name: exercise.title, classroom_name: target.name,
                         assignment_public_id: state&.assignment_public_id, due_on: state&.due_on,
                         needs_session_days: target.needs_session_days, compact: true %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p id="exercise_assign_none" class="text-sm text-mute"><%= t(".assign_none", level: @targets.scope_label) %></p>
      <% end %>
    <% end %>
  <% end %>
  <% if @progress %>
    <%= render "student_progress", progress: @progress, exercise: %>
  <% end %>
  <%= render "questions_preview", questions: @detail.questions, reveal: @reveal, student: %>
</div>
<% end %>
