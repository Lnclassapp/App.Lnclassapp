<%# 🌐 UI · assessment/exercises/show — le sujet d'un exercice : la feuille telle qu'on la distribuerait en classe (AS-02) %>
<%# Rôle : énoncé et questions numérotées, rien à remplir ; « Faire l'exercice » pour l'élève, bascules d'assignation pour l'enseignant, statut et transitions pour l'équipe (plus de « Modifier » : l'exercice se réimporte, ADR-0113 §4.6) %>
<%# ADR  : 0028, 0054, 0072, 0091 §4.4, 0112, 0113, 0115 · UDR : 0006, 0007, 0021, 0069, 0138 §3.1, XXXX-exercices-et-questions-en-cartes (§3.3 : une carte par question) · aucun cache : le HTML dépend du rôle (sécurité n° 29) · Stimulus : math %>
<% exercise = @detail.exercise %>
<% essential = @detail.essential %>
<% course = @detail.course %>
<% student = @progress.present? %>
<% grading = Entities::Assessment::Grading %>
<% page_title t(".page_title", title: exercise.title) %>
<% content_for :nav_key, "courses" %>
<%# ADR-0113 §4.3 : ouvrir la leçon retient la lecture des notions ; un lien préchargé ne la retiendrait pas. %>
<div data-turbo-prefetch="false"><%= ui_back_link course.name, href: course_path(course.slug, anchor: (essential ? "notion-#{essential.slug}" : "toute-la-lecon")) %></div>
<%# UDR-0138 §3.1 : une colonne de 720 px dès 700 px ; au téléphone, la gouttière du shell. %>
<div class="mx-auto w-full max-w-180 space-y-6">
  <header id="exercise_header" class="space-y-3">
    <p id="exercise_context" class="text-sm text-mute"><%= essential ? essential.name : t(".lesson_wide") %></p>
    <h1 class="font-display text-2xl font-medium tracking-tight text-balance"><%= exercise.title %></h1>
    <div class="flex flex-wrap items-center gap-2">
      <%= ui_badge t(".exercise_types.#{exercise.exercise_type}"), tone: (exercise.exercise_type == "evaluation" ? :brand : :info) %>
      <%= ui_badge t(".questions", count: @detail.questions.size) %>
    </div>
    <% if @status_record %>
      <div class="flex flex-wrap items-center gap-2">
        <%= content_status_panel(record: @status_record) %>
        <%= ui_dropdown label: t(".actions", name: exercise.title), id: "exercise-actions-menu", fixed: true do %>
          <%= content_transition_items(record: @status_record) %>
        <% end %>
      </div>
    <% end %>
  </header>

  <% if @detail.questions.empty? %>
    <div id="exercise_questions_empty">
      <%= ui_empty_state title: t(".no_questions"), icon: "question-mark-circle" %>
    </div>
  <% else %>
    <%# UDR-XXXX-exercices-et-questions-en-cartes §3.3 : la feuille est une région sans cadre ; l'énoncé a sa carte, chaque question la sienne. %>
    <%= tag.div id: "exercise-sheet", role: "region", "aria-labelledby": "sheet_title", class: "space-y-4", data: { controller: "math" } do %>
      <h2 id="sheet_title" class="sr-only"><%= t(".sheet_title") %></h2>
      <% figure = @detail.figure %>
      <% if exercise.statement.present? || exercise.statement_blocks.present? || figure %>
        <%= ui_card padding: :lg, id: "exercise_statement_card" do %>
          <% if exercise.statement.present? %>
            <div id="exercise_statement" class="max-w-prose text-ink"><%= simple_format(exercise.statement) %></div>
          <% end %>
          <%# ADR-0115 : le sujet en blocs (document encadré, tableau), après le texte. %>
          <% if exercise.statement_blocks.present? %>
            <div id="exercise_statement_blocks" class="mt-4 space-y-4"><%= render "assessment/statement_blocks/blocks", blocks: exercise.statement_blocks %></div>
          <% end %>
          <%# Refonte contenus maths, CA-13 : la figure citée, juste sous le sujet ; aucun emplacement sans figure. %>
          <% if figure %>
            <div id="exercise_figure" class="mt-4"><%= render "catalog/figures/figure", figure:, frame: :app %></div>
          <% end %>
        <% end %>
      <% end %>
      <ol id="exercise_questions" class="list-none space-y-4">
        <% @detail.questions.each_with_index do |question, index| %>
          <% number = index + 1 %>
          <% blank = Entities::Assessment::QuestionKinds::FillBlank::MARKER %>
          <li id="sheet-question-<%= number %>" class="question rounded-card border border-line bg-white p-4 shadow-card sm:p-6">
            <div class="mb-3 flex items-center gap-2">
              <span class="grid size-8 place-items-center rounded-full bg-brand-soft text-sm font-medium text-brand-strong tabular-nums" aria-hidden="true"><%= number %></span>
              <span id="sheet-question-<%= number %>-format" class="text-meta text-mute"><%= t(".question_formats.#{question.question_type}") %></span>
            </div>
            <p class="font-medium whitespace-pre-line text-ink">
              <span class="sr-only"><%= t(".question_number", number:) %></span>
              <%= %w[fill_blank select].include?(question.kind_name) ? question.content.sub(blank, "……………") : question.content %>
            </p>
            <% if (image = question.image) %>
              <%= tag.img src: question_image_path(image.public_id), alt: image.alt.to_s, width: image.width, height: image.height,
                          loading: "lazy", decoding: "async", class: "mt-3 h-auto max-h-72 w-full rounded-ln bg-mist object-contain" %>
            <% end %>
            <div class="mt-3">
              <%= render "assessment/exercises/sheet_kinds/#{question.kind_name}", question:, reveal: @reveal %>
            </div>
            <% if @reveal %>
              <%# ADR-0091 §4.4 : l'élève ne reçoit aucune solution ; l'enseignant et l'équipe la voient sous la question. %>
              <% if %w[choice select written notebook].exclude?(question.kind_name) %>
                <div class="mt-3" data-correct><%= render "assessment/exercises/solution", question: %></div>
              <% end %>
              <% if question.explanation.present? %>
                <div class="mt-3 flex gap-2 rounded-ln bg-info-soft px-3 py-2 text-sm text-ink">
                  <%= ui_icon "light-bulb", variant: :mini, class: "mt-0.5 text-info" %>
                  <p class="min-w-0 flex-1 whitespace-pre-line"><%= question.explanation %></p>
                </div>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
  <% end %>

  <% if student && @detail.questions.any? %>
    <%# Collé en bas au téléphone ; une seule action principale (UDR-0138 §3.1). %>
    <footer id="exercise_actions" class="sticky bottom-0 z-10 -mx-gutter space-y-3 bg-paper px-gutter pt-4 pb-safe-action min-[700px]:mx-0 min-[700px]:px-0">
      <% if @progress.started_session_public_id %>
        <%= ui_button t(".resume"), href: exercise_session_path(@progress.started_session_public_id), variant: :brand, size: :lg,
                      full: true, icon_end: "arrow-right" %>
        <% unless @resume_at %>
          <%= form_with url: exercise_sessions_path(exercise.public_id), method: :post, id: "restart-exercise-form" do %>
            <%= hidden_field_tag :restart, true, id: nil %>
            <%= ui_button t(".restart"), type: :submit, variant: :secondary, size: :lg, full: true %>
          <% end %>
        <% end %>
      <% else %>
        <% unless @resume_at %>
          <%= form_with url: exercise_sessions_path(exercise.public_id), method: :post, id: "start-exercise-form" do %>
            <% if @progress.completed_count.positive? %>
              <%= ui_button t(".redo"), type: :submit, variant: :brand, size: :lg, full: true, icon: "arrow-path" %>
            <% else %>
              <%= ui_button t(".start"), type: :submit, variant: :brand, size: :lg, full: true, icon_end: "arrow-right" %>
            <% end %>
          <% end %>
        <% end %>
        <% if @progress.best_score_percent %>
          <p id="exercise_best" class="text-center text-sm <%= grading.reaches?(@progress.best_score_percent, grading::MASTERY_THRESHOLD) ? "text-success" : "text-mute" %>">
            <%= t(".best", grade: grading.grade_on_20(@progress.best_score_percent)) %>
          </p>
        <% end %>
      <% end %>
      <%# ADR-0115 : la pause dit l'heure de reprise, sans bouton qu'on ne peut pas presser. %>
      <% if @resume_at %>
        <p id="exercise_paused" class="text-center text-sm text-mute"><%= t(".paused", time: l(@resume_at, format: :hour_minute)) %></p>
      <% end %>
    </footer>
  <% end %>

  <% if @targets %>
    <%= ui_card title: t(".assign_title"), icon: "user-group", id: "exercise_assign" do %>
      <% if @targets.classrooms.any? %>
        <%# UDR-0077 §3.3 : la ligne compacte de la fiche, une par classe. %>
        <ul class="-mx-1 divide-y divide-line rounded-ln border border-line" aria-label="<%= t(".assign_targets", title: exercise.title) %>">
          <% @targets.classrooms.each do |target| %>
            <% state = @targets.states[[ target.public_id, exercise.public_id ]] %>
            <li>
              <%= render "classroom/assignments/toggle", classroom_public_id: target.public_id, assignable_type: "Exercise",
                         assignable_key: exercise.public_id, assignable_name: exercise.title, classroom_name: target.name,
                         assignment_public_id: state&.assignment_public_id, due_on: state&.due_on,
                         needs_session_days: target.needs_session_days, compact: true %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p id="exercise_assign_none" class="text-sm text-mute"><%= t(".assign_none", level: @targets.scope_label) %></p>
      <% end %>
    <% end %>
  <% end %>
</div>
