<%# 🌐 UI · assessment/exercises/_card — la carte d'un exercice listé : de quoi s'agit-il, où j'en suis, que faire %>
<%# Rôle : un <li> par exercice (pastille de la matière, « Matière · Type », titre, état, verbe) ; toute la carte est le lien du titre ; `extra` (HTML déjà rendu, facultatif) passe sous la carte, au-dessus du lien étiré %>
<%# ADR  : 0072, 0113 · UDR : XXXX-exercices-et-questions-en-cartes (§3.1) · locals: (card:, index: nil, extra: nil) · se nourrit d'une Assessment::ExerciseCardsHelper::Card %>
<% index = local_assigns[:index] %>
<% extra = local_assigns[:extra] %>
<% reveal = index ? ui_reveal_item(index) : {} %>
<% attrs = reveal.merge(data: (reveal[:data] || {}).merge(bleed_keep: "")) %>
<% illustration = (subject_illustration(card.material_slug) if card.material_slug) %>
<% context = safe_join([ card.material_name, card.type_label ].compact_blank, t("assessment.exercises.card.separator")) %>
<%= tag.li id: card.dom_id, class: "min-w-0 #{"scroll-mt-24" if card.dom_id}", **attrs do %>
  <article class="<%= class_names("group relative flex h-full flex-col gap-3 rounded-card border border-line bg-white p-4 shadow-card",
                                  "transition hover:border-brand/40 hover:shadow-lift has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-brand" => card.href) %>">
    <div class="flex items-start gap-3">
      <% if illustration %>
        <span class="<%= class_names("grid size-11 shrink-0 place-items-center rounded-full", illustration.tint) %>" aria-hidden="true">
          <%= image_tag illustration.path, alt: "", class: "size-7", loading: "lazy" %>
        </span>
      <% end %>
      <div class="min-w-0 flex-1 space-y-1">
        <% if context.present? %>
          <p class="text-meta text-mute"><%= context %></p>
        <% end %>
        <h3 class="line-clamp-2 text-[15px] leading-snug font-medium break-words text-ink">
          <% if card.href %>
            <%= link_to card.title, card.href, class: "after:absolute after:inset-0 after:rounded-card focus-visible:outline-none" %>
          <% else %>
            <%= card.title %>
          <% end %>
        </h3>
        <% if card.meta %>
          <p class="text-meta text-mute"><%= card.meta %></p>
        <% end %>
      </div>
    </div>
    <% if card.progress %>
      <% done, total = card.progress %>
      <div class="flex items-center gap-3">
        <div class="min-w-0 flex-1">
          <%= ui_progress done:, total:, role: :teacher, label: t("assessment.comprehension.progress.label") %>
        </div>
        <span class="shrink-0 text-sm text-ink tabular-nums"><%= t("assessment.comprehension.progress.done", count: done, total:) %></span>
      </div>
    <% end %>
    <div class="mt-auto flex min-h-8 flex-wrap items-center justify-between gap-x-3 gap-y-2 border-t border-line pt-3">
      <div class="min-w-0"><%= card.status %></div>
      <% if card.action && card.href %>
        <span class="inline-flex shrink-0 items-center gap-1 text-sm font-medium text-brand-strong" aria-hidden="true">
          <%= card.action %>
          <%= ui_icon "arrow-right", variant: :mini, size: :sm, class: "transition group-hover:translate-x-0.5" %>
        </span>
      <% end %>
    </div>
    <% if extra.present? %>
      <div class="relative z-10"><%= extra %></div>
    <% end %>
  </article>
<% end %>
