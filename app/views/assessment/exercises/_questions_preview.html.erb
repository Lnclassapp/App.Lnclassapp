<%# 🌐 UI · assessment/exercises/_questions_preview — aperçu des questions d'un exercice (AS-39) %>
<%# Rôle : énoncés et type ; propositions d'un choix ; correction seulement si reveal (les nouveaux types : leur solution) ; pour l'élève, une carte, 3 questions puis « Voir plus » %>
<%# ADR  : 0028, 0054, 0091 §4.4 · UDR : 0007, 0021, 0057, 0087 §3.1 · aucun `cache` ici : sa clé ignorerait le rôle (sécurité n° 29) · Stimulus : math, reveal %>
<%= tag.section id: "exercise_questions", "aria-labelledby": "exercise_questions_title",
                class: ("rounded-card border border-line bg-white p-5 shadow-card sm:p-6" if student),
                data: (ui_reveal_data(step: 3) if student) do %>
  <div class="mb-4">
    <h2 id="exercise_questions_title" class="font-display text-xl font-medium">
      <%= t(".title") %><% if student %><%= ui_info_tip t(".student_hint"), label: t(".title") %><% end %>
    </h2>
    <% unless student %>
      <p class="mt-1 text-sm text-mute"><%= reveal ? t(".reveal_hint") : t(".student_hint") %></p>
    <% end %>
  </div>
  <% if questions.empty? %>
    <div id="exercise_questions_empty">
      <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "question-mark-circle" %>
    </div>
  <% else %>
    <ol class="<%= student ? "divide-y divide-line" : "space-y-4" %>" data-controller="math">
      <% questions.each_with_index do |question, index| %>
        <li class="question <%= student ? "py-4 first:pt-0" : "rounded-card border border-line bg-white p-4 shadow-card sm:p-5" %>"
            <%= tag.attributes(ui_reveal_item(index)) if student %>>
          <div class="flex gap-3">
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand-soft text-sm font-medium text-brand-strong tabular-nums"
                  aria-hidden="true"><%= question.position %></span>
            <div class="min-w-0 flex-1">
              <p class="sr-only"><%= t(".question", position: question.position) %></p>
              <p class="font-medium whitespace-pre-line text-ink"><%= question.content %></p>
              <p class="mt-2"><%= ui_badge t(".question_types.#{question.question_type}"), size: :sm %></p>
              <% if question.kind_name == "choice" %>
                <ul class="mt-3 space-y-1.5" aria-label="<%= t(".answers") %>">
                  <% question.answers.each_with_index do |answer, index| %>
                    <% if reveal && answer.correct %>
                      <li id="answer_<%= answer.id %>" class="answer flex items-start gap-3 rounded-ln bg-success-soft px-3 py-2" data-correct>
                        <%= ui_icon "check-circle", variant: :mini, class: "mt-0.5 text-success" %>
                        <span class="min-w-0 flex-1 font-medium text-ink"><%= answer.content %></span>
                        <%= ui_badge t(".correct"), tone: :success, size: :sm %>
                      </li>
                    <% else %>
                      <li <%= tag.attributes(id: ("answer_#{answer.id}" if reveal)) %> class="answer flex items-start gap-2 text-sm <%= reveal ? "rounded-ln bg-mist px-3 py-2 text-mute" : "text-ink" %>">
                        <span class="shrink-0 font-medium" aria-hidden="true"><%= ("A".ord + index).chr %>.</span>
                        <span class="min-w-0 flex-1"><%= answer.content %></span>
                      </li>
                    <% end %>
                  <% end %>
                </ul>
              <% elsif reveal %>
                <%# ADR-0091 §4.4 : l'élève ne reçoit aucun élément de ces types ; l'enseignant et l'équipe voient leur solution. %>
                <div class="mt-3" data-correct>
                  <%= render "assessment/exercises/solution", question: %>
                </div>
              <% end %>
              <% if reveal && question.explanation.present? %>
                <div class="mt-4 flex gap-2 rounded-ln bg-info-soft px-3 py-2 text-sm text-ink">
                  <%= ui_icon "light-bulb", variant: :mini, class: "mt-0.5 text-info" %>
                  <p class="min-w-0 flex-1 whitespace-pre-line"><strong class="font-medium"><%= t(".explanation") %></strong> <%= question.explanation %></p>
                </div>
              <% end %>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
    <% if student && questions.size > ComponentsHelper::REVEAL_LIMIT %>
      <div class="mt-2"><%= ui_reveal_more questions.size %></div>
    <% end %>
  <% end %>
<% end %>
