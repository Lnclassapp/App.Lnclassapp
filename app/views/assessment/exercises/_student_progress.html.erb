<%# 🌐 UI · assessment/exercises/_student_progress — « Ta progression » de l'élève sur l'exercice, et son action %>
<%# Rôle : meilleure note (verte dès 14/20), maîtrise, badge, sessions ; « Commencer l'exercice », « Refaire l'exercice », ou « Reprendre à la question N » et « Recommencer » %>
<%# ADR  : 0033, 0054 · UDR : 0007, 0015, 0021, 0054, 0057, 0087 §3.1 · quatre cases par deux au téléphone, sur une ligne dès 700 px %>
<% tile = "rounded-ln bg-mist px-3 py-3" %>
<%# Le libellé seul en capitales : l'infobulle qui le suit garde sa casse. %>
<% label = "text-2xs font-bold tracking-wide text-mute uppercase" %>
<section id="student_progress" aria-labelledby="student_progress_title"
         class="rounded-card border border-line bg-white p-5 shadow-card sm:p-6">
  <h2 id="student_progress_title" class="font-display text-xl font-extrabold"><%= t(".title") %></h2>
  <dl class="mt-4 grid grid-cols-2 gap-3 min-[700px]:grid-cols-4">
    <div class="<%= tile %>">
      <dt class="flex items-center gap-1"><span class="<%= label %>"><%= t(".best_score") %></span></dt>
      <dd class="mt-1 font-display text-xl font-extrabold tabular-nums">
        <% if progress.best_score_percent %>
          <% grading = Entities::Assessment::Grading %>
          <span class="<%= "text-success" if grading.grade_on_20(progress.best_score_percent) >= grading.grade_on_20(grading::MASTERY_THRESHOLD) %>"><%= grade_label(progress.best_score_percent) %></span>
        <% else %>
          <span class="text-mute"><%= t(".no_score") %></span>
        <% end %>
      </dd>
    </div>
    <div class="<%= tile %>">
      <dt class="flex items-center gap-1"><span class="<%= label %>"><%= t(".mastery") %></span><%= stat_info_tip t("shared.info_tips.mastery"), label: t(".mastery") %></dt>
      <dd class="mt-1">
        <% if progress.mastery %>
          <%= ui_badge t("assessment.badges.mastery.#{progress.mastery}"),
                       tone: { acquired: :success, fragile: :gold, struggling: :neutral }.fetch(progress.mastery), size: :sm %>
        <% else %>
          <span class="font-medium text-mute"><%= t(".no_mastery") %></span>
        <% end %>
      </dd>
    </div>
    <div class="<%= tile %>">
      <dt class="flex items-center gap-1"><span class="<%= label %>"><%= t(".badge") %></span><%= stat_info_tip t("shared.info_tips.badges"), label: t(".badge") %></dt>
      <dd class="mt-1 text-sm font-bold">
        <% if progress.badge_level %>
          <span class="inline-flex items-center gap-1.5">
            <%= ui_icon "trophy", variant: :solid, size: :sm, class: "text-gold" %><%= t(".badge_level", level: badge_label(progress.badge_level)) %>
          </span>
        <% else %>
          <span class="font-medium text-mute"><%= t(".no_badge") %></span>
        <% end %>
      </dd>
    </div>
    <div class="<%= tile %>">
      <dt class="flex items-center gap-1"><span class="<%= label %>"><%= t(".sessions") %></span></dt>
      <dd class="mt-1 text-sm font-bold tabular-nums"><%= t(".completed", count: progress.completed_count) %></dd>
    </div>
  </dl>
  <div class="mt-5 space-y-3">
    <% if progress.started_session_public_id %>
      <%= ui_button t(".resume_at", number: progress.resume_number), href: exercise_session_path(progress.started_session_public_id),
                    variant: :brand, size: :lg, full: true, icon_end: "arrow-right" %>
      <%= form_with url: exercise_sessions_path(exercise.public_id), method: :post, id: "restart-exercise-form" do %>
        <%= hidden_field_tag :restart, true, id: nil %>
        <%= ui_button t(".restart"), type: :submit, variant: :secondary, size: :lg, full: true, "aria-describedby": "restart-note" %>
      <% end %>
      <p id="restart-note" class="text-center text-xs text-mute"><%= t(".restart_note") %></p>
    <% else %>
      <%= form_with url: exercise_sessions_path(exercise.public_id), method: :post, id: "start-exercise-form" do %>
        <%# UDR-0015, amendement du 2026-10-06 : un exercice déjà terminé se « Refait ». %>
        <% if progress.completed_count.positive? %>
          <%= ui_button t(".redo"), type: :submit, variant: :brand, size: :lg, full: true, icon: "arrow-path" %>
        <% else %>
          <%= ui_button t(".start"), type: :submit, variant: :brand, size: :lg, full: true, icon_end: "arrow-right" %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
