<%# 🌐 UI · assessment/exercise_sessions/show — la copie de l'élève : le sujet, toutes les questions, « Vérifier ma copie » %>
<%# Rôle : sujet repliable, compteur « n/T répondues », une carte par question (fieldset), bouton collé en bas, confirmation des questions vides ; 422 : résumé et message par question %>
<%# ADR  : 0054, 0091 §4.4 (aucune correction, aucun id révélateur), 0105, 0112, 0115, 0120-questions-a-plusieurs-cases-et-indice §4 · UDR : 0007, 0087 §3.4, 0129, 0138 §3.2, §3.3, §3.7, 0140, 0146-je-m-entraine-dans-la-fiche §3.8 · Stimulus : math, assessment--copy, modal %>
<%# Sans JavaScript : le formulaire part tel quel, sans confirmation ni brouillon ; les questions vides comptent fausses. %>
<% play = @play %>
<% posted = @posted || {} %>
<% errors = @copy_errors || {} %>
<%# UDR-0140 §3 : les points suivent chaque légende, sauf si toutes les questions valent 1 point. %>
<% weighted = play.questions.any? { it.points != 1 } %>
<%# Une réponse rédigée ou du cahier ne se compte pas parmi les questions « répondues » : une copie sans elles part sans demande de confirmation. %>
<% counted = play.questions.count(&:counted?) %>
<%# UDR-0146 §3.8 : le texte d'un indice n'est dans la page que si son ouverture est enregistrée (hinted_question_ids). %>
<% hinted = play.hinted_question_ids %>
<% closed_hints = play.questions.select { it.hint? && hinted.exclude?(it.id) } %>
<% page_title t(".page_title", title: play.exercise_title) %>
<% content_for :nav_key, "courses" %>
<%= ui_back_link play.exercise_title, href: exercise_path(play.exercise_public_id) %>
<div class="mx-auto w-full max-w-180"
     data-controller="assessment--copy" data-assessment--copy-key-value="lnclass:copy:<%= play.session_public_id %>"
     data-assessment--copy-total-value="<%= counted %>"
     data-assessment--copy-counter-value="<%= t(".counter", answered: "%{answered}", total: "%{total}") %>"
     data-assessment--copy-missing-one-value="<%= t(".missing", count: 1) %>"
     data-assessment--copy-missing-other-value="<%= t(".missing", count: 2).sub("2", "%{count}") %>">
  <div class="sticky top-0 z-10 flex items-center justify-between gap-3 bg-paper py-3">
    <p id="copy-counter" class="text-sm font-medium text-ink tabular-nums" aria-live="polite" data-assessment--copy-target="counter"><%= t(".counter", answered: 0, total: counted) %></p>
    <a href="#copy-statement" class="inline-flex min-h-tap items-center gap-1.5 text-sm font-medium text-brand underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-brand">
      <%= ui_icon "document-text", variant: :mini, size: :sm %><%= t(".review_statement") %>
    </a>
  </div>

  <% if play.questions.any?(&:hint?) %>
    <p class="mb-4 text-sm text-mute"><%= t(".hint_notice") %></p>
  <% end %>

  <%= tag.details id: "copy-statement", open: true, class: "mb-6 rounded-card border border-line bg-white p-5 shadow-card", data: { controller: "math" } do %>
    <summary class="min-h-tap cursor-pointer font-display text-lg font-medium"><%= t(".statement") %></summary>
    <div class="mt-3 max-w-prose text-ink"><%= simple_format(play.statement) %></div>
    <%# ADR-0115 : le sujet en blocs (document encadré, tableau), après le texte. %>
    <% if play.statement_blocks.present? %>
      <div id="copy-statement-blocks" class="mt-4 space-y-4"><%= render "assessment/statement_blocks/blocks", blocks: play.statement_blocks %></div>
    <% end %>
    <%# Refonte contenus maths, CA-13 : la figure citée, juste sous le sujet ; aucun emplacement sans figure. %>
    <% if (figure = play.figure) %>
      <div id="copy-statement-figure" class="mt-4"><%= render "catalog/figures/figure", figure:, frame: :app %></div>
    <% end %>
  <% end %>

  <%= form_with url: exercise_session_copy_path(play.session_public_id), scope: :copy, method: :post, id: "copy-form",
                data: { action: "submit->assessment--copy#submit input->assessment--copy#save change->assessment--copy#save turbo:submit-end->assessment--copy#done" } do |form| %>
    <% if errors.any? %>
      <div id="copy-errors" role="alert" tabindex="-1" data-assessment--copy-target="errors"
           class="mb-6 rounded-card bg-warning-soft px-4 py-3 text-sm font-medium text-warning">
        <ul class="space-y-1">
          <% errors.each do |number, messages| %>
            <li>
              <% if number == :base %>
                <%= messages.to_sentence %>
              <% else %>
                <a href="#question-<%= number %>" class="underline"><%= t(".question", number:) %> : <%= messages.to_sentence %></a>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <ol class="list-none space-y-6">
      <% play.questions.each do |question| %>
        <% number = question.number %>
        <% problem = errors[number] %>
        <%# L'énoncé d'un texte à trous, ou d'une liste dont le trou est dans la phrase, est la phrase, qui porte le champ : la légende en est la consigne (UDR-0087 §3.4, 0140 §3). %>
        <%# Une question chiffrée à plusieurs cases est de même une phrase à champs (UDR fiche §3.8) : la phrase remplace l'énoncé, la légende est la consigne. %>
        <% legend = if question.kind_name == "fill_blank" || (question.kind_name == "numeric" && question.multi_blank?) then t("assessment.exercise_sessions.kinds.fill_blank.legend")
                    elsif question.kind_name == "select" && question.content.include?(Entities::Assessment::QuestionKinds::FillBlank::MARKER) then t("assessment.exercise_sessions.kinds.select.legend")
                    else question.content end %>
        <li id="question-<%= number %>">
          <%= ui_card data: { assessment__copy_target: ("question" if question.counted?), controller: "math" }.compact do %>
            <%= fields_for "copy[answers][#{question.id}]" do |f| %>
              <%# UDR-0105 : l'image se lit au-dessus de l'énoncé. %>
              <% if (image = question.image) %>
                <%= tag.img src: question_image_path(image.public_id), alt: image.alt.to_s, width: image.width, height: image.height,
                            loading: "lazy", decoding: "async", class: "mb-4 h-auto max-h-72 w-full rounded-ln bg-mist object-contain" %>
              <% end %>
              <fieldset class="min-w-0 space-y-4" <%= tag.attributes("aria-invalid": ("true" if problem), "aria-describedby": ("question-#{number}-error" if problem)) %>>
                <legend class="mb-2">
                  <span class="block text-xs font-medium tracking-wide text-mute uppercase"><%= t(".question", number:) %></span>
                  <%# L'énoncé d'un texte à trous est la phrase, qui porte le champ : la légende en est la consigne (UDR-0087 §3.4). %>
                  <span class="mt-1 block font-display text-xl font-medium text-balance whitespace-pre-line text-ink"><%= legend %><% if weighted %> <span class="font-body text-base font-normal text-mute"><%= t(".points", count: question.points, points: number_with_precision(question.points, precision: 1, strip_insignificant_zeros: true)) %></span><% end %></span>
                </legend>
                <%= render "assessment/exercise_sessions/kinds/#{question.kind_name}", f:, question:, number:,
                           values: (posted[question.id.to_s] || {}).with_indifferent_access %>
              </fieldset>
            <% end %>
            <% if question.hint? %>
              <div class="mt-4">
                <% if hinted.include?(question.id) %>
                  <%= render "assessment/hints/hint", question_id: question.id, hint: question.hint %>
                <% else %>
                  <%# Le formulaire est hors de la copie (un formulaire ne s'imbrique pas) : le bouton le désigne par form=. %>
                  <%= turbo_frame_tag "hint_#{question.id}" do %>
                    <%= ui_button t(".hint_button"), type: :submit, variant: :ghost, size: :sm, icon: "light-bulb", form: "hint-form-#{question.id}" %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
            <% if problem %>
              <p id="question-<%= number %>-error" class="mt-3 flex items-start gap-2 text-sm font-medium text-warning">
                <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %><%= problem.to_sentence %>
              </p>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ol>

    <%# Collé en bas, au-dessus de la zone sûre (UDR-0087 §3.2). %>
    <div class="sticky bottom-0 z-10 -mx-gutter mt-6 bg-paper px-gutter pt-4 pb-safe-action min-[700px]:mx-0 min-[700px]:px-0">
      <p class="mb-3 text-sm text-mute"><%= t(".lock_warning") %></p>
      <%= ui_button t(".submit"), type: :submit, variant: :brand, size: :lg, full: true, data: { turbo_submits_with: t(".submitting") } %>
    </div>

    <%= ui_modal id: "copy-confirm", title: t(".confirm_title"), size: :sm, placement: :phone_sheet, described_by: "copy-missing" do |modal| %>
      <p id="copy-missing" class="text-ink" data-assessment--copy-target="missing"></p>
      <% modal.footer do %>
        <%= ui_button t(".confirm"), type: :submit, variant: :brand, class: "w-full sm:w-auto", form: "copy-form",
                                     data: { action: "assessment--copy#confirm" } %>
        <%= ui_button t(".keep_going"), variant: :secondary, class: "w-full sm:w-auto", data: { action: "modal#close" } %>
      <% end %>
    <% end %>

    <template data-assessment--copy-target="offline"><%= ui_toast t(".offline"), type: :error %></template>
  <% end %>

  <%# Un formulaire par indice encore fermé, hors du formulaire de la copie : le POST ne rend ni ne modifie la copie. %>
  <% closed_hints.each do |question| %>
    <%= form_with url: exercise_session_hints_path(play.session_public_id), method: :post, id: "hint-form-#{question.id}" do %>
      <%= hidden_field_tag :question_id, question.id, id: nil %>
    <% end %>
  <% end %>
</div>
