<%# 🌐 UI · assessment/exercise_sessions/_feedback_card — verdict de la question qui vient d'être tentée %>
<%# Rôle : verdict, « Ton choix » par type (kinds/_<type>_feedback), explication ; la question suivante jointe, affichée sans requête %>
<%# ADR  : 0028, 0054, 0076, 0091 §4.4 · UDR : 0007, 0022, 0057, 0076 §3.3, 0087 §3.5 · Stimulus : math, assessment--next-question, assessment--verdict %>
<%# locals: (play:, feedback:, next_question: nil) -%>
<% tone = feedback.correct ? :success : :error %>
<%= turbo_frame_tag "question", class: "flex flex-1 flex-col" do %>
  <%= tag.div id: "feedback-card", class: "flex flex-1 flex-col",
              data: { controller: [ "assessment--verdict", ("assessment--next-question" if next_question) ].compact.join(" ") } do %>
    <%# UDR-0087 §3.5 : vert pour une bonne réponse ; une mauvaise reste neutre, avec la croix en orange, jamais le rouge. %>
    <div role="status" aria-live="polite"
         class="flex items-center gap-4 rounded-card px-4 py-4 <%= feedback.correct ? "bg-success-soft" : "border border-line bg-white" %>">
      <span class="grid size-12 shrink-0 place-items-center rounded-full <%= feedback.correct ? "bg-success text-white" : "bg-warning-soft text-warning" %>">
        <%= ui_icon feedback.correct ? "check" : "x-mark", size: :lg %>
      </span>
      <div class="min-w-0">
        <h2 tabindex="-1" data-assessment--verdict-target="title" class="font-display text-xl font-medium text-ink focus:outline-none"><%= t(".verdict.#{tone}") %></h2>
        <p class="text-sm text-ink"><%= t(".encouragement.#{tone}") %></p>
      </div>
    </div>
    <div class="mt-5 space-y-5" data-controller="math">
      <div class="space-y-1">
        <p class="text-xs font-medium tracking-wide text-mute uppercase"><%= t(".number", number: feedback.number, total: play.question_count) %></p>
        <p class="font-display text-lg font-medium whitespace-pre-line text-ink"><%= feedback.content %></p>
      </div>
      <div class="space-y-2">
        <p id="feedback-selected" class="text-xs font-medium tracking-wide text-mute uppercase"><%= t(".selected") %></p>
        <%= render "assessment/exercise_sessions/kinds/#{feedback.kind_name}_feedback", feedback: %>
      </div>
      <% if feedback.explanation %>
        <div class="rounded-card bg-info-soft px-4 py-3">
          <p class="flex items-center gap-1.5 text-sm font-medium text-info">
            <%= ui_icon "light-bulb", size: :sm %><%= t(".explanation") %>
          </p>
          <p class="mt-1 text-sm whitespace-pre-line text-ink"><%= feedback.explanation %></p>
        </div>
      <% end %>
    </div>
    <%# UDR-0087 §3.2 : l'action colle au bas de l'écran, comme « Valider ». %>
    <div id="feedback-actions"
         class="sticky bottom-0 z-10 -mx-gutter mt-auto bg-paper px-gutter pt-6 pb-safe-action min-[700px]:mx-0 min-[700px]:px-0">
      <% if play.completed? %>
        <%= ui_button t(".result"), href: exercise_session_result_path(play.session_public_id), variant: :brand, size: :lg, full: true,
                                    icon_end: "arrow-right", data: { turbo_frame: "_top" } %>
      <% else %>
        <%# Repli sans JavaScript : le lien recharge la page. Pas de préchargement : la question est déjà là. %>
        <%= ui_button t(".next"), href: exercise_session_path(play.session_public_id), variant: :brand, size: :lg, full: true,
                                  icon_end: "arrow-right",
                                  data: { action: ("assessment--next-question#show" if next_question), turbo_prefetch: false,
                                          turbo_frame: "_top" } %>
      <% end %>
    </div>
    <% if next_question %>
      <%= tag.template data: { assessment__next_question_target: "question" } do %>
        <%= render "assessment/exercise_sessions/question_card", play:, question: next_question, form: nil %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
