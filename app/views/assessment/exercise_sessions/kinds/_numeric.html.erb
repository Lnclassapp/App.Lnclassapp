<%# 🌐 UI · assessment/exercise_sessions/kinds/_numeric — réponse en nombre : un grand champ et le bouton « ± » %>
<%# Rôle : clavier décimal, virgule acceptée, « ± » pour le moins que le clavier Android n'a pas toujours ; aucune valeur attendue dans la page %>
<%# ADR  : 0091 §4.3, §4.4, 0112, 0115 (unité), 0120-questions-a-plusieurs-cases-et-indice §4 · UDR : 0087 §3.4, §3.10, 0138 §3.2, 0140 §3 (l'unité suit le champ), 0146-je-m-entraine-dans-la-fiche §3.3, §3.8 (plusieurs cases : un champ par `___`) · Stimulus : assessment--numeric, une instance par question (sans JavaScript, un champ simple ; le serveur lit la saisie) %>
<%# locals: (f:, question:, number:, values: {}) -%>
<% scope = "assessment.exercise_sessions.kinds.numeric" %>
<% if question.multi_blank? %>
  <% typed = values[:blanks].is_a?(Hash) ? values[:blanks] : {} %>
  <%# Plusieurs cases : la phrase, un champ à la place de chaque `___`, l'unité de la question après chacun ; elles passent à la ligne à 390 px. %>
  <div class="flex flex-wrap items-center gap-x-2 gap-y-3 text-lg leading-loose text-ink">
    <% blank_segments(question.content).each do |kind, part| %>
      <% if kind == :text %>
        <span class="whitespace-pre-line"><%= part %></span>
      <% else %>
        <span class="inline-flex max-w-full items-center gap-2">
          <%= text_field_tag "#{f.object_name}[blanks][#{part}]", typed[part.to_s], id: "q#{number}-blank-#{part}", inputmode: "decimal", autocomplete: "off",
                             spellcheck: false, maxlength: Dtos::Assessment::AttemptInput::RESPONSE_TEXT_MAX,
                             "aria-label": (question.unit.present? ? t("assessment.exercise_sessions.show.blank_label_unit", index: part + 1, number:, unit: question.unit) : t("assessment.exercise_sessions.show.blank_label", index: part + 1, number:)),
                             class: "h-12 min-w-24 max-w-full rounded-ln border-2 border-line bg-white px-3 font-display text-xl text-ink tabular-nums focus:border-brand-strong focus:outline-none" %>
          <% if question.unit.present? %><span class="font-display text-lg font-medium text-ink"><%= question.unit %></span><% end %>
        </span>
      <% end %>
    <% end %>
  </div>
<% else %>
<div class="space-y-2" data-controller="assessment--numeric" data-assessment--numeric-invalid-value="<%= t("#{scope}.invalid") %>">
  <%= f.label :response_text, t("#{scope}.label"), for: "q#{number}-response_text", class: "block text-xs font-medium tracking-wide text-mute uppercase" %>
  <div class="flex items-stretch gap-3">
    <button type="button" data-action="assessment--numeric#toggleSign" aria-label="<%= t("#{scope}.sign") %>"
            class="grid size-16 shrink-0 cursor-pointer place-items-center rounded-ln border-2 border-line bg-white font-display text-2xl font-medium text-ink hover:bg-mist focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">±</button>
    <%= f.text_field :response_text, value: values[:response_text], id: "q#{number}-response_text", inputmode: "decimal", autocomplete: "off", spellcheck: false,
                                     maxlength: Dtos::Assessment::AttemptInput::RESPONSE_TEXT_MAX, "aria-describedby": [ "q#{number}-numeric-hint", ("q#{number}-numeric-unit" if question.unit.present?) ].compact.join(" "),
                                     data: { assessment__numeric_target: "input", action: "input->assessment--numeric#validate" },
                                     class: "h-16 min-w-0 flex-1 rounded-ln border-2 border-line bg-white px-4 font-display text-3xl font-medium text-ink tabular-nums focus:border-brand-strong focus:outline-none" %>
    <% if question.unit.present? %>
      <span id="q<%= number %>-numeric-unit" class="flex shrink-0 items-center font-display text-2xl font-medium text-ink"><%= question.unit %></span>
    <% end %>
  </div>
  <p id="q<%= number %>-numeric-hint" class="text-sm text-mute"><%= t("#{scope}.hint") %></p>
</div>
<% end %>
