<%# 🌐 UI · assessment/exercise_sessions/kinds/_numeric — réponse en nombre : un grand champ et le bouton « ± » %>
<%# Rôle : clavier décimal, virgule acceptée, « ± » pour le moins que le clavier Android n'a pas toujours ; aucune valeur attendue dans la page %>
<%# ADR  : 0091 §4.3, §4.4 · UDR : 0087 §3.4, §3.10 · Stimulus : assessment--numeric (sans JavaScript, un champ simple ; le serveur lit la saisie) %>
<%# locals: (f:, question:) -%>
<% scope = "assessment.exercise_sessions.kinds.numeric" %>
<legend class="font-display text-xl font-medium text-balance whitespace-pre-line text-ink"><%= question.content %></legend>
<div class="space-y-2" data-controller="assessment--numeric" data-assessment--numeric-invalid-value="<%= t("#{scope}.invalid") %>">
  <%= f.label :response_text, t("#{scope}.label"), class: "block text-xs font-medium tracking-wide text-mute uppercase" %>
  <div class="flex items-stretch gap-3">
    <button type="button" data-action="assessment--numeric#toggleSign" aria-label="<%= t("#{scope}.sign") %>"
            class="grid size-16 shrink-0 cursor-pointer place-items-center rounded-ln border-2 border-line bg-white font-display text-2xl font-medium text-ink hover:bg-mist focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">±</button>
    <%= f.text_field :response_text, value: nil, required: true, inputmode: "decimal", autocomplete: "off", spellcheck: false,
                                     maxlength: Dtos::Assessment::AttemptInput::RESPONSE_TEXT_MAX, "aria-describedby": "numeric-hint",
                                     data: { assessment__numeric_target: "input", action: "input->assessment--numeric#validate" },
                                     class: "h-16 min-w-0 flex-1 rounded-ln border-2 border-line bg-white px-4 font-display text-3xl font-medium text-ink tabular-nums focus:border-brand-strong focus:outline-none" %>
  </div>
  <p id="numeric-hint" class="text-sm text-mute"><%= t("#{scope}.hint") %></p>
</div>
