<%# 🌐 UI · assessment/exercise_sessions/kinds/_matching — relier : toucher un élément à gauche, puis un à droite %>
<%# Rôle : la gauche dans l'ordre des positions, la droite mélangée ; une paire porte le même numéro ; aucun id dans la page %>
<%# ADR  : 0091 §4.4 (indices d'affichage) · UDR : 0087 §3.4, §3.10 · Stimulus : assessment--matching ; sans JavaScript, une liste de choix par élément %>
<%# locals: (f:, question:) -%>
<% scope = "assessment.exercise_sessions.kinds.matching" %>
<% button = "flex min-h-tap w-full cursor-pointer items-center gap-2 rounded-ln border-2 border-line bg-white px-3 py-3 text-left font-medium text-ink transition hover:bg-mist aria-pressed:border-brand-strong aria-pressed:bg-brand-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" %>
<% badge = "grid size-6 shrink-0 place-items-center rounded-full bg-brand-strong text-xs font-bold text-white" %>
<legend class="font-display text-xl font-extrabold text-balance whitespace-pre-line text-ink"><%= question.content %></legend>
<p class="text-sm text-mute"><%= t("#{scope}.hint") %></p>
<div data-controller="assessment--matching" data-assessment--matching-linked-value="<%= t("#{scope}.linked", x: "%{x}") %>">
  <div hidden data-assessment--matching-target="board" class="grid grid-cols-2 gap-3">
    <ul class="space-y-3" aria-label="<%= t("#{scope}.left") %>">
      <% question.prompts.each do |prompt| %>
        <li>
          <button type="button" aria-pressed="false" data-assessment--matching-target="left" data-action="assessment--matching#pickLeft" class="<%= button %>">
            <span data-pair hidden class="<%= badge %>" aria-hidden="true"></span>
            <span class="min-w-0 flex-1"><%= prompt %></span>
            <span data-linked class="sr-only"></span>
          </button>
        </li>
      <% end %>
    </ul>
    <ul class="space-y-3" aria-label="<%= t("#{scope}.right") %>">
      <% question.items.each do |item| %>
        <li>
          <button type="button" aria-pressed="false" data-assessment--matching-target="right" data-label="<%= item.content %>"
                  data-action="assessment--matching#pickRight" class="<%= button %>">
            <span data-pair hidden class="<%= badge %>" aria-hidden="true"></span>
            <span class="min-w-0 flex-1"><%= item.content %></span>
          </button>
        </li>
      <% end %>
    </ul>
  </div>
  <%# Repli sans JavaScript, et lieu de l'envoi dans tous les cas : pour chaque élément de gauche, l'indice d'affichage choisi à droite. %>
  <div data-assessment--matching-target="fallback" class="space-y-2">
    <% question.prompts.each_with_index do |prompt, rank| %>
      <div class="space-y-1">
        <%= label_tag "attempt_display_order_#{rank}", prompt, class: "block text-sm font-medium text-ink" %>
        <%= select_tag "attempt[display_order][]", options_for_select(question.items.map { [ it.content, it.index ] }),
                       include_blank: t("#{scope}.choose"), id: "attempt_display_order_#{rank}", required: true,
                       data: { assessment__matching_target: "select" },
                       class: class_names(ComponentsHelper::FIELD_INPUT, "min-h-tap w-full", ComponentsHelper::FIELD_STATES[:valid]) %>
      </div>
    <% end %>
  </div>
</div>
