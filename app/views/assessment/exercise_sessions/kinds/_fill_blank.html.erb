<%# 🌐 UI · assessment/exercise_sessions/kinds/_fill_blank — texte à trous : un champ à la place de `___`, dans la phrase %>
<%# Rôle : la phrase dans une carte, le champ à la taille de ce qui est écrit ; la consigne est la légende de la copie ; aucune réponse acceptée dans la page %>
<%# ADR  : 0091 §4.2, §4.4, 0112 · UDR : 0087 §3.4, §3.10 (le champ a pour nom l'énoncé, « blanc » à la place de `___`), 0138 §3.2 %>
<%# locals: (f:, question:, number:, values: {}) -%>
<% before, after = question.content.split(Entities::Assessment::QuestionKinds::FillBlank::MARKER, 2) %>
<div class="rounded-card border border-line bg-white p-4 text-lg leading-loose whitespace-pre-line text-ink sm:p-5"><%= before %><%= f.text_field :response_text, value: values[:response_text], id: "q#{number}-response_text", maxlength: Dtos::Assessment::AttemptInput::RESPONSE_TEXT_MAX,
                                autocomplete: "off", autocapitalize: "off", autocorrect: "off", spellcheck: false,
                                "aria-label": question.content.sub(Entities::Assessment::QuestionKinds::FillBlank::MARKER,
                                                                   t("assessment.exercise_sessions.kinds.fill_blank.blank")),
                                class: "mx-1 inline-block min-w-28 max-w-full rounded-t-ln border-0 border-b-2 border-brand-strong bg-brand-soft px-3 py-1 text-center font-medium text-ink field-sizing-content focus:outline-2 focus:outline-offset-2 focus:outline-brand" %><%= after %></div>
