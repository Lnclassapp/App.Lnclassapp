<%# 🌐 UI · assessment/exercise_sessions/_progress_bar — avancée de la session : barre pleine largeur et « 3/5 » %>
<%# Rôle : remplacée par le stream de chaque réponse (id progress_bar) ; « Question suivante » sans requête met « n/T » à jour %>
<%# ADR  : 0033, 0054 · UDR : 0022, 0057, 0087 §3.2 · barre native (rôle progressbar), sans style en ligne ; number : la question à l'écran %>
<%# locals: (play:, number:) -%>
<div id="progress_bar" class="flex min-w-0 flex-1 items-center gap-3 sm:gap-4">
  <progress value="<%= play.progress_percent %>" max="100" aria-label="<%= t(".label") %>"
            class="block h-2 min-w-0 flex-1 appearance-none overflow-hidden rounded-full bg-line accent-brand [&::-moz-progress-bar]:rounded-full [&::-moz-progress-bar]:bg-brand-strong [&::-webkit-progress-bar]:bg-line [&::-webkit-progress-value]:rounded-full [&::-webkit-progress-value]:bg-brand-strong"><%= t(".percent", percent: play.progress_percent) %></progress>
  <p id="progress_counter" class="shrink-0 text-sm font-bold text-ink tabular-nums">
    <span class="sr-only"><%= t(".counter_label") %></span><span data-counter><%= t(".counter", number:, total: play.question_count) %></span>
  </p>
</div>
