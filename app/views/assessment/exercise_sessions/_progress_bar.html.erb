<%# 🌐 UI · assessment/exercise_sessions/_progress_bar — avancée de la session, en barre seule %>
<%# Rôle : remplacée par le stream de chaque réponse (id progress_bar) ; barre native, sans style en ligne ; le nombre est dans la carte %>
<%# ADR  : 0033, 0054 · UDR : 0022, 0057 · « Question n sur T » dit l'avancement une fois (R6), la barre le montre %>
<div id="progress_bar">
  <progress value="<%= play.progress_percent %>" max="100" aria-label="<%= t(".label") %>"
            class="block h-2 w-full overflow-hidden rounded-full accent-brand"><%= t(".percent", percent: play.progress_percent) %></progress>
</div>
