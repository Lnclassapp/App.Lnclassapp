<%# 🌐 UI · assessment/exercise_sessions/_question_card — une question à répondre, dans le frame « question » %>
<%# Rôle : radios (Vrai/Faux, choix unique) ou cases à cocher et « Coche N propositions. » (plusieurs correctes) ; aucune correction %>
<%# ADR  : 0054 · UDR : 0007, 0022, 0057 · Stimulus : math (KaTeX) %>
<% errors = form ? form.errors[:answer_ids] + form.errors[:base] : [] %>
<%= turbo_frame_tag "question" do %>
  <%= ui_card padding: :none, id: "question-card", class: "overflow-hidden" do %>
    <div class="border-b border-line bg-mist px-4 py-3 sm:px-6">
      <span class="text-sm font-medium text-mute"><%= t(".number", number: question.number, total: play.question_count) %></span>
    </div>
    <%= form_with scope: :attempt, url: exercise_session_attempts_path(play.session_public_id), id: "attempt-form",
                  class: "space-y-6 p-4 sm:p-6", data: { controller: "math" } do |f| %>
      <%= f.hidden_field :question_id, value: question.id %>
      <fieldset class="space-y-4" <%= tag.attributes("aria-describedby": ("attempt-errors" if errors.any?)) %>>
        <legend class="text-lg font-semibold whitespace-pre-line text-ink"><%= question.content %></legend>
        <% if question.multiple? %>
          <p class="text-sm text-mute"><%= t(".hint", count: question.expected_count) %></p>
        <% end %>
        <div class="space-y-3">
          <% question.answers.each do |answer| %>
            <label class="flex min-h-tap cursor-pointer items-center gap-3 rounded-ln border border-line bg-white px-4 py-3 transition hover:bg-mist has-checked:border-brand has-checked:bg-brand-soft">
              <% if question.multiple? %>
                <%= check_box_tag "attempt[answer_ids][]", answer.id, false, id: "attempt_answer_#{answer.id}", class: ComponentsHelper::FIELD_CHECKBOX %>
              <% else %>
                <%= radio_button_tag "attempt[answer_ids][]", answer.id, false, id: "attempt_answer_#{answer.id}",
                                     class: "size-5 shrink-0 cursor-pointer accent-brand focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" %>
              <% end %>
              <span class="font-medium text-ink"><%= answer.content %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
      <% if errors.any? %>
        <div id="attempt-errors" role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
          <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
          <p><%= errors.to_sentence %></p>
        </div>
      <% end %>
      <%# Pleine largeur sous 640 px : le pouce l'atteint des deux côtés. %>
      <div class="border-t border-line pt-4 sm:flex sm:justify-end">
        <%= ui_button t(".submit"), type: :submit, icon_end: "arrow-right", class: "w-full sm:w-auto" %>
      </div>
    <% end %>
  <% end %>
<% end %>
