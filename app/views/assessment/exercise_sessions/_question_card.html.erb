<%# 🌐 UI · assessment/exercise_sessions/_question_card — une question à répondre, dans le frame « question » %>
<%# Rôle : « Question n sur T », son image éventuelle, l'énoncé, la saisie de son type (kinds/_<type>), « Valider » collé en bas, désactivé tant que la réponse est incomplète %>
<%# ADR  : 0054, 0091 §4.4 (aucune correction, aucun id révélateur), 0104 · UDR : 0007, 0022, 0057, 0087 §3.2, §3.4, 0129 · Stimulus : math, assessment--answer %>
<%# locals: (play:, question:, form:) -%>
<% errors = form ? form.errors[:answer_ids] + form.errors[:response_text] + form.errors[:display_order] + form.errors[:base] : [] %>
<%= turbo_frame_tag "question", class: "flex flex-1 flex-col" do %>
  <%# data-counter : « n/T » que « Question suivante » recopie dans l'en-tête, la question arrivant sans requête (UDR-0076 §3.3). %>
  <div id="question-card" class="flex flex-1 flex-col" data-counter="<%= t("assessment.exercise_sessions.progress_bar.counter", number: question.number, total: play.question_count) %>">
    <%= form_with scope: :attempt, url: exercise_session_attempts_path(play.session_public_id), id: "attempt-form",
                  class: "flex flex-1 flex-col", data: { controller: "math assessment--answer",
                                                         action: "input->assessment--answer#check change->assessment--answer#check" } do |f| %>
      <%= f.hidden_field :question_id, value: question.id %>
      <p class="mb-2 text-xs font-bold tracking-wide text-mute uppercase"><%= t(".number", number: question.number, total: play.question_count) %></p>
      <%# Avant le fieldset : la legend, rendue par le partial du type, en reste le premier enfant (UDR-0129 §3.4). %>
      <% if (image = question.image) %>
        <%= tag.img src: question_image_path(image.public_id), alt: image.alt.to_s, width: image.width, height: image.height,
                    loading: "lazy", decoding: "async", class: "mb-4 h-auto max-h-72 w-full rounded-ln bg-mist object-contain" %>
      <% end %>
      <%# La légende (l'énoncé) est rendue par le partial du type : celle des trous est la consigne, la phrase porte le champ. %>
      <fieldset class="min-w-0 space-y-4" <%= tag.attributes("aria-describedby": ("attempt-errors" if errors.any?)) %>>
        <%= render "assessment/exercise_sessions/kinds/#{question.kind_name}", f:, question: %>
      </fieldset>
      <% if errors.any? %>
        <div id="attempt-errors" role="alert" class="mt-4 flex items-start gap-2 rounded-ln bg-warning-soft px-4 py-3 text-sm font-medium text-warning">
          <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
          <p><%= errors.to_sentence %></p>
        </div>
      <% end %>
      <%# UDR-0087 §3.2 : collé en bas, au-dessus de la zone sûre ; pleine largeur, le pouce l'atteint des deux côtés. Sans
          JavaScript, il reste actif : le serveur refuse une réponse incomplète (422). %>
      <div class="sticky bottom-0 z-10 -mx-gutter mt-auto bg-paper px-gutter pt-6 pb-safe-action min-[700px]:mx-0 min-[700px]:px-0">
        <%= ui_button t(".submit"), type: :submit, variant: :brand, size: :lg, full: true,
                                    data: { assessment__answer_target: "submit" } %>
      </div>
    <% end %>
  </div>
<% end %>
