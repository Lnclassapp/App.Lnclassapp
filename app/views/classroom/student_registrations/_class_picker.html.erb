<%# 🌐 UI · classroom/student_registrations/_class_picker — la cascade en trois étapes numérotées : établissement, niveau, classe %>
<%# Rôle : établissement cherché en tapant (champ commun, DRENA à côté de chaque résultat) ; niveaux en pastilles, classes en cases ; lien optionnel sous le champ ; repli GET %>
<%# ADR  : 0062, 0085, 0095, XXXX-recherche-etablissement · UDR : 0081 (§3.3), 0091, 0102 (§3.1), 0135 (§3.2), XXXX-champ-etablissement %>
<%# locals: (form:, search:, levels:, classrooms:, scope:, framed: false, current_classroom_public_id: nil, after_school: nil, search_form: nil) -%>
<%# Partagé par l'inscription et par « Choisis ta classe » (UDR-0081 §3.5, UDR-0091 §3.4) : levels, classrooms valent nil tant que
    leur parent n'est pas choisi ; search, les locals du champ établissement (SchoolSearchField). Le formulaire hôte porte le
    contrôleur, ses deux adresses et la cible submit. framed : chaque étape dans sa carte (« Choisis ta classe ») ; sans, les
    étapes se suivent dans la carte de l'inscription. current_classroom_public_id : « Changer de classe » (UDR-0102 §3.1) marque
    la classe actuelle ; l'hôte l'ajoute aussi (current=) à l'adresse du cadre des classes. after_school : du HTML posé juste sous
    le champ établissement (le lien « J'ai le code de ma classe » de l'inscription). %>
<% registration = form.object %>
<%# La carte entoure le fieldset : une légende posée sur une bordure de fieldset chevaucherait le haut de la carte. %>
<% card_class = class_names(ComponentsHelper::CARD_BASE, ComponentsHelper::CARD_PADDINGS[:md]) if framed %>
<% step_class = "flex min-w-0 flex-col" %>
<% legend = lambda do |number, key|
     tag.legend(class: "mb-3 flex items-center gap-2 font-display text-base font-medium text-ink") do
       safe_join([ tag.span(number, class: "grid size-6 shrink-0 place-items-center rounded-full bg-brand-soft text-xs font-medium text-brand-strong"),
                   t(".#{key}") ], " ")
     end
   end %>
<%# Avec JavaScript, Chrome rend le <noscript> inline : dans un bloc, il laisserait une ligne vide. Les étapes sont donc des
    colonnes flex (le <noscript> y devient un élément vide, sans hauteur), et le bouton porte lui-même son écart. %>
<% continue_button = lambda do
     tag.noscript do
       ui_button t(".continue"), type: :submit, variant: :secondary, size: :sm, icon_end: "arrow-right", class: "mt-3",
                                 formaction: url_for(action: :new), formmethod: :get, formnovalidate: true
     end
   end %>

<div class="space-y-4">
  <%= tag.div class: card_class do %><%= tag.fieldset id: "class-picker-step-school", class: step_class do %>
    <%= legend.call(1, :step_school) %>
    <%# L'établissement trouvé charge les niveaux (picked) ; une nouvelle saisie vide le niveau et la classe (cleared). %>
    <%= tag.div class: "flex min-w-0 flex-col",
                data: { action: "school--school-search:picked->classroom--class-picker#loadLevels " \
                                "school--school-search:cleared->classroom--class-picker#clearSchool" } do %>
      <%= render "school/school_searches/field", scope:, **search, error: registration.errors[:school_public_id].first,
                                                 search_form:, fallback_url: url_for(action: :new), label_hidden: true %>
    <% end %>
    <%# Sans JavaScript, l'établissement coché part avec « Continuer » et la page revient avec ses niveaux. %>
    <%= continue_button.call if search[:chosen] || search[:result]&.rows.present? %>
    <%= after_school %>
  <% end %><% end %>

  <%= tag.div class: card_class do %><%= tag.fieldset id: "class-picker-step-level", class: step_class do %>
    <%= legend.call(2, :step_level) %>
    <%= render template: "school/school_levels/index", locals: { levels:, registration:, scope: } %>
    <%# Vide tant que l'établissement n'est pas choisi (et aussitôt vidé par une nouvelle saisie) : peer-empty, sans JavaScript. %>
    <p class="hidden text-sm text-mute peer-empty:block peer-aria-busy:hidden"><%= t(".school_first") %></p>
    <%= continue_button.call if levels.present? %>
  <% end %><% end %>

  <%= tag.div class: card_class do %><%= tag.fieldset id: "class-picker-step-classroom", class: step_class do %>
    <%= legend.call(3, :step_classroom) %>
    <%= render template: "school/level_classrooms/index", locals: { classrooms:, registration:, scope:, current: current_classroom_public_id } %>
    <p class="hidden text-sm text-mute peer-empty:block peer-aria-busy:hidden"><%= t(".level_first") %></p>
  <% end %><% end %>

  <%# Une liste qui n'arrive pas (réseau, réponse sans son frame) : le contrôleur pose cet état dans le frame, son adresse en reprise. %>
  <template data-classroom--class-picker-target="loadError">
    <%= ui_error_state title: t(".load_error"), message: t(".load_error_message"), retry_href: "#", retry_label: t(".retry") %>
  </template>
</div>
