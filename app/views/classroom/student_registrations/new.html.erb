<%# 🌐 UI · classroom/student_registrations/new — inscription élève en trois étapes : 1 Ta classe, 2 Toi, 3 Ton code secret %>
<%# Rôle : une colonne (dès lg, le panneau brand-strong à gauche, le même aux trois étapes, et le formulaire à droite) ; logo et « Besoin d'aide ? », « ‹ Retour » et « Étape N sur 3 », barre en trois segments, carte de bienvenue sur le premier écran seulement ; le formulaire est découpé par signup_steps_controller %>
<%# ADR  : 0050, 0085, XXXX-code-de-classe-a-six-caracteres · UDR : 0005, 0054 (§3.2 : logo vers l'accueil public), 0079, 0081, XXXX-inscription-eleve-en-trois-etapes (§3.1, §3.5, §3.5 bis, §3.8) %>
<% page_title t(".page_title") %>
<%# Lien valable : l'étape 1 n'existe pas, on ouvre l'étape 2. Sinon, la première étape qui porte une erreur (UDR §3.5), l'étape 1 par défaut. %>
<% floor = @preview ? 2 : 1 %>
<% step_of = { join_code: 1, classroom_public_id: 1, drena_public_id: 1, school_public_id: 1, level_slug: 1, link_token: 1,
               last_name: 2, first_name: 2, gender: 2, contact: 2, pin: 3, pin_confirmation: 3 } %>
<% start = [ @form.errors.attribute_names.filter_map { step_of[it] }.min || floor, floor ].max %>
<%# Un compte-rendu de classe pour l'étape 2 : le lien (nom de l'établissement), ou le code reconnu (sigle ou nom). %>
<% recap = if @preview then [ @preview.classroom_name, @preview.school_name ] elsif @code_preview then [ @code_preview.classroom_name, @code_preview.school_label ] end %>
<main id="student-signup" class="mx-auto flex min-h-dvh w-full max-w-md flex-col px-gutter pb-10 lg:max-w-240 lg:px-8"
      data-controller="classroom--signup-steps" data-classroom--signup-steps-start-value="<%= start %>"
      data-classroom--signup-steps-counter-value="<%= t("classroom.student_registrations.form.step_counter", n: "%{n}") %>"
      data-classroom--signup-steps-announce-value="<%= t("classroom.student_registrations.form.step_announce", n: "%{n}", title: "%{title}") %>"
      data-classroom--signup-steps-code-url-value="<%= classroom_code_path("__code__") %>">
  <div id="signup-header" class="flex min-h-bar items-center justify-between">
    <%= link_to root_path, "aria-label": t("shared.auth_welcome.logo_home"),
                           class: "flex min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" do %>
      <%= image_tag brand_logo, alt: "", class: "size-9 rounded-ln object-cover" %>
    <% end %>
    <div id="auth-help">
      <%= render "shared/help_sheet", trigger_icon: "headset", trigger_class: "font-medium! text-brand-strong!" %>
    </div>
  </div>

  <div class="flex flex-1 flex-col lg:mt-8 lg:flex-row lg:gap-10">
    <%# UDR §3.5 bis : le panneau d'ordinateur, le même aux trois étapes ; le contrôleur Stimulus y marque l'étape en cours. Il remplace
        la carte de bienvenue, la barre en trois segments et « Déjà un compte ? » du téléphone, cachés dès lg. %>
    <section id="signup-panel" aria-label="Lnclass" class="hidden min-h-135 flex-col rounded-card bg-brand-strong p-7 text-white lg:flex lg:w-90 lg:shrink-0">
      <h1 class="text-lg font-medium"><%= t(".welcome") %></h1>
      <p class="mt-2 text-meta text-brand-soft"><%= t(".panel_hint") %></p>
      <ol id="signup-panel-steps" aria-label="<%= t(".panel_steps") %>" class="mt-10 space-y-4">
        <% { 1 => :classroom, 2 => :you, 3 => :security }.each do |number, key| %>
          <li data-step="<%= number %>" data-classroom--signup-steps-target="panelStep" <%= tag.attributes("aria-current": ("step" if number == start)) %>>
            <div class="flex items-center gap-3">
              <span data-mark aria-hidden="true"
                    class="grid size-7 shrink-0 place-items-center rounded-full text-meta <%= number > start ? "border border-white" : "bg-white text-brand-strong" %>"><%= number < start ? "✓" : number %></span>
              <span data-label class="<%= number == start ? "text-base font-medium" : "text-sm" %>"><%= t("classroom.student_registrations.form.#{key}") %></span>
              <span data-done class="sr-only" <%= "hidden" unless number < start %>><%= t(".panel_step_done") %></span>
            </div>
            <% if number == 1 %>
              <%# CA-C9 : la classe trouvée (code ou lien) sous l'étape 1 cochée, et « Ce n'est pas ta classe ? ›» ; elle n'est pas répétée au-dessus du formulaire. %>
              <div id="signup-panel-recap" <%= "hidden" unless recap %> data-classroom--signup-steps-target="panelRecap" class="mt-1 ml-10 text-meta">
                <p>
                  <span data-classroom--signup-steps-target="panelRecapName"><%= recap&.first %></span> ·
                  <span data-classroom--signup-steps-target="panelRecapSchool"><%= recap&.last %></span>
                </p>
                <%= link_to new_student_registration_path, id: "panel-other-classroom",
                            data: ({ action: "click->classroom--signup-steps#restart" } unless @preview),
                            class: "inline-flex min-h-tap items-center underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-white" do %>
                  <%= t("classroom.student_registrations.form.other_classroom") %><span aria-hidden="true">&nbsp;›</span>
                <% end %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ol>
      <p class="mt-auto pt-8 text-sm">
        <%= t(".have_account") %>
        <%= link_to t(".sign_in"), new_session_path,
                    class: "inline-flex min-h-tap items-center underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-white" %>
      </p>
    </section>

    <div class="flex flex-1 flex-col lg:max-w-110 lg:pt-2">
      <div class="flex min-h-tap items-center justify-between gap-3">
        <button type="button" id="signup-back" <%= "hidden" if start <= floor %>
                data-classroom--signup-steps-target="back" data-action="classroom--signup-steps#back"
                class="inline-flex min-h-tap items-center gap-1 rounded-ln pr-3 text-sm font-medium text-brand-strong focus-visible:outline-2 focus-visible:outline-brand">
          <span aria-hidden="true">‹</span><%= t("classroom.student_registrations.form.back") %>
        </button>
        <p id="signup-step-counter" class="ml-auto text-sm text-mute" data-classroom--signup-steps-target="counter"><%= t("classroom.student_registrations.form.step_counter", n: start) %></p>
      </div>
      <ol id="signup-progress" class="mb-4 flex gap-1.5 lg:hidden" aria-hidden="true">
        <% 3.times do |index| %>
          <li data-classroom--signup-steps-target="segment"
              class="h-1.5 flex-1 rounded-full <%= index < start ? "bg-brand-strong" : "bg-line" %>"></li>
        <% end %>
      </ol>
      <p id="signup-live" class="sr-only" aria-live="polite" data-classroom--signup-steps-target="live"></p>

      <div id="signup-welcome" class="mb-4 space-y-3 lg:hidden" data-classroom--signup-steps-target="welcome" <%= "hidden" if start > floor %>>
        <section aria-label="Lnclass" class="rounded-card bg-brand-strong p-5 text-white">
          <p class="text-lg font-medium"><%= t(".welcome") %></p>
          <p class="mt-2 text-sm leading-relaxed"><%= t(".welcome_hint") %></p>
        </section>
        <h1 class="pt-1 text-xl font-medium text-ink"><%= t(".title") %></h1>
      </div>

      <%= render "classroom/student_registrations/form", start:, floor:, recap: %>

      <p id="signup-signin" class="mt-6 text-center text-sm text-mute lg:hidden" data-classroom--signup-steps-target="welcome" <%= "hidden" if start > floor %>>
        <%= t(".have_account") %>
        <%= link_to t(".sign_in"), new_session_path,
                    class: "inline-flex min-h-tap items-center font-medium text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
      </p>
    </div>
  </div>
</main>
