<%# 🌐 UI · classroom/student_registrations/new — inscription élève en trois étapes : 1 Ta classe, 2 Toi, 3 Ton code secret %>
<%# Rôle : une colonne ; logo et « Besoin d'aide ? », « ‹ Retour » et « Étape N sur 3 », barre en trois segments, carte de bienvenue sur le premier écran seulement ; le formulaire est découpé par signup_steps_controller %>
<%# ADR  : 0050, 0085, XXXX-code-de-classe-a-six-caracteres · UDR : 0005, 0054 (§3.2 : logo vers l'accueil public), 0079, 0081, XXXX-inscription-eleve-en-trois-etapes (§3.1, §3.5, §3.8) %>
<% page_title t(".page_title") %>
<%# Lien valable : l'étape 1 n'existe pas, on ouvre l'étape 2. Sinon, la première étape qui porte une erreur (UDR §3.5), l'étape 1 par défaut. %>
<% floor = @preview ? 2 : 1 %>
<% step_of = { join_code: 1, classroom_public_id: 1, drena_public_id: 1, school_public_id: 1, level_slug: 1, link_token: 1,
               last_name: 2, first_name: 2, gender: 2, contact: 2, pin: 3, pin_confirmation: 3 } %>
<% start = [ @form.errors.attribute_names.filter_map { step_of[it] }.min || floor, floor ].max %>
<%# Un compte-rendu de classe pour l'étape 2 : le lien (nom de l'établissement), ou le code reconnu (sigle ou nom). %>
<% recap = if @preview then [ @preview.classroom_name, @preview.school_name ] elsif @code_preview then [ @code_preview.classroom_name, @code_preview.school_label ] end %>
<main id="student-signup" class="mx-auto flex min-h-dvh w-full max-w-md flex-col px-gutter pb-10"
      data-controller="classroom--signup-steps" data-classroom--signup-steps-start-value="<%= start %>"
      data-classroom--signup-steps-counter-value="<%= t("classroom.student_registrations.form.step_counter", n: "%{n}") %>"
      data-classroom--signup-steps-announce-value="<%= t("classroom.student_registrations.form.step_announce", n: "%{n}", title: "%{title}") %>"
      data-classroom--signup-steps-code-url-value="<%= classroom_code_path("__code__") %>">
  <div id="signup-header" class="flex min-h-bar items-center justify-between">
    <%= link_to root_path, "aria-label": t("shared.auth_welcome.logo_home"),
                           class: "flex min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" do %>
      <%= image_tag brand_logo, alt: "", class: "size-9 rounded-ln object-cover" %>
    <% end %>
    <div id="auth-help">
      <%= render "shared/help_sheet", trigger_icon: "headset", trigger_class: "font-medium! text-brand-strong!" %>
    </div>
  </div>

  <div class="flex min-h-tap items-center justify-between gap-3">
    <button type="button" id="signup-back" <%= "hidden" if start <= floor %>
            data-classroom--signup-steps-target="back" data-action="classroom--signup-steps#back"
            class="inline-flex min-h-tap items-center gap-1 rounded-ln pr-3 text-sm font-medium text-brand-strong focus-visible:outline-2 focus-visible:outline-brand">
      <span aria-hidden="true">‹</span><%= t("classroom.student_registrations.form.back") %>
    </button>
    <p id="signup-step-counter" class="ml-auto text-sm text-mute" data-classroom--signup-steps-target="counter"><%= t("classroom.student_registrations.form.step_counter", n: start) %></p>
  </div>
  <ol id="signup-progress" class="mb-4 flex gap-1.5" aria-hidden="true">
    <% 3.times do |index| %>
      <li data-classroom--signup-steps-target="segment"
          class="h-1.5 flex-1 rounded-full <%= index < start ? "bg-brand-strong" : "bg-line" %>"></li>
    <% end %>
  </ol>
  <p id="signup-live" class="sr-only" aria-live="polite" data-classroom--signup-steps-target="live"></p>

  <div id="signup-welcome" class="mb-4 space-y-3" data-classroom--signup-steps-target="welcome" <%= "hidden" if start > floor %>>
    <section aria-label="Lnclass" class="rounded-card bg-brand-strong p-5 text-white">
      <p class="text-lg font-medium"><%= t(".welcome") %></p>
      <p class="mt-2 text-sm leading-relaxed"><%= t(".welcome_hint") %></p>
    </section>
    <h1 class="pt-1 text-xl font-medium text-ink"><%= t(".title") %></h1>
  </div>

  <%= render "classroom/student_registrations/form", start:, floor:, recap: %>

  <p id="signup-signin" class="mt-6 text-center text-sm text-mute" data-classroom--signup-steps-target="welcome" <%= "hidden" if start > floor %>>
    <%= t(".have_account") %>
    <%= link_to t(".sign_in"), new_session_path,
                class: "inline-flex min-h-tap items-center font-medium text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
  </p>
</main>
