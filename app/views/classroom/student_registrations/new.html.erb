<%# 🌐 UI · classroom/student_registrations/new — inscription élève : accueil bleu, « Créer ton compte élève » en trois rubriques numérotées %>
<%# Rôle : carte bleue au-dessus sous lg, panneau bleu à gauche dès lg ; « Besoin d'aide ? » en haut ; voie standard (cascade) ou lien de classe ; 429, 422/403 re-rendus %>
<%# ADR  : 0050, 0085 · UDR : 0005, 0054 (§3.2 : logo vers l'accueil public), 0079, 0081 (§3.1), 0088 (§3.1, §3.2, §3.4) %>
<% page_title t(".page_title") %>
<div class="grid min-h-dvh bg-paper lg:grid-cols-2">
  <%= render "shared/auth_welcome", variant: :panel, title: t(".welcome"), text: t(".welcome_hint") %>

  <div class="flex min-w-0 flex-col">
    <%= render "shared/auth_help" %>
    <main class="flex flex-1 flex-col items-center px-gutter pt-2 pb-10 lg:pt-6 lg:pb-16">
      <div class="w-full max-w-140 space-y-4">
        <%= render "shared/auth_welcome", variant: :card, title: t(".welcome"), text: t(".welcome_hint") %>

        <div class="pt-2">
          <h1 class="font-display text-2xl font-extrabold text-ink"><%= t(".title") %></h1>
          <p class="mt-1 text-sm text-mute"><%= t(".subtitle") %></p>
        </div>

        <% if @rate_limited %>
          <%= ui_error_state title: t(".rate_limited_title"), message: t("errors.codes.rate_limited") %>
        <% else %>
          <%= render "classroom/student_registrations/form" %>

          <p class="text-center text-sm text-mute">
            <%= t(".have_account") %>
            <%= link_to t(".sign_in"), new_session_path,
                        class: "inline-flex min-h-tap items-center font-bold text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
          </p>
        <% end %>
      </div>
    </main>
  </div>
</div>
