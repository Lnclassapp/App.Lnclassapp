<%# 🌐 UI · classroom/student_registrations/_submit — « Créer mon compte » et les conditions, en fin de la dernière étape %>
<%# Rôle : à l'étape 3 (Ton code secret), ou à l'étape 2 après l'entrée élève (le code est déjà choisi) %>
<%# UDR  : 0135 (§3.1), 0176-entree-eleve-unique (§3.6) %>
<%# locals: (form:) -%>
<%# « Création… » pendant l'envoi : Turbo désactive le bouton et change son texte. Le bouton n'attend plus de classe cochée : le code suffit. %>
<%= ui_button t("classroom.student_registrations.form.submit"), type: :submit, variant: :primary, size: :lg, full: true, id: "student-registration-submit",
              data: { turbo_submits_with: t("classroom.student_registrations.form.submitting") } %>
<p class="text-center text-xs text-mute">
  <%= t("classroom.student_registrations.form.terms_html",
        terms: link_to(t("classroom.student_registrations.form.terms_link"), terms_path, class: "text-brand-strong underline underline-offset-2"),
        privacy: link_to(t("classroom.student_registrations.form.privacy_link"), privacy_path, class: "text-brand-strong underline underline-offset-2")) %>
</p>
