<%# 🌐 UI · classroom/student_archives/_result_row — un exercice terminé : illustration de la matière, titre, matière · date, note %>
<%# Rôle : ligne en lecture seule, jamais un lien (UDR-0013) ; masquée au-delà de la 3e, révélée par « Voir plus » %>
<%# UDR  : 0057 (R3), 0069 §3.3, 0090 §3.2, §3.6 · note verte dès 14/20 affiché (MASTERY_THRESHOLD sur 20, 68 % compris), à l'encre dessous, jamais rouge %>
<%# locals: (result:, index:) -%>
<% illustration = subject_illustration(result.material_slug) %>
<% grading = Entities::Assessment::Grading %>
<% grade = grading.grade_on_20(result.score_percent) %>
<%= tag.li class: "flex items-center gap-3 py-3", **ui_reveal_item(index) do %>
  <%# Décorative : la matière est écrite sous le titre. %>
  <span class="<%= class_names("grid size-11 shrink-0 place-items-center rounded-full", illustration.tint) %>" aria-hidden="true">
    <%= image_tag illustration.path, alt: "", class: "size-7", loading: "lazy" %>
  </span>
  <div class="min-w-0 flex-1">
    <p class="line-clamp-2 font-medium break-words text-ink"><%= result.exercise_title %></p>
    <p class="mt-0.5 text-sm text-mute"><%= t(".detail", material: result.material_name, date: l(result.completed_at.to_date, format: t(".date_format"))) %></p>
  </div>
  <span data-grade class="<%= class_names("shrink-0 rounded-full px-3 py-1.5 text-sm font-medium tabular-nums",
                                          grading.reaches?(result.score_percent, grading::MASTERY_THRESHOLD) ? "bg-success-soft text-success" : "border border-line bg-mist text-ink") %>">
    <span aria-hidden="true"><%= grade_label(result.score_percent) %></span><span class="sr-only"><%= t(".grade_spoken", grade:) %></span>
  </span>
<% end %>
