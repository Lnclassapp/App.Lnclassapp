<%# 🌐 UI · classroom/posters/_poster — une feuille A4 : classe, établissement, QR du lien, 3 étapes (locals : poster) %>
<%# Rôle : l'affiche que l'enseignant colle en classe ; le QR est celui du lien /c/<jeton>?s=qr %>
<%# ADR  : partage-classe-k-factor · UDR : partage-de-classe (§3.2) %>
<article class="mx-auto flex max-w-180 flex-col items-center gap-8 py-8 text-center break-inside-avoid break-after-page last:break-after-auto">
  <header class="flex items-center gap-3">
    <%= image_tag brand_logo, alt: "", width: 40, height: 40, class: "size-10 rounded-sm" %>
    <p class="font-display text-2xl text-ink"><%= t("classroom.posters.poster.brand") %></p>
  </header>
  <h2 class="font-display text-6xl font-medium text-ink"><%= poster.classroom_name %></h2>
  <p class="text-2xl text-mute"><%= poster.school_name %></p>
  <figure role="img" aria-label="<%= t("classroom.posters.poster.qr_label") %>" class="size-72 print:size-96">
    <%= class_join_qr_svg(poster.link_token) %>
  </figure>
  <p class="break-all font-mono text-xl text-ink"><%= join_classroom_url(poster.link_token).sub(%r{\Ahttps?://}, "") %></p>
  <ol class="flex flex-col gap-4 text-left">
    <% %i[scan student secret].each_with_index do |step, index| %>
      <li class="flex items-center gap-4 text-2xl text-ink">
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brand text-2xl text-on-brand" aria-hidden="true"><%= index + 1 %></span>
        <%= t("classroom.posters.poster.steps.#{step}") %>
      </li>
    <% end %>
  </ol>
  <p class="text-lg text-mute"><%= t("classroom.posters.poster.footer") %></p>
</article>
