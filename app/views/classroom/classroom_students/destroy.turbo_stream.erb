<%# 🌐 UI · classroom/classroom_students/destroy — un élève retiré de la classe (IL-14) %>
<%# Rôle : toast, ligne retirée avec sa modale, titre de la liste recompté (focus) ; page enseignant : effectif et compte filtré, liste vidée → état vide ; page de la direction : re-demandée et fusionnée %>
<%# ADR  : 0065, 0085 (§4.5) · UDR : 0006, 0081 (§3.7) · le titre reçoit le focus (autofocus, tabindex -1) ; @search : la recherche de la liste %>
<% roster = { classroom: @header, students: @overview.students, search: @search, new_count: @overview.new_students_count,
              can_remove: true, focus_title: true } %>
<%# Le titre de la liste (classroom/classrooms/_roster_title), avec l'autofocus qui y ramène le focus. %>
<% title = render partial: "classroom/classrooms/roster_title", formats: :html,
                   locals: { count: @header.active_students_count, new_count: @overview.new_students_count, focus: true } %>
<%= turbo_stream_toast @notice, type: :success %>
<% if @direction_page %>
  <%# Sa page n'a ni l'effectif de l'en-tête ni la liste de l'enseignant : la ligne part, puis la page re-demandée remet
      ses chiffres, son sous-titre et, liste vidée, son état vide (morphing, défilement gardé ; le toast est permanent). %>
  <%= turbo_stream.remove "student_#{@student.public_id}" %>
  <%= turbo_stream.replace "classroom_roster_title", title %>
  <%= turbo_stream.refresh(request_id: nil) %>
<% else %>
  <%= turbo_stream.update "classroom_headcount",
                          t("classroom.classrooms.header.headcount", count: @header.active_students_count, max: @header.max_students) %>
  <% if @overview.students.empty? %>
    <%# Plus personne à montrer (classe vide, ou recherche sans résultat) : l'état vide existant de la section. %>
    <%= turbo_stream.replace "classroom_roster", partial: "classroom/classrooms/roster", locals: roster %>
  <% else %>
    <%= turbo_stream.remove "student_#{@student.public_id}" %>
    <%= turbo_stream.update "classroom_roster_count", t("classroom.classrooms.roster.count", count: @overview.students.size) %>
    <%= turbo_stream.replace "classroom_roster_title", title %>
  <% end %>
<% end %>
