<%# 🌐 UI · classroom/classroom_students/_summary — trois chiffres et badges de l'élève sur les exercices de la classe %>
<%# Rôle : « Faits 7 sur 10 », « En retard » (si une échéance existe), « Pas encore faits » ; badges de la classe par palier %>
<%# ADR  : 0072 (§4.4), 0079 (§4.2), 0097 (§4.3, §4.5) · UDR : 0062 (§3.5), 0072, 0107 (§3.3) · jamais un badge d'une autre classe %>
<%# locals: (file:) -%>
<% counts = file.counts %>
<% figure = "font-display text-3xl font-medium tabular-nums" %>
<%= ui_card padding: :md, id: "student_file_summary" do %>
  <dl id="student_file_counts" aria-label="<%= t(".counts_label") %>" class="flex flex-wrap gap-x-10 gap-y-4">
    <div>
      <dt class="text-sm text-mute"><%= t(".done") %></dt>
      <dd class="<%= figure %>"><%= counts.done %> <span class="font-sans text-base font-normal text-mute"><%= t(".done_of", count: counts.assigned) %></span></dd>
    </div>
    <% if file.assignments.any?(&:due_on) %>
      <div>
        <dt class="text-sm text-mute"><%= t(".late") %></dt>
        <dd class="<%= figure %>"><%= counts.late %></dd>
      </div>
    <% end %>
    <div>
      <dt class="text-sm text-mute"><%= t(".pending") %></dt>
      <dd class="<%= figure %>"><%= counts.pending %></dd>
    </div>
  </dl>
  <div class="mt-6 border-t border-line pt-5">
    <p class="mb-2 text-sm text-mute"><%= t(".badges_title") %></p>
    <%= render "assessment/comprehension/badge_counts", counts: file.badge_counts %>
  </div>
<% end %>
