<%# 🌐 UI · classroom/classroom_students/_identity — en-tête de la fiche d'un élève %>
<%# Rôle : photo, nom (le seul h1), « Numéro 07 •• •• •• 56 · Arrivé·e le 12 oct. » ; la classe n'est pas répétée, elle est dans le lien de retour %>
<%# ADR  : 0083 (§4.4 bis), 0085 (§4.4) · UDR : enseignant §3.6, 0079 (§3.8 ter) · la valeur masquée de la requête, telle quelle : ni tel:, ni copie %>
<%# locals: (student:) -%>
<div id="student_file_identity" class="flex items-center gap-4">
  <%= ui_avatar student.display_name, src: account_photo_src(student.public_id, student.photo_version), size: :lg, tone_seed: student.public_id %>
  <div class="min-w-0 space-y-1">
    <h1 class="font-display text-lg font-medium break-words"><%= student.display_name %></h1>
    <p class="text-sm text-mute">
      <% if student.contact %>
        <span title="<%= t(".contact_masked") %>"><%= t(".contact") %> <span class="font-mono whitespace-nowrap"><span aria-hidden="true"><%= student.contact %></span><span class="sr-only"><%= t(".contact_masked") %></span></span></span> ·
      <% end %>
      <%= t(".arrived", date: l(student.joined_at.to_date, format: :arrived)) %>
    </p>
  </div>
</div>
