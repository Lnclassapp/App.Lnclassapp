<%# 🌐 UI · classroom/student_classrooms/_pending_gaps — « Notions à revoir » (lacunes en attente) de « Ma classe », juste après « Exercices assignés » %>
<%# Rôle : une ligne par lacune pending, vers sa fiche ; 3 lignes, puis « Voir plus (n) » ; rendue seulement s'il y a une lacune %>
<%# ADR  : 0043, 0090 (§4.1 : pas de préchargement) · UDR : 0173 §3 (règles 5, 7, 8), 0007, 0057, 0058 §3.3 · CA-E3 (mvp-teacher-student) %>
<%# suivi-classe-lecon §3.3 : `proposals` ({ essential_slug => Proposal } | nil) donne l'exercice à refaire ; sans proposition, la notion de la leçon %>
<%# locals: (gaps:, proposals: nil) -%>
<%= render layout: "shared/screens/group", locals: { id: "student_classroom_gaps", title: t("classroom.student_classrooms.pending_gaps.title"), total: gaps.size } do %>
  <% gaps.each_with_index do |gap, index| %>
    <% proposal = proposals&.dig(gap.essential_slug) %>
    <% href = if proposal&.exercise_public_id
                course_sheet_path(gap.course_slug, "notion-#{gap.essential_slug}", anchor: "sheet-exercise-#{proposal.exercise_public_id}")
              else
                course_path(gap.course_slug, anchor: "notion-#{gap.essential_slug}")
              end %>
    <%= render "shared/screens/row", title: gap.essential_name, href:,
                                     icon: ui_icon("light-bulb"), folded: index >= ComponentsHelper::REVEAL_LIMIT %>
  <% end %>
<% end %>
