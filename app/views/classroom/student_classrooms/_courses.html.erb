<%# 🌐 UI · classroom/student_classrooms/_courses — « Fiches de cours » de « Ma classe » : une ligne par cours d'un exercice assigné %>
<%# Rôle : pastille de la matière, nom du cours, « Matière · n exercices assignés » ; la ligne mène au cours ; 3 puis « Voir plus (n) » ; masquée sans cours %>
<%# ADR  : 0072 · UDR : 0173 §3 (règles 5, 7, 8), 0076 §3.2 %>
<%# locals: (courses:) -%>
<% if courses.any? %>
  <%= render layout: "shared/screens/group", locals: { id: "student_classroom_courses", title: t("classroom.student_classrooms.show.courses_title"), total: courses.size } do %>
    <% courses.each_with_index do |course, index| %>
      <% illustration = subject_illustration(course.material_slug) %>
      <%= render "shared/screens/row", id: "course_#{course.slug}", title: course.name, href: course_path(course.slug),
                                       detail: "#{course.material_name} · #{t("classroom.student_classrooms.course_card.assigned", count: course.assigned_count)}",
                                       icon: image_tag(illustration.path, alt: "", class: "size-7", loading: "lazy"), tint: illustration.tint,
                                       folded: index >= ComponentsHelper::REVEAL_LIMIT %>
    <% end %>
  <% end %>
<% end %>
