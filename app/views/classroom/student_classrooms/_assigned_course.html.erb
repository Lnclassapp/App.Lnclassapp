<%# 🌐 UI · classroom/student_classrooms/_assigned_course — un cours assigné à la classe de l'élève (CL-22) %>
<%# Rôle : toute la ligne mène au cours du catalogue : nom sur une ligne, matière ; masquée après la 3ᵉ (« Voir plus ») %>
<%# ADR  : 0035, 0048 · UDR : 0007, 0011 (amendée le 2026-10-02), 0057 %>
<%# locals: (course:, course_counter: 0) -%>
<%= tag.li id: "course_#{course.slug}", **ui_reveal_item(course_counter) do %>
  <%= link_to course_path(course.slug),
              class: "group flex min-h-tap items-center gap-4 px-5 py-4 transition hover:bg-mist active:bg-mist sm:px-6 focus-visible:outline-2 focus-visible:outline-brand" do %>
    <div class="min-w-0 flex-1 space-y-1.5">
      <p class="truncate font-display font-extrabold text-ink"><%= course.name %></p>
      <%= ui_subject_badge course.material_name, category: course.material_category, size: :sm %>
    </div>
    <%= ui_icon "chevron-right", variant: :mini, class: "text-mute transition group-hover:translate-x-0.5 group-hover:text-brand-strong" %>
  <% end %>
<% end %>
