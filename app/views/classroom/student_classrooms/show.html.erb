<%# 🌐 UI · classroom/student_classrooms/show — « Ma classe » de l'élève, écran intérieur style Wave (chantier ecrans-wave-ma-classe-historique) %>
<%# Rôle : flèche retour, « Ma classe » et la classe en sous-titre ; puis, d'abord ce qui est à faire : exercices assignés, notions à revoir, fiches de cours, exercices traités, chacun en carte blanche, lignes plates, 3 puis « Voir plus (n) » ; une section vide est masquée %>
<%# ADR  : 0028, 0072, 0089 §4.3 · UDR : 0173 (écrans minimalistes style Wave §3, règles 1 à 8), 0011, 0057, 0076 §3.2, 0145 · sans nom d'élève %>
<% page_title t(".page_title") %>
<% content_for :inner, "1" %>
<% classroom = @classroom %>
<% sheets = @assigned_sheets %>
<% pending_gaps = classroom.pending_gaps %>
<% treated = classroom.treated_exercises %>
<% courses = classroom.courses %>
<% level = [ classroom.level_name, classroom.series_name ].compact.join(" · ") %>
<% subtitle = [ classroom.classroom_name, (level unless level == classroom.classroom_name), classroom.school_name, classroom.school_year ].compact_blank.join(" · ") %>

<div id="student_classroom" class="mx-auto w-full max-w-180 space-y-6 pb-6">
  <%= render "shared/screens/inner_header", title: t(".title"), back_href: student_home_path, subtitle: %>

  <% unless classroom.has_teacher %>
    <%= render "no_teacher", classroom: %>
  <% end %>

  <%= render "assigned_sheets", sheets: %>

  <% if pending_gaps.any? %>
    <%= render "pending_gaps", gaps: pending_gaps, proposals: @remediation_proposals %>
  <% end %>

  <%= render "courses", courses: %>

  <% if treated.any? %>
    <%= render layout: "shared/screens/group", locals: { id: "student_classroom_treated", title: t("classroom.student_classrooms.show.treated_title"), total: treated.size } do %>
      <% treated.each_with_index do |exercise, index| %>
        <% card = exercise_card_for_treated(exercise) %>
        <% illustration = subject_illustration(card.material_slug) %>
        <%= render "shared/screens/row", title: card.title, href: card.href, detail: "#{card.material_name} · #{card.type_label}",
                                         icon: image_tag(illustration.path, alt: "", class: "size-7", loading: "lazy"), tint: illustration.tint,
                                         trailing: card.status, folded: index >= ComponentsHelper::REVEAL_LIMIT %>
      <% end %>
    <% end %>
  <% end %>

  <%# Rien du tout : une seule phrase, qui dit ce qui viendra (règle 2 : aucune section vide n'est rendue). %>
  <% if sheets.empty? && pending_gaps.empty? && treated.empty? && courses.empty? %>
    <%= ui_empty_state title: t(".assigned_empty"), description: t(".assigned_empty_description"), icon: "clipboard-document-check" %>
  <% end %>
</div>
