<%# 🌐 UI · classroom/student_classrooms/show — « Ma classe » de l'élève (CL-22, CL-10 volet élève), redessinée (chantier ma-classe-eleve) %>
<%# Rôle : une colonne (pleine, 720 px dès 700 px, 960 px au plus dès 1 024 px) : classe en dégradé, invitation sans enseignant, cours, exercices à faire, fiches à revoir et traités %>
<%# ADR  : 0028, 0048, 0072, 0076, 0089 §4.3 · UDR : 0011, 0057, 0062, 0071 §3.5, 0076 §3.2, 0081 §3.8, 0084, 0086, CA-E3 (mvp-teacher-student) · sans lien « Accueil », sans nom d'élève %>
<% page_title t(".page_title") %>

<%# max-w-180 (720 px) ne borne rien sous 700 px, où la colonne prend toute la largeur moins les marges (UDR-0086 §3.5). %>
<div id="student_classroom" class="mx-auto w-full max-w-180 lg:max-w-240">
  <%# UDR-0086 §3.1 : plus de retour « Accueil », l'en-tête et le menu de l'avatar y mènent (UDR-0084). %>
  <%= ui_page_header title: t(".title") %>

  <%# grid-cols-1 = minmax(0, 1fr) : une ligne longue (titre, bande de cartes) ne peut plus élargir la colonne, ni la page. %>
  <div class="grid grid-cols-1 gap-6">
    <%= render "classroom_card", classroom: @classroom %>

    <% unless @classroom.has_teacher %>
      <%= render "no_teacher", classroom: @classroom %>
    <% end %>

    <%= render "courses", courses: @classroom.courses %>

    <%# UDR-0086 §3.4 : côte à côte dès 1 024 px ; items-start garde à chaque carte sa hauteur. %>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start">
      <%# CA-E3 : « Fiches à revoir » juste après « Exercices assignés », dans la même colonne ; « traités » reste à côté. %>
      <div class="grid grid-cols-1 gap-6">
        <% assigned = @classroom.assigned_exercises %>
        <%= ui_card title: t(".assigned_title"), id: "student_classroom_assigned", data: (ui_reveal_data if assigned.any?) do %>
          <% if assigned.empty? %>
            <%= ui_empty_state title: t(".assigned_empty"), description: t(".assigned_empty_description"),
                               icon: "clipboard-document-check" %>
          <% else %>
            <ul class="divide-y divide-line">
              <% assigned.each_with_index do |exercise, index| %>
                <%= render "assigned_exercise", exercise:, index: %>
              <% end %>
            </ul>
            <%= ui_reveal_more assigned.size %>
          <% end %>
        <% end %>

        <% pending_gaps = @classroom.pending_gaps %>
        <%= render "pending_gaps", gaps: pending_gaps if pending_gaps.any? %>
      </div>

      <% treated = @classroom.treated_exercises %>
      <%= ui_card title: t(".treated_title"), id: "student_classroom_treated", data: (ui_reveal_data if treated.any?) do %>
        <% if treated.empty? %>
          <%= ui_empty_state title: t(".treated_empty"), description: t(".treated_empty_description"), icon: "check-circle" %>
        <% else %>
          <ul class="divide-y divide-line">
            <% treated.each_with_index do |exercise, index| %>
              <%= render "treated_exercise", exercise:, index: %>
            <% end %>
          </ul>
          <%= ui_reveal_more treated.size %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
