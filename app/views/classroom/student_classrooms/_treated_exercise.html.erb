<%# 🌐 UI · classroom/student_classrooms/_treated_exercise — un exercice terminé par l'élève, à son meilleur score %>
<%# Rôle : toute la ligne mène au résultat de sa dernière session : meilleure note sur 20, titre, maîtrise %>
<%# ADR  : 0033 · UDR : 0057 (R3), 0076 §3.2 · charte §5 : vert au-dessus du seuil, neutre sinon, jamais d'ambre ni de rouge %>
<%# locals: (exercise:, index:) -%>
<% passed = exercise.best_score_percent >= Entities::Assessment::Grading::PASS_THRESHOLD %>
<%= tag.li(**ui_reveal_item(index)) do %>
  <%= link_to exercise_session_result_path(exercise.last_session_public_id),
              class: "group flex min-h-tap items-center gap-3 px-4 py-3 transition hover:bg-mist active:bg-mist sm:px-6 focus-visible:outline-2 focus-visible:outline-brand" do %>
    <span class="<%= class_names("grid size-12 shrink-0 place-items-center rounded-ln text-xs font-bold tabular-nums",
                                 passed ? "bg-success-soft text-success" : "bg-mist text-ink") %>"><%= grade_label(exercise.best_score_percent) %></span>
    <span class="min-w-0 flex-1">
      <span class="line-clamp-2 font-medium break-words text-ink"><%= exercise.title %></span>
      <span class="mt-0.5 block text-xs text-mute"><%= t(".best") %> · <%= mastery_label(exercise.best_score_percent) %></span>
    </span>
    <%= ui_icon "chevron-right", variant: :mini, size: :sm, class: "text-mute transition group-hover:translate-x-0.5" %>
  <% end %>
<% end %>
