<%# 🌐 UI · classroom/student_classrooms/_course_card — une carte de la bande « Cours assignés » de « Ma classe » %>
<%# Rôle : toute la carte mène au cours : pastille de la matière, nom, matière, nombre d'exercices assignés à la classe %>
<%# ADR  : 0072 · UDR : 0076 §3.2 · le cours d'un exercice assigné : un cours ne s'assigne plus %>
<%# locals: (course:) -%>
<% illustration = subject_illustration(course.material_slug) %>
<li id="course_<%= course.slug %>" class="shrink-0 basis-3/4 snap-start sm:basis-1/3">
  <%= link_to course_path(course.slug),
              class: "flex h-full flex-col gap-3 rounded-card border border-line bg-white p-4 transition hover:border-brand active:bg-mist focus-visible:outline-2 focus-visible:outline-brand" do %>
    <span class="<%= class_names("grid size-12 place-items-center rounded-full", illustration.tint) %>" aria-hidden="true">
      <%= image_tag illustration.path, alt: "", class: "size-8", loading: "lazy" %>
    </span>
    <span class="line-clamp-2 font-display font-extrabold text-ink"><%= course.name %></span>
    <span class="mt-auto flex flex-wrap items-center gap-2">
      <%= ui_subject_badge course.material_name, category: course.material_category, size: :sm %>
      <span class="text-xs text-mute"><%= t(".assigned", count: course.assigned_count) %></span>
    </span>
  <% end %>
</li>
