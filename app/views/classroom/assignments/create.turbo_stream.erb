<%# 🌐 UI · classroom/assignments/create — exercice assigné, ou refus en place (déjà assigné, type inconnu : 422) %>
<%# Rôle : succès : toast (avec l'échéance s'il y en a une), bascule remplacée par « Assigné · Pour … » ; jours tout juste %>
<%#        donnés : la page est rafraîchie par morphing, ses autres « Assigner » n'ouvrent plus la modale ; refus : toast seul %>
<%# ADR  : 0048, 0072 · UDR : 0006, 0028, 0062 (§3.4) · Stimulus : modal (fermeture sur turbo:submit-end réussi) %>
<% if @refusal %>
  <%= turbo_stream_toast @refusal, type: :error, title: t("classroom.assignments.refusals.title") %>
<% else %>
  <% assignable = @assignment.assignable %>
  <%= turbo_stream_toast @message, type: :success %>
  <%= turbo_stream.replace "assignment_#{@classroom.public_id}_#{assignable.type}_#{assignable.key}",
                           partial: "classroom/assignments/toggle",
                           locals: { classroom_public_id: @classroom.public_id, assignable_type: assignable.type,
                                     assignable_key: assignable.key, assignable_name: assignable.name,
                                     assignment_public_id: @assignment.public_id, due_on: @assignment.due_on } %>
  <% if @days_saved %>
    <%= turbo_stream.refresh(request_id: nil) %>
  <% end %>
<% end %>
