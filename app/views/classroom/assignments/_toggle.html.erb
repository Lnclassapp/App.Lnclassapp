<%# 🌐 UI · classroom/assignments/_toggle — bascule d'assignation d'un exercice dans une classe, remplacée par les streams %>
<%# Rôle : « Assigner » (POST, ou lien vers la modale des jours tant que l'enseignant ne les a pas donnés), ou « Assigné », %>
<%#        l'échéance pour l'enseignant (« Pour jeu. 8 oct. ») et « Retirer » (PATCH archive) %>
<%# ADR  : 0048, 0072 · UDR : 0006, 0028, 0062 (§3.4) %>
<%# locals: (classroom_public_id:, assignable_type:, assignable_key:, assignable_name:, assignment_public_id:, due_on: nil, needs_session_days: false) -%>
<% button = class_names(ComponentsHelper::BUTTON_BASE, ComponentsHelper::BUTTON_SIZES[:sm]) %>
<div id="<%= "assignment_#{classroom_public_id}_#{assignable_type}_#{assignable_key}" %>" class="flex shrink-0 flex-wrap items-center gap-2">
  <% if assignment_public_id %>
    <%= ui_badge t(".assigned"), tone: :success, icon: "check" %>
    <% if due_on %>
      <span class="text-sm text-mute"><%= due_for_teacher(due_on) %></span>
    <% end %>
    <%= button_to archive_assignment_path(assignment_public_id), method: :patch, params: { classroom_public_id: },
                  form_class: "contents", class: class_names(button, ComponentsHelper::BUTTON_VARIANTS[:ghost]),
                  "aria-label": t(".archive_label", name: assignable_name) do %>
      <%= ui_icon "x-mark", size: :sm %><%= t(".archive") %>
    <% end %>
  <% elsif needs_session_days %>
    <%= ui_button t(".assign"), variant: :secondary, size: :sm, icon: "plus",
                  href: new_classroom_assignment_path(classroom_public_id, assignable_key:),
                  data: { turbo_frame: "modal" }, "aria-label": t(".assign_label", name: assignable_name) %>
  <% else %>
    <%= button_to classroom_assignments_path(classroom_public_id),
                  params: { assignment: { assignable_type:, assignable_key: } }, form_class: "contents",
                  class: class_names(button, ComponentsHelper::BUTTON_VARIANTS[:secondary]),
                  "aria-label": t(".assign_label", name: assignable_name) do %>
      <%= ui_icon "plus", size: :sm %><%= t(".assign") %>
    <% end %>
  <% end %>
</div>
