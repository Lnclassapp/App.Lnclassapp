<%# 🌐 UI · classroom/assignments/archive — ressource retirée, ou refus en place (déjà retirée : 422) %>
<%# Rôle : succès : toast « X retiré de la classe » et bascule remplacée par « Assigner » ; refus : toast d'erreur seul %>
<%# ADR  : 0048 · UDR : 0006, 0028 %>
<% if @refusal %>
  <%= turbo_stream_toast @refusal, type: :error, title: t("classroom.assignments.refusals.title") %>
<% else %>
  <% assignable = @assignment.assignable %>
  <%= turbo_stream_toast @message, type: :success %>
  <%= turbo_stream.replace "assignment_#{@classroom.public_id}_#{assignable.type}_#{assignable.key}",
                           partial: "classroom/assignments/toggle",
                           locals: { classroom_public_id: @classroom.public_id, assignable_type: assignable.type,
                                     assignable_key: assignable.key, assignable_name: assignable.name,
                                     assignment_public_id: nil } %>
<% end %>
