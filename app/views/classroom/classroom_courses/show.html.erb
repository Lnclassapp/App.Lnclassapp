<%# 🌐 UI · classroom/classroom_courses/show — un cours vu depuis une classe (CL-11) %>
<%# Rôle : en-tête de la leçon, puis « Fiche de révision », « Prépare interros » et « Prépare devoirs » avec les bascules d'assignation de cette classe %>
<%# ADR  : 0048, 0072, 0113, 0121 · UDR : 0006, 0007, 0028, 0054, 0062, 0139 §3.4, 0149 §3 · retour : la classe %>
<%# Une classe archivée n'a plus cette page (404, Lot C de vie-de-la-classe) : plus d'avis « archivée » ici. %>
<% course = @course.course %>
<% page_title course.name %>
<% content_for :nav_key, "classrooms" %>
<%= ui_back_link @classroom.name, href: classroom_path(@classroom.public_id) %>

<%= ui_card padding: :md, class: "mb-8" do %>
  <div class="min-w-0 space-y-3">
    <p class="text-sm text-mute"><%= t(".context", classroom: @classroom.name, school: @classroom.school_name) %></p>
    <h1 class="font-display text-2xl font-medium tracking-tight text-balance sm:text-3xl"><%= course.name %></h1>
    <% if course.subtitle.present? %>
      <p class="text-mute"><%= course.subtitle %></p>
    <% end %>
    <div class="flex flex-wrap items-center gap-2">
      <%= ui_badge [ course.level_name, course.series_name ].compact.join(" ") %>
      <%= ui_subject_badge course.material_name, category: course.material_category %>
    </div>
  </div>
<% end %>

<div class="space-y-10">
  <section id="fiche-de-revision" aria-labelledby="revision_title">
    <h2 id="revision_title" class="mb-4 font-display text-xl font-medium"><%= t(".revision_title") %></h2>
    <%= render "catalog/courses/revision_sheet", course:, revision: @revision %>
  </section>

  <%# Les bascules de cette classe seulement : une autre classe se gère depuis sa propre page. %>
  <%= render "catalog/courses/prepare_sheets", prepare: @prepare, classroom_public_id: @classroom.public_id %>
</div>
