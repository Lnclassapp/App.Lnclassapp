<%# 🌐 UI · classroom/teacher_homes/show — accueil enseignant (TR-05) : bandeau jaune, « À suivre », fiches de cours et « Inviter », annonces, « Cette semaine », Historique %>
<%# Rôle : le bandeau (hors de la colonne, sous lg), puis une colonne (57 rem dès lg sur fond blanc, sans bandeau, « Cette semaine » et « Historique » côte à côte) : sections de HOME_SECTIONS[:teacher] sans carte enveloppante ni « Bonjour », jamais vides, collègues en attente ; sans classe, la seule carte « Ajoutez vos classes » %>
<%# ADR  : 0026, 0048, 0063, 0076, 0078 · UDR : 0006, 0026, 0050, 0069, 0071 §3.5, 0077 §3.1, 0098 §3.3, 0126, 0143, écrans enseignant §3.1, §3.3, §3.13, accueil-enseignant-actions §3.1 à §3.3 · titre « Accueil · Enseignant · Lnclass » %>
<% page_title t(".page_title") %>
<%# UDR enseignant §3.3 : ni « Bonjour » ni prénom ; la page garde son titre pour les lecteurs d'écran. %>
<h1 class="sr-only"><%= t(".page_title") %></h1>
<%# Le bandeau va bord à bord : le shell le rend au-dessus de la colonne (content_for :home_band) et retire l'en-tête sous lg. %>
<% content_for :home_band, render("shared/navigation/home_band", role: :teacher, user: shell_user) %>
<%# -mt-20 : « À suivre » déborde sur le bandeau de 132 px (le shell garde 24 px de marge haute) ; data-bleed-keep : les cartes restent dans la marge, arrondies, sous 640 px. %>
<%# Dès lg : deux colonnes égales, réservées à « Cette semaine » et « Historique » ; toute autre section prend les deux (lg:col-span-2). %>
<div id="teacher_home" data-bleed-keep class="<%= class_names("mx-auto grid w-full max-w-180 grid-cols-1 gap-6 lg:max-w-228 lg:grid-cols-2", "-mt-20 lg:mt-0" => !lnclass_app?) %>">
  <% home_sections_for(:teacher).each do |key, _icon| %>
    <% if key == :classrooms %>
      <%# min-w-0 : case de la grille, la liste prendrait sinon la largeur de sa bande et la page défilerait en largeur. %>
      <%# UDR accueil-enseignant-actions §3.1 : « À suivre » (ou « Mes classes ») ; sans classe, la carte « Ajoutez vos classes ». %>
      <section id="teacher_home_classrooms" aria-labelledby="teacher_home_classrooms_title" class="min-w-0 lg:col-span-2">
        <% if @home.classrooms.empty? %>
          <h2 id="teacher_home_classrooms_title" class="sr-only"><%= t("classroom.teacher_homes.to_follow.title_all") %></h2>
          <%= render "add_classroom_card", school_label: @home.school_sigle || @home.school_name %>
        <% else %>
          <%= render "to_follow", home: @home %>
        <% end %>
      </section>
    <% elsif key == :courses %>
      <%# ADR-0103 §4.6 : sans matière dans cet établissement, une invitation à les choisir, jamais une grille vide. %>
      <section id="teacher_home_courses" aria-labelledby="teacher_home_courses_title" class="lg:col-span-2">
        <%# UDR accueil-enseignant-actions §3.2 : le titre dit ce que les ronds ouvrent ; une matière, il la nomme. %>
        <% single = @home.materials.first unless @home.several_materials? %>
        <h2 id="teacher_home_courses_title" class="<%= class_names("mb-3 font-display text-base font-medium text-ink", "sr-only" => @home.materials.empty?) %>">
          <%= single ? t(".courses_title_material", material: single.name) : t(".courses_title") %>
        </h2>
        <% if @home.materials.empty? %>
          <%= render "choose_materials", id: "teacher_home_courses_no_materials" %>
        <% else %>
          <%= render "course_levels", home: @home, invite: @invite %>
        <% end %>
      </section>
    <% elsif key == :announcements %>
      <%# UDR-0077 §3.1 : en lecture seule, sans croix (le masquage est à l'élève) ; absente sans annonce lisible. %>
      <% if @announcements.any_readable? %>
        <div class="min-w-0 lg:col-span-2"><%= render "communication/messages/carousel", carousel: @announcements, dismissible: false %></div>
      <% end %>
    <% elsif key == :activity %>
      <%# Sans historique, « Cette semaine » prend les deux colonnes (dès lg) ; vide, elle n'est pas rendue (UDR
          accueil-enseignant-actions §3.3), sauf l'invitation à choisir ses matières. %>
      <% if @follow_ups.any? || @home.materials.empty? %>
        <div class="<%= class_names("min-w-0", "lg:col-span-2" => @history.empty?) %>">
          <%= render "follow_ups", follow_ups: @follow_ups, badges: @home.several_materials?, no_materials: @home.materials.empty? %>
        </div>
      <% end %>
    <% elsif key == :history %>
      <%# Sans « Cette semaine », l'historique prend les deux colonnes. %>
      <% week = @follow_ups.any? || @home.materials.empty? %>
      <div class="<%= class_names("min-w-0", "lg:col-span-2" => !week) %>"><%= render "history", history: @history, badges: @home.several_materials? %></div>
    <% end %>
  <% end %>
  <% if @pending_colleagues %>
    <div class="min-w-0 lg:col-span-2"><%= render "classroom/teacher_homes/pending_colleagues", pending: @pending_colleagues %></div>
  <% end %>
</div>
<%# UDR-0078, amendement du 2026-10-07 : l'invitation à installer l'app, en pop-up, sur l'accueil seulement %>
<%= render "shared/navigation/install_banner", role: "teacher" %>
