<%# 🌐 UI · classroom/teacher_homes/_classroom_card — une classe déclarée sur l'accueil enseignant %>
<%# Rôle : une carte du carrousel : « Tle D 1 · CSMT › » vers la classe, effectif, exercices en cours, badges sans zéro, code et « Copier » %>
<%# ADR  : 0048 · UDR : 0007, 0026, 0077 §3.1, écrans enseignant §3.1, §3.2, §3.3 (carte de classe), §3.12 · locals: (classroom: TeacherHomeQuery::ClassroomRow, school_label:) -%>
<% code = Entities::Classroom::JoinCode.display(classroom.join_code) %>
<% counts = classroom.badge_counts.reject { |_, count| count.zero? } %>
<li id="classroom_<%= classroom.public_id %>" class="shrink-0 basis-5/6 snap-start px-1.5 sm:basis-1/3 lg:basis-69">
  <div class="relative flex h-full flex-col gap-2 rounded-card border border-line bg-white p-5 shadow-card">
    <%= link_to classroom_path(classroom.public_id), "aria-label": t(".header_label", classroom: classroom.name),
                class: "-mt-3 mr-10 inline-flex min-h-tap max-w-full items-center gap-1 rounded-sm text-xs font-medium tracking-wide text-brand-strong uppercase focus-visible:outline-2 focus-visible:outline-brand" do %>
      <span class="truncate"><%= t(".header", classroom: classroom.name, school: school_label) %></span>
      <%= ui_icon "chevron-right", variant: :mini, size: :sm, class: "shrink-0" %>
    <% end %>
    <%= image_tag brand_logo(teacher: true), alt: "", class: "absolute top-5 right-5 size-4.5 rounded-sm" %>
    <p class="text-lg font-medium text-ink"><%= t(".students", count: classroom.active_students_count) %></p>
    <%# Classe vide : la ligne des exercices devient une consigne, sans badge (UDR enseignant §3.3). %>
    <% if classroom.active_students_count.zero? %>
      <p class="text-meta text-mute"><%= t(".empty_hint") %></p>
    <% else %>
      <p class="text-meta text-mute"><%= t(".assignments", count: classroom.active_assignments_count) %></p>
      <% if counts.any? %>
        <ul class="flex flex-wrap gap-1.5" aria-label="<%= t(".badges_label") %>">
          <% counts.each do |level, count| %>
            <li>
              <span class="sr-only"><%= t("assessment.comprehension.badge_box", count:, level: badge_label(level)) %></span>
              <span aria-hidden="true"><%= badge_pill(level, count:) %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    <% end %>
    <%# Le code reste sélectionnable sans JavaScript : le bouton « Copier » ne paraît qu'avec lui. %>
    <div id="classroom_code_<%= classroom.public_id %>" role="group" aria-labelledby="classroom_code_label_<%= classroom.public_id %>"
         class="mt-auto flex items-center justify-between gap-3 rounded-ln border border-dashed border-line-strong p-3 lg:flex-wrap">
      <div class="min-w-0">
        <p id="classroom_code_label_<%= classroom.public_id %>" class="text-xs text-mute"><%= t(".code_label") %></p>
        <p class="font-mono text-base font-medium tracking-widest text-ink select-all"><%= code %></p>
      </div>
      <%= ui_copy_button code, label: t(".copy"), aria_label: t(".copy_label", classroom: classroom.name), copied: t(".copied") %>
    </div>
  </div>
</li>
