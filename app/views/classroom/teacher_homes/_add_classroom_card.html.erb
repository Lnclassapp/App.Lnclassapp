<%# 🌐 UI · classroom/teacher_homes/_add_classroom_card — la carte « Ajoutez vos classes » d'un accueil enseignant sans classe %>
<%# Rôle : l'en-tête (sigle), le titre, la phrase et un bouton plein vers la déclaration des classes (teacher_classrooms_path) %>
<%# ADR  : 0026 · UDR : écrans enseignant §3.13, §3.12, accueil-enseignant-actions §3.1 (aucune classe) · locals: (school_label:) -%>
<div id="add_classroom" class="relative flex flex-col gap-3 rounded-card border border-line bg-white p-5 shadow-card">
  <p class="mr-10 truncate text-xs font-medium tracking-wide text-brand-strong uppercase"><%= school_label %></p>
  <%= image_tag brand_logo(teacher: true), alt: "", class: "absolute top-5 right-5 size-4.5 rounded-sm" %>
  <h3 class="text-lg font-medium text-ink"><%= t(".empty_title") %></h3>
  <p class="text-meta text-mute"><%= t(".empty_description") %></p>
  <%= ui_button t(".action"), href: teacher_classrooms_path, full: true %>
</div>
