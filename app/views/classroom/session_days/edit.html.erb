<%# 🌐 UI · classroom/session_days/edit — jours de séance de l'enseignant pour la classe, dans le frame « modal » (page sans JavaScript) %>
<%# Rôle : feuille du bas à 390 px ; six jours pré-cochés en pilules, « Prochaine séance : … » (Stimulus), « Annuler » et « Enregistrer » ; tout décocher vaut « non renseigné » ; les dates déjà données ne changent pas %>
<%# ADR  : 0072 · UDR : 0006, 0054, 0062 (§3.4, §3.7, §3.9), 0134 (§3.13) · Stimulus : modal, autofocus, classroom--next-session · ouverte par « Modifier les jours de la … » de la fiche de cours %>
<% tab_title = page_title(t(".title", classroom: @classroom.name)) %>
<% error = @form.errors[:weekdays].any? %>
<% checked = @form.weekdays %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title", classroom: @classroom.name), id: "session-days-modal", size: :form, placement: :sheet, open: true,
               document_title: tab_title do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "session-days-form", icon: "check" %>
    <% end %>
    <%= form_with url: classroom_session_days_path(@classroom.public_id), method: :patch, id: "session-days-form",
                  class: "space-y-3",
                  data: { controller: "classroom--next-session", classroom__next_session_today_value: Date.current.iso8601 } do %>
      <%= tag.fieldset id: "session_days_weekdays", class: "space-y-2", "aria-invalid": ("true" if error),
                       "aria-describedby": [ "session_days_unchanged", ("session_days_weekdays_error" if error) ].compact.join(" "),
                       data: { action: "change->classroom--next-session#update" } do %>
        <legend class="sr-only"><%= t(".legend") %></legend>
        <%= hidden_field_tag "session_days[weekdays][]", "", id: nil %>
        <div class="grid grid-cols-3 gap-2">
          <% (1..6).each do |day| %>
            <label class="flex min-h-tap cursor-pointer items-center justify-center rounded-ln border border-line bg-white text-sm font-medium text-ink transition hover:bg-mist has-checked:border-brand-strong has-checked:bg-brand-soft has-checked:text-brand-strong has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-brand">
              <%= check_box_tag "session_days[weekdays][]", day, checked.include?(day), id: "session_days_weekdays_#{day}", class: "sr-only",
                                data: { classroom__next_session_target: "day" } %>
              <span aria-hidden="true"><%= t(".short.#{day}") %></span>
              <span class="sr-only"><%= t(".long.#{day}") %></span>
            </label>
          <% end %>
        </div>
        <% if error %>
          <p id="session_days_weekdays_error" class="flex items-center gap-1.5 text-sm font-medium text-error"
             data-classroom--next-session-target="error">
            <%= ui_icon "exclamation-circle", variant: :mini, size: :sm %><%= t(".invalid") %>
          </p>
        <% end %>
      <% end %>
      <p hidden data-classroom--next-session-target="line" class="text-sm font-medium text-ink" aria-live="polite">
        <%= t(".next_session") %> <span data-classroom--next-session-target="date"></span>
      </p>
      <p id="session_days_unchanged" class="text-sm text-mute"><%= t(".unchanged") %></p>
    <% end %>
  <% end %>
<% end %>
