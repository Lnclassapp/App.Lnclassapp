<%# 🌐 UI · classroom/teachings/_toggle — bascule d'une classe : déclarée ou non %>
<%# Rôle : bouton aria-pressed dans un formulaire POST (déclarer) ou DELETE (retirer), remplacé par le stream de la réponse %>
<%# ADR  : 0030 · UDR : 0025 %>
<%= button_to classroom_teaching_path(classroom.public_id), method: (classroom.declared ? :delete : :post),
              form: { id: "teaching_#{classroom.public_id}", class: "h-full" }, "aria-pressed": classroom.declared.to_s,
              class: class_names("flex h-full min-h-tap w-full cursor-pointer items-center justify-between gap-3 rounded-ln border " \
                                 "px-4 py-3 text-left font-medium text-ink transition focus-visible:outline-2 " \
                                 "focus-visible:outline-offset-2 focus-visible:outline-brand",
                                 classroom.declared ? "border-brand bg-brand-soft" : "border-line bg-white hover:border-brand/40 hover:bg-mist") do %>
  <span><%= classroom.name %></span>
  <% if classroom.declared %>
    <%= ui_icon "check-circle", variant: :solid, class: "text-brand-strong" %>
  <% else %>
    <%= ui_icon "plus-circle", class: "text-mute" %>
  <% end %>
<% end %>
