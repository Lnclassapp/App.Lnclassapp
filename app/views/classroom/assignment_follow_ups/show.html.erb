<%# 🌐 UI · classroom/assignment_follow_ups/show — rapport d'un exercice assigné, enseignant de la classe et équipe %>
<%# Rôle : en-tête (rond de la matière, titre, « Maths · 10 questions · à rendre … »), puis le rapport (section) : « 20 / 27 faits », cases par badge, questions, élèves dont ceux qui n'ont pas fait l'exercice %>
<%# ADR  : 0072, 0079, 0097 (§4.9) · UDR : 0062 (§3.9), 0072 (§3.5 bis), 0109 (§3.1), enseignant (§3.8) · chaque nom mène à la fiche de l'élève ; classe archivée : 404 (ADR-0088) %>
<% follow_up = @follow_up %>
<% illustration = subject_illustration(follow_up.material_slug) %>
<% due = follow_up.due_on ? t(".due", date: l(follow_up.due_on, format: :due_short)) : t(".no_due") %>
<% page_title follow_up.exercise_title %>
<% content_for :nav_key, "classrooms" %>
<%= ui_back_link @classroom.name, href: classroom_path(@classroom.public_id) %>

<div class="mb-8 space-y-4 lg:flex lg:items-start lg:justify-between lg:gap-6 lg:space-y-0">
  <div class="flex min-w-0 items-center gap-4">
    <span class="<%= class_names("grid size-14 shrink-0 place-items-center rounded-full", illustration.tint) %>" aria-hidden="true">
      <%= image_tag illustration.path, alt: "", class: "size-10", loading: "lazy" %>
    </span>
    <div class="min-w-0">
      <p class="text-sm text-mute"><%= t(".context", classroom: @classroom.name, school: @classroom.school_name) %></p>
      <h1 class="font-display text-lg font-medium tracking-tight text-balance sm:text-2xl"><%= follow_up.exercise_title %></h1>
      <p class="text-sm text-mute">
        <%= t(".meta", count: follow_up.question_count, subject: follow_up.material_shortname, due:) %>
        <span class="sr-only"><%= t(".assigned_on", date: l(follow_up.assigned_on, format: t(".assigned_format"))) %></span>
      </p>
    </div>
  </div>
  <%= ui_button t(".see_exercise"), href: exercise_path(follow_up.exercise_public_id), variant: :secondary, icon: "eye",
                                    class: "w-full lg:w-auto lg:shrink-0" %>
</div>

<%# CA-24 : la première copie et la meilleure note de chaque élève qui a rendu ; le nom mène à sa fiche. %>
<% if follow_up.copies.any? %>
  <section id="follow_up_copies" aria-labelledby="follow_up_copies_title" class="mb-8">
    <h2 id="follow_up_copies_title" class="mb-3 font-display text-lg font-medium"><%= t(".copies_title") %></h2>
    <ul class="divide-y divide-line border-b border-line">
      <% follow_up.copies.each do |copy| %>
        <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3">
          <%= link_to copy.display_name, classroom_student_path(@classroom.public_id, copy.public_id),
                      class: "font-medium text-ink underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
          <span class="text-sm text-mute tabular-nums"><%= t(".copy_summary", first: grade_label(copy.first_score), best: grade_label(copy.best_score)) %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%# Une date limite passée (jour d'Abidjan) : « En retard » sous chaque élève qui n'a pas fait l'exercice, et la pastille « N en retard » les compte. %>
<% overdue = follow_up.due_on.present? && follow_up.due_on < Time.zone.today %>
<%= render "assessment/comprehension/section", comprehension: @comprehension, classroom: @classroom, assignment_public_id: follow_up.public_id,
                                                    late: (follow_up.pending_students.size if overdue), pending: follow_up.pending_students,
                                                    overdue: overdue %>
