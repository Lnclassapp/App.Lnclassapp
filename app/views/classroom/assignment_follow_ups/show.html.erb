<%# 🌐 UI · classroom/assignment_follow_ups/show — suivi d'un exercice assigné, enseignant de la classe et équipe %>
<%# Rôle : en-tête (classe, exercice, échéance), trois chiffres en dl, puis les seuls rendus en retard, nommés ; aucun identifiant d'élève %>
<%# ADR  : 0072 · UDR : 0062 (§3.5, §3.9) · les « pas encore faits » ne sont pas nommés (question ouverte du grill) %>
<% follow_up = @follow_up %>
<% counts = follow_up.counts %>
<% page_title follow_up.exercise_title %>
<% content_for :nav_key, "classrooms" %>
<%= ui_back_link @classroom.name, href: classroom_path(@classroom.public_id) %>

<%= ui_card padding: :md, class: "mb-8" do %>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0 space-y-3">
      <p class="text-sm text-mute"><%= t(".context", classroom: @classroom.name, school: @classroom.school_name) %></p>
      <h1 class="font-display text-2xl font-extrabold tracking-tight text-balance sm:text-3xl"><%= follow_up.exercise_title %></h1>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-mute">
        <%= ui_subject_badge follow_up.material_name, category: follow_up.material_category, size: :sm %>
        <span class="font-medium text-ink"><%= due_for_teacher(follow_up.due_on) %></span>
        <span><%= t(".assigned_on", date: l(follow_up.assigned_on, format: t(".assigned_format"))) %></span>
      </div>
    </div>
    <%= ui_button t(".see_exercise"), href: exercise_path(follow_up.exercise_public_id), variant: :ghost, size: :sm, icon: "eye",
                                      class: "self-start sm:shrink-0" %>
  </div>

  <dl id="follow_up_counts" aria-label="<%= t(".counts_label") %>"
      class="mt-6 flex flex-wrap gap-x-10 gap-y-4 border-t border-line pt-5">
    <div>
      <dt class="text-sm text-mute"><%= t(".done") %></dt>
      <dd class="font-display text-3xl font-extrabold tabular-nums"><%= counts.done %></dd>
    </div>
    <% if follow_up.due_on %>
      <div>
        <dt class="text-sm text-mute"><%= t(".late") %></dt>
        <dd class="font-display text-3xl font-extrabold tabular-nums"><%= counts.late %></dd>
      </div>
    <% end %>
    <div>
      <dt class="text-sm text-mute"><%= t(".pending") %></dt>
      <dd class="font-display text-3xl font-extrabold tabular-nums"><%= counts.pending %></dd>
    </div>
  </dl>
<% end %>

<% if follow_up.due_on.nil? %>
  <p class="text-sm text-mute"><%= t(".no_due_date") %></p>
<% elsif follow_up.late_students.any? %>
  <section id="late_students" aria-labelledby="late_students_title">
    <h2 id="late_students_title" class="mb-4 font-display text-xl font-extrabold"><%= t(".late_title") %></h2>
    <ul class="divide-y divide-line rounded-card border border-line bg-white shadow-card">
      <% follow_up.late_students.each do |student| %>
        <li class="flex items-center justify-between gap-3 px-4 py-3 sm:px-5">
          <span class="min-w-0 truncate font-medium"><%= student.display_name %></span>
          <span class="shrink-0 text-sm text-mute tabular-nums"><%= t(".done_on", date: l(student.done_on, format: :due_short)) %></span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
