<%# 🌐 UI · classroom/classroom_essentials/show — une fiche essentielle vue depuis une classe (CL-12, AS-20) %>
<%# Rôle : en-tête de la fiche, élèves à revoir et fiche levée, puis ses exercices publiés, chacun avec sa bascule (échéance, modale des jours) et la réussite %>
<%#        de la classe ; la fiche ne s'assigne plus %>
<%# ADR  : 0048, 0072, 0101 · UDR : 0006, 0007, 0028, 0029 (amendée le 2026-10-02), 0054, 0062 (§3.4), 0069 (§3.8), 0121 · retour : le cours dans la classe %>
<%# Une classe archivée n'a plus cette page (404, Lot C de vie-de-la-classe) : chaque exercice garde sa bascule. %>
<% essential = @essential.essential %>
<% page_title essential.name %>
<% content_for :nav_key, "classrooms" %>
<%= ui_back_link @essential.course_name, href: classroom_course_path(@classroom.public_id, @essential.course_slug) %>

<%= ui_card padding: :md, class: "mb-8" do %>
  <div class="min-w-0 space-y-3">
    <p class="text-sm text-mute"><%= t(".context", classroom: @classroom.name, school: @classroom.school_name) %></p>
    <h1 class="font-display text-2xl font-extrabold tracking-tight text-balance sm:text-3xl"><%= essential.name %></h1>
    <% if essential.subtitle.present? %>
      <p class="text-mute"><%= essential.subtitle %></p>
    <% end %>
  </div>
<% end %>

<%# UDR-0121 §3.2 : qui aider, au-dessus de quoi assigner ; absent sans lacune. %>
<% if @gaps && (@gaps.pending.any? || @gaps.lifted.any?) %>
  <%= render "gaps", detail: @gaps %>
<% end %>

<section id="classroom_essential_exercises" aria-labelledby="classroom_essential_exercises_title">
  <div class="mb-4">
    <h2 id="classroom_essential_exercises_title" class="font-display text-xl font-extrabold"><%= t(".exercises_title") %></h2>
    <p class="mt-1 text-sm text-mute"><%= t(".hint") %></p>
  </div>
  <% if @essential.exercises.empty? %>
    <%= ui_empty_state title: t(".empty"), description: t(".empty_description"), icon: "clipboard-document-list" %>
  <% else %>
    <ul class="divide-y divide-line rounded-card border border-line bg-white shadow-card">
      <% @essential.exercises.each do |exercise| %>
        <li class="flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5">
          <div class="min-w-0">
            <p class="font-medium text-ink"><%= exercise.title %></p>
            <p class="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-xs text-mute">
              <span><%= t(".questions", count: exercise.questions_count) %></span>
              <% if exercise.success_percent %>
                <span><%= t(".success_rate", percent: exercise.success_percent, passed: exercise.passed_students_count,
                                              count: exercise.completed_students_count) %></span>
              <% else %>
                <span><%= t(".no_result") %></span>
              <% end %>
            </p>
          </div>
          <%= render "classroom/assignments/toggle", classroom_public_id: @classroom.public_id, assignable_type: "Exercise",
                     assignable_key: exercise.public_id, assignable_name: exercise.title, classroom_name: @classroom.name,
                     assignment_public_id: exercise.assignment_public_id, due_on: exercise.due_on,
                     needs_session_days: @essential.needs_session_days %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
