<%# 🌐 UI · classroom/classroom_essentials/_gaps — « Élèves à revoir » et « Fiche levée » sur la fiche vue depuis la classe (AS-17) %>
<%# Rôle : les noms, la date, le compte d'échecs dès 2 ; une carte vide n'est pas rendue ; aucun identifiant d'élève dans le HTML %>
<%# ADR  : 0041, 0043, 0101 (§4.4) · UDR : 0121 (§3.2), 0029 · enseignant de la classe et équipe seulement %>
<%# locals: (detail:) -%>
<section id="classroom_essential_gaps" aria-labelledby="classroom_essential_gaps_title" class="mb-8">
  <h2 id="classroom_essential_gaps_title" class="mb-4 font-display text-xl font-medium"><%= t(".title") %></h2>
  <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
    <% if detail.pending.any? %>
      <%= ui_card title: t(".pending_title"), icon: "light-bulb", heading: :h3, id: "classroom_essential_gaps_pending",
                  class: ("lg:col-span-2" if detail.lifted.empty?) do |card| %>
        <% card.actions do %>
          <%= ui_badge detail.pending.size, tone: :warning, size: :sm %>
        <% end %>
        <%= tag.div data: ui_reveal_data do %>
          <ul class="divide-y divide-line">
            <% detail.pending.each_with_index do |row, index| %>
              <%= tag.li class: "flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 py-3", **ui_reveal_item(index) do %>
                <span class="font-medium text-ink"><%= row.display_name %></span>
                <span class="text-sm text-mute">
                  <%= t(".since", date: l(row.opened_on, format: :short)) %><% if row.failed_sessions_count >= 2 %> · <%= t(".failures", count: row.failed_sessions_count) %><% end %>
                </span>
              <% end %>
            <% end %>
          </ul>
          <div class="mt-2"><%= ui_reveal_more detail.pending.size %></div>
        <% end %>
      <% end %>
    <% end %>
    <% if detail.lifted.any? %>
      <%= ui_card title: t(".lifted_title"), icon: "check-badge", heading: :h3, id: "classroom_essential_gaps_lifted",
                  class: ("lg:col-span-2" if detail.pending.empty?) do |card| %>
        <% card.actions do %>
          <%= ui_badge detail.lifted.size, tone: :success, size: :sm %>
        <% end %>
        <%= tag.div data: ui_reveal_data do %>
          <ul class="divide-y divide-line">
            <% detail.lifted.each_with_index do |row, index| %>
              <%= tag.li class: "flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 py-3", **ui_reveal_item(index) do %>
                <span class="font-medium text-ink"><%= row.display_name %></span>
                <span class="text-sm text-mute"><%= t(".lifted_on", date: l(row.resolved_on, format: :short)) %></span>
              <% end %>
            <% end %>
          </ul>
          <div class="mt-2"><%= ui_reveal_more detail.lifted.size %></div>
        <% end %>
      <% end %>
    <% end %>
  </div>
</section>
