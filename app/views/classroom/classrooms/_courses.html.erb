<%# 🌐 UI · classroom/classrooms/_courses — bloc « Cours » de la page d'une classe (memo Q18) %>
<%# Rôle : les cours publiés du niveau (et de la série) de la classe, des matières de l'enseignant, en bande (une par matière au-delà d'une) ; chacun mène au cours dans la classe %>
<%# ADR  : 0072, 0103 · UDR : 0028, 0062 (§3.4), 0077 (§3.4), 0127 (§3.1) · seul chemin de l'enseignant vers les exercices depuis la classe ; l'équipe voit toutes les matières %>
<%# locals: (classroom:, courses:) -%>
<section id="classroom_courses" aria-labelledby="classroom_courses_title" class="min-w-0">
  <h2 id="classroom_courses_title" class="mb-4 font-display text-xl font-medium"><%= t(".title") %></h2>
  <% if courses.empty? %>
    <div id="classroom_courses_empty">
      <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "book-open" %>
    </div>
  <% else %>
    <%# UDR-0127 §3.1 : l'enseignant de plusieurs matières lit une bande par matière, dans son ordre, titrée par la matière ;
        une seule matière (ou l'équipe), une seule bande, sans titre. %>
    <% groups = courses.chunk_while { |one, other| one.material_slug == other.material_slug }.to_a %>
    <% banded = current_actor.teacher? && groups.size > 1 %>
    <div class="space-y-5">
      <% (banded ? groups : [ courses ]).each do |group| %>
        <% first = group.first %>
        <div id="<%= banded ? "classroom_courses_#{first.material_slug}" : "classroom_courses_band" %>" class="min-w-0">
          <% if banded %>
            <h3 class="mb-2 flex items-center gap-2 text-sm font-medium text-mute">
              <%= ui_subject_badge first.material_name, category: first.material_category, size: :sm %>
              <span><%= t(".count", count: group.size) %></span>
            </h3>
          <% end %>
          <% label = banded ? t(".band_label", material: first.material_name) : t(".title") %>
          <%# UDR-0077 §3.4 : la bande et ses points du carrousel d'annonces (UDR-0071 §3.5) ; sans JavaScript, elle défile, sans points. %>
          <div data-controller="communication--carousel">
            <%# L'espace entre cartes est leur remplissage (px-1.5), repris par -mx-1.5 : trois tiers entiers à partir de 640 px. %>
            <ul class="scrollbar-none -mx-1.5 flex snap-x snap-mandatory overflow-x-auto pb-1 motion-safe:scroll-smooth"
                aria-label="<%= label %>" data-communication--carousel-target="track">
              <% group.each do |course| %>
                <li id="classroom_course_<%= course.slug %>" class="shrink-0 basis-3/4 snap-start px-1.5 sm:basis-1/3">
                  <div class="relative flex h-full flex-col gap-3 rounded-card border border-line bg-white p-4 transition hover:border-brand/40">
                    <div class="flex flex-wrap gap-1.5">
                      <%= ui_subject_badge course.material_name, category: course.material_category, size: :sm %>
                      <%= ui_badge [ course.level_name, course.series_name ].compact.join(" · "), size: :sm %>
                    </div>
                    <div class="min-w-0">
                      <%= link_to course.name, classroom_course_path(classroom.public_id, course.slug),
                                  class: "font-display font-medium text-balance after:absolute after:inset-0 after:rounded-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" %>
                      <% if course.subtitle.present? %>
                        <p class="mt-1 line-clamp-2 text-sm text-mute"><%= course.subtitle %></p>
                      <% end %>
                    </div>
                    <p class="mt-auto flex items-center gap-1.5 text-xs text-mute">
                      <%= ui_icon "document-text", size: :sm %><%= t(".essentials", count: course.essentials_count) %>
                    </p>
                  </div>
                </li>
              <% end %>
            </ul>
            <div class="hidden justify-center gap-1.5 pt-3" aria-hidden="true" data-communication--carousel-target="pager">
              <% group.each_index do |index| %>
                <span class="<%= index.zero? ? "h-1.5 w-4 rounded-full bg-brand-strong" : "h-1.5 w-1.5 rounded-full bg-line" %>"
                      data-communication--carousel-target="dot"></span>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</section>
