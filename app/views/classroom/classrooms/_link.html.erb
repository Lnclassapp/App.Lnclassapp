<%# 🌐 UI · classroom/classrooms/_link — carte « Inscrire vos élèves » : partager sur WhatsApp, copier le lien, changer (menu ⋮, confirmation) %>
<%# Rôle : l'adresse /c/<jeton> n'est portée que par les boutons, jamais affichée ; aucun code de classe (il est sur la carte de l'accueil, CA-I1) ; vu par l'enseignant, la direction et l'équipe %>
<%# ADR  : 0063, 0085 (§4.1) · UDR : enseignant §3.5, 0054 (§3.5), 0081 (§3.6) · classroom : public_id, name, link_token · rendu par qui l'accorde %>
<%# locals: (classroom:) -%>
<% url = join_classroom_url(classroom.link_token) %>
<div id="classroom_link" class="rounded-card border border-line bg-white p-4 shadow-card">
  <div class="flex items-center justify-between gap-2">
    <p id="classroom_link_label" class="font-display text-lg font-medium text-ink"><%= t(".label") %></p>
    <div class="-my-2 -mr-2">
      <%= ui_dropdown label: t(".more_label"), id: "classroom-link-menu" do %>
        <%= ui_dropdown_item t(".change"), dialog: "change-classroom-link", icon: "arrow-path" %>
      <% end %>
    </div>
  </div>
  <p class="mt-1 text-sm text-mute"><%= t(".hint") %></p>
  <div class="mt-4 flex flex-wrap gap-2" role="group" aria-labelledby="classroom_link_label">
    <%= ui_button t(".whatsapp"), href: whatsapp_share_url(t(".whatsapp_message", classroom: classroom.name, url:)),
                                  target: "_blank", rel: "noopener", id: "classroom_whatsapp_share" %>
    <%= ui_copy_button url, label: t(".copy"), aria_label: t(".copy_label"), icon: "link", copied: t(".copied"), size: :md %>
  </div>
  <%= ui_modal title: t(".change_title"), id: "change-classroom-link", size: :sm do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".change"), type: :submit, form: "change-classroom-link-form" %>
    <% end %>
    <%= form_with url: classroom_link_path(classroom.public_id), method: :patch, id: "change-classroom-link-form" do %>
      <p class="text-sm text-mute"><%= t(".change_warning") %></p>
    <% end %>
  <% end %>
</div>
