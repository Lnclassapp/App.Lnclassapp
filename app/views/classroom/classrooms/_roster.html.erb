<%# 🌐 UI · classroom/classrooms/_roster — liste nominative de la classe, rendue seulement si ReadClassroomPolicy l'accorde %>
<%# Rôle : « Chercher un élève » ; frame classroom_roster_list : puces de badge (`badge=`), compteur, une ligne par élève (« 9 faits sur 18 », badge de classe, lien vers sa fiche), « Voir les suivants » %>
<%# ADR  : 0028, 0060, 0067, 0083 (§4.4 bis), 0085, 0089 (§4.2), 0097 (§4.7) · UDR : enseignant §3.2 et §3.5, 0007, 0027, 0047, 0054, 0079 (§3.8 ter), 0081 (§3.7), 0084 (§3.7), 0108 · sans menu ⋮ : les actions sont sur la fiche %>
<%# total, page, badge_filter, new_count : par défaut ceux que la page de la classe a lus (@overview, @page) ; le stream
    du retrait (classroom_students/destroy) rend la liste avec focus_title pour rendre le focus au titre (UDR-0081 §3.7).
    can_remove reste dans la signature pour ce stream, qui ne change pas d'appel ; la liste ne l'utilise plus. -%>
<%# locals: (classroom:, students:, search: "", total: @overview&.students_total.to_i, page: @page || 1, badge_filter: @overview&.badge_filter, new_count: @overview&.new_students_count.to_i, can_remove: @can_remove_students == true, focus_title: false) -%>
<% per_page = Queries::Classroom::ClassroomOverviewQuery::PER_PAGE %>
<section id="classroom_roster" aria-labelledby="classroom_roster_title" class="min-w-0">
  <%# UDR-0081 §3.7 : le compte des nouveaux est dans le titre, lu avec lui ; la même balise est rendue par le stream du retrait. %>
  <%= render "classroom/classrooms/roster_title", count: classroom.active_students_count, new_count:, focus: focus_title %>
  <% if classroom.active_students_count.zero? %>
    <div id="classroom_roster_empty">
      <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "user-group" %>
    </div>
  <% else %>
    <%= form_with scope: :classroom_roster_search, url: classroom_path(classroom.public_id), method: :get, id: "classroom-roster-search",
                  html: { role: "search", "aria-label": t(".search_label") }, class: "mb-4 flex flex-col gap-3 sm:flex-row sm:items-end",
                  data: { turbo_frame: "classroom_roster_list", controller: "search" } do |form| %>
      <%# Le filtre de badge se combine à la recherche : il voyage avec elle (UDR enseignant §3.5). %>
      <%= hidden_field_tag :badge, badge_filter, id: nil if badge_filter %>
      <div class="min-w-0 sm:flex-1">
        <%= ui_field form, :q, as: :search, label: t(".search_label"), name: "q", value: search, autocomplete: "off",
                               data: { action: "search#queue" } %>
      </div>
      <%= ui_button t(".search_submit"), type: :submit, variant: :secondary, icon: "magnifying-glass",
                                         data: { search_target: "button" } %>
      <%# UDR-0054 §3.9 : réponse non 2xx → le contrôleur search pose cet état dans le frame. %>
      <template data-search-target="error"><%= ui_error_state retry_href: "#" %></template>
    <% end %>
    <%= turbo_frame_tag "classroom_roster_list", class: "block transition-opacity aria-busy:opacity-50" do %>
      <%= ui_icon_sprite do %>
        <%# UDR enseignant §3.5 : « Tous · Bronze · Argent · Or · Diamant · Pas encore », un badge à la fois ; sans JavaScript, chaque
            puce est un lien qui recharge la page. La recherche se combine au filtre : les puces la gardent. %>
        <nav id="classroom_roster_badges" aria-label="<%= t(".badges_label") %>" class="mb-4 flex gap-2 overflow-x-auto pb-1">
          <% [ nil, *Queries::Classroom::ClassroomOverviewQuery::BADGE_FILTERS ].each do |key| %>
            <% current = key == badge_filter %>
            <%= link_to classroom_path(classroom.public_id, q: search.presence, badge: key, anchor: "classroom_roster"),
                        id: "classroom_roster_badge_#{key || 'all'}", "aria-current": ("true" if current), data: { turbo_action: "advance" },
                        class: class_names("inline-flex min-h-11 shrink-0 items-center gap-1.5 rounded-full border px-4 text-sm",
                                           "focus-visible:outline-2 focus-visible:outline-brand",
                                           current ? "border-brand-strong bg-brand-strong text-white" : "border-line bg-white text-ink hover:bg-mist") do %>
              <% if key && key != Queries::Classroom::ClassroomOverviewQuery::NO_BADGE %>
                <%= comprehension_trophy(current ? "text-white" : comprehension_badge_class(key.to_sym, 1)) %>
              <% end %>
              <%= key ? comprehension_box_label(key.to_sym) : t(".all") %>
            <% end %>
          <% end %>
        </nav>
        <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
          <p id="classroom_roster_count" aria-live="polite" class="text-sm text-mute">
            <% if students.empty? %>
              <%= badge_filter && search.blank? ? t(".empty_badge") : t(".no_match") %>
            <% elsif students.size < total %>
              <%= t(".count_partial", shown: students.size, total:) %>
            <% else %>
              <%= t(".count", count: students.size) %>
            <% end %>
          </p>
          <div class="flex items-center gap-3">
            <%# UDR-0084 §3.7 : « Fait seul (7 j) », colonne de l'ordinateur ; au téléphone, une ligne sous le nom. %>
            <div id="self_practice_heading" class="hidden items-center gap-1 text-sm text-mute sm:flex">
              <%= t(".self_practice") %><%= ui_info_tip t(".self_practice_tip"), label: t(".self_practice") %>
            </div>
            <p class="hidden items-center gap-1 text-sm text-mute sm:flex">
              <%= t(".last_score") %><%= ui_info_tip t(".last_score_tip"), label: t(".last_score") %>
            </p>
          </div>
        </div>
        <% if students.empty? && badge_filter && search.blank? %>
          <%= ui_empty_state title: t(".empty_badge"), icon: "user-group" %>
        <% elsif students.empty? %>
          <%= ui_empty_state title: t(".no_match"), icon: "magnifying-glass" do %>
            <%= ui_button t(".clear_search"), href: classroom_path(classroom.public_id), variant: :secondary, icon: "x-mark",
                                              data: { turbo_frame: "_top" } %>
          <% end %>
        <% else %>
          <% first_added = per_page * (page - 1) if page > 1 %>
          <ul class="divide-y divide-line rounded-card border border-line bg-white shadow-card">
            <% students.each_with_index do |student, index| %>
              <li id="student_<%= student.public_id %>" class="flex items-center gap-3 px-4 py-3 lg:grid lg:grid-cols-content-action lg:gap-y-2">
                <%# UDR-0108 §3.2 : la photo et le nom forment un seul lien vers la fiche ; après « Voir les suivants », le focus
                    va au lien de la première ligne ajoutée, par le contrôleur autofocus (UDR-0054 §3.3 : jamais l'attribut). %>
                <% focus = { controller: "autofocus", autofocus_target: "field" } if index == first_added %>
                <%= link_to classroom_student_path(classroom.public_id, student.public_id), data: { turbo_frame: "_top", **focus.to_h },
                            class: "group flex min-w-0 flex-1 items-center gap-3 rounded-ln focus-visible:outline-2 focus-visible:outline-brand" do %>
                  <span aria-hidden="true" class="shrink-0">
                    <%= ui_avatar student.display_name, src: account_photo_src(student.public_id, student.photo_version), size: :sm %>
                  </span>
                  <div class="min-w-0">
                    <p class="w-full text-sm font-medium break-words underline-offset-4 group-hover:underline sm:truncate"><%= student.display_name %></p>
                    <%# UDR enseignant §3.5 : « 9 faits sur 18 », puis « · 1 en retard » en text-warning. %>
                    <% if student.assigned_count.positive? %>
                      <p id="progress_<%= student.public_id %>" class="text-sm text-mute"><%= t(".done_of", count: student.done_count, assigned: student.assigned_count) %><% if student.late_count.positive? %> <span class="text-warning">· <%= t(".late", count: student.late_count) %></span><% end %></p>
                    <% end %>
                  </div>
                <% end %>
                <div class="flex shrink-0 items-center gap-1 sm:gap-3 lg:justify-self-end">
                  <%# UDR enseignant §3.2, §3.5 : « Or · 15/20 » (trophée du palier sur une pastille neutre) ou « Pas encore » en text-mute. %>
                  <% if student.badge %>
                    <p id="badge_<%= student.public_id %>" class="<%= Assessment::BadgesHelper::BADGE_PILL %> shrink-0">
                      <%= comprehension_trophy(Assessment::ComprehensionHelper::BADGE_ICON_CLASSES.fetch(student.badge)) %>
                      <%= t(".badge_grade", badge: badge_label(student.badge), grade: student.grade) %>
                    </p>
                  <% else %>
                    <p id="badge_<%= student.public_id %>" class="ui-badge ui-badge-md shrink-0 bg-mist text-mute"><%= comprehension_box_label(:none) %></p>
                  <% end %>
                </div>
                <%# ≥ lg : la colonne est étroite (UDR enseignant §3.5), « Fait seul » et le dernier score passent sur une seconde ligne, sous le nom ;
                    en dessous, `contents` laisse ces deux cellules en ligne avec le badge, comme avant. %>
                <div class="contents lg:col-span-2 lg:flex lg:flex-wrap lg:justify-between lg:gap-x-4 lg:gap-y-1">
                  <p id="self_practice_<%= student.public_id %>" class="hidden w-24 text-right text-sm sm:block lg:flex lg:w-auto lg:items-baseline lg:gap-x-2 lg:text-left">
                    <span class="block text-xs text-mute"><%= t(".self_practice") %></span>
                    <% if student.self_practice_count.zero? %>
                      <span class="text-mute">—</span>
                    <% else %>
                      <span class="font-medium tabular-nums"><%= student.self_practice_count %></span>
                    <% end %>
                  </p>
                  <p class="hidden text-right text-sm sm:block lg:flex lg:flex-wrap lg:items-baseline lg:justify-end lg:gap-x-2">
                    <span class="block text-xs text-mute"><%= t(".last_score") %></span>
                    <% if student.last_score_percent %>
                      <span class="font-medium tabular-nums"><%= student.last_score_percent %> %</span>
                      <%# Décision du porteur (2026-09-27) : le score mène au résultat détaillé (note, revue, propositions correctes) %>
                      <%= link_to t(".see_result"), exercise_session_result_path(student.last_session_public_id), data: { turbo_frame: "_top" },
                                  class: "block text-xs font-medium text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
                    <% else %>
                      <span class="text-mute"><%= t(".no_score") %></span>
                    <% end %>
                  </p>
                </div>
              </li>
            <% end %>
          </ul>
          <% if students.size < total %>
            <%# UDR-0108 §3.3, §3.4 : le cadre est remplacé par sa version plus longue ; sans JavaScript, le lien rend la page. %>
            <div id="classroom_roster_more" class="mt-4 flex justify-center">
              <%= ui_button t(".more", count: [ total - students.size, per_page ].min),
                            href: classroom_path(classroom.public_id, q: search.presence, badge: badge_filter,
                                                 page: page + 1, anchor: "classroom_roster"),
                            variant: :secondary, icon: "chevron-down",
                            data: { turbo_frame: "classroom_roster_list", turbo_action: "replace" } %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
</section>
