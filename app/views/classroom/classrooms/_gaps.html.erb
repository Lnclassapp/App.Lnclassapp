<%# 🌐 UI · classroom/classrooms/_gaps — bloc « Fiches à revoir » de la page d'une classe (AS-17) %>
<%# Rôle : une ligne par fiche (nom, nombre d'élèves à revoir), vers la fiche vue depuis la classe ; 3 lignes puis « Voir plus » %>
<%# ADR  : 0043, 0101 (§4.4) · UDR : 0121 (§3.1), 0077 (§3.4 : l'ordre de la page) · enseignant de la classe et équipe seulement %>
<%# locals: (classroom:, gaps:) -%>
<%= tag.section id: "classroom_gaps", "aria-labelledby": "classroom_gaps_title", class: "min-w-0", data: ui_reveal_data do %>
  <h2 id="classroom_gaps_title" class="font-display text-xl font-medium"><%= t(".title") %></h2>
  <p class="mt-1 mb-4 text-sm text-mute"><%= t(".subtitle", grade: Entities::Assessment::Grading.grade_on_20(Entities::Assessment::Grading::PASS_THRESHOLD)) %></p>
  <ul class="divide-y divide-line rounded-card border border-line bg-white shadow-card" data-turbo-prefetch="false">
    <% gaps.each_with_index do |gap, index| %>
      <%= tag.li class: "relative flex items-center gap-3 px-4 py-4 hover:bg-mist sm:px-5", **ui_reveal_item(index) do %>
        <%= ui_icon "light-bulb", size: :md, class: "text-warning" %>
        <div class="min-w-0 flex-1">
          <%= link_to gap.essential_name, classroom_essential_path(classroom.public_id, gap.course_slug, gap.essential_slug),
                      class: "block truncate font-medium text-ink after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-brand" %>
        </div>
        <%= ui_badge t(".students", count: gap.pending_count), tone: :warning, size: :sm %>
        <%= ui_icon "chevron-right", variant: :mini, size: :sm, class: "text-mute" %>
      <% end %>
    <% end %>
  </ul>
  <div class="mt-3"><%= ui_reveal_more gaps.size %></div>
<% end %>
