<%# 🌐 UI · classroom/classrooms/show — page d'une classe (CL-10), enseignant qui y enseigne et équipe %>
<%# Rôle : en-tête (retour selon le rôle, code et lien copiables), jours de séance (enseignant), cours en bande, exercices assignés, élèves %>
<%# ADR  : 0026, 0028, 0072 · UDR : 0006, 0027 (amendée le 2026-10-02), 0054, 0062 (§3.4), 0077 (§3.4 : l'ordre) %>
<% page_title @header.name %>
<% content_for :nav_key, "classrooms" %>
<%= render "header", classroom: @header %>

<div class="space-y-10">
  <% if @overview.session_days %>
    <%= render "session_days", classroom: @header, weekdays: @overview.session_days %>
  <% end %>
  <%= render "courses", classroom: @header, courses: @overview.courses %>
  <%= render "assigned_exercises", classroom: @header, assignments: @overview.assignments %>
  <% if @overview.students %>
    <%= render "roster", classroom: @header, students: @overview.students, search: @search %>
  <% end %>
</div>
