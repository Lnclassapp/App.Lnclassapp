<%# 🌐 UI · classroom/classrooms/show — page d'une classe (CL-10), enseignant qui y enseigne et équipe %>
<%# Rôle : en-tête (retour selon le rôle, titre, « sigle · année »), lien d'inscription, exercices assignés, fiches à revoir, élèves filtrés par badge ; ≥ lg : deux colonnes égales de 57 rem au plus, le lien, les exercices et les fiches à gauche, les élèves à droite %>
<%# ADR  : 0026, 0028, 0072, 0101 · UDR : enseignant §3.5, 0006, 0027, 0054, 0062 (§3.4), 0077 (§3.4 : l'ordre), 0121 · « Vos jours de séance » n'est plus rendu (§3.5, §3.13) : routes et données gardées ; plus de bande « Fiches de cours » : les cours s'ouvrent depuis l'accueil et l'onglet Cours %>
<% page_title @header.name %>
<% content_for :nav_key, "classrooms" %>
<% link_shown = @header.link_shown_to?(current_actor) %>
<div class="lg:mx-auto lg:max-w-228">
  <%= render "header", classroom: @header, school_sigle: @overview.school_sigle %>

  <%# Sans lien, les blocs suivent le titre à 32 px comme avant ; avec lui, c'est le lien qui suit le titre à 16 px. %>
  <div class="<%= class_names("space-y-10 lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-8 lg:space-y-0", "mt-8": !link_shown) %>">
    <div class="min-w-0">
      <%# UDR-0081 §3.6 : le bloc du lien, pour qui gère la classe ; le code n'y est plus (CA-I1, il est sur la carte de l'accueil). %>
      <% if link_shown %>
        <div class="mb-8"><%= render "link", classroom: @header %></div>
      <% end %>
      <div class="space-y-10">
        <%= render "assigned_exercises", classroom: @header, assignments: @overview.assignments %>
        <%# UDR-0121 §3.1 : les fiches à revoir, entre les exercices assignés et les élèves ; absent s'il est vide. %>
        <% if @gaps.present? %>
          <%= render "gaps", classroom: @header, gaps: @gaps %>
        <% end %>
      </div>
    </div>
    <% if @overview.students %>
      <%= render "roster", classroom: @header, students: @overview.students, search: @search %>
    <% end %>
  </div>
</div>
