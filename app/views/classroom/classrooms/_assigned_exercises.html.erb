<%# 🌐 UI · classroom/classrooms/_assigned_exercises — bloc « Exercices assignés » de la page d'une classe, au format de « Cette semaine » %>
<%# Rôle : une carte par assignation active (matière, type, échéance, barre « 20 / 27 faits », pastille « 7 en retard » ou « 7 pas encore », « Voir le suivi ») ; trois cartes puis « Voir plus » %>
<%# ADR  : 0048, 0072, 0079 · UDR : enseignant §3.3 et §3.5, 0062 (§3.4, vide : lien vers « Cours »), 0077 (§3.4 : 3 puis « Voir plus »), 0145 (§3.1, §3.2 : la carte d'exercice) · comptes et lien seulement sous FollowAssignmentPolicy %>
<%# locals: (classroom:, assignments:) -%>
<%= tag.section id: "assigned_exercises", "aria-labelledby": "assigned_exercises_title", class: "min-w-0",
                data: (ui_reveal_data if assignments.any?) do %>
  <h2 id="assigned_exercises_title" class="mb-4 font-display text-xl font-medium"><%= t(".title") %></h2>
  <% if assignments.empty? %>
    <div id="assigned_exercises_empty">
      <%# Seul l'enseignant assigne : l'équipe lit le texte sans le bouton (UDR-0062, 2026-10-29). %>
      <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "clipboard-document-list",
                         action: ({ label: t(".empty_action"), href: courses_path, variant: :secondary, icon: "book-open" } if current_actor.teacher?) %>
    </div>
  <% else %>
    <ul class="grid gap-3 sm:grid-cols-2">
      <% assignments.each_with_index do |assignment, index| %>
        <%= render "assessment/exercises/card", card: exercise_card_for_assignment(assignment, classroom_public_id: classroom.public_id), index: %>
      <% end %>
    </ul>
    <%= ui_reveal_more assignments.size %>
  <% end %>
<% end %>
