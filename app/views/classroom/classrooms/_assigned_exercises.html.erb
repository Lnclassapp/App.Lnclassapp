<%# 🌐 UI · classroom/classrooms/_assigned_exercises — bloc « Exercices assignés » de la page d'une classe, au format de « Cette semaine » %>
<%# Rôle : une ligne par assignation active : titre vers le suivi, matière et échéance, barre « 20 / 27 faits », pastille « 7 en retard » ou « 7 pas encore » ; trois lignes puis « Voir plus » %>
<%# ADR  : 0048, 0072, 0079 · UDR : enseignant §3.3 et §3.5, 0062 (§3.4), 0077 (§3.4 : 3 lignes puis « Voir plus ») · comptes et lien seulement sous FollowAssignmentPolicy %>
<%# locals: (classroom:, assignments:) -%>
<%= tag.section id: "assigned_exercises", "aria-labelledby": "assigned_exercises_title", class: "min-w-0",
                data: (ui_reveal_data if assignments.any?) do %>
  <h2 id="assigned_exercises_title" class="mb-4 font-display text-xl font-medium"><%= t(".title") %></h2>
  <% if assignments.empty? %>
    <div id="assigned_exercises_empty">
      <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "clipboard-document-list" %>
    </div>
  <% else %>
    <ul class="divide-y divide-line border-y border-line">
      <% assignments.each_with_index do |assignment, index| %>
        <% counts = assignment.counts %>
        <%= tag.li id: "assignment_#{assignment.public_id}", class: "relative flex items-center gap-3 py-4 hover:bg-mist",
                   **ui_reveal_item(index) do %>
          <div class="min-w-0 flex-1 space-y-1.5">
            <% if counts %>
              <%= link_to assignment.exercise_title, classroom_assignment_path(classroom.public_id, assignment.public_id),
                          class: "block truncate font-medium text-ink after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-brand" %>
            <% else %>
              <p class="truncate font-medium text-ink"><%= assignment.exercise_title %></p>
            <% end %>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <%= ui_subject_badge assignment.material_name, category: assignment.material_category, size: :sm %>
              <span class="text-sm text-mute"><%= due_for_teacher(assignment.due_on) %></span>
            </div>
            <% if counts %>
              <% total = counts.done + counts.pending %>
              <div class="flex items-center gap-3">
                <div class="min-w-0 flex-1">
                  <%= ui_progress done: counts.done, total:, role: :teacher, label: t("assessment.comprehension.progress.label") %>
                </div>
                <span class="shrink-0 text-sm text-ink tabular-nums"><%= t("assessment.comprehension.progress.done", count: counts.done, total:) %></span>
              </div>
              <%# PRD CA-G6 : échu et pas fait, « 7 en retard » ; sinon « 7 pas encore » ; tous l'ont fait, rien. %>
              <% if counts.pending.positive? %>
                <% overdue = assignment.due_on && assignment.due_on < Time.zone.today %>
                <p>
                  <% if overdue %>
                    <%= ui_badge t("assessment.comprehension.progress.late", count: counts.pending), tone: :warning, dot: true %>
                  <% else %>
                    <%= ui_badge t(".pending", count: counts.pending) %>
                  <% end %>
                </p>
              <% end %>
            <% end %>
          </div>
          <% if counts %>
            <%= ui_icon "chevron-right", variant: :mini, class: "text-mute" %>
          <% end %>
        <% end %>
      <% end %>
    </ul>
    <%= ui_reveal_more assignments.size %>
  <% end %>
<% end %>
