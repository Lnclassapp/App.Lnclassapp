<%# 🌐 UI · classroom/classrooms/_header — en-tête de la page d'une classe (CL-10, CL-04) %>
<%# Rôle : retour selon le rôle ; titre, « CSMT · 2026-2027 » dessous, logo enseignant à droite ; le bloc du lien (_link) est rendu par show, dans la colonne de gauche ; l'effectif est dans le titre de la liste %>
<%# ADR  : 0028, 0041, 0063, 0085 · UDR : enseignant §3.5, 0027, 0050, 0054, 0081 · Stimulus : clipboard · WhatsApp : lien sortant, sans nom d'élève %>
<%# locals: (classroom:, school_sigle:) -%>
<div id="classroom_header">
  <% if shell_user.role.to_s == "team" %>
    <%= ui_back_link classroom.school_name, href: school_path(classroom.school_public_id) %>
  <% else %>
    <%= ui_back_link t(".back"), href: teacher_home_path %>
  <% end %>
  <div class="mt-4 mb-4 flex items-start justify-between gap-3">
    <div class="min-w-0">
      <h1 class="font-display text-lg font-medium text-balance break-words"><%= classroom.name %></h1>
      <%# Un établissement sans sigle se nomme en entier. %>
      <p class="text-sm text-mute"><%= t(".subtitle", school: school_sigle.presence || classroom.school_name, year: classroom.school_year) %></p>
      <% if classroom.status == "archived" %>
        <div class="mt-2"><%= ui_badge t(".archived"), tone: :warning, size: :sm, dot: true %></div>
      <% end %>
    </div>
    <%= image_tag brand_logo(teacher: true), alt: "", class: "size-6 shrink-0 rounded-sm" %>
  </div>
</div>
