<%# 🌐 UI · classroom/student_classroom_changes/new — « Changer de classe » : l'élève à classe active choisit sa nouvelle classe %>
<%# Rôle : rappel de la classe actuelle, alertes, cascade (établissement actuel replié, sa classe « Ta classe »), « Continuer » en GET vers la confirmation %>
<%# ADR  : 0085, 0095 · UDR : 0081 (§3.4, §3.5), 0091, 0102 (§3.1) %>
<% page_title t(".page_title") %>
<%# grid-cols-1 = minmax(0, 1fr) : un nom d'établissement long ne peut pas élargir la colonne. %>
<div class="grid w-full max-w-160 grid-cols-1">
  <%= ui_page_header title: t(".title"), subtitle: t(".current", classroom: @current.name, school: @current.school_name),
                     back: { label: t(".back"), href: profile_path } %>

  <%# UDR-0102 §3.1 : rien n'est écrit ici ; le formulaire mène à la confirmation, en GET. %>
  <%= form_with model: @form, scope: :student_classroom_change, url: confirm_student_classroom_change_path, method: :get,
                id: "student-classroom-change-form", class: "space-y-4",
                data: { controller: "classroom--class-picker",
                        "classroom--class-picker-schools-url-value": drena_schools_path("__drena__", scope: :student_classroom_change),
                        "classroom--class-picker-levels-url-value": school_picker_levels_path("__school__", scope: :student_classroom_change),
                        "classroom--class-picker-classrooms-url-value": school_picker_classrooms_path("__school__", "__level__",
                                                                                                     scope: :student_classroom_change,
                                                                                                     current: @current.public_id) } do |form| %>
    <% if @link_invalid %>
      <div id="classroom-link-invalid" role="alert" class="flex items-start gap-2 rounded-ln bg-warning-soft px-4 py-3 text-sm font-medium text-ink">
        <%= ui_icon "exclamation-triangle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0 text-warning" %>
        <p><%= t(".link_invalid") %></p>
      </div>
    <% end %>
    <%# Classe complète, retiré de cette classe, même classe, débit : la raison en tête ; le focus y va (UDR-0102 §3.7). %>
    <% if @form.errors[:base].any? %>
      <div id="student-classroom-change-refusal" role="alert" tabindex="-1" data-autofocus-target="field"
           class="flex scroll-mt-24 items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error outline-none">
        <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
        <p><%= @form.errors[:base].to_sentence %></p>
      </div>
    <% end %>

    <%= render "classroom/student_registrations/class_picker", form:, scope: :student_classroom_change, framed: true,
                                                               current_classroom_public_id: @current.public_id, **class_picker_lists %>

    <%# Sans JavaScript, jamais désactivé ; le contrôleur classroom--class-picker le désactive tant qu'aucune classe n'est cochée. %>
    <%= ui_button t(".submit"), type: :submit, variant: :brand, size: :lg, full: true, icon_end: "arrow-right",
                                id: "student-classroom-change-submit", data: { "classroom--class-picker-target": "submit" } %>
  <% end %>
</div>
