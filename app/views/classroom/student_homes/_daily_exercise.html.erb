<%# 🌐 UI · classroom/student_homes/_daily_exercise — carte de l'exercice du jour, dans « À faire », sans travail de l'enseignant %>
<%# Rôle : trois états (:proposed « Commencer », :done_today « Bravo, à demain ! », :none) ; « Commencer » démarre la session comme Mes matières %>
<%# ADR  : 0054, 0089 §4.1 · UDR : 0084 §3.6 (états), §3.8 (tokens), §3.10 (section titrée, aria-live) %>
<%# locals: (daily:) -%>
<% scope = "classroom.student_homes.daily_exercise" %>
<section id="student_home_daily" aria-labelledby="student_home_daily_title" class="rounded-card border border-line bg-paper p-4">
  <h3 id="student_home_daily_title" class="inline-flex items-center gap-1.5 rounded-full bg-brand-soft px-2.5 py-1 text-xs font-semibold text-brand-strong">
    <%= ui_icon "sparkles", variant: :mini, size: :sm %><%= t("#{scope}.badge") %>
  </h3>
  <div id="student_home_daily_state" class="mt-3" aria-live="polite" data-state="<%= daily.state %>">
    <% case daily.state %>
    <% when :proposed %>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
        <div class="min-w-0 flex-1 space-y-1.5">
          <%= ui_subject_badge daily.material_name, category: daily.material_category, size: :sm %>
          <p class="line-clamp-2 font-medium break-words text-ink">
            <%= link_to daily.exercise_title, exercise_path(daily.exercise_public_id),
                        class: "rounded-sm hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" %>
          </p>
        </div>
        <%# Le même départ que _assigned_exercise et Mes matières : POST, puis la session (une session en cours reprend). %>
        <%= button_to exercise_sessions_path(daily.exercise_public_id), form_class: "contents",
                      class: class_names(ComponentsHelper::BUTTON_BASE, ComponentsHelper::BUTTON_SIZES[:md],
                                         ComponentsHelper::BUTTON_VARIANTS[:primary], "shrink-0"),
                      "aria-label": t("#{scope}.start_label", title: daily.exercise_title) do %>
          <%= ui_icon "play", size: :sm %><%= t("#{scope}.start") %>
        <% end %>
      </div>
    <% when :done_today %>
      <div class="flex items-start gap-3">
        <%= ui_icon "check-circle", size: :lg, class: "text-success" %>
        <div class="space-y-0.5">
          <p class="font-semibold text-ink"><%= t("#{scope}.done") %></p>
          <% if daily.tomorrow_material_name %>
            <p class="text-sm text-mute"><%= t("#{scope}.tomorrow", subject: daily.tomorrow_material_name) %></p>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-mute"><%= t("#{scope}.none") %></p>
    <% end %>
  </div>
</section>
