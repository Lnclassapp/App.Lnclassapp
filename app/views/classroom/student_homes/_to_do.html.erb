<%# 🌐 UI · classroom/student_homes/_to_do — « À faire » de l'accueil : les exercices assignés non commencés, une liste plate %>
<%# Rôle : rien s'il n'y en a pas ; sinon 3 lignes puis « Voir plus (n) » ; rond de la matière, titre, matière, l'échéance alignée à droite ; triées par échéance (l'ordre de la query) %>
<%# UDR  : XXXX écrans minimalistes style Wave §3 (accueil, règles 2, 7 et 8), 0062 §3.1 (échéance) · locals: (exercises:) -%>
<% open = exercises.select { it.completed_count.zero? } %>
<% if open.any? %>
  <%= render layout: "shared/screens/group", locals: { id: "student_to_do", title: t(".title"), total: open.size } do %>
    <% open.each_with_index do |exercise, index| %>
      <% illustration = subject_illustration(exercise.material_slug) %>
      <%= render "shared/screens/row", id: "student_to_do_#{exercise.public_id}", title: exercise.title, href: exercise_path(exercise.public_id),
                                       tint: illustration.tint, detail: exercise.material_name, value: due_text(exercise.due_on),
                                       folded: index >= ComponentsHelper::REVEAL_LIMIT,
                                       icon: image_tag(illustration.path, alt: "", class: "size-6", loading: "lazy") %>
    <% end %>
  <% end %>
<% end %>
