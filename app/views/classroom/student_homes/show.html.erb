<%# 🌐 UI · classroom/student_homes/show — accueil élève, style Wave : bandeau, carte de la classe, grille des matières, annonces, « À faire », historique, invitation %>
<%# Rôle : le bandeau bleu (hors de la colonne, sous lg), puis le blanc à coins arrondis qui commence à 159 px ; chaque section vide est absente ; sans classe, « Choisis ta classe », la grille de son dernier niveau et les annonces %>
<%# ADR  : 0033, 0043, 0078, 0085, 0089, 0126 (contexte billing, §4.5) · UDR : XXXX écrans minimalistes style Wave §3, 0071 §3.5, 0081 §3.5, 0132 accueil élève (§3.1 structure, amendement eleve-sans-prof), 0158 (§3 bandeau, masqué en bêta : UDR acces-beta), hors-connexion-bandeau-copie-provisoire-et-file §3.6 · titre « Accueil · Élève · Lnclass » %>
<% page_title t(".page_title") %>
<%# UDR-0084 §3.5 : ni « Bonjour » ni prénom ; la page garde son titre pour les lecteurs d'écran. %>
<h1 class="sr-only"><%= t(".page_title") %></h1>
<%# Le bandeau va bord à bord : le shell le rend au-dessus de la colonne (content_for :home_band) et retire l'en-tête sous lg ;
    :wave_home : la page rend elle-même sa colonne (UDR XXXX §3). %>
<% content_for :home_band, render("band", user: shell_user) %>
<% content_for :wave_home, "1" %>

<%# Le message du partage WhatsApp : la bannière d'invitation est sa seule porte (ADR-0089 §4.3). %>
<% invite_href = whatsapp_share_url(t("classroom.student_homes.invite_teacher.message", classroom: @home&.classroom_name, school: @home&.school_name,
                                                                                         link: new_teacher_registration_url)) %>
<%# Phone : des bandes (blanc, gris, blanc, gris) pleine largeur ; dès lg, une colonne centrée sur le fond mist. -mt-wave-lap : le blanc
    recouvre le bandeau de 28 px et commence à 159 px ; la coque Android n'a pas de bandeau, rien ne recouvre. %>
<div id="student_home" class="min-w-0 bg-mist pb-12 lg:mx-auto lg:w-full lg:max-w-180 lg:space-y-6 lg:bg-transparent lg:px-8 lg:py-8 lg:pb-12">
  <div class="<%= class_names("space-y-6 bg-white pb-6 lg:bg-transparent lg:pb-0", "-mt-wave-lap rounded-t-wave lg:mt-0 lg:rounded-none" => !lnclass_app?) %>">
    <% if @home %>
      <%= render "class_card", home: @home, overlap: !lnclass_app? %>
      <div class="px-gutter lg:px-0 lg:pt-2">
        <%= render "subjects", subjects: @home.subjects, late_slugs: @home.late_material_slugs %>
      </div>
    <% else %>
      <%= render "choose_class", form: @form, archived: @archived, overlap: !lnclass_app? %>
      <% if @subjects.present? %>
        <div class="px-gutter lg:px-0"><%= render "subjects", subjects: @subjects, late_slugs: [] %></div>
      <% end %>
    <% end %>
    <%# Les avis, sous la grille : la carte de la classe garde le haut de la jonction. %>
    <div class="space-y-3 px-gutter empty:hidden lg:px-0">
      <%= render "billing/subscriptions/home_notice", access: @access %>
      <%# UDR hors-connexion §3.6 : les copies rendues hors ligne qui attendent le réseau, lues sur l'appareil. %>
      <%= render "shared/offline/pending_copies" %>
    </div>
  </div>
  <%# UDR-0071 §3.5 : seulement si l'élève a au moins une annonce lisible, masquées comprises ; toutes masquées, la
      section est rendue cachée (cible d'« Annuler »). %>
  <% if @announcements&.any_readable? %>
    <%= render "communication/messages/carousel", carousel: @announcements, student: true %>
  <% end %>
  <% if @home %>
    <% to_do = capture { render "to_do", exercises: @home.assigned_exercises } %>
    <%# Historique : le cadre différé rend son titre avec ses lignes, ou rien ; « À faire » vide ne laisse pas de bande blanche. %>
    <div class="bg-white px-gutter py-3 lg:space-y-6 lg:bg-transparent lg:p-0">
      <div class="py-3 empty:hidden lg:p-0"><%= to_do %></div>
      <%= turbo_frame_tag Classroom::StudentHomesController::RECENT_ACTIVITY_FRAME, src: student_home_path, loading: :lazy,
                          target: "_top", class: "block min-h-px" %>
    </div>
    <div class="px-gutter pt-6 lg:p-0">
      <%= render "invite_banner", invite_href: %>
    </div>
  <% end %>
</div>
<%# UDR-0078, amendement du 2026-10-07 : l'invitation à installer l'app, en pop-up, sur l'accueil seulement ; en dernier. %>
<%= render "shared/navigation/install_banner", role: "student" %>
