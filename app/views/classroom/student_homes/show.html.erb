<%# 🌐 UI · classroom/student_homes/show — accueil élève (CL-23, TR-04, AS-36), redessiné (chantier accueil-eleve) %>
<%# Rôle : une colonne (pleine, puis 720 px dès 700 px, 960 px au plus dès 1 024 px) : classe, matières, annonces, à faire, activité différée ; sans classe, « Choisis ta classe » %>
<%# ADR  : 0033, 0043, 0078, 0085, 0089 · UDR : 0057, 0071 §3.5, 0078, 0081 §3.5, 0084 §3.5 · titre « Accueil · Élève · Lnclass » ; listes à 3 lignes puis « Voir plus » %>
<% page_title t(".page_title") %>
<%# UDR-0084 §3.5 : ni « Bonjour » ni prénom ; la page garde son titre pour les lecteurs d'écran. %>
<h1 class="sr-only"><%= t(".page_title") %></h1>

<%# grid-cols-1 = minmax(0, 1fr) : une ligne longue (titre, bande de cartes) ne peut plus élargir la colonne, ni la page.
    max-w-180 (720 px) ne borne rien sous 700 px, où la colonne prend toute la largeur moins les marges. %>
<div id="student_home" class="mx-auto grid w-full max-w-180 grid-cols-1 gap-6 lg:max-w-240">
  <% if @home.nil? %>
    <%# UDR-0081 §3.5 : sans classe active, ni exercices ni matières ni activité à lire (tous suivent la classe) : la seule carte. %>
    <%= render "no_classroom" %>
  <% else %>
    <%# UDR-0084 §3.5 : le même ordre à toutes les tailles, celui de HOME_SECTIONS[:student]. %>
    <% home_sections_for(:student).each do |key, icon| %>
      <% if key == :classroom %>
        <%= render "classroom_card", home: @home %>
      <% elsif key == :subjects %>
        <%= render "subjects", subjects: @home.subjects, late_slugs: @home.late_material_slugs, icon: %>
      <% elsif key == :announcements %>
        <%# UDR-0071 §3.5 : seulement si l'élève a au moins une annonce lisible, masquées comprises ; toutes masquées, la
            section est rendue cachée (cible d'« Annuler »). %>
        <% if @announcements.any_readable? %>
          <%= render "communication/messages/carousel", carousel: @announcements, link: false %>
        <% end %>
      <% elsif key == :todo %>
        <%= render "todo", exercises: @home.assigned_exercises, gaps: @home.pending_gaps, icon:, daily: @daily,
                           classroom: @home.classroom_name, school: @home.school_name %>
      <% end %>
    <% end %>

    <%= ui_card title: t(".activity_title"), subtitle: t(".activity_subtitle"), id: "student_home_activity" do %>
      <%= turbo_frame_tag Classroom::StudentHomesController::RECENT_ACTIVITY_FRAME, src: student_home_path, loading: :lazy,
                          target: "_top" do %>
        <%= ui_loading_state variant: :skeleton %>
      <% end %>
    <% end %>
  <% end %>
</div>
<%# UDR-0078, amendement du 2026-10-07 : l'invitation à installer l'app, en pop-up, sur l'accueil seulement ; en dernier. %>
<%= render "shared/navigation/install_banner", role: "student" %>
