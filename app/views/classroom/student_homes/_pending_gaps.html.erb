<%# 🌐 UI · classroom/student_homes/_pending_gaps — « Fiches essentielles à revoir » (lacunes en attente), sous « À faire » %>
<%# Rôle : une ligne par lacune pending, vers sa fiche essentielle publiée ; 3 lignes, puis « Voir plus » %>
<%# ADR  : 0043 · UDR : 0007, 0057, 0058 §3.3, 0084 §3.5, §3.8 (carte blanche, tokens seuls) %>
<%# locals: (gaps:) -%>
<%= ui_card title: t(".title"), subtitle: t(".subtitle"), id: "student_home_gaps" do %>
  <%= tag.div data: ui_reveal_data do %>
    <ul class="space-y-2">
      <% gaps.each_with_index do |gap, index| %>
        <%= tag.li(**ui_reveal_item(index)) do %>
          <%= link_to course_essential_path(gap.course_slug, gap.essential_slug),
                      class: "group flex min-h-tap items-center gap-3 rounded-ln border border-line bg-white px-4 py-2 font-medium text-ink transition hover:border-brand hover:bg-brand-soft focus-visible:outline-2 focus-visible:outline-brand" do %>
            <%= ui_icon "light-bulb", size: :md, class: "text-mute" %>
            <span class="line-clamp-2 min-w-0 flex-1 break-words"><%= gap.essential_name %></span>
            <%= ui_icon "chevron-right", variant: :mini, size: :sm, class: "text-mute transition group-hover:translate-x-0.5" %>
          <% end %>
        <% end %>
      <% end %>
    </ul>
    <%= ui_reveal_more gaps.size %>
  <% end %>
<% end %>
