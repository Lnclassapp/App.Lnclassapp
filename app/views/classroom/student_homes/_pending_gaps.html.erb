<%# 🌐 UI · classroom/student_homes/_pending_gaps — « Fiches essentielles à revoir » (lacunes en attente) %>
<%# Rôle : une ligne par lacune pending, avec le lien vers sa fiche essentielle publiée %>
<%# ADR  : 0043 · UDR : 0007, 0010 %>
<%# locals: (gaps:) -%>
<%= ui_card title: t(".title"), subtitle: t(".subtitle"), icon: "light-bulb", id: "student_home_gaps" do %>
  <ul class="space-y-2">
    <% gaps.each do |gap| %>
      <li>
        <%= link_to course_essential_path(gap.course_slug, gap.essential_slug),
                    class: "group flex min-h-tap items-center justify-between gap-3 rounded-ln border border-line px-4 py-2 font-medium text-ink transition hover:border-warning hover:bg-warning-soft focus-visible:outline-2 focus-visible:outline-brand" do %>
          <span class="min-w-0 truncate"><%= gap.essential_name %></span>
          <%= ui_icon "chevron-right", variant: :mini, size: :sm, class: "text-mute transition group-hover:translate-x-0.5" %>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
