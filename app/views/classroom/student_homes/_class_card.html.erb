<%# 🌐 UI · classroom/student_homes/_class_card — la carte de la classe, à cheval sur la jonction bleu → blanc de l'accueil %>
<%# Rôle : « Ta classe », son nom, l'établissement, son sigle en pastille ronde (celui de la base, sinon les initiales du nom), le logo Lnclass en bas à droite et « Entrer en classe » vers Ma classe %>
<%# UDR  : XXXX écrans minimalistes style Wave §3 (accueil, carte de classe), 0132 accueil élève §3.1 · locals: (home:, overlap: true) — overlap : la carte remonte sur le bandeau (faux dans la coque Android, qui n'en a pas) -%>
<%= tag.section id: "student_class_card", "aria-labelledby": "student_class_title",
                class: class_names("relative z-10 mx-5 rounded-card bg-white p-5 shadow-lift lg:mx-0", { "max-lg:-top-wave-card max-lg:-mb-wave-card" => local_assigns.fetch(:overlap, true) }) do %>
  <div class="flex items-center gap-3">
    <div class="min-w-0 flex-1">
      <p class="text-xs font-semibold tracking-wide text-brand-strong uppercase"><%= t(".label") %></p>
      <h2 id="student_class_title" class="mt-1 text-2xl leading-tight font-bold text-balance text-ink"><%= home.classroom_name %></h2>
      <p class="mt-1 text-sm text-mute"><%= home.school_name %></p>
    </div>
    <span id="student_school_sigle" aria-hidden="true"
          class="grid size-20 shrink-0 place-items-center rounded-full bg-brand-soft text-2xl font-extrabold tracking-tight text-brand-strong inset-ring-3 inset-ring-white ring-2 ring-brand/20">
      <%= school_sigle(sigle: home.school_sigle, name: home.school_name) %>
    </span>
  </div>
  <div class="mt-4 flex items-center justify-between gap-3">
    <%= ui_button t(".enter"), href: student_classroom_path, id: "student_class_enter", icon_end: "arrow-right",
                  "aria-label": t(".enter_label", classroom: home.classroom_name) %>
    <%= image_tag brand_logo, alt: "", class: "size-5 shrink-0 rounded-sm" %>
  </div>
<% end %>
