<%# 🌐 UI · classroom/student_homes/_assigned_exercise — un exercice assigné : titre, matière, un bouton %>
<%# Rôle : « Commencer » (POST) ou « Reprendre » (session en cours), principal sur la 1re ligne seulement, masqué après la 3e %>
<%# ADR  : 0054 · UDR : 0057, 0058 §3.3 · badge, score, maîtrise et sessions vivent sur la page de l'exercice %>
<%# locals: (exercise:, index:) -%>
<% variant = index.zero? ? :primary : :secondary %>
<%= tag.li class: "flex items-center gap-3 px-5 py-3 sm:gap-4 sm:px-6", **ui_reveal_item(index) do %>
  <div class="min-w-0 flex-1 space-y-1">
    <p class="truncate font-medium text-ink"><%= exercise.title %></p>
    <%= ui_subject_badge exercise.material_name, category: exercise.material_category, size: :sm %>
  </div>
  <div class="shrink-0">
    <% if exercise.started_session_public_id %>
      <%= ui_button t(".resume"), href: exercise_session_path(exercise.started_session_public_id), variant:, size: :sm,
                    icon: "arrow-path", "aria-label": t(".resume_label", title: exercise.title) %>
    <% else %>
      <%= button_to exercise_sessions_path(exercise.public_id), form_class: "contents",
                    class: class_names(ComponentsHelper::BUTTON_BASE, ComponentsHelper::BUTTON_SIZES[:sm],
                                       ComponentsHelper::BUTTON_VARIANTS[variant]),
                    "aria-label": t(".start_label", title: exercise.title) do %>
        <%= ui_icon "play", size: :sm %><%= t(".start") %>
      <% end %>
    <% end %>
  </div>
<% end %>
