<%# 🌐 UI · classroom/student_homes/_classroom_card — « Ma classe », la carte bleue qui ouvre l'accueil élève %>
<%# Rôle : classe, niveau, établissement et effectif, puis « Entrer en classe » ; jamais la liste nominative ni de code (UDR-0081 §3.8) %>
<%# ADR  : 0040, 0041, 0085 · UDR : 0010, 0081, 0084 §3.5, §3.8 (dégradé brand-strong → brand, tokens seuls) %>
<%# locals: (home:) -%>
<%# Le texte reste sur brand-strong (AA avec text-white, dans les deux thèmes) : le dégradé ne s'éclaircit vers brand
    qu'au-delà de 60 %, dans le coin du bouton. Sans shadow-card, la carte garde ses marges et ses coins sous 640 px. %>
<section id="student_home_classroom" aria-labelledby="student_home_classroom_title"
         class="rounded-card bg-linear-to-br from-brand-strong from-60% to-brand p-5 text-white shadow-pop sm:p-6">
  <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex min-w-0 items-center gap-4">
      <span class="grid size-14 shrink-0 place-items-center rounded-card bg-white text-brand-strong" aria-hidden="true">
        <%= ui_icon "academic-cap", size: :xl %>
      </span>
      <div class="min-w-0">
        <h2 id="student_home_classroom_title" class="text-xs font-medium tracking-widest uppercase"><%= t(".title") %></h2>
        <p class="truncate font-display text-2xl leading-tight font-medium"><%= home.classroom_name %></p>
        <p class="text-sm"><%= t(".context", level: home.level_name, school: home.school_name) %></p>
        <p class="mt-0.5 inline-flex items-center gap-1.5 text-sm">
          <%= ui_icon "users", variant: :mini, size: :sm %><%= t(".students", count: home.classmates_count) %>
        </p>
      </div>
    </div>
    <%= link_to student_classroom_path,
                class: "group inline-flex min-h-tap shrink-0 items-center justify-center gap-2 rounded-full bg-white px-6 font-display font-medium text-brand-strong transition active:scale-95 hover:bg-brand-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white" do %>
      <%= ui_icon "door-open", size: :md %><span><%= t(".enter") %></span><%= ui_icon "arrow-right", variant: :mini, size: :md, class: "transition group-hover:translate-x-0.5" %>
    <% end %>
  </div>
</section>
