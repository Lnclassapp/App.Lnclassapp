<%# 🌐 UI · classroom/student_homes/_recent_activity — contenu du frame différé de l'activité récente %>
<%# Rôle : les 10 dernières sessions terminées, avec score et note sur 20, chacune vers son résultat %>
<%# ADR  : 0033 · UDR : 0006, 0010 %>
<%# locals: (sessions:) -%>
<%= turbo_frame_tag Classroom::StudentHomesController::RECENT_ACTIVITY_FRAME, target: "_top" do %>
  <% if sessions.empty? %>
    <%= ui_empty_state title: t(".empty"), description: t(".empty_description"), icon: "bolt" %>
  <% else %>
    <ul class="space-y-2">
      <% sessions.each do |session| %>
        <li>
          <%= link_to exercise_session_result_path(session.public_id),
                      class: "group flex min-h-tap items-center gap-3 rounded-ln px-3 py-2 transition hover:bg-mist focus-visible:outline-2 focus-visible:outline-brand" do %>
            <span class="<%= class_names("grid size-12 shrink-0 place-items-center rounded-ln text-xs font-bold",
                                         session.score_percent >= Entities::Assessment::Grading::PASS_THRESHOLD ? "bg-success-soft text-success" : "bg-warning-soft text-warning") %>">
              <%= t(".score", score: session.score_percent) %>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block truncate text-sm font-medium text-ink"><%= session.exercise_title %></span>
              <span class="mt-0.5 flex flex-wrap gap-x-2 text-xs text-mute">
                <span><%= grade_label(session.score_percent) %></span>
                <span><%= mastery_label(session.score_percent) %></span>
                <span><%= t(".completed", time: time_ago_in_words(session.completed_at)) %></span>
              </span>
            </span>
            <%= ui_icon "chevron-right", variant: :mini, size: :sm, class: "text-mute transition group-hover:translate-x-0.5" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
<% end %>
