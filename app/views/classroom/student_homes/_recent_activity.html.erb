<%# 🌐 UI · classroom/student_homes/_recent_activity — contenu du frame différé de l'activité récente %>
<%# Rôle : les 10 dernières sessions terminées : pastille de la matière, titre, matière, note sur 20 et « il y a … » ; 3 lignes puis « Voir plus » %>
<%# ADR  : 0033 · UDR : 0006, 0057, 0058 §3.3 (une seule forme de la note), 0084 §3.8 (verte dès 14/20, à l'encre dessous, jamais rouge) %>
<%# locals: (sessions:) -%>
<%= turbo_frame_tag Classroom::StudentHomesController::RECENT_ACTIVITY_FRAME, target: "_top" do %>
  <% if sessions.empty? %>
    <%= ui_empty_state title: t(".empty"), description: t(".empty_description"), icon: "bolt" %>
  <% else %>
    <%= tag.div data: ui_reveal_data do %>
      <ul class="divide-y divide-line">
        <% sessions.each_with_index do |session, index| %>
          <% illustration = subject_illustration(session.material_slug) %>
          <%= tag.li(**ui_reveal_item(index)) do %>
            <%= link_to exercise_session_result_path(session.public_id),
                        class: "group -mx-3 flex min-h-tap items-center gap-3 rounded-ln px-3 py-3 transition hover:bg-mist focus-visible:outline-2 focus-visible:outline-brand" do %>
              <span class="<%= class_names("grid size-11 shrink-0 place-items-center rounded-full", illustration.tint) %>" aria-hidden="true">
                <%= image_tag illustration.path, alt: "", class: "size-7", loading: "lazy" %>
              </span>
              <span class="min-w-0 flex-1">
                <span class="line-clamp-2 text-sm font-medium break-words text-ink"><%= session.exercise_title %></span>
                <span class="mt-0.5 block text-xs text-mute"><%= session.material_name %></span>
              </span>
              <span class="shrink-0 text-right">
                <%# Vert dès « 14/20 » affiché (MASTERY_THRESHOLD sur 20, 68 % compris, UDR-0090 §4), à l'encre dessous ; jamais en rouge ni en ambre. %>
                <% grading = Entities::Assessment::Grading %>
                <span data-grade class="<%= class_names("block font-display text-base font-extrabold",
                                                        grading.grade_on_20(session.score_percent) >= grading.grade_on_20(grading::MASTERY_THRESHOLD) ? "text-success" : "text-ink") %>"><%= grade_label(session.score_percent) %></span>
                <span class="block text-xs text-mute"><%= t(".completed", time: time_ago_in_words(session.completed_at)) %></span>
              </span>
            <% end %>
          <% end %>
        <% end %>
      </ul>
      <%= ui_reveal_more sessions.size %>
    <% end %>
  <% end %>
<% end %>
