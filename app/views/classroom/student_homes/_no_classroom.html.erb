<%# 🌐 UI · classroom/student_homes/_no_classroom — l'accueil de l'élève sans classe active (classe archivée, ou retiré) %>
<%# Rôle : à la place de la carte de classe, « Choisis ta classe », son bouton vers la cascade et, s'il existe, l'historique %>
<%# ADR  : 0036, 0040, 0085 · UDR : 0081 (§3.5), 0084 (§3.8, §3.9 : carte blanche, tokens seuls) %>
<%= tag.section id: "student_home_no_classroom", "aria-labelledby": "student_home_no_classroom_title",
                class: class_names(ComponentsHelper::CARD_BASE, ComponentsHelper::CARD_PADDINGS[:md], "space-y-4") do %>
  <span class="grid size-12 place-items-center rounded-ln bg-brand-soft text-brand-strong" aria-hidden="true">
    <%= ui_icon "academic-cap", size: :lg %>
  </span>
  <div class="space-y-1">
    <h2 id="student_home_no_classroom_title" class="font-display text-2xl leading-tight font-extrabold text-ink"><%= t(".title") %></h2>
    <p class="text-sm text-mute"><%= t(".no_classroom") %></p>
  </div>
  <div class="flex flex-col items-start gap-2">
    <%= ui_button t(".choose"), href: new_student_classroom_choice_path, variant: :brand, icon_end: "arrow-right" %>
    <% if @archived %>
      <%= link_to t(".archive"), student_archive_path,
                  class: "inline-flex min-h-tap items-center rounded-sm text-sm font-bold text-brand-strong hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
    <% end %>
  </div>
<% end %>
