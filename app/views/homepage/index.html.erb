<%# 🌐 UI · homepage/index — landing publique de Lnclass %>
<%# Rôle : présente le contenu V1 et oriente chaque rôle par sa modale (TR-01) ; source de l'identité visuelle %>
<%# UDR  : 0012, 0005 · ADR : 0049 (polices servies par l'application, plus de Google Fonts) %>
<% content_for :title, t(".page_title") %>

<div class="min-h-screen bg-paper font-sans text-ink antialiased">
  <%# ---------- En-tête ---------- %>
  <header class="sticky top-0 z-50 border-b border-ink/10 bg-paper/90 backdrop-blur">
    <nav class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-3">
      <%= link_to root_path, class: "flex items-center gap-2.5" do %>
        <%= image_tag "logo/lnclass.jpeg", alt: "", class: "size-9 rounded-sm" %>
        <span class="font-display text-xl font-extrabold tracking-tight">Lnclass</span>
      <% end %>

      <ul class="hidden items-center gap-8 text-sm font-medium text-ink/70 md:flex">
        <li><a href="#pour-qui" class="hover:text-ink"><%= t(".nav.audience") %></a></li>
        <li><a href="#fonctionnalites" class="hover:text-ink"><%= t(".nav.features") %></a></li>
        <li><a href="#comment" class="hover:text-ink"><%= t(".nav.how") %></a></li>
      </ul>

      <div class="flex items-center gap-2">
        <%= ui_button t(".nav.sign_in"), href: new_session_path, variant: :ghost, size: :sm, class: "max-sm:hidden" %>
        <%= ui_button t(".nav.start"), href: "#rejoindre", size: :sm %>
      </div>
    </nav>
  </header>

  <main>
    <%# ---------- Héros ---------- %>
    <section id="hero" class="relative overflow-hidden bg-brand">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 md:grid-cols-2 md:py-24">
        <div>
          <p class="mb-5 inline-flex items-center gap-2 rounded-full bg-ink/10 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-ink"></span>
            <%= t(".hero.eyebrow") %>
          </p>
          <h1 class="font-display text-4xl leading-display font-extrabold tracking-tight text-balance sm:text-5xl lg:text-6xl">
            <%= t(".hero.title") %>
          </h1>
          <p class="mt-6 max-w-lg text-lg text-ink/80"><%= t(".hero.lead") %></p>
          <div class="mt-8 flex flex-wrap gap-3">
            <%= render "role_modal", role: :student, placement: :hero, variant: :primary %>
            <%= render "role_modal", role: :teacher, placement: :hero, variant: :secondary %>
          </div>
        </div>

        <div class="relative">
          <div class="absolute -inset-3 translate-x-4 translate-y-4 rounded-card bg-ink" aria-hidden="true"></div>
          <%= image_tag "homepage/student.png", alt: t(".hero.image_alt"),
                class: "relative aspect-4/3 w-full rounded-card object-cover object-hero" %>
          <div class="absolute -bottom-6 -left-4 flex items-center gap-3 rounded-card bg-white p-3 pr-5 shadow-pop sm:-left-8">
            <span class="grid size-11 place-items-center rounded-ln bg-gold/20"><%= ui_icon "trophy", size: :lg %></span>
            <div class="text-sm leading-tight">
              <p class="font-bold"><%= t(".hero.card_title") %></p>
              <p class="text-ink/60"><%= t(".hero.card_meta") %></p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%# ---------- Matières ---------- %>
    <section aria-label="<%= t(".subjects.label") %>" class="border-b border-ink/10 bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-2 px-5 py-5">
        <p class="mr-2 text-sm font-medium text-ink/70"><%= t(".subjects.label") %></p>
        <% [ [ "Maths", :science ], [ "PC", :science ], [ "SVT", :science ], [ "H-G", :other ],
             [ "Français", :literature ], [ "Philo", :literature ] ].each do |name, category| %>
          <%= ui_subject_badge name, category: %>
        <% end %>
        <span class="ml-1 text-sm text-ink/60"><%= t(".subjects.more") %></span>
      </div>
    </section>

    <%# ---------- Pour qui ---------- %>
    <section id="pour-qui" class="scroll-mt-20 py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-5">
        <div class="max-w-2xl">
          <p class="text-sm font-bold tracking-widest text-brand-strong uppercase"><%= t(".audience.eyebrow") %></p>
          <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight sm:text-4xl"><%= t(".audience.title") %></h2>
          <p class="mt-4 text-lg text-ink/70"><%= t(".audience.lead") %></p>
        </div>

        <% roles = [
          { key: :students, logo: "logo/student.jpg", accent: "bg-brand" },
          { key: :teachers, logo: "logo/teacher.jpg", accent: "bg-teacher" }
        ] %>

        <div class="mt-12 grid gap-5 sm:grid-cols-2">
          <% roles.each do |role| %>
            <article class="group relative overflow-hidden rounded-card border border-ink/10 bg-white p-6 transition hover:-translate-y-1 hover:shadow-pop">
              <div class="absolute inset-x-0 top-0 h-1.5 <%= role[:accent] %>"></div>
              <%= image_tag role[:logo], alt: "", class: "size-16 rounded-card" %>
              <h3 class="mt-5 font-display text-xl font-extrabold"><%= t(".audience.roles.#{role[:key]}.title") %></h3>
              <p class="mt-2 text-ink/70"><%= t(".audience.roles.#{role[:key]}.text") %></p>
            </article>
          <% end %>
        </div>
      </div>
    </section>

    <%# ---------- Fonctionnalités ---------- %>
    <section id="fonctionnalites" class="scroll-mt-20 bg-ink py-20 text-white md:py-28">
      <div class="mx-auto max-w-6xl px-5">
        <div class="grid gap-12 md:grid-cols-5 md:gap-16">
          <div class="md:col-span-2">
            <p class="text-sm font-bold tracking-widest text-brand uppercase"><%= t(".features.eyebrow") %></p>
            <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight sm:text-4xl"><%= t(".features.title") %></h2>
            <p class="mt-4 text-lg text-white/70"><%= t(".features.lead") %></p>
          </div>

          <dl class="grid gap-px overflow-hidden rounded-card bg-white/10 sm:grid-cols-2 md:col-span-3">
            <% %i[exercises curriculum badges teachers].each_with_index do |feature, i| %>
              <div class="bg-ink p-6">
                <dt class="flex items-baseline gap-3">
                  <span class="font-display text-sm font-extrabold text-brand"><%= format("%02d", i + 1) %></span>
                  <span class="font-display text-lg font-extrabold"><%= t(".features.items.#{feature}.title") %></span>
                </dt>
                <dd class="mt-2 text-white/65"><%= t(".features.items.#{feature}.text") %></dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>
    </section>

    <%# ---------- Comment ça marche ---------- %>
    <section id="comment" class="scroll-mt-20 py-20 md:py-28">
      <div class="mx-auto max-w-6xl px-5">
        <div class="mx-auto max-w-2xl text-center">
          <p class="text-sm font-bold tracking-widest text-brand-strong uppercase"><%= t(".how.eyebrow") %></p>
          <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight sm:text-4xl"><%= t(".how.title") %></h2>
        </div>

        <ol class="mt-14 grid gap-8 md:grid-cols-3">
          <% %i[code join learn].each_with_index do |step, i| %>
            <li class="relative rounded-card bg-brand-soft p-6">
              <span class="grid size-12 place-items-center rounded-full bg-ink font-display text-lg font-extrabold text-white"><%= i + 1 %></span>
              <h3 class="mt-5 font-display text-xl font-extrabold"><%= t(".how.steps.#{step}.title") %></h3>
              <p class="mt-2 text-ink/70"><%= t(".how.steps.#{step}.text") %></p>
            </li>
          <% end %>
        </ol>
      </div>
    </section>

    <%# ---------- Appel à l'action ---------- %>
    <section id="rejoindre" class="scroll-mt-20 px-5 pb-20 md:pb-28">
      <div class="relative mx-auto max-w-6xl overflow-hidden rounded-sheet bg-brand px-6 py-14 sm:px-12 md:py-20">
        <%= image_tag "logo/lnclass.jpeg", alt: "",
              class: "pointer-events-none absolute -right-16 -bottom-20 w-80 opacity-90 mix-blend-multiply md:w-104" %>
        <div class="relative max-w-xl">
          <h2 class="font-display text-3xl font-extrabold tracking-tight sm:text-5xl"><%= t(".join.title") %></h2>
          <p class="mt-4 text-lg text-ink/80"><%= t(".join.lead") %></p>
          <div class="mt-8 flex flex-wrap gap-3">
            <%= render "role_modal", role: :student, placement: :join, variant: :primary %>
            <%= render "role_modal", role: :teacher, placement: :join, variant: :secondary %>
          </div>
        </div>
      </div>
    </section>
  </main>

  <%# ---------- Pied de page ---------- %>
  <footer class="border-t border-ink/10">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-5 py-8 text-sm text-ink/60 sm:flex-row">
      <div class="flex items-center gap-2">
        <%= image_tag "lnclass/lnclass.png", alt: "", class: "size-6 rounded-sm" %>
        <span class="font-display font-extrabold text-ink">Lnclass</span>
        <span>© <%= Date.current.year %></span>
      </div>
      <ul class="flex gap-6">
        <li><a href="#pour-qui" class="hover:text-ink"><%= t(".nav.audience") %></a></li>
        <li><a href="#fonctionnalites" class="hover:text-ink"><%= t(".nav.features") %></a></li>
        <li><a href="#comment" class="hover:text-ink"><%= t(".nav.how") %></a></li>
      </ul>
    </div>
  </footer>
</div>
