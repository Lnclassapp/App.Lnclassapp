<%# 🌐 UI · active_storage/blobs/_blob — pièce jointe d'un contenu riche (Action Text), rendue sans adresse %>
<%# Rôle : légende, ou nom et taille ; ni image ni lien : les routes Active Storage ne sont pas dessinées et l'éditeur refuse les pièces jointes %>
<%# ADR  : 0060 %>
<figure class="attachment attachment--file attachment--<%= blob.filename.extension %>">
  <figcaption class="attachment__caption">
    <% if caption = blob.try(:caption) %>
      <%= caption %>
    <% else %>
      <span class="attachment__name"><%= blob.filename %></span>
      <span class="attachment__size"><%= number_to_human_size blob.byte_size %></span>
    <% end %>
  </figcaption>
</figure>
