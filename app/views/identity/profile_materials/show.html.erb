<%# 🌐 UI · identity/profile_materials/show — « Mes matières », l'écran de retrait de l'enseignant (/profile/materials) %>
<%# Rôle : « N sur 3 », une ligne par matière avec « Retirer » (UpdateTeacherMaterials sans elle), la dernière sans bouton ; refus du serveur sous la liste ; dès lg, rendu dans le frame du panneau « Mon compte » %>
<%# ADR  : 0103 (§4.4) · UDR : écrans enseignant sans répétition (§3.4) · CA-H3, CA-H5, CA-H7 %>
<% page_title t(".title") %>
<% max = Entities::Identity::TeacherMaterials::MAX %>
<% materials = profile.materials %>
<% removable = materials.size > Entities::Identity::TeacherMaterials::MIN %>
<% errors = @form ? @form.errors[:material_slugs] + @form.errors[:base] : [] %>
<%# UDR §3.4 (≥ lg) : le lien « Mes matières » du panneau charge cet écran dans son frame, sans quitter la page en dessous ; « ‹ Mon compte »
    et « Retirer » y restent, la page entière n'est servie qu'à plein écran (téléphone, sans JavaScript). %>
<% panel = turbo_frame_request_id == NavigationHelper::ACCOUNT_PANEL_FRAME %>
<% screen = capture do %>
<div class="flex max-w-md flex-col gap-4">
<% if panel %>
  <%# Rendu dans le frame, la réponse n'a pas le layout (ni sa région de toasts) : le message de l'envoi précédent se lit ici, et part avec la requête. %>
  <% flash.each do |key, message| %>
    <% next unless message.is_a?(String) %>
    <% alert = key.to_s == "alert" %>
    <%= tag.p message, role: (alert ? "alert" : "status"),
                       class: class_names("rounded-ln px-4 py-3 text-sm font-medium", "bg-error-soft text-error": alert, "bg-success-soft text-success": !alert) %>
  <% end %>
<% end %>
  <div>
    <%= ui_back_link t(".back"), href: teacher_menu_path %>
    <h1 class="font-display text-lg leading-tight font-medium text-ink"><%= t(".title") %></h1>
    <p class="mt-1 text-sm text-mute">
      <%= t(".count", count: materials.size, max:) %><% if materials.size >= max %> <%= t(".full") %><% end %>
    </p>
  </div>

  <ul id="teacher_materials" class="divide-y divide-line">
    <% materials.each do |material| %>
      <% illustration = subject_illustration(material.slug) %>
      <li id="teacher_material_<%= material.slug %>" class="flex items-center gap-3 py-3">
        <span class="<%= class_names("grid size-12 shrink-0 place-items-center rounded-full", illustration.tint) %>">
          <%= image_tag illustration.path, alt: "", class: "size-8", "aria-hidden": true, loading: "lazy" %>
        </span>
        <span class="min-w-0 flex-1 truncate text-ink" title="<%= material.name %>"><%= material.shortname.presence || material.name %></span>
        <% if removable %>
          <%= form_with scope: :profile_materials, url: profile_materials_path, method: :patch, data: { modal_refresh: true } do |form| %>
            <%= hidden_field_tag "profile_materials[screen]", "removal", id: nil %>
            <% materials.reject { it.slug == material.slug }.each do |kept| %>
              <%= hidden_field_tag "profile_materials[material_slugs][]", kept.slug, id: nil %>
            <% end %>
            <%= ui_button t(".remove"), type: :submit, variant: :secondary, size: :sm, "aria-label": t(".remove_label", material: material.name) %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if errors.any? %>
    <p id="teacher_materials_error" role="alert" class="flex items-center gap-1.5 text-sm font-medium text-error">
      <%= ui_icon "exclamation-circle", variant: :mini, size: :sm %><%= errors.to_sentence %>
    </p>
  <% end %>

  <p class="rounded-ln bg-mist p-4 text-sm text-mute"><%= t(".kept_assignments") %></p>
</div>
<% end %>
<%= panel ? turbo_frame_tag(NavigationHelper::ACCOUNT_PANEL_FRAME) { screen } : screen %>
