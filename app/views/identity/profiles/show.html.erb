<%# 🌐 UI · identity/profiles/show — « Mon profil », dans le shell du rôle ; l'élève a sa page (UDR-0089), les autres rôles UDR-0041 %>
<%# Rôle : retour « Accueil », « Mes informations », badge Ambassadeur (enseignant), carte du code secret, « Apparence » %>
<%# ADR  : 0055, 0063 · UDR : 0006, 0041, 0050, 0054, 0057, 0065 (carte « Apparence »), 0089 (élève : _student) %>
<% page_title t(".page_title") %>
<% if current_actor.student? %>
  <%= render "student", profile: @profile %>
<% else %>
<%= ui_page_header title: t(".title"), subtitle: t(".subtitle"), back: { label: t(".back"), href: home_path_for(current_actor.role) } %>

<div class="grid max-w-2xl gap-6">
  <%= render "information", profile: @profile %>

  <% if @referral && Entities::Identity::Ambassador.ambassador?(referred_count: @referral.referred_count) %>
    <%= ui_card id: "profile_ambassador" do %>
      <div class="flex flex-wrap items-center gap-3">
        <%= ui_badge t("identity.referrals.ambassador.badge"), tone: :gold, icon: "trophy" %>
        <p class="text-sm text-mute"><%= t("identity.referrals.ambassador.thanks", count: @referral.referred_count) %></p>
      </div>
    <% end %>
  <% end %>

  <%= ui_card id: "profile_security", "aria-labelledby": "profile_security_title" do %>
    <h2 id="profile_security_title" class="font-display text-lg leading-tight font-extrabold"><%= t(".security_title") %></h2>
    <p class="mt-2 text-sm text-mute"><%= t(".security_body") %></p>
    <div class="mt-4">
      <%= ui_button t(".change_pin"), href: edit_profile_pin_path, icon: "key", data: { turbo_frame: "modal" } %>
    </div>
  <% end %>

  <%# Sur grand écran, l'interrupteur est dans l'en-tête, à côté de l'avatar %>
  <%= render "shared/theme_switch", variant: :card, wrapper: "lg:hidden" %>
</div>
<% end %>
