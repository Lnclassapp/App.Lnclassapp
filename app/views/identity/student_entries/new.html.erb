<%# 🌐 UI · identity/student_entries/new — « Je suis élève », numéro d'abord : le numéro, puis le code (compte) ou « Nouveau sur Lnclass » (code tapé une fois) %>
<%# Rôle : même cadre que la connexion (accueil bleu, carte) ; @stage :contact, :pin ou :new_account ; @preview : bandeau de la classe du lien /c/<jeton> ; 422/429 re-rendus %>
<%# ADR  : 0050, 0141-entree-eleve-revele-un-numero-inscrit, 0148-connexion-revele-un-numero-inscrit · UDR : 0054, 0088, 0176-entree-eleve-unique, 0180-pave-numerique-confirmation-code, 0189-connexion-numero-d-abord (§3.4) %>
<% page_title t("identity.student_entries.new.page_title") %>
<% scope = "identity.student_entries.new" %>
<% link_class = "inline-flex min-h-tap items-center font-medium text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
<% number = lambda do |label|
     tag.div(id: "student-entry-number", class: "rounded-ln bg-paper px-4 py-3") do
       safe_join([ tag.p(label, class: "text-sm text-mute"),
                   tag.p(@form.contact.to_s.scan(/\d{2}/).join(" "), class: "mt-1 font-mono text-xl font-medium tracking-wider text-ink") ])
     end
   end %>
<% fix_number = capture do %>
  <p class="mt-4 text-center text-sm">
    <%= link_to t("#{scope}.not_my_number"), new_student_entry_path(fresh: 1, link: @link_token), id: "student-entry-fix-number", class: link_class,
                data: { turbo_prefetch: false } %>
  </p>
<% end %>
<div class="grid min-h-dvh grid-cols-1 bg-paper lg:grid-cols-2">
  <%= render "shared/auth_welcome", variant: :panel, title: t("#{scope}.welcome") %>

  <div class="flex min-w-0 flex-col">
    <%= render "shared/auth_help" %>
    <main class="flex flex-1 flex-col items-center px-gutter pt-2 pb-10 lg:justify-center lg:pb-16">
      <div class="w-full max-w-110 space-y-4">
        <%= render "shared/auth_welcome", variant: :card, title: t("#{scope}.welcome") %>

        <% if @preview %>
          <%# UDR §3.4 : la classe du lien, rappelée au-dessus du formulaire. %>
          <div id="student-entry-classroom" class="rounded-ln border border-brand/30 bg-brand-soft px-4 py-3">
            <p class="text-xs tracking-wider text-mute uppercase"><%= t("#{scope}.classroom_label") %></p>
            <p class="text-base font-medium text-ink"><%= @preview.classroom_name %> · <%= @preview.school_name %></p>
          </div>
        <% end %>

        <% if @stage == :pin %>
          <%= ui_card title: t("#{scope}.pin_title"), heading: :h1, padding: :lg do %>
            <%= form_with model: @form, scope: :student_entry, url: student_entries_path, id: "student-entry-pin-form", class: "space-y-5",
                          data: { controller: "identity--pin-pad" } do |form| %>
              <% if @link_token %><%= hidden_field_tag "student_entry[link_token]", @link_token, id: nil %><% end %>
              <%= render "identity/student_entries/base_errors" %>
              <%= number.call(t("#{scope}.number_label")) %>
              <input type="text" autocomplete="username" value="<%= @form.contact %>" hidden aria-hidden="true" tabindex="-1">
              <%# UDR-0189 §3.6 (amendement du 2026-11-27) : le code en 4 cases et au pavé, envoyé au 4e chiffre. %>
              <% field = ui_field(form, :pin, as: :password, reveal: true, required: true, minlength: 4, maxlength: 4, pattern: "[0-9]{4}", inputmode: "numeric",
                                  autocomplete: "current-password", placeholder: "****", hint: t("#{scope}.pin_hint"),
                                  data: { identity__pin_pad_target: "field" }) %>
              <%= render "shared/pin_pad", prefix: "student-entry", field:, hint: t("#{scope}.pin_hint"), error: @form.errors.messages_for(:pin).first,
                                           offline: t("#{scope}.pin_pad.offline") %>
              <% if @form.errors.of_kind?(:pin, :wrong_pin) %>
                <%# UDR-0176 §3.3 : « Code secret oublié ? » sous l'erreur du code. %>
                <p class="text-center text-sm">
                  <%= link_to t("#{scope}.forgot_pin"), new_identity_pin_reset_path, id: "student-entry-forgot-pin", class: link_class %>
                </p>
              <% end %>
              <%= ui_button t("#{scope}.submit"), type: :submit, variant: :primary, size: :lg, full: true, id: "student-entry-pin-submit",
                            data: { turbo_submits_with: t("#{scope}.submitting"), identity__pin_pad_target: "submit" } %>
            <% end %>
            <%= fix_number %>
          <% end %>
        <% elsif @stage == :new_account %>
          <%= ui_card title: t("#{scope}.confirm_title"), heading: :h1, padding: :lg do %>
            <%= form_with model: @form, scope: :student_entry, url: student_entries_path, id: "student-entry-confirm-form", class: "space-y-5",
                          data: { controller: "identity--pin-pad" } do |form| %>
              <% if @link_token %><%= hidden_field_tag "student_entry[link_token]", @link_token, id: nil %><% end %>
              <%= render "identity/student_entries/base_errors" %>
              <%= number.call(t("#{scope}.confirm_lead")) %>
              <%# UDR-0189 §3.4 : le code tapé une seule fois ; une erreur de frappe se rattrape par « Code secret oublié ? ». %>
              <% field = ui_field(form, :pin, as: :password, reveal: true, required: true, minlength: 4, maxlength: 4, pattern: "[0-9]{4}", inputmode: "numeric",
                                  autocomplete: "new-password", placeholder: "****", hint: t("#{scope}.confirm_hint"),
                                  data: { identity__pin_pad_target: "field" }) %>
              <%= render "shared/pin_pad", prefix: "student-entry", field:, hint: t("#{scope}.confirm_hint"),
                                           match: t("#{scope}.pin_pad.match"), offline: t("#{scope}.pin_pad.offline") %>
              <%= ui_button t("#{scope}.confirm_submit"), type: :submit, variant: :primary, size: :lg, full: true, id: "student-entry-confirm-submit",
                            data: { turbo_submits_with: t("#{scope}.submitting"), identity__pin_pad_target: "submit" } %>
            <% end %>
            <%= fix_number %>
          <% end %>
        <% else %>
          <%= ui_card title: t("#{scope}.title"), heading: :h1, padding: :lg do %>
            <%= form_with model: @form, scope: :student_entry, url: student_entries_path, id: "student-entry-form", class: "space-y-5",
                          data: { controller: "identity--phone-digits" } do |form| %>
              <% if @link_token %><%= hidden_field_tag "student_entry[link_token]", @link_token, id: nil %><% end %>
              <%= render "identity/student_entries/base_errors" %>
              <%= ui_field form, :contact, as: :tel, required: true, value: @form.raw_contact.presence || @form.contact,
                           maxlength: 20, placeholder: t("#{scope}.contact_placeholder"), inputmode: "numeric", autocomplete: "username",
                           autofocus: @link_token.nil?, hint: t("#{scope}.contact_hint"),
                           data: { identity__phone_digits_target: "input", action: "input->identity--phone-digits#clean" } %>
              <%= ui_button t("#{scope}.submit"), type: :submit, variant: :primary, size: :lg, full: true, id: "student-entry-submit",
                            data: { turbo_submits_with: t("#{scope}.submitting") } %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </main>
  </div>
</div>
