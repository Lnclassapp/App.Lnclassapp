<%# 🌐 UI · identity/sessions/new — connexion par numéro et PIN, pour tous les rôles (au « vous ») : accueil bleu, carte « Connexion » %>
<%# Rôle : carte bleue au-dessus sous lg, panneau bleu à gauche dès lg (carte centrée en hauteur) ; « Besoin d'aide ? » en haut ; 422 re-rendu par Turbo %>
<%# ADR  : 0050, 0084, 0086 · UDR : 0005, 0019, 0054 (§3.3 focus, §3.4 infobulle, §3.8 numéro pré-rempli), 0057, 0060, 0080, 0082 (§3.4), 0088 (§3.1 à §3.3) %>
<% page_title t(".page_title") %>
<div class="grid min-h-dvh grid-cols-1 bg-paper lg:grid-cols-2">
  <%= render "shared/auth_welcome", variant: :panel, title: t(".welcome") %>

  <div class="flex min-w-0 flex-col">
    <%= render "shared/auth_help" %>
    <main class="flex flex-1 flex-col items-center px-gutter pt-2 pb-10 lg:justify-center lg:pb-16">
      <div class="w-full max-w-110 space-y-4">
        <%= render "shared/auth_welcome", variant: :card, title: t(".welcome") %>

        <%= ui_card title: t(".title"), heading: :h1, padding: :lg do %>
          <%= form_with model: @form, scope: :session, url: session_path, id: "session-form", class: "space-y-5",
                        data: { controller: "identity--phone-digits" } do |form| %>
            <% if @wrong_app %>
              <%# Le message selon la coque et l'app proposée ; la coque ouvre dans le navigateur un lien en target="_blank". %>
              <% refusal = ".wrong_app_for.#{@wrong_app[:shell]}.#{@wrong_app[:app]}" %>
              <div id="wrong-app" role="alert" class="flex items-start gap-2 rounded-ln bg-warning-soft px-4 py-3 text-sm text-ink">
                <%= ui_icon "exclamation-triangle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0 text-warning" %>
                <div class="min-w-0">
                  <p class="font-semibold"><%= t("#{refusal}.title") %></p>
                  <p class="mt-0.5"><%= t("#{refusal}.body") %>
                    <%= link_to t("#{refusal}.link"), @wrong_app[:url], target: "_blank", rel: "noopener",
                                class: "font-medium text-brand-strong underline underline-offset-4" %></p>
                </div>
              </div>
            <% end %>
            <% if @form.errors[:base].any? %>
              <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
                <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
                <p><%= @form.errors[:base].to_sentence %></p>
              </div>
            <% end %>
            <%# Chiffres seuls, indicatif retiré, 10 chiffres au plus : même règle que les inscriptions (contrôleur identity--phone-digits). %>
            <%= ui_field form, :contact, as: :tel, required: true, value: @form.raw_contact, maxlength: 10,
                         placeholder: t(".contact_placeholder"), inputmode: "numeric", autocomplete: "username", autofocus: !@prefilled,
                         data: { identity__phone_digits_target: "input", action: "input->identity--phone-digits#clean" } %>
            <div>
              <%= ui_field form, :pin, as: :password, reveal: true, required: true, maxlength: 4, inputmode: "numeric",
                           autocomplete: "current-password", autofocus: @prefilled, placeholder: "****",
                           hint: t(".pin_info_message") %>
              <%= ui_info_tip t(".pin_info_tip"), label: Dtos::Identity::CredentialsInput.human_attribute_name(:pin) %>
            </div>
            <%= ui_button t(".submit"), type: :submit, variant: :brand, full: true %>
            <p class="text-center text-sm">
              <%= link_to t(".forgot_pin"), new_identity_pin_reset_path,
                          class: "inline-flex min-h-tap items-center font-medium text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
            </p>
          <% end %>
          <%# UDR-0088 §3.3 : un filet, puis le chemin vers l'inscription élève (les autres rôles s'inscrivent sur invitation). %>
          <p id="session-sign-up" class="mt-5 flex flex-wrap items-center justify-center gap-x-1.5 border-t border-line pt-4 text-sm text-mute">
            <%= t(".no_account") %>
            <%= link_to t(".sign_up"), new_student_registration_path,
                        class: "inline-flex min-h-tap items-center font-bold text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
          </p>
        <% end %>
      </div>
    </main>
  </div>
</div>
