<%# 🌐 UI · identity/sessions/new — connexion par numéro et PIN : un titre, un formulaire, une action, pour tous les rôles %>
<%# Rôle : deux colonnes à partir de lg ; échec re-rendu en 422 par Turbo ; focus sur le numéro, ou sur le PIN pré-rempli %>
<%# ADR  : 0050, 0084, 0085 · UDR : 0005, 0019, 0054 (§3.2 logo, §3.3 focus, §3.4 infobulle, §3.8 numéro pré-rempli), 0057, 0060, 0080, 0081 (§3.4) %>
<% page_title t(".page_title") %>
<main class="grid min-h-dvh bg-paper lg:grid-cols-2">
  <section class="hidden items-center justify-center bg-brand-soft p-10 lg:flex">
    <div class="max-w-sm text-center">
      <%= link_to root_path, "aria-label": t(".logo_home"),
                             class: "mx-auto mb-6 flex w-fit min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-brand" do %>
        <%= image_tag "logo/lnclass.jpeg", alt: "", class: "size-16 rounded-card object-cover shadow-card" %>
      <% end %>
      <p class="font-display text-2xl font-extrabold text-ink"><%= t(".welcome") %></p>
    </div>
  </section>

  <section class="flex flex-col items-center justify-center px-gutter py-10">
    <div class="mb-8 text-center lg:hidden">
      <%= link_to root_path, "aria-label": t(".logo_home"),
                             class: "mx-auto flex w-fit min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-brand" do %>
        <%= image_tag "logo/lnclass.jpeg", alt: "", class: "size-14 rounded-card object-cover shadow-card" %>
      <% end %>
    </div>

    <div class="w-full max-w-sm">
      <%= ui_card title: t(".title"), heading: :h1, padding: :lg do %>
        <%= form_with model: @form, scope: :session, url: session_path, id: "session-form", class: "space-y-5" do |form| %>
          <% if @wrong_app %>
            <%# Le message selon la coque et l'app proposée ; la coque ouvre dans le navigateur un lien en target="_blank". %>
            <% refusal = ".wrong_app_for.#{@wrong_app[:shell]}.#{@wrong_app[:app]}" %>
            <div id="wrong-app" role="alert" class="flex items-start gap-2 rounded-ln bg-warning-soft px-4 py-3 text-sm text-ink">
              <%= ui_icon "exclamation-triangle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0 text-warning" %>
              <div class="min-w-0">
                <p class="font-semibold"><%= t("#{refusal}.title") %></p>
                <p class="mt-0.5"><%= t("#{refusal}.body") %>
                  <%= link_to t("#{refusal}.link"), @wrong_app[:url], target: "_blank", rel: "noopener",
                              class: "font-medium text-brand-strong underline underline-offset-4" %></p>
              </div>
            </div>
          <% end %>
          <% if @form.errors[:base].any? %>
            <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
              <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
              <p><%= @form.errors[:base].to_sentence %></p>
            </div>
          <% end %>
          <%= ui_field form, :contact, as: :tel, required: true, value: @form.raw_contact, maxlength: 15,
                       placeholder: t(".contact_placeholder"), inputmode: "tel", autocomplete: "username", autofocus: !@prefilled %>
          <div>
            <%= ui_field form, :pin, as: :password, reveal: true, required: true, maxlength: 4, inputmode: "numeric",
                         autocomplete: "current-password", autofocus: @prefilled %>
            <%= ui_info_tip t(".pin_info_tip"), label: Dtos::Identity::CredentialsInput.human_attribute_name(:pin) %>
          </div>
          <%= ui_button t(".submit"), type: :submit, variant: :brand, full: true %>
          <p class="text-center text-sm">
            <%= link_to t(".forgot_pin"), new_identity_pin_reset_path,
                        class: "inline-flex min-h-tap items-center font-medium text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
          </p>
        <% end %>
      <% end %>
    </div>
  </section>
</main>
