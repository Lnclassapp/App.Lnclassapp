<%# 🌐 UI · identity/referrals/show — page « Inviter un collègue », atteinte depuis la déclaration des classes et le panneau du compte %>
<%# Rôle : deux liens (MET-8) : un collègue de l'établissement courant, puis un autre collègue (parrainage) ; sans établissement actif, un état vide %>
<%# ADR  : 0063, 0094 (§11) · UDR : 0006, 0050, 0054, 0098 (§3.6) · retour : « Classes » %>
<% page_title t(".page_title") %>
<% content_for :nav_key, "classrooms" %>
<%= ui_page_header title: t(".title"), subtitle: t(".subtitle"), back: { label: t(".back"), href: teacher_classrooms_path } %>
<div class="flex max-w-3xl flex-col gap-6">
  <% if @invite %>
    <%= render "identity/referrals/invite", invite: @invite %>
    <%= render "identity/referrals/sponsor", invite: @invite %>
  <% else %>
    <%= ui_empty_state title: t(".closed_title"), description: t(".closed_description"), icon: "user-plus" %>
  <% end %>
</div>
