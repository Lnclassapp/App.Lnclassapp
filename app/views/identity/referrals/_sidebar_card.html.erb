<%# 🌐 UI · identity/referrals/_sidebar_card — carte « Parrainage » du frame différé de la barre latérale (ReferralQuery::Row ou nil) %>
<%# Rôle : compteur, badge, lien /e/<code>?ref=<jeton>, WhatsApp et copie comptés comme sur la page d'invitation ; sans invitation, le frame vide %>
<%# ADR  : 0063, 0076 (§4.2) · UDR : 0050, 0069 (§3.6) · Stimulus : identity--share, clipboard · identifiants préfixés sidebar_referral_ (le bloc _invite reste dans le DOM) %>
<%# frame : options du frame quand une page rend la carte avec elle (NavigationHelper::SIDEBAR_FRAME_OPTIONS) %>
<%# locals: (invite:, frame: {}) -%>
<%= turbo_frame_tag "sidebar_referral", **frame do %>
  <% if invite %>
    <% link = school_code_signup_url(invite.school_code, ref: invite.referral_token) %>
    <% message = t("identity.referrals.invite.message", school: invite.school_name, link:) %>
    <section id="sidebar_referral_card" aria-labelledby="sidebar_referral_title" class="rounded-card border border-line bg-white p-4 shadow-card">
      <div class="flex items-center justify-between gap-2">
        <h2 id="sidebar_referral_title" class="font-display text-base font-extrabold"><%= t(".title") %></h2>
        <% if Entities::Identity::Ambassador.ambassador?(referred_count: invite.referred_count) %>
          <%= ui_badge t("identity.referrals.ambassador.badge"), tone: :gold, size: :sm, icon: "trophy" %>
        <% end %>
      </div>
      <p id="sidebar_referral_count" class="mt-1 text-sm text-mute"><%= t("identity.referrals.invite.count", count: invite.referred_count) %></p>

      <p class="mt-3 text-xs font-semibold tracking-wider text-mute uppercase"><%= t(".link_label") %></p>
      <a id="sidebar_referral_link" href="<%= link %>" title="<%= link %>" class="block truncate text-sm font-medium text-brand-strong"><%= link %></a>

      <div id="sidebar_referral_actions" class="mt-3 grid gap-2" data-controller="identity--share"
           data-identity--share-url-value="<%= teacher_referral_shares_path %>" data-identity--share-link-value="<%= link %>"
           data-identity--share-text-value="<%= message %>" data-action="clipboard:copied->identity--share#recordCopy">
        <%= ui_button t("identity.referrals.invite.whatsapp"), href: whatsapp_share_url(message), variant: :brand, size: :sm, full: true,
                      icon: "chat-bubble-left-right", target: "_blank", rel: "noopener",
                      data: { action: "identity--share#record", "identity--share-channel-param": "whatsapp" } %>
        <%= ui_copy_button link, label: t("identity.referrals.invite.copy"), aria_label: t("identity.referrals.invite.copy_label"),
                                 copied: t("shared.clipboard.copied_link"), variant: :secondary, size: :sm, icon: "link" %>
        <%= ui_button t(".more"), href: teacher_invite_path, variant: :ghost, size: :sm, full: true %>
      </div>
    </section>
  <% end %>
<% end %>
