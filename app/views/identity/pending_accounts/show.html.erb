<%# 🌐 UI · identity/pending_accounts/show — compte sans accueil : élève sans classe, enseignant sans école ou en attente %>
<%# Rôle : écran de sortie, sans redirection ; issues : rejoindre une classe ou voir son historique (élève), DRENA puis établissement (enseignant) %>
<%# ADR  : 0030, 0036, 0040, 0063, 0071, 0082 · UDR : 0006, 0050, 0054, 0056, 0078 (§3.9) %>
<% page_title t(".page_title") %>
<div id="pending_account">
  <% if @school_join %>
    <%# Enseignant sans établissement ni demande en attente (retiré, ou demande refusée) : DRENA puis établissement, sans code. %>
    <div class="flex flex-col gap-6">
      <% if @join_request&.status == "rejected" %>
        <div id="join_request_rejected" class="rounded-card border border-line bg-white/60 p-4 text-sm">
          <p class="font-medium text-ink"><%= t(".join_request.rejected.title") %></p>
          <p class="mt-1 text-mute"><%= t(".join_request.rejected.description", school: @join_request.school_name) %></p>
        </div>
      <% end %>
      <%= ui_empty_state title: t(".no_school.title"), description: t(".no_school.description"), icon: "building-library",
                         heading: :h1 %>
      <% if @rate_limited %>
        <%= ui_error_state title: t(".rate_limited.title"), message: t(".rate_limited.message") %>
      <% else %>
        <%# Repli sans JavaScript (UDR-0024 §2.4) : la DRENA choisie revient en GET et liste ses établissements. %>
        <form id="school-join-drena" action="<%= pending_account_path %>" method="get"></form>
        <%= form_with model: @school_join, scope: :school_join, url: pending_school_join_path, id: "school-join-form",
                      class: "flex flex-col gap-4",
                      data: { controller: "school--drena-schools",
                              "school--drena-schools-url-value": drena_schools_path("__drena__", scope: :school_join) } do |form| %>
          <% if @school_join.errors[:base].any? %>
            <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
              <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
              <p><%= @school_join.errors[:base].to_sentence %></p>
            </div>
          <% end %>
          <div class="space-y-2">
            <%= ui_field form, :drena_public_id, as: :select, choices: @drena_options, prompt: t(".drena_prompt"),
                         form: "school-join-drena", data: { action: "change->school--drena-schools#load" } %>
            <%# Repli sans JavaScript : noscript plutôt qu'un attribut posé par Stimulus, que le morphing du 422 effacerait. %>
            <noscript>
              <%= ui_button t(".show_schools"), type: :submit, variant: :secondary, size: :sm, icon: "magnifying-glass",
                            form: "school-join-drena" %>
            </noscript>
          </div>
          <%# Avec JavaScript, le frame vient de /drenas/:id/schools?scope=school_join (ADR-0082 §4.5) : mêmes champs, même scope. %>
          <%= render template: "school/drena_schools/index",
                     locals: { schools: @school_options, drena_public_id: @school_join.drena_public_id, registration: @school_join,
                               scope: :school_join } %>
          <%= ui_button t(".join"), type: :submit, variant: :brand, full: true %>
        <% end %>
      <% end %>
      <%= ui_button t(".sign_out"), href: session_path, method: :delete, variant: :secondary, full: true %>
    </div>
  <% else %>
    <% if @join_request %>
      <% state = @join_request.status == "rejected" ? "rejected" : "pending" %>
      <% title = t(".join_request.#{state}.title") %>
      <% description = t(".join_request.#{state}.description", school: @join_request.school_name) %>
      <% icon = state == "rejected" ? "no-symbol" : "clock" %>
    <% else %>
      <% key = @archived ? "former_student" : @case %>
      <% title, description, icon = t(".#{key}.title"), t(".#{key}.description"), "clock" %>
    <% end %>
    <%# L'état vide est toute la page : son titre en est le h1 (UDR-0054 §3.1). %>
    <%= ui_empty_state title:, description:, icon:, heading: :h1 do %>
      <% if @case == :student %>
        <%= ui_button t(".student.join"), href: new_join_code_path, variant: :brand, icon: "academic-cap" %>
        <% if @archived %>
          <%= ui_button t(".student.archive"), href: student_archive_path, variant: :secondary, icon: "archive-box" %>
        <% end %>
      <% end %>
      <%= ui_button t(".sign_out"), href: session_path, method: :delete, variant: :secondary %>
    <% end %>
  <% end %>
</div>
