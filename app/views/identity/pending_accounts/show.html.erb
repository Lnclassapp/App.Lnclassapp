<%# 🌐 UI · identity/pending_accounts/show — compte sans accueil : élève sans classe, enseignant sans école %>
<%# Rôle : écran de sortie, sans redirection ; seules issues : rejoindre une classe (élève) ou se déconnecter %>
<%# ADR  : 0030, 0040 · UDR : 0006 %>
<% content_for :title, t(".page_title") %>
<%= ui_empty_state title: t(".#{@case}.title"), description: t(".#{@case}.description"), icon: "clock" do %>
  <% if @case == :student %>
    <%= ui_button t(".student.join"), href: new_join_code_path, variant: :brand, icon: "academic-cap" %>
  <% end %>
  <%= ui_button t(".sign_out"), href: session_path, method: :delete, variant: :secondary %>
<% end %>
