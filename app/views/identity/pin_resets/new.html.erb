<%# 🌐 UI · identity/pin_resets/new — nouveau PIN par le code de récupération %>
<%# Rôle : numéro, code à 8 chiffres, nouveau PIN et confirmation ; échec re-rendu en 422 par Turbo %>
<%# ADR  : 0032, 0050 · UDR : 0005 %>
<% content_for :title, t(".page_title") %>
<main class="flex min-h-dvh flex-col items-center justify-center bg-paper px-gutter py-10">
  <div class="w-full max-w-sm">
    <%= ui_card title: t(".title"), subtitle: t(".subtitle"), icon: "key", padding: :lg do %>
      <%= form_with model: @form, scope: :pin_reset, url: identity_pin_reset_path, id: "pin-reset-form", class: "space-y-5" do |form| %>
        <% if @form.errors[:base].any? %>
          <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
            <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
            <p><%= @form.errors[:base].to_sentence %></p>
          </div>
        <% end %>
        <%= ui_field form, :contact, as: :tel, required: true, maxlength: 15, placeholder: t("identity.sessions.new.contact_placeholder"),
                     inputmode: "tel", autocomplete: "tel" %>
        <%= ui_field form, :code, required: true, value: "", maxlength: 8, inputmode: "numeric", autocomplete: "one-time-code",
                     hint: t(".code_hint") %>
        <%= ui_field form, :pin, as: :password, required: true, maxlength: 4, inputmode: "numeric", autocomplete: "new-password",
                     hint: t(".pin_hint") %>
        <%= ui_field form, :pin_confirmation, as: :password, required: true, maxlength: 4, inputmode: "numeric",
                     autocomplete: "new-password" %>
        <%= ui_button t(".submit"), type: :submit, variant: :brand, full: true %>
        <p class="text-center text-sm">
          <%= link_to t(".back"), new_session_path, class: "font-medium text-brand-strong underline-offset-4 hover:underline" %>
        </p>
      <% end %>
    <% end %>
  </div>
</main>
