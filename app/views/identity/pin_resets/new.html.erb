<%# 🌐 UI · identity/pin_resets/new — nouveau PIN par le code de récupération, même carte que la connexion %>
<%# Rôle : numéro, code à 8 chiffres, nouveau PIN et confirmation, formats en infobulle ; échec re-rendu en 422 par Turbo %>
<%# ADR  : 0032, 0050 · UDR : 0005, 0054 (§3.2 : logo vers l'accueil public, retour « Se connecter »), 0057, 0060 %>
<% page_title t(".page_title") %>
<main class="flex min-h-dvh flex-col items-center justify-center bg-paper px-gutter py-10">
  <div class="w-full max-w-sm">
    <div class="mb-6 text-center">
      <%= link_to root_path, "aria-label": t(".logo_home"),
                             class: "mx-auto flex w-fit min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-brand" do %>
        <%= image_tag brand_logo, alt: "", class: "size-14 rounded-card object-cover shadow-card" %>
      <% end %>
    </div>
    <%= ui_back_link t(".back"), href: new_session_path %>
    <%= ui_card title: t(".title"), subtitle: t(".subtitle"), heading: :h1, padding: :lg do %>
      <%= form_with model: @form, scope: :pin_reset, url: identity_pin_reset_path, id: "pin-reset-form", class: "space-y-5" do |form| %>
        <% if @form.errors[:base].any? %>
          <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
            <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
            <p><%= @form.errors[:base].to_sentence %></p>
          </div>
        <% end %>
        <%= ui_field form, :contact, as: :tel, required: true, maxlength: 15, placeholder: t("identity.sessions.new.contact_placeholder"),
                     inputmode: "tel", autocomplete: "tel" %>
        <div>
          <%= ui_field form, :code, required: true, value: "", maxlength: 9, inputmode: "numeric", autocomplete: "one-time-code" %>
          <%= ui_info_tip t(".code_info_tip"), label: Dtos::Identity::PinResetInput.human_attribute_name(:code) %>
        </div>
        <div>
          <%= ui_field form, :pin, as: :password, reveal: true, required: true, maxlength: 4, inputmode: "numeric",
                       autocomplete: "new-password" %>
          <%= ui_info_tip t(".pin_info_tip"), label: Dtos::Identity::PinResetInput.human_attribute_name(:pin) %>
        </div>
        <%= ui_field form, :pin_confirmation, as: :password, reveal: true, required: true, maxlength: 4, inputmode: "numeric",
                     autocomplete: "new-password" %>
        <%= ui_button t(".submit"), type: :submit, variant: :brand, full: true %>
      <% end %>
    <% end %>
  </div>
</main>
