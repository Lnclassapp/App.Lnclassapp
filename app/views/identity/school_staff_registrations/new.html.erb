<%# 🌐 UI · identity/school_staff_registrations/new — inscription de la direction, en deux colonnes, sur le modèle de l'enseignant %>
<%# Rôle : accueil à gauche (teinte école), formulaire à droite ; échec re-rendu en 422 ; débit dépassé en 429 (« Trop de tentatives ») %>
<%# ADR  : 0057, 0077 · UDR : 0005, 0054 (§3.2 : logo vers l'accueil public), 0070 (§3.1) %>
<% page_title t(".page_title") %>
<main class="grid min-h-dvh bg-paper md:grid-cols-2">
  <section class="hidden items-center justify-center bg-school/10 p-10 md:flex">
    <div class="max-w-sm text-center">
      <%= link_to root_path, "aria-label": t(".logo_home"),
                             class: "mx-auto mb-6 flex w-fit min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-brand" do %>
        <%= image_tag "logo/lnclass.jpeg", alt: "", class: "size-16 rounded-card object-cover shadow-card" %>
      <% end %>
      <h1 class="mb-3 font-display text-2xl font-extrabold text-ink"><%= t(".welcome") %></h1>
      <p class="text-sm leading-relaxed text-mute"><%= t(".welcome_hint") %></p>
    </div>
  </section>

  <section class="flex flex-col items-center justify-center px-gutter py-10">
    <div class="mb-8 text-center md:hidden">
      <%= link_to root_path, "aria-label": t(".logo_home"),
                             class: "mx-auto mb-3 flex w-fit min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-brand" do %>
        <%= image_tag "logo/lnclass.jpeg", alt: "", class: "size-14 rounded-card object-cover shadow-card" %>
      <% end %>
      <p class="text-sm text-mute"><%= t(".welcome_hint") %></p>
    </div>

    <div class="w-full max-w-md">
      <% if @rate_limited %>
        <%= ui_error_state title: t(".rate_limited_title"), message: t("errors.codes.rate_limited") %>
      <% else %>
        <%= ui_card padding: :lg do %>
          <div class="mb-8 text-center">
            <h2 class="font-display text-xl font-extrabold text-ink"><%= t(".title") %></h2>
            <p class="mt-1 text-sm text-mute"><%= t(".subtitle") %></p>
          </div>

          <%= render "identity/school_staff_registrations/form" %>

          <p class="mt-6 text-center text-sm text-mute">
            <%= t(".have_account") %>
            <%= link_to t(".sign_in"), new_session_path, class: "font-medium text-brand-strong underline-offset-4 hover:underline" %>
          </p>
        <% end %>
      <% end %>
    </div>
  </section>
</main>
