<%# 🌐 UI · identity/teacher_registrations/_form — formulaire d'inscription enseignant, en quatre rubriques %>
<%# Rôle : l'établissement est désigné par son code (champ, ou bandeau quand il est déjà trouvé), ou sans code (@pending) ; 422 %>
<%# ADR  : 0030, 0037, 0050, 0057, 0063 · UDR : 0024, 0044, 0050 %>
<% if @pending %>
  <%# Formulaire GET de la seule DRENA (repli sans JavaScript, UDR-0024) : son sélecteur s'y rattache par l'attribut form. %>
  <form id="teacher-signup-drena" action="<%= new_pending_teacher_registration_path %>" method="get"></form>
<% end %>
<%= form_with model: @form, scope: :teacher_registration, url: (@pending ? pending_teacher_registrations_path : teacher_registrations_path),
              id: (@pending ? "pending-teacher-registration-form" : "teacher-registration-form"), class: "space-y-6",
              data: ({ controller: "school--drena-schools", "school--drena-schools-url-value": drena_schools_path("__drena__") } if @pending) do |form| %>
  <% if @form.ref %>
    <%= form.hidden_field :ref %>
  <% end %>
  <% if @form.errors[:base].any? %>
    <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
      <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
      <p><%= @form.errors[:base].to_sentence %></p>
    </div>
  <% end %>

  <fieldset class="space-y-4">
    <legend class="mb-3 text-xs font-semibold tracking-wider text-mute uppercase"><%= t(".personal") %></legend>
    <%= ui_field form, :last_name, required: true, maxlength: 50, autocomplete: "family-name", placeholder: t(".last_name_placeholder") %>
    <%= ui_field form, :first_name, required: true, maxlength: 80, autocomplete: "given-name", placeholder: t(".first_name_placeholder") %>
    <% gender_error = @form.errors[:gender].first %>
    <fieldset class="space-y-1.5" <%= tag.attributes("aria-describedby": ("teacher_registration_gender_error" if gender_error)) %>>
      <legend class="mb-1.5 block text-sm font-medium text-ink">
        <%= Dtos::Identity::TeacherRegistrationInput.human_attribute_name(:gender) %><span class="text-error" aria-hidden="true"> *</span>
      </legend>
      <div class="grid grid-cols-2 gap-3">
        <% Entities::Identity::User::GENDERS.each do |gender| %>
          <label class="flex min-h-tap cursor-pointer items-center gap-3 rounded-ln border border-line bg-white px-4 transition has-checked:border-brand has-checked:bg-brand-soft">
            <%= form.radio_button :gender, gender, required: true, class: "size-5 shrink-0 accent-brand",
                                  "aria-invalid": ("true" if gender_error) %>
            <span class="text-sm font-medium text-ink"><%= t("genders.#{gender}") %></span>
          </label>
        <% end %>
      </div>
      <% if gender_error %>
        <p id="teacher_registration_gender_error" class="flex items-center gap-1.5 text-sm font-medium text-error">
          <%= ui_icon "exclamation-circle", variant: :mini, size: :sm %><%= gender_error %>
        </p>
      <% end %>
    </fieldset>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="mb-3 text-xs font-semibold tracking-wider text-mute uppercase"><%= t(".contact") %></legend>
    <%= ui_field form, :contact, as: :tel, required: true, value: @form.raw_contact, maxlength: 15, inputmode: "tel",
                 autocomplete: "tel", placeholder: t(".contact_placeholder"), hint: t(".contact_hint") %>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="mb-3 text-xs font-semibold tracking-wider text-mute uppercase"><%= t(".school_and_subject") %></legend>
    <% if @pending %>
      <%= render "identity/pending_teacher_registrations/school_fields", form: %>
    <% elsif @preview %>
      <div class="space-y-2">
        <%= render "identity/teacher_registrations/school_preview", preview: @preview %>
        <%= form.hidden_field :school_code, value: Entities::School::SchoolCode.display(@form.school_code) %>
        <%= link_to t(".other_code"), new_teacher_registration_path, id: "other-school-code",
                    class: "inline-flex min-h-tap items-center text-sm font-medium text-brand-strong underline-offset-4 hover:underline" %>
      </div>
    <% else %>
      <%= ui_field form, :school_code, required: true, value: @form.raw_school_code, maxlength: 12, autocomplete: "off",
                   autocapitalize: "characters", spellcheck: false, placeholder: t(".school_code_placeholder"),
                   hint: t(".school_code_hint"), class: "font-display tracking-widest uppercase" %>
      <%= link_to t(".no_school_code"), new_pending_teacher_registration_path, id: "no-school-code",
                  class: "inline-flex min-h-tap items-center text-sm font-medium text-brand-strong underline-offset-4 hover:underline" %>
    <% end %>
    <%= ui_field form, :material_slug, as: :select, required: true, choices: material_options, prompt: t(".material_prompt") %>
  </fieldset>

  <fieldset class="space-y-4">
    <legend class="mb-3 text-xs font-semibold tracking-wider text-mute uppercase"><%= t(".security") %></legend>
    <%= ui_field form, :pin, as: :password, required: true, maxlength: 4, inputmode: "numeric", autocomplete: "new-password",
                 hint: t(".pin_hint") %>
    <%= ui_field form, :pin_confirmation, as: :password, required: true, maxlength: 4, inputmode: "numeric",
                 autocomplete: "new-password" %>
  </fieldset>

  <%= ui_button t(".submit"), type: :submit, variant: :brand, size: :lg, full: true %>
<% end %>
