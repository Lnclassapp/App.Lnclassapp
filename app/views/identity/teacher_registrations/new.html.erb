<%# 🌐 UI · identity/teacher_registrations/new — inscription enseignant en trois étapes : 1 Votre établissement, 2 Vous, 3 Votre code secret %>
<%# Rôle : une colonne ; logo et « Besoin d'aide ? », « ‹ Retour » et « Étape N sur 3 », barre en trois segments, carte de bienvenue sur le premier écran seulement ; le formulaire est découpé par signup_steps_controller (celui de l'élève) %>
<%# ADR  : 0030, 0050, 0083, 0103 (§4.4 : une matière) · UDR : 0005, 0024, 0054 (§3.2 : logo vers l'accueil public), 0079, XXXX-ecrans-enseignant-sans-repetition (§3.9), XXXX-inscription-eleve-en-trois-etapes (§3.1, §3.5, §3.8) %>
<% page_title t(".page_title") %>
<%# Lien d'établissement valable : l'étape 1 n'existe pas, on ouvre l'étape 2. Sinon, la première étape qui porte une erreur, l'étape 1 par défaut. %>
<% floor = @preview ? 2 : 1 %>
<% step_of = { drena_public_id: 1, school_public_id: 1, invite_token: 1, material_slug: 2, last_name: 2, first_name: 2, gender: 2, contact: 2,
               pin: 3, pin_confirmation: 3 } %>
<% start = @rate_limited ? 1 : [ @form.errors.attribute_names.filter_map { step_of[it] }.min || floor, floor ].max %>
<% steps = "classroom--signup-steps" %>
<%# Le contrôleur n'est branché que sur le formulaire : un lien ouvert trop souvent n'a ni étapes ni formulaire. %>
<% steps_data = if @rate_limited
     {}
   else
     { controller: steps, "#{steps}-start-value": start, "#{steps}-counter-value": t(".step_counter", n: "%{n}"),
       "#{steps}-announce-value": t(".step_announce", n: "%{n}", title: "%{title}") }
   end %>
<%= tag.main id: "teacher-signup", class: "mx-auto flex min-h-dvh w-full max-w-md flex-col px-gutter pb-10", data: steps_data do %>
  <div id="signup-header" class="flex min-h-bar items-center justify-between">
    <%= link_to root_path, "aria-label": t("shared.auth_welcome.logo_home"),
                           class: "flex min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" do %>
      <%= image_tag brand_logo(teacher: true), alt: "", class: "size-8 rounded-ln object-cover" %>
    <% end %>
    <div id="auth-help">
      <%= render "shared/help_sheet", trigger_icon: "headset", trigger_class: "font-medium! text-brand-strong!" %>
    </div>
  </div>

  <% if @rate_limited %>
    <%# Le lien /i/<jeton> ouvert plus de dix fois par minute : rien n'est révélé, ni l'établissement ni la raison. %>
    <div class="mt-6">
      <%= ui_error_state title: t(".rate_limited_title"), message: t("errors.codes.rate_limited") %>
    </div>
  <% else %>
    <div class="flex min-h-tap items-center justify-between gap-3">
      <button type="button" id="signup-back" <%= "hidden" if start <= floor %>
              data-<%= steps %>-target="back" data-action="<%= steps %>#back"
              class="inline-flex min-h-tap items-center gap-1 rounded-ln pr-3 text-sm font-medium text-brand-strong focus-visible:outline-2 focus-visible:outline-brand">
        <span aria-hidden="true">‹</span><%= t(".back") %>
      </button>
      <p id="signup-step-counter" class="ml-auto text-sm text-mute" data-<%= steps %>-target="counter"><%= t(".step_counter", n: start) %></p>
    </div>
    <ol id="signup-progress" class="mb-4 flex gap-1.5" aria-hidden="true">
      <% 3.times do |index| %>
        <li data-<%= steps %>-target="segment"
            class="h-1.5 flex-1 rounded-full <%= index < start ? "bg-brand-strong" : "bg-line" %>"></li>
      <% end %>
    </ol>
    <p id="signup-live" class="sr-only" aria-live="polite" data-<%= steps %>-target="live"></p>

    <div id="signup-welcome" class="mb-4 space-y-3" data-<%= steps %>-target="welcome" <%= "hidden" if start > floor %>>
      <section aria-label="Lnclass" class="rounded-card bg-brand-strong p-5 text-white">
        <p class="text-lg font-medium"><%= t(".welcome") %></p>
        <p class="mt-2 text-sm leading-relaxed"><%= t(".welcome_hint") %></p>
      </section>
      <h1 class="pt-1 text-xl font-medium text-ink"><%= t(".title") %></h1>
    </div>

    <%= render "identity/teacher_registrations/form", start:, floor: %>

    <p id="signup-signin" class="mt-6 text-center text-sm text-mute" data-<%= steps %>-target="welcome" <%= "hidden" if start > floor %>>
      <%= t(".have_account") %>
      <%= link_to t(".sign_in"), new_session_path,
                  class: "inline-flex min-h-tap items-center font-medium text-brand-strong underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-brand" %>
    </p>
  <% end %>
<% end %>
