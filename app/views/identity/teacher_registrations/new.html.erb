<%# 🌐 UI · identity/teacher_registrations/new — inscription enseignant, en deux colonnes (reprise de l'ancienne application) %>
<%# Rôle : accueil à gauche, formulaire à droite ; /e/<code> refusé en 404 (carte), débit dépassé en 429 ; échec re-rendu en 422 ; @pending : sans code %>
<%# ADR  : 0030, 0050, 0057, 0063 · UDR : 0005, 0024, 0044, 0050, 0054 (§3.2 : logo vers l'accueil public) %>
<% page_title t(".page_title") %>
<main class="grid min-h-dvh bg-paper md:grid-cols-2">
  <section class="hidden items-center justify-center bg-brand-soft p-10 md:flex">
    <div class="max-w-sm text-center">
      <%= link_to root_path, "aria-label": t(".logo_home"),
                             class: "mx-auto mb-6 flex w-fit min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-brand" do %>
        <%= image_tag "logo/lnclass.jpeg", alt: "", class: "size-16 rounded-card object-cover shadow-card" %>
      <% end %>
      <h1 class="mb-3 font-display text-2xl font-extrabold text-ink"><%= t(".welcome") %></h1>
      <p class="text-sm leading-relaxed text-mute"><%= t(".welcome_hint") %></p>
    </div>
  </section>

  <section class="flex flex-col items-center justify-center px-gutter py-10">
    <div class="mb-8 text-center md:hidden">
      <%= link_to root_path, "aria-label": t(".logo_home"),
                             class: "mx-auto mb-3 flex w-fit min-h-tap items-center rounded-card focus-visible:outline-2 focus-visible:outline-brand" do %>
        <%= image_tag "logo/lnclass.jpeg", alt: "", class: "size-14 rounded-card object-cover shadow-card" %>
      <% end %>
      <%# Le h1 de la colonne gauche est masqué sur téléphone (hidden md:flex) : celui-ci le remplace, UDR-0054. %>
      <h1 class="mb-2 font-display text-xl font-extrabold text-ink"><%= t(".welcome") %></h1>
      <p class="text-sm text-mute"><%= t(".welcome_hint") %></p>
    </div>

    <div class="w-full max-w-md">
      <% if @rate_limited %>
        <%= ui_error_state title: t(".rate_limited_title"), message: t("errors.codes.rate_limited") %>
      <% elsif @invalid_code %>
        <%= ui_card padding: :lg do %>
          <div id="invalid-school-code" class="flex flex-col items-center text-center">
            <span class="grid size-14 place-items-center rounded-full bg-error-soft text-error"><%= ui_icon "exclamation-triangle", size: :lg %></span>
            <h2 class="mt-4 font-display text-xl font-extrabold text-ink"><%= t(".invalid_code.title") %></h2>
            <p class="mt-1 text-sm text-mute"><%= t(".invalid_code.description") %></p>
            <div class="mt-6 w-full">
              <%= ui_button t(".invalid_code.other_code"), href: new_teacher_registration_path, variant: :brand, full: true,
                                                           icon: "arrow-path" %>
            </div>
          </div>
        <% end %>
      <% else %>
        <%= ui_card padding: :lg do %>
          <div class="mb-8 text-center">
            <h2 class="font-display text-xl font-extrabold text-ink"><%= t(@pending ? ".pending_title" : ".title") %></h2>
            <p class="mt-1 text-sm text-mute"><%= t(@pending ? ".pending_subtitle" : ".subtitle") %></p>
          </div>

          <%= render "identity/teacher_registrations/form" %>

          <p class="mt-6 text-center text-sm text-mute">
            <%= t(".have_account") %>
            <%= link_to t(".sign_in"), new_session_path, class: "font-medium text-brand-strong underline-offset-4 hover:underline" %>
          </p>
        <% end %>
      <% end %>
    </div>
  </section>
</main>
