<%# 🌐 UI · communication/authored_messages/edit — « Modifier l'annonce », page entière, pour son seul auteur %>
<%# Rôle : le formulaire prérempli (thème, illustration) ; publiée, un avertissement, ni parution ni brouillon ni encadré du plafond ; re-rendu en 422 %>
<%# ADR  : 0078, 0081 · UDR : 0054, 0071 (§3.8), 0075 (§3.3) %>
<% page_title t(".page_title") %>
<% content_for :nav_key, "announcements" %>
<%= ui_page_header title: t(".title"), back: { label: t("communication.tabs.mine"), href: my_announcements_path } %>
<%= ui_card do %>
  <%= render "form", form: @form, message: @message, url: announcement_path(@message.public_id), method: :patch %>
<% end %>
