<%# 🌐 UI · communication/authored_messages/_form — le formulaire d'annonce, page entière (nouvelle ou modifiée) %>
<%# Rôle : titre et texte décomptés, destinataires, thème, illustration (base puis équipe), image, audio, parution, encadré du plafond ; 422 sous les champs %>
<%# ADR  : 0045, 0078, 0081 · UDR : 0005, 0067, 0071 (§3.8), 0075 (§3.3) · locaux : form:, message: (nil pour une nouvelle), url:, method: %>
<% caps = Entities::Communication::Message %>
<% published = message&.status == "published" %>
<% reselect = form.errors.any? ? " #{t('.reselect')}" : "" %>
<%# UDR-0075 §3.3 : le décompte du résumé d'article (UDR-0067), réutilisé tel quel ; le serveur rend « 18 / 60 ». %>
<% counted = ->(max) { { controller: "communication--character-count", "communication--character-count-max-value": max,
                         "communication--character-count-near-value": t(".counter.near"),
                         "communication--character-count-full-value": t(".counter.full") } } %>
<% counting = { "communication--character-count-target": "input", action: "input->communication--character-count#update" } %>
<% option = "flex min-h-tap cursor-pointer flex-col items-center gap-1 rounded-ln border border-line bg-white p-2 text-xs font-medium " \
            "has-checked:border-brand has-checked:bg-brand-soft has-focus-visible:outline-2 has-focus-visible:outline-brand" %>
<%= form_with model: form, scope: :announcement, url:, method:, multipart: true, id: "announcement-form", class: "grid max-w-form gap-5" do |f| %>
  <% if published %>
    <div class="rounded-ln bg-info-soft p-4 text-sm text-info"><%= t(".published_notice") %></div>
  <% end %>

  <%= tag.div data: counted.(caps::TITLE_MAX) do %>
    <%= ui_field f, :title, required: true, maxlength: caps::TITLE_MAX, hint: t(".hints.title"), data: counting %>
    <p class="mt-1 text-right text-xs tabular-nums text-mute" data-communication--character-count-target="count"><%= t(".counter.count", count: form.title.length, max: caps::TITLE_MAX) %></p>
    <span class="sr-only" aria-live="polite" data-communication--character-count-target="status"></span>
  <% end %>
  <%= tag.div data: counted.(caps::BODY_MAX) do %>
    <%= ui_field f, :body, as: :textarea, rows: 3, required: true, maxlength: caps::BODY_MAX, hint: t(".hints.body"), data: counting %>
    <p class="mt-1 text-right text-xs tabular-nums text-mute" data-communication--character-count-target="count"><%= t(".counter.count", count: form.body.length, max: caps::BODY_MAX) %></p>
    <span class="sr-only" aria-live="polite" data-communication--character-count-target="status"></span>
  <% end %>

  <% case current_actor.role %>
  <% when :team %>
    <% school = form_school %>
    <% if school %>
      <%= f.hidden_field :school_public_id %>
      <%= ui_radio_group f, :scope, choices: [ [ t("communication.scopes.national"), "national" ], [ school.name, "school" ] ], required: true %>
    <% else %>
      <%= f.hidden_field :scope, value: "national" %>
      <p class="text-sm text-mute"><%= t(".one_school") %></p>
    <% end %>
    <%= ui_radio_group f, :audience, choices: %w[all students teachers school_admins].map { [ t("communication.audiences.#{it}"), it ] },
                                     columns: 2, required: true %>
  <% when :school_admin %>
    <p class="text-sm text-mute"><%= t(".for_school", school: form_school&.name) %></p>
    <%= ui_radio_group f, :audience, choices: %w[students teachers school_admins].map { [ t("communication.audiences.#{it}"), it ] },
                                     required: true %>
  <% else %>
    <%= ui_checkbox_group f, :classroom_public_ids, choices: classroom_choices, label: t("communication.audiences.classrooms"),
                                                    hint: t(".hints.classrooms"), required: true %>
  <% end %>

  <%# UDR-0075 §3.3 : dix pastilles ; le contrôleur recolore les illustrations du fieldset voisin, sans JavaScript elles restent en « Ciel ». %>
  <%= tag.fieldset data: { controller: "communication--theme-preview", "communication--theme-preview-illustrations-value": "announcement-illustrations" } do %>
    <legend class="mb-1.5 block text-sm font-medium text-ink"><%= Dtos::Communication::MessageInput.human_attribute_name(:theme) %></legend>
    <div class="grid grid-cols-5 gap-2">
      <% caps::THEMES.each do |key| %>
        <label class="flex min-h-tap cursor-pointer flex-col items-center gap-1 rounded-ln p-1 text-xs font-medium has-focus-visible:outline-2 has-focus-visible:outline-brand has-checked:bg-mist has-checked:font-bold">
          <%= f.radio_button :theme, key, class: "sr-only", data: { action: "change->communication--theme-preview#preview" } %>
          <span class="grid size-10 place-items-center rounded-full bg-brand-soft ring-1 ring-school/30" data-announcement-theme="<%= key %>">
            <span class="size-3 rounded-full bg-brand-strong"></span>
          </span>
          <span><%= t("communication.themes.#{key}") %></span>
        </label>
      <% end %>
    </div>
    <% if (error = form.errors[:theme].first) %>
      <p class="mt-1.5 flex items-center gap-1.5 text-sm font-medium text-error">
        <%= ui_icon "exclamation-circle", variant: :mini, size: :sm %><%= error %>
      </p>
    <% end %>
  <% end %>

  <%# Les 8 de base, puis les dessins de l'équipe non retirés, par date d'ajout ; la valeur d'un dessin est son public_id. %>
  <%# Décision du chantier annonces-v2 (Lot E) : une annonce garde son dessin de l'équipe jusqu'à sa fin, même retiré depuis ; %>
  <%# son formulaire le propose encore, en dernier (UpdateMessage l'accepte, une nouvelle annonce ne le voit pas). %>
  <% drawings = library_illustrations %>
  <% carried = message&.illustration_id %>
  <% if carried && drawings.none? { it.id == carried } %>
    <% drawings += Repositories::Communication::IllustrationRepository.new.find_all_by_ids(ids: [ carried ]).values %>
  <% end %>
  <fieldset id="announcement-illustrations">
    <legend class="mb-1.5 block text-sm font-medium text-ink"><%= Dtos::Communication::MessageInput.human_attribute_name(:illustration) %></legend>
    <div class="grid grid-cols-4 gap-2">
      <% caps::ILLUSTRATIONS.each do |key| %>
        <label class="<%= option %>">
          <%= f.radio_button :illustration, key, class: "peer sr-only" %>
          <%= announcement_illustration key, class: "size-12" %>
          <span><%= t("communication.illustrations.#{key}") %></span>
        </label>
      <% end %>
      <% drawings.each do |illustration| %>
        <label class="<%= option %>">
          <%= f.radio_button :illustration, illustration.public_id, class: "peer sr-only" %>
          <%= announcement_illustration illustration, class: "size-12" %>
          <span><%= illustration.name %></span>
        </label>
      <% end %>
    </div>
    <% if (error = form.errors[:illustration].first) %>
      <p class="mt-1.5 flex items-center gap-1.5 text-sm font-medium text-error">
        <%= ui_icon "exclamation-circle", variant: :mini, size: :sm %><%= error %>
      </p>
    <% end %>
  </fieldset>

  <%# ui_field ne connaît pas as: :file : le type passe au contrôle, comme tout attribut ; jamais de valeur sur un fichier. %>
  <%= ui_field f, :image, type: "file", value: nil, accept: "image/png,image/jpeg,image/webp", hint: t(".hints.image") + reselect,
                          class: "cursor-pointer py-2.5 file:mr-3 file:cursor-pointer file:border-0 file:bg-transparent file:font-medium file:text-brand-strong" %>
  <% if message && edited.image %>
    <div class="flex items-center gap-3">
      <%= image_tag announcement_file_path(message.public_id, kind: "image"), alt: "", class: "size-16 rounded-ln object-cover" %>
      <%= ui_field f, :remove_image, as: :checkbox %>
    </div>
  <% end %>

  <%= ui_field f, :audio, type: "file", value: nil, accept: "audio/mpeg,audio/mp4,.mp3,.m4a", hint: t(".hints.audio") + reselect,
                          class: "cursor-pointer py-2.5 file:mr-3 file:cursor-pointer file:border-0 file:bg-transparent file:font-medium file:text-brand-strong" %>
  <% if message && edited.audio %>
    <div class="grid gap-3">
      <audio controls preload="none" src="<%= announcement_file_path(message.public_id, kind: "audio") %>" class="w-full"></audio>
      <%= ui_field f, :remove_audio, as: :checkbox %>
    </div>
  <% end %>

  <% unless published %>
    <%# UDR-0075 §3.3 : plus de « Visible jusqu'au » ; la fin est la parution + 30 jours (ADR-0081 §4.1). %>
    <div class="space-y-1.5">
      <%= ui_field f, :published_at, type: "datetime-local", hint: t(".hints.published_at") %>
      <p class="text-xs text-mute"><%= t(".lasts") %></p>
    </div>
  <% end %>

  <%# UDR-0075 §3.3 : l'encadré du plafond, lu à l'ouverture ; jamais en modification d'une annonce publiée (departing est nil). %>
  <% if (leaving = departing) %>
    <div id="announcement-cap-notice" role="status" class="rounded-ln bg-info-soft p-4 text-sm text-info">
      <p><%= t(".cap.notice", count: caps::LIVE_CAP, title: leaving.title) %></p>
      <p class="mt-1 text-xs"><%= t(".cap.scheduled") %></p>
    </div>
  <% end %>

  <div class="flex flex-wrap justify-end gap-3">
    <%= ui_button t(".cancel"), variant: :ghost, href: my_announcements_path %>
    <% unless published %>
      <%= ui_button t(".save_draft"), type: :submit, variant: :secondary, name: "commit", value: "draft" %>
    <% end %>
    <%= ui_button t(".publish"), type: :submit, variant: :primary, name: "commit", value: "publish" %>
  </div>
<% end %>
