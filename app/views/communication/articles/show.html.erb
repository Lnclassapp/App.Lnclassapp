<%# 🌐 UI · communication/articles/show — page publique d'un article ; aperçu de l'équipe (brouillon, archivé) avec bandeau %>
<%# Rôle : en-tête commun, titre, signature et date, couverture, texte Action Text, suite de la lecture ; balises de partage %>
<%# UDR  : 0064 (§3.3, §3.4, §3.6) · ADR : 0073 (§4.4, §4.8) %>
<% page_title @article.title %>
<% published = @article.status == "published" %>
<% content_for :head do %>
  <% if published %>
    <%= render "communication/articles/head", title: @article.title, description: @article.excerpt,
                                              canonical: canonical_url(blog_article_path(@article.slug)), type: "article",
                                              image: @article.cover, published_on: @article.published_on %>
  <% else %>
    <%= tag.meta(name: "robots", content: "noindex, nofollow") %>
  <% end %>
<% end %>
<main class="flex min-h-dvh flex-col items-center bg-paper px-gutter py-10">
  <div class="w-full max-w-prose">
    <% unless published %>
      <p id="article_status_banner" class="mb-6 flex flex-wrap items-center gap-2 rounded-ln bg-mist px-4 py-3 text-sm text-ink">
        <%= article_status_badge(@article.status) %>
        <%= t(".status.#{@article.status}_hint") %>
      </p>
    <% end %>
    <%= render "communication/articles/masthead", back_label: t(".back"), back_href: back_href(blog_path, from: blog_path) %>
    <article aria-labelledby="article_title">
      <header class="mb-6">
        <h1 id="article_title" class="font-display text-3xl leading-tight font-extrabold text-balance break-words hyphens-auto"><%= @article.title %></h1>
        <p id="article_byline" class="mt-3 text-sm text-mute">
          <%= @article.author_name || t(".team_signature") %>
          <% if @article.published_on %>
            <span aria-hidden="true">·</span>
            <time datetime="<%= @article.published_on.iso8601 %>"><%= t(".published_on", date: article_date(@article.published_on)) %></time>
          <% end %>
        </p>
      </header>
      <% if (cover = @article.cover) %>
        <figure class="mb-8">
          <%= image_tag article_image_src(cover), alt: cover.alt, width: cover.width, height: cover.height, loading: :eager,
                                                  fetchpriority: "high", decoding: :async, class: "h-auto w-full rounded-card bg-mist" %>
        </figure>
      <% end %>
      <div id="article_body" class="break-words"><%= @article.body %></div>
    </article>
    <nav id="article_next" aria-label="<%= t(".next_label") %>" class="mt-10 flex flex-col gap-3 border-t border-line pt-6 sm:flex-row">
      <%= ui_button t(".discover"), href: root_path, variant: :primary, full: true, class: "sm:w-auto" %>
      <%= ui_button t(".all_articles"), href: blog_path, variant: :secondary, full: true, class: "sm:w-auto" %>
    </nav>
  </div>
</main>
