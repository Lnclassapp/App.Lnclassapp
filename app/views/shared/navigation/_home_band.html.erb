<%# 🌐 UI · shared/navigation/_home_band — bandeau des accueils élève et enseignant %>
<%# Rôle : fond du rôle (role_fill_class), avatar à gauche qui ouvre « Mon compte », « Besoin d'aide ? » à droite, texte role_ink_classes (blanc sur le bleu, band-ink sur l'orange) ; la carte à cheval est celle de la page %>
<%# UDR  : accueil élève §3.1, §3.8 · XXXX écrans minimalistes style Wave §3 (élève : bandeau de 187 px, aide en icône seule) · écrans enseignant §3.1, §3.3 · locals : role (:student ou :teacher), user (ShellUser) ; avatar et aide quittent le bandeau dès lg (la barre du haut les porte) %>
<% role = role.to_sym %>
<% fill = role_fill_class(role) %>
<% ink = role_ink_classes(role) %>
<%# UDR XXXX écrans minimalistes style Wave §3 : l'élève a l'aide en icône seule (son nom est dans aria-label), le bandeau de 187 px. %>
<% icon_only = role == :student %>
<%# Élève ≈ 96 px, enseignant ≈ 132 px : la carte déborde de 40 % sur le bandeau. %>
<header class="<%= class_names("#{role}-band", fill, ink[:text], "flex items-start justify-between gap-3 px-gutter pt-4",
                               role == :teacher ? "min-h-33" : "min-h-wave-band") %>">
  <%= link_to account_panel_page_path(role), "aria-label": t(".account", name: user.name),
              class: "grid size-12 shrink-0 place-items-center rounded-full focus-visible:outline-2 #{ink[:outline]} lg:hidden" do %>
    <% if user.avatar_url %>
      <%= image_tag user.avatar_url, alt: "", loading: "lazy", decoding: "async", class: "size-12 rounded-full object-cover" %>
    <% else %>
      <span aria-hidden="true" class="grid size-12 place-items-center rounded-full bg-white text-sm font-medium text-brand-strong">
        <%= avatar_initials(user.name) %>
      </span>
    <% end %>
  <% end %>
  <%= link_to help_path, "aria-label": (t(".help") if icon_only),
              class: class_names("inline-flex min-h-tap items-center gap-2 rounded-full text-sm font-medium focus-visible:outline-2 lg:hidden",
                                 ink[:text], ink[:outline], "size-12 justify-center bg-on-brand/20" => icon_only, "px-3" => !icon_only) do %>
    <%= ui_icon "headset" %><% unless icon_only %><span><%= t(".help") %></span><% end %>
  <% end %>
</header>
