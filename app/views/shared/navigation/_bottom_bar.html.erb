<%# 🌐 UI · shared/navigation/_bottom_bar — navigation mobile (sous lg) %>
<%# Rôle : toutes les destinations du rôle, cibles de 48 px, au-dessus de l'indicateur système ; « Plus » si le rôle a une liste secondaire %>
<%# UDR  : 0006, 0068 (§3.3) %>
<% destinations = navigation_for(user.role) %>
<% secondary = secondary_navigation_for(user.role) %>
<nav aria-label="<%= t(".label") %>" class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 pb-safe backdrop-blur lg:hidden">
  <ul class="mx-auto grid max-w-lg gap-1 px-2 pt-1 <%= nav_grid_class(bottom_bar_size(user.role)) %>">
    <% destinations.each do |destination| %>
      <li><%= nav_link destination, style: :bottom %></li>
    <% end %>
    <% if secondary.any? %>
      <li><%= render "shared/navigation/more_menu", role: user.role, entries: secondary %></li>
    <% end %>
  </ul>
</nav>
