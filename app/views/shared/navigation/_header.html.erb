<%# 🌐 UI · shared/navigation/_header — en-tête du shell : élève (logo, aide, menu de l'avatar) ; enseignant (avatar, aide ; dès lg filet jaune, logo, « Lnclass », aide, avatar) ; sinon logo, rôle, (aide de la direction), menu du compte %>
<%# Rôle : filet de couleur du rôle en haut (pour l'enseignant : dès lg seulement) ; ni l'élève ni l'enseignant n'ont la lune : le mode sombre est dans « Mon compte » ; la direction et l'équipe gardent l'en-tête d'origine, la direction y gagne « Besoin d'aide ? » %>
<%# UDR  : 0006, 0065 (interrupteur à côté de l'avatar : direction et équipe, lg+), 0061 (entrées de page :account_menu), 0080 §3.1, 0082 §3.1, 0084 §3.1, 0128, XXXX écrans enseignant §3.1, §3.14 et élève §3.1, XXXX accueil élève §3.1 (sous lg, le bandeau remplace l'en-tête) %>
<%# user nil : la barre de l'enseignant à l'inscription (UDR enseignant §3.14), dès lg seulement, sans avatar. %>
<%# UDR accueil élève §3.1 : une page qui porte le bandeau bleu (content_for :home_band) a déjà l'avatar et l'aide sous lg : l'en-tête n'y paraît qu'à partir de lg. %>
<header class="<%= class_names("sticky top-0 z-40 h-bar border-b border-line bg-paper/90 backdrop-blur", "max-lg:hidden" => content_for?(:home_band) || user.nil?) %>">
  <%# UDR enseignant §3.1 : sous lg, le filet de l'enseignant est retiré (doublon du bandeau de l'accueil) ; dès lg, §3.14 le rend. %>
  <% if user.nil? || user.role.to_sym == :teacher %>
    <div class="absolute inset-x-0 top-0 h-1 <%= role_fill_class(:teacher) %> max-lg:hidden" aria-hidden="true"></div>
  <% elsif (accent = role_accent(user.role)) %>
    <div class="absolute inset-x-0 top-0 h-1 <%= accent %>" aria-hidden="true"></div>
  <% end %>
  <% if user && user.role.to_sym == :student %>
    <%# UDR-0084 §3.1 : le logo à gauche ; à droite « Besoin d'aide ? » puis l'avatar seul. Porteur, 2026-10-26 (mvp-teacher-student,
        lot D) : l'aide reste dans l'en-tête à toute largeur, « Mon compte » ne la porte plus. UDR élève §3.1 : plus de lune, le
        mode sombre est dans le menu. %>
    <div class="flex h-full items-center justify-between gap-3 px-gutter lg:px-8">
      <%= link_to student_home_path, class: "flex items-center gap-2.5 rounded-full focus-visible:outline-2 focus-visible:outline-brand" do %>
        <%= image_tag brand_logo, alt: "", class: "size-9 rounded-sm" %>
        <span class="font-display text-xl font-medium tracking-tight">Lnclass</span>
      <% end %>
      <div class="flex items-center gap-1">
        <%= render "shared/help_sheet", trigger_icon: "headset", user:,
                                        trigger_class: "font-medium! text-brand-strong!" %>
        <%= render "shared/navigation/avatar_menu", user: %>
      </div>
    </div>
  <% elsif user.nil? || account_panel?(user.role) %>
    <%# UDR-0082 §3.1 : sous lg, sans logo ; l'avatar ouvre le panneau du compte, l'aide à droite. UDR enseignant §3.1 : plus de lune ni de
        filet ; le mode sombre est dans « Mon compte ». UDR enseignant §3.14 (dès lg) : filet jaune, logo enseignant et « Lnclass » à
        gauche, « Besoin d'aide ? » puis l'avatar à droite ; à l'inscription (user nil), sans avatar. %>
    <div class="flex h-full items-center justify-between gap-3 px-gutter lg:px-8">
      <%= link_to (user ? home_path_for(user.role) : root_path), class: "hidden items-center gap-2.5 rounded-full focus-visible:outline-2 focus-visible:outline-brand lg:order-1 lg:flex" do %>
        <%= image_tag brand_logo(teacher: true), alt: "", class: "size-9 rounded-sm" %>
        <span class="font-display text-base font-medium tracking-tight">Lnclass</span>
      <% end %>
      <% if user %><div class="lg:order-3"><%= render "shared/navigation/account_panel", user: %></div><% end %>
      <div class="flex items-center gap-1 lg:order-2 lg:ml-auto">
        <%# À l'inscription, la colonne de la page a sa propre feuille d'aide : l'id de celle de la barre est distinct. %>
        <%= render "shared/help_sheet", trigger_class: "lg:text-brand-strong!", user:, id: ("help-sheet-bar" if user.nil?) %>
      </div>
    </div>
  <% else %>
    <%# Sous lg, l'avatar se colle au bord droit (pr-2). %>
    <div class="flex h-full items-center justify-between gap-3 px-gutter max-lg:pr-2 lg:px-8">
      <%= link_to home_path_for(user.role), class: "flex items-center gap-2.5 rounded-full focus-visible:outline-2 focus-visible:outline-brand" do %>
        <%= image_tag brand_logo, alt: "", class: "size-9 rounded-sm" %>
        <span class="font-display text-xl font-medium tracking-tight">Lnclass</span>
      <% end %>
      <div class="flex items-center gap-3">
        <span class="hidden sm:inline-flex"><%= ui_role_badge user.role %></span>
        <%# UDR-0128 §3.4 : la direction écrit au support, avec son message prêt ; l'équipe, c'est le support. %>
        <%= render "shared/help_sheet", trigger_class: nil, user: user if user.role.to_sym == :school_admin %>
        <%= render "shared/theme_switch", variant: :icon, wrapper: "max-lg:hidden" %>
        <%= ui_dropdown label: t(".account"), id: "account-menu",
              trigger: safe_join([ ui_avatar(user.name, src: user.avatar_url, size: :sm), tag.span(user.name, class: "hidden text-sm font-medium md:inline") ]) do %>
          <div class="border-b border-line px-3 pt-2 pb-3">
            <p class="truncate font-medium"><%= user.name %></p>
            <% if user.detail %><p class="truncate text-xs text-mute"><%= user.detail %></p><% end %>
          </div>
          <div class="pt-1.5">
            <%# Une page peut ajouter ses entrées en tête du menu (UDR-0061). %>
            <%= yield :account_menu %>
            <% account_links.each do |link| %>
              <%= ui_dropdown_item link[:label], href: link[:href], icon: link[:icon], method: link[:method], tone: link[:tone] %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</header>
