<%# 🌐 UI · shared/navigation/_account_panel — panneau du compte : identité, liens du rôle (NavigationHelper::ACCOUNT_PANELS ; élève : ceux du menu de l'avatar), thème, déconnexion %>
<%# Rôle : sur le site, <dialog> latérale ouverte par l'avatar de l'en-tête (enseignant) ; `page: true` rend le seul contenu (/students/menu, /teachers/menu) %>
<%# UDR  : 0080 §3.1, §3.2, §3.6 · 0082 §3.2 · 0084 §3.2 (liens 3 à 7 pour l'élève) · 0098 §3.1 (rubrique « Établissement ») · 0061 (déclencheur-lien : sans JavaScript, l'avatar mène à la page du panneau) · locals : user, page %>
<% link_class = "flex min-h-tap w-full items-center gap-3 rounded-ln px-3 text-sm font-medium
                 focus-visible:outline-2 focus-visible:outline-brand" %>
<%# UDR-0084 §3.2 : la page /students/menu de l'app Android reprend les liens 3 à 7 du menu de l'avatar du web. %>
<% student = user.role.to_sym == :student %>
<% links = if student
             [ { label: t("shared.navigation.profile"), href: profile_path, icon: "user-circle" },
               { label: t("shared.navigation.avatar_menu.history"), href: student_archive_path, icon: "archive-box" },
               ({ label: t("shared.navigation.avatar_menu.add_photo"), href: edit_profile_photo_path, icon: "camera" } unless user.avatar_url),
               { label: t("shared.help_sheet.trigger"), href: help_path, icon: "headset" } ].compact
           else
             account_panel_links(user.role)
           end %>
<% content = capture do %>
  <div class="flex items-center gap-3 border-b border-line pb-4">
    <%= ui_avatar user.name, src: user.avatar_url, size: :lg, tone_seed: (user.public_id if student) %>
    <div class="min-w-0">
      <p class="truncate font-display font-medium text-ink"><%= user.name %></p>
      <% if user.detail %><p class="truncate text-sm text-mute"><%= user.detail %></p><% end %>
    </div>
  </div>
  <%# UDR-0098 §3.1 : à partir de deux établissements, un bouton par établissement ; le courant est coché et désactivé. %>
  <% if !student && teacher_schools.size > 1 %>
    <section id="account_schools" aria-labelledby="account_schools_title" class="border-b border-line py-3">
      <h2 id="account_schools_title" class="px-3 text-xs font-medium tracking-wide text-mute uppercase">
        <%= t("shared.navigation.account_panel.schools.title") %>
      </h2>
      <ul class="mt-1">
        <% teacher_schools.each do |school| %>
          <li>
            <%= button_to teacher_current_school_path, method: :patch, params: { school_public_id: school.public_id },
                          form: { id: "switch-school-#{school.public_id}" }, disabled: school.current,
                          title: school.name, "aria-current": ("true" if school.current),
                          "aria-label": t("shared.navigation.account_panel.schools.#{school.current ? 'current' : 'switch'}", school: school.name),
                          class: class_names(link_class, "cursor-pointer text-ink hover:bg-mist disabled:cursor-default disabled:hover:bg-transparent",
                                             "font-medium": school.current) do %>
              <% if school.current %>
                <%= ui_icon "check", class: "text-brand-strong" %>
              <% else %>
                <span class="size-5 shrink-0" aria-hidden="true"></span>
              <% end %>
              <span class="min-w-0 flex-1 truncate text-left"><%= school.name %></span>
              <% if school.primary %><%= ui_badge t("shared.navigation.account_panel.schools.primary"), size: :sm %><% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
  <nav aria-label="<%= t("shared.navigation.account_panel.label") %>" class="py-2">
    <ul>
      <% links.each do |link| %>
        <li>
          <%= link_to link[:href], class: class_names(link_class, "text-ink hover:bg-mist"), "aria-current": ("page" if current_page?(link[:href])) do %>
            <%= ui_icon link[:icon], class: "text-mute" %><span><%= link[:label] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
  <div class="flex items-center justify-between border-t border-line py-3 pl-3">
    <span class="text-sm text-ink"><%= t("shared.theme_switch.label") %></span>
    <%= render "shared/theme_switch", variant: :icon %>
  </div>
  <div class="border-t border-line pt-3">
    <%= button_to session_path, method: :delete, class: class_names(link_class, "cursor-pointer text-error hover:bg-error-soft") do %>
      <%= ui_icon "arrow-right-start-on-rectangle" %><span><%= t("shared.navigation.sign_out") %></span>
    <% end %>
  </div>
<% end %>
<% if local_assigns[:page] %>
  <%= content %>
<% else %>
  <%# Le déclencheur est celui de la modale (même contrôleur) : un lien que le contrôleur modal intercepte. Seule la
      phrase cachée le nomme ; sous md, l'avatar paraît seul. %>
  <%= ui_modal id: "account_panel", title: t(".title"), size: :sm, placement: :drawer,
               trigger: safe_join([ tag.span(safe_join([ ui_avatar(user.name, src: user.avatar_url, size: :sm),
                                                         tag.span(user.name, class: "hidden text-sm font-medium md:inline") ]),
                                             class: "flex items-center gap-2.5", "aria-hidden": "true"),
                                    tag.span(t(".open"), class: "sr-only") ]),
               trigger_href: account_panel_page_path(user.role), trigger_variant: :ghost, trigger_class: "gap-2.5 pr-2 pl-0" do %>
    <%= content %>
  <% end %>
<% end %>
