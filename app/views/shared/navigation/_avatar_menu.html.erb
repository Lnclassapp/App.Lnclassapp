<%# 🌐 UI · shared/navigation/_avatar_menu — « Mon compte » de l'élève : l'avatar de l'en-tête ouvre un panneau plein écran (<dialog>) %>
<%# Rôle : Mon profil, Modifier mon code secret, Mode sombre, Se déconnecter, rien d'autre ; `page: true` rend le seul contenu (/students/menu : coque Android, bandeau de l'accueil) %>
<%# UDR  : écrans élève sans répétition §3.1, §3.8 · Stimulus : modal (Échap, focus rendu à l'avatar), autofocus (1re entrée), theme · locals : user, page %>
<%# locals: (user:, page: false) -%>
<% links = account_panel_links(user.role) %>
<% link_class = "flex min-h-tap w-full items-center gap-4 rounded-ln py-1 text-ink hover:bg-mist focus-visible:outline-2 focus-visible:outline-brand" %>
<% pill = "grid size-9 shrink-0 place-items-center rounded-full bg-brand-soft text-brand-strong" %>
<% content = capture do %>
  <div class="flex items-center gap-4 border-b border-line pb-4">
    <%= ui_avatar user.name, src: user.avatar_url, size: :lg, tone_seed: user.public_id %>
    <div class="min-w-0">
      <p class="truncate font-display text-lg font-medium text-ink"><%= user.name %></p>
      <% if user.detail %><p class="truncate text-sm text-mute"><%= user.detail %></p><% end %>
    </div>
  </div>
  <nav aria-label="<%= t("shared.navigation.account_panel.label") %>" class="py-2">
    <ul>
      <% links.each_with_index do |link, index| %>
        <li>
          <%= link_to link[:href], class: link_class, "aria-current": ("page" if current_page?(link[:href])),
                                   data: ({ autofocus_target: "fallback" } if index.zero? && !local_assigns[:page]) do %>
            <span class="<%= pill %>" aria-hidden="true"><%= ui_icon link[:icon] %></span>
            <span><%= link[:label] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>
  <%# Un seul interrupteur : celui du panneau (le theme_controller le garde d'accord avec le cookie). Caché sans JavaScript. %>
  <%= tag.div hidden: true, class: "border-t border-line py-2", data: { controller: "theme", action: "theme:changed@window->theme#sync" } do %>
    <%= tag.button type: "button", role: "switch", "aria-checked": (theme_preference == "dark").to_s,
                   data: { theme_target: "switch", action: "theme#toggle" },
                   class: class_names(link_class, "group cursor-pointer text-left") do %>
      <span class="<%= pill %>" aria-hidden="true"><%= ui_icon "moon" %></span>
      <span class="flex-1"><%= t("shared.navigation.account_panel.entries.dark_mode") %></span>
      <span class="relative mr-3 h-7 w-12 shrink-0 rounded-full bg-mute transition group-aria-checked:bg-brand" aria-hidden="true">
        <span class="absolute top-1 left-1 size-5 rounded-full bg-white shadow-card transition group-aria-checked:translate-x-5"></span>
      </span>
    <% end %>
  <% end %>
  <div class="border-t border-line pt-2">
    <%= button_to session_path, method: :delete, class: class_names(link_class, "cursor-pointer") do %>
      <span class="<%= pill %>" aria-hidden="true"><%= ui_icon "arrow-right-start-on-rectangle" %></span>
      <span><%= t("shared.navigation.sign_out") %></span>
    <% end %>
  </div>
<% end %>
<% if local_assigns[:page] %>
  <%= content %>
<% else %>
  <%# Le déclencheur et la boîte partagent le contrôleur modal : showModal() piège le focus, Échap ferme et rend le focus à
      l'avatar. Plein écran à toute largeur ; le panneau latéral de 400 px dès lg est le lot O2. %>
  <div data-controller="modal" data-action="turbo:before-cache@document->modal#close">
    <button type="button" id="avatar-menu-button" aria-haspopup="dialog" aria-controls="avatar-menu"
            aria-label="<%= t("shared.navigation.avatar_menu.open", name: user.name) %>" data-action="modal#open"
            class="grid size-tap cursor-pointer place-items-center rounded-full transition hover:bg-ink/5
                   focus-visible:outline-2 focus-visible:outline-brand">
      <%= ui_avatar user.name, src: user.avatar_url, size: :sm, add_photo: true, tone_seed: user.public_id %>
    </button>
    <dialog id="avatar-menu" aria-labelledby="avatar-menu-title" data-modal-target="dialog"
            data-action="close->modal#closed modal:opened->autofocus#focus"
            data-controller="autofocus" data-autofocus-mode-value="dialog"
            class="m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto bg-white p-0 text-ink backdrop:bg-ink/40
                   motion-safe:open:animate-fade-in">
      <div class="mx-auto flex min-h-full w-full max-w-md flex-col px-gutter pb-6">
        <div class="flex items-center justify-between gap-4 py-3">
          <h2 id="avatar-menu-title" class="font-display text-xl font-medium"><%= t("shared.navigation.account_panel.title") %></h2>
          <button type="button" data-action="modal#close" aria-label="<%= t("components.modal.close") %>" class="ui-icon-button -mr-2 shrink-0">
            <%= ui_icon "x-mark" %>
          </button>
        </div>
        <%= content %>
      </div>
    </dialog>
  </div>
<% end %>
