<%# 🌐 UI · shared/navigation/_link — une destination de navigation, appelée par nav_link %>
<%# Rôle : aria-current sur la page active ; une route pas encore dessinée donne une entrée inactive %>
<%# UDR  : 0006 %>
<%= content_tag :a, href: path, class: classes, "aria-current": ("page" if active), "aria-disabled": ("true" if path.nil?) do %>
  <span class="<%= icon_classes %>"><%= ui_icon destination.icon, variant: (active ? :solid : :outline) %></span>
  <span><%= t("shared.navigation.#{destination.key}") %></span>
<% end %>
