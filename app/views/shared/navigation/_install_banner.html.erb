<%# 🌐 UI · shared/navigation/_install_banner — invitation à installer l'app, en pop-up, sur l'accueil élève et enseignant %>
<%# Rôle : feuille basse (ui_modal placement: :sheet) ouverte par le contrôleur install, sur téléphone seulement : Android installable, ou Safari iPhone %>
<%# UDR  : 0078 (amendement du 2026-10-07 : pop-up, accueil seul), 0061, 0080 · ADR : 0082, 0084 (§4.2) %>
<%# locals: (role:) -%>
<%# ADR-0084 §4.2 : dans la coque Android, l'app est déjà installée ; rien n'est rendu. %>
<% unless lnclass_app? %>
  <div data-controller="install" data-action="close->install#dismissed:capture">
    <%= ui_modal id: "install_banner", title: t(".title.#{role}"), size: :sm, placement: :sheet do |modal| %>
      <div class="flex items-start gap-3">
        <%= tag.img src: "/icon-192.png", alt: "", width: 48, height: 48, class: "size-12 shrink-0 rounded-ln" %>
        <div class="min-w-0 flex-1">
          <p class="text-sm text-mute"><%= t(".body.#{role}") %></p>
          <%# §3.1.2 : la liste ordonnée donne l'ordre aux lecteurs d'écran ; pastilles et icônes sont décoratives. %>
          <ol class="mt-3 grid gap-2 text-sm text-ink" data-install-target="ios" hidden>
            <% { ios_share: "arrow-up-on-square", ios_add: "plus-circle" }.each.with_index(1) do |(key, icon), step| %>
              <li class="flex items-center gap-2">
                <span class="grid size-6 place-items-center rounded-full bg-brand-soft text-xs font-bold text-brand-strong" aria-hidden="true"><%= step %></span>
                <span><%= t(".#{key}.#{role}_html") %></span>
                <%= ui_icon icon, size: :sm %>
              </li>
            <% end %>
          </ol>
        </div>
      </div>
      <% modal.footer do %>
        <%= ui_button t(".later"), variant: :ghost, data: { action: "install#later" } %>
        <%= ui_button t(".install"), variant: :primary, icon: "arrow-down-tray", hidden: true,
                      data: { install_target: "android", action: "install#prompt" } %>
      <% end %>
    <% end %>
  </div>
<% end %>
