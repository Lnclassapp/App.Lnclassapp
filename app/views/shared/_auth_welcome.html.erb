<%# 🌐 UI · shared/_auth_welcome — l'accueil bleu de la connexion et de l'inscription élève : carte en haut du formulaire, ou panneau à gauche %>
<%# Rôle : variant :card sous 1 024 px (logo 48 px), :panel au-delà (moitié de l'écran, logo 64 px) ; aplat brand, texte on-brand (UDR-0171), tokens seuls %>
<%# UDR  : 0054 (§3.2 logo vers l'accueil public), 0084 §3.5 (AA ; dégradé remplacé par l'aplat, UDR-0171), 0088 (§3.1, §3.7) · locals : variant, title, text %>
<%# locals: (variant:, title:, text: nil) -%>
<%# UDR-0171 : un aplat du bleu de marque, texte on-brand blanc (5,52:1) dans les deux thèmes. %>
<% gradient = "bg-brand text-on-brand" %>
<% logo = lambda do |size|
     link_to root_path, "aria-label": t(".logo_home"),
                        class: "flex w-fit min-h-tap shrink-0 items-center rounded-card focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-on-brand" do
       tag.span(image_tag(brand_logo, alt: "", class: "#{size} rounded-ln object-cover"),
                class: "grid place-items-center rounded-card bg-white p-1.5 shadow-lift")
     end
   end %>
<% case variant.to_sym %>
<% when :card %>
  <section id="auth-welcome-card" aria-label="Lnclass" class="rounded-card p-5 shadow-lift lg:hidden <%= gradient %>">
    <div class="flex items-center gap-4">
      <%= logo.call("size-12") %>
      <p class="font-display text-2xl leading-tight font-medium"><%= title %></p>
    </div>
    <% if text %><p class="mt-3 text-sm leading-relaxed"><%= text %></p><% end %>
  </section>
<% when :panel %>
  <aside id="auth-welcome-panel" aria-label="Lnclass"
         class="hidden items-center justify-center p-10 lg:sticky lg:top-0 lg:flex lg:h-dvh lg:self-start <%= gradient %>">
    <div class="grid max-w-sm justify-items-center gap-5 text-center">
      <%= logo.call("size-16") %>
      <p class="font-display text-4xl leading-tight font-medium"><%= title %></p>
      <% if text %><p class="text-lg leading-relaxed"><%= text %></p><% end %>
    </div>
  </aside>
<% else %>
  <% raise ArgumentError, "shared/auth_welcome variant : card ou panel (reçu « #{variant} »)" %>
<% end %>
