<%# 🌐 UI · shared/_school_staff — bloc « Direction » de l'établissement, pour la direction et pour l'équipe %>
<%# Rôle : comptes direction actifs avec leur fonction, arrivée, places « par le code » ; menu ⋮ par ligne (shared/_school_staff_row) %>
<%# ADR  : 0077, 0092 · UDR : 0042, 0070 (§3.4), 0092 (§3.2, §3.4) · locals : voir la ligne ; position_url (équipe seule) %>
<%= ui_card id: "school_staff", title: t("shared.school_staff.title"), padding: :md do %>
  <%= render "shared/school_staff_places", by_code_count: %>
  <% if staff.empty? %>
    <%= ui_empty_state title: t("shared.school_staff.empty"), icon: "user-group" %>
  <% else %>
    <ul id="school_staff_list" class="divide-y divide-line">
      <% staff.each do |row| %>
        <%= render "shared/school_staff_row", row:, viewer_id:, remove_url:, removable:, school_type:,
                                              position_url: local_assigns[:position_url] %>
      <% end %>
    </ul>
  <% end %>
  <% if newcomer %>
    <p id="school_staff_newcomer" class="mt-3 text-xs text-mute"><%= t("shared.school_staff.newcomer") %></p>
  <% end %>
<% end %>
