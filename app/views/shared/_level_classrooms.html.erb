<%# 🌐 UI · shared/_level_classrooms — bloc « Classes par niveau », partagé par la fiche de l'équipe et la page de la direction %>
<%# Rôle : une ligne par niveau/série : nombre de classes de l'année, « − » (dernière classe, confirmée) et « + » (classe suivante) %>
<%# ADR  : 0041, 0059, 0071 · UDR : 0006, 0046, 0056 · add_url : chemin du « + » ; remove_url : public_id → chemin du « − » %>
<% scope = "teams.level_classrooms.block" %>
<% accepts_classrooms = block.school_status == "active" %>
<section id="school_level_classrooms" aria-labelledby="school_level_classrooms_title" class="rounded-card border border-line bg-white shadow-card">
  <div class="px-4 pt-4 sm:px-5">
    <h3 id="school_level_classrooms_title" class="font-display text-lg font-extrabold"><%= t("#{scope}.title") %></h3>
    <p class="mt-1 text-sm text-mute"><%= t("#{scope}.hint") %></p>
    <% unless accepts_classrooms %>
      <p id="school_level_classrooms_inactive" class="mt-2 text-sm text-warning"><%= t("#{scope}.inactive") %></p>
    <% end %>
  </div>
  <% if block.rows.empty? %>
    <div class="p-4 sm:p-5">
      <%= ui_empty_state title: t("#{scope}.empty_title"), description: t("#{scope}.empty_description"), icon: "academic-cap" %>
    </div>
  <% else %>
    <ul class="grid gap-x-6 px-4 pb-2 sm:grid-cols-2 sm:px-5 2xl:grid-cols-3">
      <% block.rows.each do |row| %>
        <% remove_label = tag.span(t("#{scope}.remove", level: row.label), class: "sr-only") %>
        <li id="level_classrooms_<%= row.key %>" class="flex items-center justify-between gap-3 border-t border-line py-2">
          <span class="min-w-0 truncate font-medium"><%= row.label %></span>
          <div role="group" aria-label="<%= t("#{scope}.count", level: row.label, count: row.count) %>" class="flex shrink-0 items-center gap-1">
            <% if row.last_classroom %>
              <%= ui_modal title: t("#{scope}.remove_title", name: row.last_classroom.name), id: "remove-classroom-#{row.key}", size: :sm,
                           trigger: remove_label, trigger_variant: :secondary, trigger_icon: "minus" do |modal| %>
                <% modal.footer do %>
                  <%= ui_button t("#{scope}.cancel"), variant: :secondary, data: { action: "modal#close" } %>
                  <%= ui_button t("#{scope}.confirm_remove"), type: :submit, variant: :danger, form: "remove-classroom-#{row.key}-form" %>
                <% end %>
                <%= form_with url: remove_url.call(row.last_classroom.public_id), method: :delete,
                              id: "remove-classroom-#{row.key}-form" do %>
                  <p class="text-sm text-mute"><%= t("#{scope}.remove_warning") %></p>
                <% end %>
              <% end %>
            <% else %>
              <%= ui_button remove_label, variant: :secondary, icon: "minus", disabled: true %>
            <% end %>
            <span class="w-8 text-center font-display text-lg font-extrabold tabular-nums" aria-hidden="true"><%= row.count %></span>
            <% if accepts_classrooms && row.open %>
              <%= form_with url: add_url, method: :post do %>
                <%= hidden_field_tag :level, row.level_slug, id: nil %>
                <%= hidden_field_tag :series, row.series_slug, id: nil %>
                <%= ui_button tag.span(t("#{scope}.add", level: row.label), class: "sr-only"), type: :submit, variant: :secondary, icon: "plus" %>
              <% end %>
            <% else %>
              <span class="w-tap" aria-hidden="true"></span>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
