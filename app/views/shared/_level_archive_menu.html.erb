<%# 🌐 UI · shared/_level_archive_menu — menu ⋮ de l'en-tête d'un niveau : archiver toutes ses classes actives (confirmé) %>
<%# Rôle : « Archiver le niveau » ouvre une confirmation qui chiffre les classes, élèves et enseignants concernés %>
<%# ADR  : 0088 · UDR : 0083, 0042, 0056 · Stimulus : dropdown, modal %>
<%# locals: (name:, slug:, classrooms_count:, students_count:, teachers_count:, archive_path:) -%>
<% dialog_id = "archive-level-#{slug}" %>
<div>
  <%= ui_dropdown label: t(".actions", name:), id: "level-menu-#{slug}", fixed: true do %>
    <%= ui_dropdown_item t(".archive"), dialog: dialog_id, icon: "archive-box", tone: :danger %>
  <% end %>
  <%= ui_modal title: t(".title", count: classrooms_count, name:), id: dialog_id, size: :sm, described_by: "#{dialog_id}-description" do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".confirm"), type: :submit, form: "#{dialog_id}-form", variant: :danger, icon: "archive-box" %>
    <% end %>
    <p id="<%= dialog_id %>-description" class="text-sm text-mute">
      <%= t(".warning", people: t(".people", students: t(".students", count: students_count), teachers: t(".teachers", count: teachers_count))) %>
    </p>
    <%= form_with url: archive_path, method: :post, id: "#{dialog_id}-form" do %>
      <%= hidden_field_tag :level, slug %>
    <% end %>
  <% end %>
</div>
