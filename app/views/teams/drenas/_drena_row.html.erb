<%# 🌐 UI · teams/drenas/_drena_row — une ligne du tableau des DRENA (Queries::School::DrenasQuery::Row) %>
<%# Rôle : nom, slug, compteurs ; menu ⋮ : « Modifier » et « Supprimer » (confirmation lue à la demande), dans le frame modal %>
<%# ADR  : 0029, 0036, 0076 · UDR : 0006, 0035, 0042 · lot E3 du chantier politique-cache %>
<tr id="drena_<%= drena.public_id %>" class="align-middle">
  <td class="px-4 py-3 font-medium text-ink"><%= drena.name %></td>
  <td class="px-4 py-3"><code class="rounded-sm bg-mist px-1.5 py-0.5 font-mono text-xs text-ink"><%= drena.slug %></code></td>
  <td class="px-4 py-3 text-right tabular-nums"><%= drena.schools_count %></td>
  <td class="px-4 py-3 text-right tabular-nums"><%= drena.classrooms_count %></td>
  <td class="sticky-actions px-4 py-3">
    <div class="flex justify-end">
      <%= ui_dropdown label: t(".actions", name: drena.name), id: "drena-actions-#{drena.public_id}", fixed: true do %>
        <%= ui_dropdown_item t(".edit"), href: edit_drena_path(drena.public_id), icon: "pencil-square", frame: "modal" %>
        <%# Lot E3 (politique-cache) : la confirmation est lue à la demande dans le frame « modal ». %>
        <%= ui_dropdown_item t(".delete"), href: deletion_drena_path(drena.public_id), icon: "trash", tone: :danger, frame: "modal" %>
      <% end %>
    </div>
  </td>
</tr>
