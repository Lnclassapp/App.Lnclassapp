<%# 🌐 UI · teams/drenas/index — écran des DRENA de l'équipe %>
<%# Rôle : tableau #drenas par nom, slug à citer dans les imports, compteurs ; « Importer des DRENA » et « Nouvelle DRENA » ouvrent la modale %>
<%# ADR  : 0029, 0034, 0066 · UDR : 0006, 0035, 0053, 0054 %>
<% page_title t(".page_title") %>
<% content_for :nav_key, "schools" %>
<%= ui_page_header title: t(".title"), subtitle: t(".subtitle"),
                   back: { label: t(".back"), href: team_home_path } do %>
  <%# Les deux boutons restent sur une ligne dès sm (UDR-0053) : ce bloc ne se replie pas et le sous-titre cède la place.
      Au téléphone, il passe à la ligne s'il ne tient pas. %>
  <div id="drenas-header-actions" class="flex flex-wrap items-center gap-3 sm:shrink-0 sm:flex-nowrap">
    <%= ui_button t(".import"), href: new_teams_import_path(kind: "drenas"), variant: :secondary, icon: "arrow-up-tray", data: { turbo_frame: "modal" } %>
    <%= ui_button t(".new"), href: new_drena_path, icon: "plus", data: { turbo_frame: "modal" } %>
  </div>
<% end %>

<div class="relative overflow-x-auto rounded-card border border-line bg-white shadow-card">
  <table class="w-full min-w-2xl text-left text-sm">
    <thead class="border-b border-line text-xs text-mute">
      <tr>
        <th scope="col" class="px-4 py-3 font-medium"><%= t(".columns.name") %></th>
        <th scope="col" class="px-4 py-3 font-medium">
          <%= t(".columns.slug") %> <span class="font-normal">(<%= t(".columns.slug_hint") %>)</span>
        </th>
        <th scope="col" class="px-4 py-3 text-right font-medium"><%= t(".columns.schools") %></th>
        <th scope="col" class="px-4 py-3 text-right font-medium"><%= t(".columns.classrooms") %></th>
        <th scope="col" class="sticky-actions px-4 py-3"><span class="sr-only"><%= t(".columns.actions") %></span></th>
      </tr>
    </thead>
    <tbody id="drenas" class="divide-y divide-line">
      <%= render partial: "drena_row", collection: @drenas, as: :drena %>
    </tbody>
  </table>
  <%# Vidé par create, rempli par destroy quand la dernière ligne part : sans contenu, il ne prend aucune place. %>
  <div id="drenas_empty" class="p-6 empty:hidden"><%= ui_empty_state(title: t(".empty_title"), description: t(".empty_description"), icon: "building-library") if @drenas.empty? %></div>
</div>
