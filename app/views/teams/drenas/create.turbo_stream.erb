<%# 🌐 UI · teams/drenas/create — succès de la création d'une DRENA %>
<%# Rôle : toast, modale refermée, tableau #drenas rendu de nouveau (ordre des noms) ; l'état vide s'efface seul %>
<%# ADR  : 0029, 0034 · UDR : 0006, 0035 %>
<%= turbo_stream_toast t(".created", name: @drena.name), type: :success %>
