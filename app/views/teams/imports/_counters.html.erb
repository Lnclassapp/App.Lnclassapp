<%# 🌐 UI · teams/imports/_counters — les quatre compteurs d'un rapport %>
<%# Rôle : importés, ignorés, en erreur, total ; propres au type du rapport (report_text) %>
<%# ADR  : 0039, 0056, 0096 · UDR : 0006, 0105 · rendu à la fin d'un import, et dans un rapport de régénération échoué %>
<dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
  <% { imported: import.imported_count, skipped: import.skipped_count, errors: import.error_count, total: import.total_count }.each do |counter, value| %>
    <div class="rounded-ln bg-mist px-4 py-3">
      <dt class="text-xs text-mute"><%= report_text(import, "counters.#{counter}") %></dt>
      <dd id="import_counter_<%= counter %>" class="font-display text-2xl font-medium tabular-nums"><%= value %></dd>
    </div>
  <% end %>
</dl>
