<%# 🌐 UI · teams/imports/_status — suivi d'un import, frame rechargé chaque seconde tant que l'import tourne %>
<%# Rôle : phase et progression pendant l'import ; à la fin, compteurs, détails, bilan par fichier et erreurs ; rejet : son motif %>
<%# ADR  : 0039, 0056, 0068, 0096 · UDR : 0006, 0043, 0055, 0105 · Stimulus : teams--import-status · libellés propres au type : report_text %>
<%# Régénération de masse (UDR-0105) : la sélection est dans le sous-titre, pas dans les détails ; « Déjà changés » s'explique. %>
<% regeneration = Entities::Catalog::ImportKind::CODE_REGENERATIONS.include?(import.kind) %>
<% details = import.details.except("selection") %>
<%# Pas de src sur le frame : Turbo le chargerait dès son arrivée ; le contrôleur le pose au premier rechargement. %>
<%= turbo_frame_tag "import_status",
                    data: { controller: "teams--import-status", teams__import_status_url_value: teams_import_path(import.public_id) } do %>
  <div data-teams--import-status-target="state" data-status="<%= import.status %>" class="space-y-5" aria-live="polite">
    <div class="flex flex-wrap items-center gap-3">
      <%= ui_badge import_status_label(import), tone: import_status_tone(import.status), dot: true %>
      <% if import.finished_at %>
        <span class="text-sm text-mute"><%= t(".finished_at", time: l(import.finished_at, format: :short)) %></span>
      <% end %>
    </div>

    <% case import.status %>
    <% when "queued", "validating", "importing" %>
      <%# Aucun signe de vie depuis la limite : le job est mort (ADR-0096 §4.3). Le suivi continue, au cas où il reprendrait. %>
      <% if import_stalled?(import) %>
        <div class="space-y-2">
          <div id="import_stalled" role="alert" class="rounded-ln bg-warning-soft px-4 py-3 text-sm font-medium text-ink"><%= report_text(import, "stalled", minutes: import_stale_minutes) %></div>
          <p class="text-sm text-mute"><%= report_text(import, "processed", count: import.processed_count) %></p>
        </div>
      <% else %>
        <div class="space-y-2">
          <p class="text-sm font-medium"><%= report_text(import, "phases.#{import.status}") %></p>
          <progress class="h-2 w-full overflow-hidden rounded-full accent-brand" aria-label="<%= report_text(import, "phases.#{import.status}") %>"></progress>
          <p class="text-sm text-mute"><%= report_text(import, "processed", count: import.processed_count) %></p>
        </div>
      <% end %>
    <% when "completed" %>
      <%= render "teams/imports/counters", import: %>
      <% if regeneration %>
        <%# Un <details> ne vit pas dans un <p> : le navigateur fermerait le paragraphe avant lui. %>
        <div id="import_skipped_tip" class="-mt-2 text-sm text-mute">
          <%= report_text(import, "counters.skipped") %> <%= ui_info_tip t(".skipped_tip"), label: report_text(import, "counters.skipped") %>
        </div>
      <% end %>
      <% if details.any? %>
        <div>
          <h3 class="mb-2 text-sm font-medium"><%= t(".details_title") %></h3>
          <ul class="space-y-1 text-sm">
            <% details.each do |key, value| %>
              <li><%= t(".details.#{key}", default: key.to_s.humanize) %> : <span class="font-medium tabular-nums"><%= value %></span></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <% if import.files.any? %>
        <%= render "teams/imports/files", import: %>
      <% end %>
      <% if import.import_errors.any? %>
        <%= render "teams/imports/import_errors", import: %>
      <% end %>
    <% when "rejected" %>
      <div role="alert" class="rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error"><%= t(import.file_count > 1 ? ".rejected_files" : ".rejected") %></div>
      <% if import.file_count > 1 %>
        <%= render "teams/imports/files", import: %>
      <% end %>
      <%= render "teams/imports/import_errors", import: %>
    <% when "failed" %>
      <div role="alert" class="rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error"><%= report_text(import, "failed") %></div>
      <%# Une régénération échouée a pu changer des codes avant de s'arrêter : elle le dit, et le motif de l'arrêt (UDR-0105). %>
      <% if regeneration %>
        <%= render "teams/imports/counters", import: %>
        <% if import.import_errors.any? %>
          <%= render "teams/imports/import_errors", import: %>
        <% end %>
      <% end %>
    <% end %>
  </div>
<% end %>
