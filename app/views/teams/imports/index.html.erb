<%# 🌐 UI · teams/imports/index — écran des imports de l'équipe %>
<%# Rôle : rapports récents filtrables par type (génération des classes comprise) ; « Nouvel import » : téléversement %>
<%# ADR  : 0039, 0056 · UDR : 0006, 0043, 0054 %>
<% page_title t(".page_title") %>
<%= ui_page_header title: t(".title"), subtitle: t(".subtitle") do %>
  <%= ui_dropdown label: t(".new"), id: "new-import-menu",
                  trigger: tag.span(safe_join([ ui_icon("arrow-up-tray", size: :sm), t(".new") ]), class: "flex items-center gap-2 pl-3 text-sm font-medium") do %>
    <% Entities::Catalog::ImportKind::KINDS.each do |kind| %>
      <%= link_to t("import_kinds.#{kind}"), new_teams_import_path(kind:), role: "menuitem", tabindex: -1,
                  data: { turbo_frame: "modal" },
                  class: "ui-menu-item ui-menu-item-default" %>
    <% end %>
  <% end %>
<% end %>

<nav aria-label="<%= t(".filter_label") %>" class="mb-5 flex flex-wrap gap-2">
  <% [ nil, *Entities::Catalog::ImportKind::REPORT_KINDS ].each do |kind| %>
    <%= link_to (kind ? t("import_kinds.#{kind}") : t(".all")), teams_imports_path(kind:),
                "aria-current": ("page" if kind == @kind),
                class: class_names("inline-flex min-h-10 items-center rounded-full border px-4 text-sm font-medium transition",
                                   kind == @kind ? "border-ink bg-ink text-white" : "border-line bg-white text-ink hover:bg-mist") %>
  <% end %>
</nav>

<div class="overflow-x-auto rounded-card border border-line bg-white shadow-card">
  <table class="w-full min-w-3xl text-left text-sm">
    <thead class="border-b border-line text-xs text-mute">
      <tr>
        <% %i[date kind file status imported skipped errors author].each do |column| %>
          <th scope="col" class="px-4 py-3 font-medium"><%= t(".columns.#{column}") %></th>
        <% end %>
      </tr>
    </thead>
    <tbody id="imports" class="divide-y divide-line">
      <%= render partial: "import_row", collection: @imports, as: :import %>
    </tbody>
  </table>
  <% if @imports.empty? %>
    <div id="imports_empty" class="p-6">
      <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "arrow-up-tray" %>
    </div>
  <% end %>
</div>
