<%# 🌐 UI · teams/imports/show — page de suivi d'un import %>
<%# Rôle : en-tête du rapport (type, fichier, auteur, date), puis le suivi rechargé tant que l'import tourne %>
<%# ADR  : 0039 · UDR : 0006 %>
<% content_for :title, t(".page_title", kind: t("import_kinds.#{@import.kind}")) %>
<div class="mb-4">
  <%= ui_button t(".back"), href: teams_imports_path, variant: :ghost, size: :sm, icon: "arrow-left" %>
</div>
<%= ui_page_header title: t(".title", kind: t("import_kinds.#{@import.kind}")),
                   subtitle: t(".subtitle", filename: @import.filename, author: @import.imported_by_name, date: l(@import.created_at, format: :short)) %>
<%= ui_card do %>
  <%= render "status", import: @import %>
<% end %>
