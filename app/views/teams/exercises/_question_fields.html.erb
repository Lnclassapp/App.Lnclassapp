<%# 🌐 UI · teams/exercises/_question_fields — une question du formulaire : image, énoncé, type, explication, propositions %>
<%# Rôle : rendue par fields_for, ou clonée depuis <template> ; ses propositions ont leur propre contrôleur nested-form ; son image, assessment--question-image %>
<%# ADR  : 0054, 0091, 0104 · UDR : 0007, 0017, 0087, 0129 · Stimulus : teams--nested-form, teams--question-kind, assessment--question-image (errors : structure, « questions[i] ») %>
<% kinds = Entities::Assessment::Question::KIND_NAMES.values.select { lookup_context.exists?("kinds/#{it}_fields", [ "teams/exercises" ], true) } %>
<% types = Entities::Assessment::Question::TYPES.select { kinds.include?(Entities::Assessment::Question.kind_name_for(it)) } %>
<% kind = Entities::Assessment::Question.kind_name_for(form.object.question_type) || "choice" %>
<%= tag.fieldset class: "relative rounded-card border border-line bg-white p-4 counter-question",
                 data: { nested_question: true, controller: "teams--question-kind",
                         teams__question_kind_kinds_value: types.to_h { [ it, Entities::Assessment::Question.kind_name_for(it) ] }.to_json } do %>
  <legend class="float-left w-full pr-14 font-medium text-ink">
    <%= t(".legend") %> <span class="question-number"></span>
  </legend>
  <%= ui_button variant: :ghost, size: :sm, icon: "trash", "aria-label": t(".remove"), class: "absolute! top-3 right-3",
                data: { action: "teams--nested-form#remove" } %>
  <div class="clear-both space-y-4 pt-3">
    <% if errors.any? %>
      <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
        <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
        <p><%= errors.to_sentence %></p>
      </div>
    <% end %>
    <%= render "question_image_fields", form: %>
    <%= ui_field form, :content, as: :textarea, rows: 2, required: true, placeholder: t(".content_placeholder") %>
    <div class="grid gap-4 sm:grid-cols-2">
      <%= ui_field form, :question_type, as: :select, required: true,
                                         choices: types.map { [ t("teams.exercises.question_types.#{it}"), it ] },
                                         data: { teams__question_kind_target: "select", action: "teams--question-kind#switch" } %>
      <%= ui_field form, :explanation, hint: t(".explanation_hint") %>
    </div>
    <%# ADR-0091 §4.5 : un panneau par famille de types ; seul celui du type choisi est actif, donc envoyé. Un panneau
        n'existe qu'une fois son partial livré : un type sans le sien n'est pas proposé. %>
    <% Entities::Assessment::Question::KIND_NAMES.each_value.select { kinds.include?(it) }.each do |name| %>
      <%= tag.fieldset class: "min-w-0", hidden: name != kind, disabled: name != kind,
                       data: { teams__question_kind_target: "panel", kind: name } do %>
        <%= render "teams/exercises/kinds/#{name}_fields", form: %>
      <% end %>
    <% end %>
  </div>
<% end %>
