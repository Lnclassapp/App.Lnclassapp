<%# 🌐 UI · teams/exercises/kinds/_ordering_fields — remettre dans l'ordre : trois à six étapes, dans le bon ordre %>
<%# Rôle : rendu par _question_fields dans le panneau du type ; l'ordre des champs est le bon ordre ; chaque étape est juste %>
<%# ADR  : 0091 §4.2, §4.5 · UDR : 0017, 0087 §3.7 · Stimulus : teams--nested-form · ids suffixés : un panneau caché garde les siens %>
<%# locals: (form:) -%>
<% scope = "teams.exercises.kinds.ordering" %>
<div class="space-y-2" data-controller="teams--nested-form" data-teams--nested-form-placeholder-value="NEW_ANSWER"
     data-teams--nested-form-item-value="[data-nested-answer]">
  <p class="text-sm text-mute"><%= t("#{scope}.hint") %></p>
  <p class="text-sm font-medium text-ink"><%= t("#{scope}.answers") %></p>
  <div data-teams--nested-form-target="list" class="space-y-2">
    <%= form.fields_for :answers do |answer_form| %>
      <%= render "teams/exercises/kinds/text_answer_fields", form: answer_form, kind: "ordering", placeholder: t("#{scope}.placeholder") %>
    <% end %>
  </div>
  <template data-teams--nested-form-target="template">
    <%= form.fields_for :answers, Dtos::Assessment::AnswerInput.new, child_index: "NEW_ANSWER" do |answer_form| %>
      <%= render "teams/exercises/kinds/text_answer_fields", form: answer_form, kind: "ordering", placeholder: t("#{scope}.placeholder") %>
    <% end %>
  </template>
  <%= ui_button t("#{scope}.add"), variant: :ghost, size: :sm, icon: "plus", data: { action: "teams--nested-form#add" } %>
</div>
