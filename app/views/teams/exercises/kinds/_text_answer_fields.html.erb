<%# 🌐 UI · teams/exercises/kinds/_text_answer_fields — un élément texte d'une question hors choix (réponse acceptée, étape) %>
<%# Rôle : le texte, « correcte » posé à 1 (ADR-0091 §4.2 : chaque élément est juste), « Retirer » ; ids suffixés par le type %>
<%# ADR  : 0091 §4.2 · UDR : 0017, 0087 §3.7 · Stimulus : teams--nested-form · locals : form (fields_for :answers), kind, placeholder %>
<%# locals: (form:, kind:, placeholder:) -%>
<% id = "#{form.field_id(:content)}_#{kind}" %>
<% error = form.object.errors[:content].first %>
<div data-nested-answer class="space-y-1">
  <div class="flex items-center gap-2">
    <%= form.hidden_field :correct, value: "1", id: nil %>
    <%= form.label :content, placeholder, for: id, class: "sr-only" %>
    <%= form.text_field :content, id:, required: true, maxlength: Dtos::Assessment::AnswerInput::CONTENT_MAX, placeholder:,
                                  autocomplete: "off", "aria-invalid": ("true" if error), "aria-describedby": ("#{id}_error" if error),
                                  class: class_names(ComponentsHelper::FIELD_INPUT, "min-h-tap min-w-0 flex-1",
                                                     ComponentsHelper::FIELD_STATES[error ? :invalid : :valid]) %>
    <%= ui_button variant: :ghost, size: :sm, icon: "x-mark", "aria-label": t("teams.exercises.answer_fields.remove"),
                  data: { action: "teams--nested-form#remove" } %>
  </div>
  <% if error %>
    <p id="<%= id %>_error" class="flex items-center gap-1.5 text-sm font-medium text-error">
      <%= ui_icon "exclamation-circle", variant: :mini, size: :sm %><%= error %>
    </p>
  <% end %>
</div>
