<%# 🌐 UI · teams/exercises/kinds/_numeric_fields — réponse en nombre : la valeur attendue et la marge facultative %>
<%# Rôle : rendu par _question_fields dans le panneau du type ; une seule valeur (« -3,5 »), juste ; sans marge, la valeur exacte %>
<%# ADR  : 0091 §4.2, §4.5 · UDR : 0017, 0087 §3.7 · ids suffixés : un panneau caché garde les siens %>
<%# locals: (form:) -%>
<% scope = "teams.exercises.kinds.numeric" %>
<div class="grid gap-4 sm:grid-cols-2">
  <%= form.fields_for :answers, form.object.answers.first(1).presence || [ Dtos::Assessment::AnswerInput.new ] do |answer_form| %>
    <% id = "#{answer_form.field_id(:content)}_numeric" %>
    <% error = answer_form.object.errors[:content].first %>
    <div class="space-y-1.5">
      <%= answer_form.hidden_field :correct, value: "1", id: nil %>
      <%= answer_form.label :content, t("#{scope}.value"), for: id, class: "block text-sm font-medium text-ink" %>
      <%= answer_form.text_field :content, id:, required: true, inputmode: "decimal", autocomplete: "off",
                                           placeholder: t("#{scope}.value_placeholder"), "aria-invalid": ("true" if error),
                                           class: class_names(ComponentsHelper::FIELD_INPUT, "min-h-tap w-full",
                                                              ComponentsHelper::FIELD_STATES[error ? :invalid : :valid]) %>
    </div>
  <% end %>
  <% tolerance_id = "#{form.field_id(:numeric_tolerance)}_numeric" %>
  <% tolerance_error = form.object.errors[:numeric_tolerance].first %>
  <div class="space-y-1.5">
    <%= form.label :numeric_tolerance, t("#{scope}.tolerance"), for: tolerance_id, class: "block text-sm font-medium text-ink" %>
    <%= form.text_field :numeric_tolerance, id: tolerance_id, inputmode: "decimal", autocomplete: "off", placeholder: "0,1",
                                            "aria-describedby": "#{tolerance_id}_hint", "aria-invalid": ("true" if tolerance_error),
                                            class: class_names(ComponentsHelper::FIELD_INPUT, "min-h-tap w-full",
                                                               ComponentsHelper::FIELD_STATES[tolerance_error ? :invalid : :valid]) %>
    <p id="<%= tolerance_id %>_hint" class="text-sm <%= tolerance_error ? "font-medium text-error" : "text-mute" %>"><%= tolerance_error || t("#{scope}.tolerance_hint") %></p>
  </div>
</div>
