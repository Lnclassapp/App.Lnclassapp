<%# 🌐 UI · teams/staff_invitations/new — invitation de la direction d'un établissement, servie dans le frame « modal » %>
<%# Rôle : le numéro et la fonction ; établissement non actif en tête, autre refus sous son champ, en 422 ; succès : le lien %>
<%# ADR  : 0038, 0050, 0065, 0092 · UDR : 0019, 0052, 0054, 0092 (§3.1) · l'onglet porte le titre de la modale ouverte %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title"), id: "staff-invitation-modal", open: true, document_title: page_title(t(".title")) do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "staff-invitation-form", icon: "paper-airplane" %>
    <% end %>
    <p class="mb-5 text-sm text-mute"><%= t(".intro", school: @school.name) %></p>
    <%= form_with model: @form, scope: :invitation, url: school_staff_invitations_path(@school.public_id),
                  id: "staff-invitation-form", class: "space-y-5" do |form| %>
      <% alerts = @form.errors[:school] + @form.errors[:base] %>
      <% if alerts.any? %>
        <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
          <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
          <p><%= alerts.to_sentence %></p>
        </div>
      <% end %>
      <%= ui_field form, :contact, as: :tel, required: true, value: @form.raw_contact, maxlength: 15, inputmode: "tel",
                   autocomplete: "off", autofocus: true, placeholder: t(".contact_placeholder"), hint: t(".contact_hint") %>
      <%= render "shared/staff_position_fieldset", form:, legend: t(".position"), school_type: @school.school_type %>
    <% end %>
  <% end %>
<% end %>
