<%# 🌐 UI · teams/staff_invitations/_created — le lien d'invitation de la direction, montré une seule fois, dans la modale %>
<%# Rôle : champ en lecture seule et consigne de transmission ; rendu par create.turbo_stream et par la page created %>
<%# ADR  : 0038, 0065 · UDR : 0019, 0052 %>
<%= ui_modal title: t("teams.staff_invitations.created.title"), id: "staff-invitation-created-modal", open: true do |modal| %>
  <% modal.footer do %>
    <%= ui_button t("teams.staff_invitations.created.close"), variant: :secondary, data: { action: "modal#close" } %>
  <% end %>
  <div class="space-y-4">
    <p class="text-sm text-ink">
      <%= t("teams.staff_invitations.created.summary", contact: invitation.contact.scan(/\d{2}/).join(" "), school: school.name) %>
    </p>
    <div class="space-y-1.5">
      <label for="invitation-link" class="block text-sm font-medium text-ink"><%= t("teams.staff_invitations.created.link") %></label>
      <input id="invitation-link" type="text" value="<%= url %>" readonly aria-describedby="invitation-link-hint"
             class="block min-h-tap w-full rounded-ln border border-line bg-mist px-4 font-mono text-sm text-ink">
      <p id="invitation-link-hint" class="text-sm text-mute"><%= t("teams.staff_invitations.created.instructions") %></p>
    </div>
    <p class="flex items-start gap-2 rounded-ln bg-warning-soft px-4 py-3 text-sm text-ink">
      <%= ui_icon "exclamation-triangle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
      <%= t("teams.staff_invitations.created.once") %>
    </p>
  </div>
<% end %>
