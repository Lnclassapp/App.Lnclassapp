<%# 🌐 UI · teams/staff_invitations/created — repli HTML de l'invitation de la direction, sans Turbo %>
<%# Rôle : la modale du lien, ouverte sur le shell ; le lien n'est jamais placé dans un flash %>
<%# ADR  : 0038, 0065 · UDR : 0019, 0052, 0054 %>
<% page_title t(".title") %>
<%= turbo_frame_tag "modal" do %>
  <%= render "created", invitation: @invitation, school: @school, url: @invitation_url %>
<% end %>
