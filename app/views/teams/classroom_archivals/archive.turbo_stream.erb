<%# 🌐 UI · teams/classroom_archivals/archive — réponse de « Archiver la classe » de la fiche %>
<%# Rôle : toast (succès avec « Annuler » qui restaure, ou motif du refus), niveau remplacé par morphing, fiche re-demandée après un succès %>
<%# ADR  : 0088 · UDR : 0083, 0056 %>
<% undo = { label: t("teams.classroom_archivals.undo"), href: restore_school_classroom_archival_path(@school.public_id, params[:public_id]), method: :patch } %>
<%= turbo_stream_toast @notice || @alert, type: (@notice ? :success : :info), action: (undo if @notice) %>
<% if @level %>
  <%= turbo_stream.replace "level_#{@level.slug}", method: :morph do %>
    <%= render "teams/schools/classroom_group", level: @level, school_active: @school.status == "active", school_public_id: @school.public_id %>
  <% end %>
<% end %>
<% if @notice %>
  <%= turbo_stream.refresh(request_id: nil) %>
<% end %>
