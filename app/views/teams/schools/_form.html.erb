<%# 🌐 UI · teams/schools/_form — modification d'un établissement, dans la modale d'edit (aucune création) %>
<%# Rôle : nom, sigle, DRENA, type, statut, cycle en radios ; rappelle que changer le type ou le cycle ne touche à aucune classe %>
<%# ADR  : 0030, 0036 · UDR : 0005, 0036 %>
<% school = Entities::School::School %>
<%= form_with model: @form, scope: :school, url:, method: :patch, id: "school-form", class: "space-y-5" do |form| %>
  <%= ui_field form, :name, required: true, maxlength: school::NAME_MAX, autofocus: true,
               hint: t(".name_hint", count: school::NAME_MAX) %>
  <div class="grid gap-5 sm:grid-cols-2">
    <%= ui_field form, :sigle, maxlength: school::SIGLE_MAX, placeholder: t(".sigle_placeholder"),
                 hint: t(".sigle_hint", count: school::SIGLE_MAX) %>
    <%= ui_field form, :drena_public_id, as: :select, required: true, choices: drena_options.map { [ it.name, it.public_id ] } %>
  </div>
  <div class="grid gap-5 sm:grid-cols-2">
    <%= ui_field form, :school_type, as: :select, required: true,
                 choices: school::SCHOOL_TYPES.map { [ t("school_types.#{it}"), it ] } %>
    <%= ui_field form, :status, as: :select, required: true,
                 choices: school::STATUSES.map { [ t("school_statuses.#{it}"), it ] } %>
  </div>
  <%= ui_radio_group form, :cycle, required: true, choices: school::CYCLES.map { [ t("teams.schools.cycles.#{it}"), it ] } %>
  <p class="flex items-start gap-2 rounded-ln bg-info-soft p-3 text-sm text-info">
    <%= ui_icon "information-circle", variant: :mini, class: "mt-0.5" %><span><%= t(".classrooms_hint") %></span>
  </p>
<% end %>
