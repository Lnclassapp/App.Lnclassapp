<%# 🌐 UI · teams/schools/_header — en-tête de la fiche d'un établissement, remplacé par les streams update et deactivate %>
<%# Rôle : nom, sigle, DRENA, type, cycle, statut, code d'établissement (copier, lien) ; menu ⋮ : inviter la direction, modifier, régénérer le code, désactiver %>
<%# ADR  : 0030, 0036, 0057, 0063, 0065 · UDR : 0006, 0036, 0042, 0044, 0050, 0052 · Stimulus : classroom--join-code-copy %>
<% active = school.status != "inactive" %>
<%# Seul un établissement actif reçoit une classe ou une direction : ni désactivé, ni en brouillon (porteur, 2026-09-27 ; ADR-0065) %>
<% accepts_classrooms = school.status == "active" %>
<% code = Entities::School::SchoolCode.display(school.school_code) %>
<% link = school_code_signup_url(school.school_code) %>
<div id="school_header" class="mb-8">
  <nav aria-label="<%= t(".breadcrumb") %>" class="mb-4 text-sm">
    <%= link_to schools_path, class: "inline-flex min-h-tap items-center gap-1.5 font-medium text-mute transition hover:text-ink" do %>
      <%= ui_icon "chevron-left", variant: :mini, size: :sm %><%= t(".back") %>
    <% end %>
  </nav>
  <%= ui_card padding: :md do %>
    <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
      <div class="flex min-w-0 items-start gap-4">
        <span class="grid size-14 shrink-0 place-items-center rounded-card bg-ink font-display text-lg font-extrabold text-white" aria-hidden="true">
          <%= (school.sigle || school.name).first(3).upcase %>
        </span>
        <div class="min-w-0">
          <h1 class="font-display text-2xl font-extrabold tracking-tight text-balance sm:text-3xl"><%= school.name %></h1>
          <dl class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-mute">
            <% if school.sigle %>
              <div class="flex gap-1"><dt><%= t(".sigle") %></dt><dd class="font-medium text-ink"><%= school.sigle %></dd></div>
            <% end %>
            <div class="flex items-center gap-1">
              <dt><%= ui_icon "map-pin", size: :sm, label: t(".drena") %></dt><dd><%= school.drena_name %></dd>
            </div>
            <% if school.national_code %>
              <div id="school_national_code" class="flex gap-1">
                <dt><%= t(".national_code") %></dt><dd class="font-mono font-medium text-ink"><%= school.national_code %></dd>
              </div>
            <% end %>
            <div class="flex gap-1"><dt class="sr-only"><%= t(".type") %></dt><dd><%= t("school_types.#{school.school_type}") %></dd></div>
            <div class="flex gap-1"><dt class="sr-only"><%= t(".cycle") %></dt><dd><%= t("teams.schools.cycles.#{school.cycle}") %></dd></div>
            <div class="flex gap-1">
              <dt class="sr-only"><%= t(".status") %></dt>
              <dd><%= ui_badge t("school_statuses.#{school.status}"), tone: school_status_tone(school.status), size: :sm, dot: true %></dd>
            </div>
          </dl>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-3 lg:shrink-0 lg:flex-nowrap">
        <% if accepts_classrooms %>
          <%= ui_button t(".add_classroom"), href: new_school_classroom_path(school.public_id), icon: "plus",
                        data: { turbo_frame: "modal" } %>
        <% end %>
        <%= ui_dropdown label: t(".actions", name: school.name), id: "school-header-actions", fixed: true do %>
          <% if accepts_classrooms %>
            <%= ui_dropdown_item t(".invite_staff"), href: new_school_staff_invitation_path(school.public_id), icon: "user-plus",
                                                     frame: "modal" %>
          <% end %>
          <%= ui_dropdown_item t(".edit"), href: edit_school_path(school.public_id), icon: "pencil-square", frame: "modal" %>
          <%= ui_dropdown_item t(".regenerate_code"), dialog: "regenerate-school-code", icon: "arrow-path" %>
          <% if active %>
            <%= ui_dropdown_item t(".deactivate"), dialog: "deactivate-school-header", icon: "no-symbol" %>
          <% end %>
        <% end %>
        <%= ui_modal title: t(".regenerate_title", name: school.name), id: "regenerate-school-code", size: :sm do |modal| %>
          <% modal.footer do %>
            <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
            <%= ui_button t(".confirm_regenerate"), type: :submit, form: "regenerate-school-code-form" %>
          <% end %>
          <%= form_with url: school_code_path(school.public_id), method: :patch, id: "regenerate-school-code-form" do %>
            <p class="text-sm text-mute"><%= t(".regenerate_warning", code:) %></p>
          <% end %>
        <% end %>
        <% if active %>
          <%= ui_modal title: t(".deactivate_title", name: school.name), id: "deactivate-school-header", size: :sm do |modal| %>
            <% modal.footer do %>
              <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
              <%= ui_button t(".confirm_deactivate"), type: :submit, form: "deactivate-school-header-form" %>
            <% end %>
            <%= form_with url: deactivate_school_path(school.public_id), method: :patch, id: "deactivate-school-header-form" do %>
              <p class="text-sm text-mute"><%= t(".deactivate_warning") %></p>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div id="school_code" class="mt-5 border-t border-line pt-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
          <p id="school_code_label" class="text-xs font-semibold tracking-wider text-mute uppercase"><%= t(".school_code") %></p>
          <span id="school_code_value" aria-labelledby="school_code_label"
                class="font-mono text-2xl font-bold tracking-widest text-ink"><%= code %></span>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <% { code => [ ".copy_code", t(".copy_code_label", code:), "clipboard-document", ".code_copied" ],
               link => [ ".copy_link", t(".copy_link_label"), "link", ".link_copied" ] }.each do |value, (label, aria_label, icon, copied)| %>
            <span data-controller="classroom--join-code-copy" data-classroom--join-code-copy-code-value="<%= value %>">
              <%= ui_button t(label), variant: :secondary, size: :sm, icon:, "aria-label": aria_label,
                                      data: { action: "classroom--join-code-copy#copy" } %>
              <template data-classroom--join-code-copy-target="copied"><%= ui_toast t(copied), type: :success %></template>
              <template data-classroom--join-code-copy-target="failed"><%= ui_toast t(".copy_failed"), type: :warning %></template>
            </span>
          <% end %>
        </div>
      </div>
      <p class="mt-3 text-sm text-mute">
        <%= t(".school_code_hint") %>
        <%= link_to link, link, id: "school_code_link", class: "font-medium break-all text-brand-strong underline-offset-4 hover:underline" %>
      </p>
      <% unless accepts_classrooms %>
        <p class="mt-2 flex items-start gap-1.5 text-sm font-medium text-warning">
          <%= ui_icon "exclamation-triangle", variant: :mini, size: :sm, class: "mt-0.5" %><%= t(".school_code_inactive") %>
        </p>
      <% end %>
    </div>
  <% end %>
</div>
