<%# 🌐 UI · teams/schools/_school_row — un établissement de la liste nationale %>
<%# Rôle : lien vers la fiche (hors du frame), sans code d'établissement (IE-21) ; menu ⋮ : « Modifier », désactivation et suppression, dans le frame « modal » %>
<%# ADR  : 0030, 0036, 0076, 0083 · UDR : 0006, 0036, 0042, 0079 · confirmations lues à la demande (lot E3 du chantier politique-cache) %>
<% active = school.status != "inactive" %>
<tr id="school_<%= school.public_id %>" class="align-middle">
  <td class="min-w-48 px-4 py-3">
    <%= link_to school.name, school_path(school.public_id), data: { turbo_frame: "_top" },
                class: "font-medium text-ink underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" %>
    <% if school.sigle %>
      <span class="block text-xs text-mute"><%= school.sigle %></span>
    <% end %>
  </td>
  <td class="px-4 py-3 whitespace-nowrap text-mute"><%= school.drena_name %></td>
  <td class="px-4 py-3 whitespace-nowrap"><%= t("school_types.#{school.school_type}") %></td>
  <td class="px-4 py-3"><%= t("teams.schools.cycles.#{school.cycle}") %></td>
  <td class="px-4 py-3"><%= ui_badge t("school_statuses.#{school.status}"), tone: school_status_tone(school.status), size: :sm, dot: true %></td>
  <td class="px-4 py-3 tabular-nums"><%= school.classrooms_count %></td>
  <td class="px-4 py-3 tabular-nums"><%= school.teachers_count %></td>
  <td class="sticky-actions px-4 py-3">
    <div class="flex justify-end">
      <%= ui_dropdown label: t(".actions", name: school.name), id: "school-actions-#{school.public_id}", fixed: true do %>
        <%= ui_dropdown_item t(".edit"), href: edit_school_path(school.public_id), icon: "pencil-square", frame: "modal" %>
        <%# Lot E3 (politique-cache) : les deux confirmations sont lues à la demande dans le frame « modal ». %>
        <% if active %>
          <%= ui_dropdown_item t(".deactivate"), href: deactivation_school_path(school.public_id), icon: "no-symbol", frame: "modal" %>
        <% end %>
        <%= ui_dropdown_item t(".delete"), href: deletion_school_path(school.public_id), icon: "trash", tone: :danger, frame: "modal" %>
      <% end %>
    </div>
  </td>
</tr>
