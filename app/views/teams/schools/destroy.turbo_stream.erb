<%# 🌐 UI · teams/schools/destroy — suppression d'un établissement, ou son refus (422) %>
<%# Rôle : succès : toast, ligne retirée, puis la liste re-demandée et fusionnée (compteur, état vide, page) ; refus : toast d'erreur, ligne re-rendue %>
<%# ADR  : 0036 · UDR : 0006, 0036 %>
<% if @kept_school %>
  <%= turbo_stream_toast t(".referenced"), type: :error %>
  <%= turbo_stream.replace "school_#{@kept_school.public_id}", partial: "school_row", locals: { school: @kept_school } %>
<% else %>
  <%= turbo_stream_toast t(".done"), type: :success %>
  <%= turbo_stream.remove "school_#{params[:public_id]}" %>
  <%= turbo_stream.refresh(request_id: nil) %>
<% end %>
