<%# 🌐 UI · teams/schools/deletion — confirmation « Supprimer <nom> ? », lue à la demande (SC-07) %>
<%# Rôle : servie dans le frame « modal » depuis le menu ⋮ de la liste ; sans frame (sans JavaScript), page complète utilisable %>
<%# ADR  : 0036, 0067, 0076 · UDR : 0006, 0036, 0042, 0054 · lot E3 du chantier politique-cache : plus de copie dans chaque ligne %>
<% id = "delete-school-#{@school.public_id}" %>
<% page_title t(".title", name: @school.name) %>
<% content_for :nav_key, "schools" %>
<%# Page complète seulement : le retour à la liste, puisque « Annuler » ne fait rien sans JavaScript (UDR-0054). %>
<% unless turbo_frame_request? %>
  <%= link_to t(".back"), schools_path, id: "back-to-schools", class: "mb-4 inline-flex min-h-tap items-center text-sm font-medium text-brand-strong underline-offset-4 hover:underline" %>
<% end %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal id:, size: :sm, open: true, title: t(".title", name: @school.name) do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".confirm"), type: :submit, variant: :danger, form: "delete-school-form-#{@school.public_id}" %>
    <% end %>
    <%= form_with url: school_path(@school.public_id), method: :delete, id: "delete-school-form-#{@school.public_id}" do %>
      <p class="text-sm text-mute"><%= t(".warning") %></p>
    <% end %>
  <% end %>
<% end %>
