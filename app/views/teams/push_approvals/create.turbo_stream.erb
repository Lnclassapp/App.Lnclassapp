<%# 🌐 UI · teams/push_approvals/create — « Valider l'envoi » : toast, ligne du motif remplacée, ligne ajoutée à l'historique %>
<%# Rôle : l'état « Validé » vient du plan relu (auteur et nombre réels) ; la ligne d'historique n'est ajoutée qu'à la validation qui a réussi %>
<%# ADR  : XXXX envois de notifications (§4.4) · UDR : XXXX écran notifications de l'équipe (§3.4, §3.5) %>
<%= turbo_stream_toast @toast, type: @toast_type %>
<% if @entry %>
  <%= turbo_stream.replace "push_plan_#{@entry.motive}", partial: "teams/push_plans/motive", locals: { entry: @entry, closed: @closed } %>
<% end %>
<% if @approval && @entry&.approval %>
  <%= turbo_stream.prepend "push_history_list" do %>
    <li class="py-2"><%= t("teams.push_settings.history.approval", at: l(@approval.approved_at, format: "%-d %b %H h %M"), name: @entry.approval.by_name,
                                                                    motive: t("teams.push_settings.motives.#{@approval.motive}"), count: @approval.recipients_count) %></li>
  <% end %>
<% end %>
