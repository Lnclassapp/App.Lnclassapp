<%# 🌐 UI · teams/push_approvals/create — « Valider l'envoi » : toast, ligne du motif remplacée, historique relu %>
<%# Rôle : l'état « Validé » vient du plan relu (auteur et nombre réels) ; l'historique n'est relu qu'après la validation qui a réussi %>
<%# ADR  : XXXX envois de notifications (§4.4) · UDR : XXXX écran notifications de l'équipe (§3.4, §3.5) %>
<%= turbo_stream_toast @toast, type: @toast_type %>
<% if @entry %>
  <%= turbo_stream.replace "push_plan_#{@entry.motive}", partial: "teams/push_plans/motive", locals: { entry: @entry, closed: @closed } %>
<% end %>
<% if @history %>
  <%= turbo_stream.replace "push_history", partial: "teams/push_settings/history", locals: { history: @history } %>
<% end %>
