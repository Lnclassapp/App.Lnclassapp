<%# 🌐 UI · teams/answer_keys/show — le corrigé d'une leçon : chaque exercice dans l'ordre de « Prépare interros », bonnes réponses et corrections %>
<%# Rôle : page pleine en lecture seule pour l'équipe, sans bouton d'édition ; navigation masquée à l'impression, un exercice ne se coupe pas %>
<%# ADR  : 0113 (§4.6), 0115 · UDR : XXXX-fiche-de-revision-en-quatre-blocs §3.5, §3.6 · Stimulus : math %>
<% key = @key %>
<% page_title t(".page_title", name: key.course_name) %>
<% content_for :nav_key, "courses" %>
<div class="mx-auto w-full max-w-180 space-y-6" data-controller="math">
  <div class="print:hidden"><%= ui_back_link key.course_name, href: course_path(key.course_slug) %></div>
  <%= ui_page_header title: t(".title", name: key.course_name) do %>
    <%= content_status_badge(key.status) %>
  <% end %>
  <p class="text-mute">
    <%= t(".summary", count: key.exercises.size, questions: t(".questions", count: key.questions_count)) %>
  </p>

  <% if key.exercises.empty? %>
    <%= ui_empty_state title: t(".empty"), icon: "clipboard-document-check" %>
  <% end %>

  <% lesson_wide_number = 0 %>
  <% key.exercises.each do |exercise| %>
    <% lesson_wide_number += 1 if exercise.essential_name.nil? %>
    <% heading_id = "exercise-title-#{exercise.public_id}" %>
    <section id="exercise-<%= exercise.public_id %>" class="print:break-inside-avoid" aria-labelledby="<%= heading_id %>">
    <%= ui_card padding: :md do %>
      <p class="text-xs uppercase tracking-wide text-mute">
        <%= exercise.essential_name || t(".lesson_wide", group: t("catalog.courses.show.lesson_wide_title"), number: lesson_wide_number) %>
      </p>
      <h2 id="<%= heading_id %>" class="font-display text-lg font-medium"><%= exercise.title %></h2>
      <div class="mt-2 space-y-3 text-ink">
        <% if exercise.statement.present? %>
          <div class="max-w-prose"><%= simple_format(h(exercise.statement)) %></div>
        <% end %>
        <% if exercise.statement_blocks.present? %>
          <div class="space-y-4"><%= render "assessment/statement_blocks/blocks", blocks: exercise.statement_blocks %></div>
        <% end %>
        <% if exercise.figure %>
          <%= render "catalog/figures/figure", figure: exercise.figure, frame: :app %>
        <% end %>
      </div>
      <ol class="mt-4 list-none space-y-5">
        <% exercise.questions.each do |question| %>
          <li>
            <p class="font-medium whitespace-pre-line text-ink">
              <span class="tabular-nums"><%= t(".question_heading", number: question.position, points: number_with_precision(question.points, precision: 1, strip_insignificant_zeros: true)) %></span>
              <span class="block font-normal"><%= question.content %></span>
            </p>
            <% case question.kind_name %>
            <% when "numeric" %>
              <p class="mt-2 flex items-center gap-1.5 text-success">
                <%= ui_icon "check-circle", variant: :mini, size: :sm %>
                <span class="sr-only"><%= t(".right_answer") %></span>
                <span class="text-ink"><%= t(".expected_value") %> : <strong><%= question.answers.first&.content %><%= " #{question.unit}" if question.unit.present? %></strong>
                <% if question.numeric_tolerance&.positive? %>(<%= t(".tolerance", tolerance: question.numeric_tolerance.to_s("F").delete_suffix(".0").tr(".", ",")) %>)<% end %></span>
              </p>
            <% when "written", "notebook" %>
              <% if question.explanation.present? %>
                <div class="mt-2 rounded-card bg-mist p-3">
                  <p class="text-sm font-medium text-ink"><%= t(".model_answer") %></p>
                  <p class="mt-1 whitespace-pre-line text-ink"><%= question.explanation %></p>
                </div>
              <% end %>
            <% else %>
              <ul class="mt-2 space-y-1">
                <% question.answers.each do |answer| %>
                  <li class="flex items-start gap-1.5 <%= answer.correct ? "text-ink" : "text-mute" %>">
                    <% if answer.correct %>
                      <%= ui_icon "check-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0 text-success" %>
                      <span class="sr-only"><%= t(".right_answer") %></span>
                    <% else %>
                      <span class="size-4 shrink-0" aria-hidden="true"></span>
                    <% end %>
                    <span><%= answer.content %><%= " → #{answer.match_content}" if answer.match_content.present? %></span>
                  </li>
                <% end %>
              </ul>
            <% end %>
            <% if question.explanation.present? && %w[written notebook].exclude?(question.kind_name) %>
              <div class="mt-3 rounded-card bg-mist p-3">
                <p class="text-sm font-medium text-ink"><%= t(".correction") %></p>
                <p class="mt-1 whitespace-pre-line text-ink"><%= question.explanation %></p>
              </div>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
    </section>
  <% end %>
</div>
