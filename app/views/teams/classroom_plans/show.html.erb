<%# 🌐 UI · teams/classroom_plans/show — barème des classes générées, écran du référentiel de l'équipe %>
<%# Rôle : garde-fou (classes existantes inchangées), lignes non définies, totaux par établissement, tableau #classroom_plan_lines ; « Modifier » au menu ⋮ %>
<%# ADR  : 0030, 0058 · UDR : 0006, 0042, 0045 %>
<% content_for :title, t(".page_title") %>
<%= ui_page_header title: t(".title"), subtitle: t(".subtitle") %>

<p id="classroom-plan-notice" class="mb-4 flex items-start gap-2 text-sm text-mute">
  <%= ui_icon "information-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0 text-info" %>
  <span><%= t(".notice") %></span>
</p>

<%= render "undefined", sheet: @sheet %>
<%= render "totals", sheet: @sheet %>

<% if @sheet.lines.empty? %>
  <div id="classroom_plan_empty">
    <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "calculator",
                       action: { label: t(".empty_action"), href: levels_path, icon: "squares-2x2" } %>
  </div>
<% else %>
  <%# relative : le libellé sr-only de la colonne des actions reste dans le conteneur défilant, sans élargir la page. %>
  <div class="relative overflow-x-auto rounded-card border border-line bg-white shadow-card">
    <table class="w-full text-left text-sm">
      <thead class="border-b border-line text-xs text-mute">
        <tr>
          <% %i[level series public private].each do |column| %>
            <th scope="col" class="px-4 py-3 font-medium"><%= t(".columns.#{column}") %></th>
          <% end %>
          <th scope="col" class="px-4 py-3"><span class="sr-only"><%= t(".columns.actions") %></span></th>
        </tr>
      </thead>
      <tbody id="classroom_plan_lines" class="divide-y divide-line">
        <%= render partial: "line_row", collection: @sheet.lines, as: :line %>
      </tbody>
    </table>
  </div>
<% end %>
