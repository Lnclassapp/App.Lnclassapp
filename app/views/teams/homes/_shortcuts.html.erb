<%# 🌐 UI · teams/homes/_shortcuts — raccourcis de l'accueil équipe (TR-09) %>
<%# Rôle : « Nouveau cours » et « Inviter un membre » (admin) ouvrent la modale ; les autres, dont « Croissance », mènent à leur écran %>
<%# ADR  : 0038, 0039, 0063 · UDR : 0006, 0018, 0050 %>
<%# locals: (can_invite:) -%>
<nav id="team_home_shortcuts" aria-label="<%= t(".label") %>" class="mb-5 flex flex-wrap gap-3">
  <%= ui_button t(".new_course"), href: new_teams_course_path, icon: "plus", data: { turbo_frame: "modal" } %>
  <%= ui_button t(".schools"), href: schools_path, variant: :secondary, icon: "building-library" %>
  <%= ui_button t(".imports"), href: teams_imports_path, variant: :secondary, icon: "arrow-up-tray" %>
  <%= ui_button t(".growth"), href: teams_growth_path, variant: :secondary, icon: "arrow-trending-up" %>
  <% if can_invite %>
    <%= ui_button t(".invite"), href: new_teams_invitation_path, variant: :secondary, icon: "user-plus", data: { turbo_frame: "modal" } %>
  <% end %>
  <%= ui_button t(".unlock_account"), href: teams_account_lookup_path, variant: :secondary, icon: "lock-open" %>
</nav>
