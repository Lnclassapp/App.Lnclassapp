<%# 🌐 UI · teams/series/_matrix — matrice niveaux × séries, remplacée par les streams des séries %>
<%# Rôle : une case par couple ; cochée, la série est ouverte au niveau et proposée aux classes et aux cours %>
<%# ADR  : 0034, 0036 · UDR : 0006, 0033 %>
<section id="level_series_matrix" aria-labelledby="level_series_matrix_title">
  <div class="mb-4">
    <h2 id="level_series_matrix_title" class="font-display text-xl font-extrabold"><%= t(".title") %></h2>
    <p class="mt-1 text-sm text-mute"><%= t(".subtitle") %></p>
  </div>
  <% if matrix.levels.empty? || matrix.series.empty? %>
    <%= ui_card do %>
      <p class="text-sm text-mute"><%= t(".empty") %></p>
    <% end %>
  <% else %>
    <div class="overflow-x-auto rounded-card border border-line bg-white shadow-card">
      <table class="w-full text-sm">
        <thead class="border-b border-line text-xs text-mute">
          <tr>
            <th scope="col" class="px-4 py-3 text-left font-medium"><%= t(".level") %></th>
            <% matrix.series.each do |series| %>
              <th scope="col" class="px-2 py-3 text-center font-medium text-ink"><%= series.name %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% matrix.levels.each do |level| %>
            <tr>
              <th scope="row" class="px-4 py-2 text-left font-medium whitespace-nowrap"><%= level.name %></th>
              <% matrix.series.each do |series| %>
                <%= render "teams/level_series/cell", cell: matrix.cell(level, series) %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="mt-3 flex items-center gap-2 text-xs text-mute">
      <%= ui_icon "lock-closed", variant: :mini, size: :sm %><%= t(".used_legend") %>
    </p>
  <% end %>
</section>
