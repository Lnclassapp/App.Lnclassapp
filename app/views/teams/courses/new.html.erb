<%# 🌐 UI · teams/courses/new — création d'un cours, servie dans le frame « modal » %>
<%# Rôle : modale large ouverte dès son arrivée ; le cours naît en brouillon ; un échec la re-rend en 422 avec la saisie %>
<%# ADR  : 0035, 0037 · UDR : 0006, 0014, 0054 %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title"), id: "course-modal", size: :lg, open: true, document_title: page_title(t(".title")) do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "course-form" %>
    <% end %>
    <p class="mb-5 flex flex-wrap items-center gap-2 text-sm text-mute">
      <%= content_status_badge("draft") %> <%= t(".draft_notice") %>
    </p>
    <%= render "form", input: @form, options: @options, url: teams_courses_path, method: :post %>
  <% end %>
<% end %>
