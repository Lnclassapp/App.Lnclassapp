<%# 🌐 UI · teams/courses/transition — publication ou archivage d'un cours, rendu par publish et archive %>
<%# Rôle : toast et statut et entrées du menu ⋮ remplacés ; refus (422) : toast d'erreur, statut et menu re-rendus dans son état relu %>
<%# ADR  : 0035 · UDR : 0006, 0014 %>
<% if @refused %>
  <%= turbo_stream_toast t(".refused", name: @course.name), type: :error %>
<% else %>
  <%= turbo_stream_toast t(".#{@course.status}", name: @course.name), type: :success %>
<% end %>
<%= turbo_stream.replace "content_status_course_#{@course.slug}" do %>
  <%= content_status_panel(record: @course) %>
<% end %>
<%= turbo_stream.replace "content_transitions_course_#{@course.slug}", content_transition_items(record: @course) %>
