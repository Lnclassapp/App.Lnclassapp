<%# 🌐 UI · teams/courses/edit — modification d'un cours, servie dans le frame « modal » %>
<%# Rôle : le contenu enregistré est rechargé dans l'éditeur ; le statut s'affiche mais ne se change pas ici ; notions et exercices se réimportent (lien) ; échec en 422 %>
<%# ADR  : 0029, 0035, 0037 · UDR : 0006, 0014, 0054 %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title"), id: "course-modal", size: :lg, open: true, document_title: page_title(t(".title")) do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "course-form" %>
    <% end %>
    <p class="mb-5 flex flex-wrap items-center gap-2 text-sm text-mute">
      <%= content_status_badge(@course.status) %> <%= t(".status_notice") %>
    </p>
    <%# edition-lecon-equipe : ce formulaire ne porte que la leçon ; ce que la page montre sous elle se réimporte (ADR-0113 §4.6). %>
    <p id="course-import-notice" class="mb-5 text-sm text-mute">
      <%= t(".import_notice") %>
      <%= link_to t(".import_link"), new_teams_import_path(kind: "course_tree"), class: "font-medium text-brand underline", data: { turbo_frame: "modal" } %>
    </p>
    <%= render "form", input: @form, options: @options, url: teams_course_path(@course.slug), method: :patch %>
  <% end %>
<% end %>
