<%# 🌐 UI · teams/billing/relay_points/edit — modification d'un point relais, servie dans le frame « modal » %>
<%# Rôle : modale ouverte avec le formulaire rempli ; pas de suppression, on désactive le point relais %>
<%# ADR  : cartes-activation (contexte billing, §4.1) · UDR : caisse-equipe §3.2 · modèle : teams/drenas/edit %>
<% page_title t(".title") %>
<% content_for :nav_key, "billing" %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title"), document_title: page_title(t(".title")), id: "relay-point-modal", open: true do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "relay-point-form", data: { turbo_submits_with: t(".submitting") } %>
    <% end %>
    <%= render "form", form: @form, url: teams_billing_relay_point_path(@relay_point.public_id), method: :patch, school_choices: @school_choices %>
  <% end %>
<% end %>
