<%# 🌐 UI · teams/deletion_requests/index — « Demandes de suppression » : les demandes en attente, la plus proche échéance d'abord %>
<%# Rôle : une ligne par compte (lien étiré vers sa fiche), reçue le …, « À traiter avant le … » ; 3 lignes puis « Voir plus » %>
<%# ADR  : 0036 (amendement 2), 0038 · UDR : 0006, 0054, 0057 (R3), 0062 %>
<% page_title t(".page_title") %>
<%= ui_page_header title: t(".title"), back: { label: t(".back"), href: team_home_path } %>

<% if @requests.empty? %>
  <%= ui_empty_state title: t(".empty_title"), description: t(".empty_description"), icon: "inbox" %>
<% else %>
  <% today = Time.zone.today %>
  <%= tag.section id: "deletion_requests", "aria-label": t(".title"), data: ui_reveal_data do %>
    <ul class="divide-y divide-line overflow-hidden rounded-card border border-line bg-white shadow-card">
      <% @requests.each_with_index do |row, index| %>
        <%= tag.li id: "deletion_request_#{row.public_id}", class: "relative flex items-center gap-3 px-4 py-4 active:bg-mist sm:px-5",
                   **ui_reveal_item(index) do %>
          <div class="min-w-0 flex-1">
            <%= link_to row.display_name, teams_account_lookup_path(contact: row.contact),
                        class: "block truncate font-medium text-ink after:absolute after:inset-0 focus-visible:outline-2 focus-visible:outline-brand" %>
            <p class="mt-0.5 text-sm text-mute"><%= t(".received", date: l(row.requested_on, format: :due_short)) %></p>
            <div class="mt-1.5"><%= render "due", due_on: row.due_on, stage: row.stage(today) %></div>
          </div>
          <%= ui_icon "chevron-right", variant: :mini, class: "text-mute" %>
        <% end %>
      <% end %>
    </ul>
    <div class="mt-3"><%= ui_reveal_more @requests.size %></div>
  <% end %>
<% end %>
