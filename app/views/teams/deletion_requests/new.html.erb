<%# 🌐 UI · teams/deletion_requests/new — « Enregistrer une demande de suppression » d'un élève, servie dans le frame « modal » %>
<%# Rôle : la date de réception de la demande, jamais future ; 422 dans la modale (date absente, future, demande déjà en attente) %>
<%# ADR  : 0036 (amendement 2) · UDR : 0006, 0020, 0054 · succès : teams/deletion_requests/create.turbo_stream %>
<% tab_title = page_title(t(".title", name: @account.display_name)) %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title", name: @account.display_name), id: "deletion-request-modal", size: :sm, open: true,
               document_title: tab_title do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "deletion-request-form", icon: "inbox-arrow-down" %>
    <% end %>
    <%= form_with model: @form, scope: :deletion_request, url: teams_deletion_request_path(@account.public_id),
                  id: "deletion-request-form", class: "space-y-5" do |form| %>
      <% if @form.errors[:base].any? %>
        <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
          <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
          <p><%= @form.errors[:base].to_sentence %></p>
        </div>
      <% end %>
      <%= ui_field form, :requested_on, as: :date, label: t(".requested_on"), required: true, max: Date.current.iso8601 %>
    <% end %>
  <% end %>
<% end %>
