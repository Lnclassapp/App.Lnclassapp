<%# 🌐 UI · teams/materials/edit — modification d'une matière, servie dans le frame « modal » %>
<%# Rôle : nom, abrégé et catégorie modifiables, le slug jamais ; échec re-rendu en 422 avec les erreurs et la saisie %>
<%# ADR  : 0029, 0034 · UDR : 0006, 0034 %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title"), id: "material-modal", open: true do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "material-form", icon: "check" %>
    <% end %>
    <%= render "form", url: material_path(params[:slug]), method: :patch %>
  <% end %>
<% end %>
