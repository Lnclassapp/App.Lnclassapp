<%# 🌐 UI · teams/materials/_material_row — une matière du tableau %>
<%# Rôle : badge teinté par la catégorie (jamais par le nom), usages ; menu ⋮ : « Modifier » en modale, suppression confirmée dans la page %>
<%# ADR  : 0034, 0036 · UDR : 0006, 0034, 0042 %>
<tr id="material_<%= material.slug %>" class="align-middle">
  <td class="px-4 py-3"><%= ui_subject_badge material.name, category: material.category %></td>
  <td class="px-4 py-3 whitespace-nowrap"><%= material.shortname %></td>
  <td class="px-4 py-3 whitespace-nowrap text-mute"><%= t("materials.categories.#{material.category}") %></td>
  <td class="px-4 py-3 tabular-nums"><%= material.courses_count %></td>
  <td class="px-4 py-3 tabular-nums"><%= material.teachers_count %></td>
  <td class="sticky-actions px-4 py-3">
    <div class="flex justify-end">
      <%= ui_dropdown label: t(".actions", name: material.name), id: "material-actions-#{material.slug}", fixed: true do %>
        <%= ui_dropdown_item t(".edit"), href: edit_material_path(material.slug), icon: "pencil-square", frame: "modal" %>
        <%= ui_dropdown_item t(".delete"), dialog: "delete-material-#{material.slug}", icon: "trash", tone: :danger %>
      <% end %>
    </div>
    <%= ui_modal title: t(".delete_title", name: material.name), id: "delete-material-#{material.slug}", size: :sm do |modal| %>
      <% modal.footer do %>
        <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
        <%= ui_button t(".confirm"), type: :submit, variant: :danger, form: "delete-material-form-#{material.slug}" %>
      <% end %>
      <%= form_with url: material_path(material.slug), method: :delete, id: "delete-material-form-#{material.slug}" do %>
        <p class="text-sm text-mute"><%= t(".delete_warning") %></p>
      <% end %>
    <% end %>
  </td>
</tr>
