<%# 🌐 UI · teams/dashboards/_filters — période (trois liens) et DRENA (liste déroulante validée), en GET %>
<%# Rôle : l'URL porte period et drena : elle se partage et survit au retour arrière ; aucun envoi automatique %>
<%# ADR  : 0062 · UDR : 0049 %>
<%# locals: (period:, drena:, drenas:) -%>
<% select_class = class_names(ComponentsHelper::FIELD_INPUT, ComponentsHelper::FIELD_SHAPES[:select], ComponentsHelper::FIELD_STATES[:valid]) %>
<div id="team_dashboard_filters" class="grid gap-4 rounded-card border border-line bg-white p-4 shadow-card lg:grid-cols-2 lg:items-end">
  <nav aria-label="<%= t(".period_label") %>">
    <p class="mb-1.5 text-sm font-medium text-ink" aria-hidden="true"><%= t(".period_label") %></p>
    <ul class="flex flex-wrap gap-2">
      <% Entities::School::ReportingPeriod::KEYS.each do |key| %>
        <li>
          <%= link_to t("teams.dashboards.periods.#{key}"), team_dashboard_path(period: key, drena: drena&.public_id),
                      "aria-current": (key == period.key ? "true" : nil),
                      class: class_names("inline-flex min-h-tap items-center rounded-full px-4 text-sm font-medium transition focus-visible:outline-2 focus-visible:outline-brand",
                                         key == period.key ? "bg-ink text-white" : "bg-mist text-ink hover:bg-line") %>
        </li>
      <% end %>
    </ul>
  </nav>
  <%= form_with url: team_dashboard_path, method: :get, id: "team-dashboard-drena", role: "search", "aria-label": t(".drena_form_label"),
                class: "flex flex-wrap items-end gap-3" do %>
    <%= hidden_field_tag :period, period.key, id: nil %>
    <div class="min-w-0 flex-1 basis-60 space-y-1.5">
      <%= label_tag "dashboard_drena", t(".drena_label"), class: "block text-sm font-medium text-ink" %>
      <div class="relative">
        <%= select_tag :drena, options_for_select([ [ t(".all_drenas"), "" ], *drenas.map { [ it.name, it.public_id ] } ], drena&.public_id),
                       id: "dashboard_drena", class: select_class %>
        <%= ui_icon "chevron-down", variant: :mini, class: "pointer-events-none absolute top-1/2 right-3 -translate-y-1/2 text-mute" %>
      </div>
    </div>
    <%= ui_button t(".submit"), type: :submit, icon: "funnel" %>
    <% if drena %>
      <%= ui_button t(".clear"), href: team_dashboard_path(period: period.key), variant: :ghost, icon: "x-mark" %>
    <% end %>
  <% end %>
</div>
