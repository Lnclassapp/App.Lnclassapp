<%# 🌐 UI · teams/level_series/create — couple coché, ou refusé (déjà lié, 422) %>
<%# Rôle : la case est remplacée par son état en base, avec un toast %>
<%# ADR  : 0034 · UDR : 0006, 0033 %>
<% if @refused %>
  <%= turbo_stream_toast t(".refused", level: @cell.level_name, series: @cell.series_name), type: :error %>
<% else %>
  <%= turbo_stream_toast t(".done", level: @cell.level_name, series: @cell.series_name), type: :success %>
<% end %>
<%= turbo_stream.replace "level_series_#{@cell.level_slug}_#{@cell.series_slug}", partial: "cell", locals: { cell: @cell } %>
