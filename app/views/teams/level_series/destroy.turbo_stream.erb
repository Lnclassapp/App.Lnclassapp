<%# 🌐 UI · teams/level_series/destroy — couple décoché, ou refusé parce qu'une classe ou un cours l'utilise (422) %>
<%# Rôle : la case est remplacée par son état en base ; le refus dit sa raison dans un toast d'erreur %>
<%# ADR  : 0034, 0036 · UDR : 0006, 0033 %>
<%= turbo_stream_toast @message, type: @refused ? :error : :success %>
<%= turbo_stream.replace "level_series_#{@cell.level_slug}_#{@cell.series_slug}", partial: "cell", locals: { cell: @cell } %>
