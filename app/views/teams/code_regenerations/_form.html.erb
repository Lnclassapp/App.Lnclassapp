<%# 🌐 UI · teams/code_regenerations/_form — modale d'une régénération de masse, dans le frame « modal » ; re-rendue en 422 %>
<%# Rôle : nombre et portée, année des classes, conséquences, nombre à taper hors d'une DRENA ou d'un établissement %>
<%# ADR  : 0096 · UDR : 0104 · Stimulus : modal, autofocus · aucun code ni jeton : la sélection voyage en champs cachés %>
<% target = @form.target %>
<% selection = @form.selection %>
<% scope = @preview.scope %>
<% count = number_with_delimiter(@preview.count) %>
<% empty = @preview.count.zero? %>
<% year = Entities::Classroom::SchoolYear.current(Date.current) %>
<% question = if scope.school_name then t(".question.#{target}.school_html", count:, school: scope.school_name)
              elsif scope.drena_name then t(".question.#{target}.drena_html", count:, drena: scope.drena_name)
              else t(".question.#{target}.all_html", count:)
              end %>
<% filters = selection.school ? [] : code_regeneration_filter_labels(selection) %>
<% recount = ->(all_years) { new_code_regeneration_path(target:, **selection.to_h.symbolize_keys, all_years: ("1" if all_years)) } %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title.#{target}"), id: "code-regeneration-modal", size: :sm, open: true,
               document_title: page_title(t("teams.code_regenerations.new.page_title.#{target}")) do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <% unless empty %>
        <%= ui_button t(".confirm.#{target}"), type: :submit, form: "code-regeneration-form", icon: "arrow-path", variant: :danger %>
      <% end %>
    <% end %>
    <%= form_with model: @form, scope: :code_regeneration, url: code_regenerations_path, id: "code-regeneration-form",
                  class: "space-y-3 text-sm", data: { turbo_frame: "_top" } do |form| %>
      <%= form.hidden_field :target %>
      <%= form.hidden_field :current_year_only, value: @form.current_year_only ? "1" : "0" %>
      <% selection.to_h.each do |key, value| %>
        <%= hidden_field_tag "code_regeneration[selection][#{key}]", value, id: nil %>
      <% end %>
      <% if empty %>
        <div id="code_regeneration_empty" role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 font-medium text-error">
          <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
          <p><%= t(".empty.#{target}") %></p>
        </div>
      <% else %>
        <p id="code_regeneration_question" class="text-ink"><%= question %></p>
      <% end %>
      <% if filters.any? %>
        <p id="code_regeneration_filters" class="text-mute"><%= t(".filters", filters: filters.join(" · ")) %></p>
      <% end %>
      <% if target == Entities::Catalog::ImportKind::CLASSROOM_LINK_REGENERATION %>
        <p id="code_regeneration_year" class="text-mute">
          <% if @form.current_year_only %>
            <%= t(".current_year", year:) %>
            <%= link_to t(".include_past_years"), recount.call(true), data: { turbo_frame: "modal" },
                        class: "inline-flex min-h-tap items-center font-medium text-brand-strong underline-offset-4 hover:underline" %>
          <% else %>
            <%= t(".all_years") %>
            <%= link_to t(".current_year_only", year:), recount.call(false), data: { turbo_frame: "modal" },
                        class: "inline-flex min-h-tap items-center font-medium text-brand-strong underline-offset-4 hover:underline" %>
          <% end %>
        </p>
      <% end %>
      <ul id="code_regeneration_rules" class="list-disc space-y-1 pl-5 text-mute">
        <% t(".rules.#{target}").each do |rule| %>
          <li><%= rule %></li>
        <% end %>
      </ul>
      <% unless empty || selection.scoped? %>
        <%= ui_field form, :typed_count, label: t(".typed_count_label", count:), required: true, inputmode: "numeric",
                                         autocomplete: "off", value: nil, autofocus: true %>
      <% end %>
      <p class="text-xs text-mute"><%= t(".background") %></p>
    <% end %>
  <% end %>
<% end %>
