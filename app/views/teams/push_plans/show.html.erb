<%# 🌐 UI · teams/push_plans/show — carte « Plan du jour » rendue dans le frame « push_plan » de la page Notifications %>
<%# Rôle : un bloc par motif à valider (nombre, texte, établissements, « Valider l'envoi »), aucun nom d'élève ; état vide dans la carte %>
<%# ADR  : XXXX envois de notifications (§4.4) · UDR : XXXX écran notifications de l'équipe (§3.4, §3.7, §3.8) %>
<%= turbo_frame_tag "push_plan" do %>
  <%= ui_card title: t(".title"), subtitle: t(".subtitle", date: l(@now.to_date, format: "%A %-d %B")), icon: "calendar-days", id: "push_plan_card" do %>
    <% if @closed %>
      <p id="push_plan_closed" class="mb-3 text-sm font-medium text-ink"><%= t(".closed") %></p>
    <% end %>
    <% if @entries.all? { it.students.zero? && it.approval.nil? } %>
      <%= ui_empty_state title: t(".empty.title"), description: t(".empty.description"), icon: "check-circle" %>
    <% else %>
      <div class="grid grid-cols-1 gap-3">
        <% @entries.each do |entry| %>
          <%= render "teams/push_plans/motive", entry:, closed: @closed %>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
