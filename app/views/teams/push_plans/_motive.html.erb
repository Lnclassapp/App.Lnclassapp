<%# 🌐 UI · teams/push_plans/_motive — la ligne d'un motif du plan du jour : à valider, validé, ou aucun élève concerné %>
<%# Rôle : id push_plan_<motive> remplacé par le Turbo Stream de la validation ; jamais un nom d'élève, seulement des nombres et des établissements %>
<%# ADR  : XXXX envois de notifications (§4.4) · UDR : XXXX écran notifications de l'équipe (§3.4, §3.8, §3.9) %>
<%# locals: (entry:, closed:) -%>
<% motive_label = t("teams.push_settings.motives.#{entry.motive}") %>
<% if entry.approval.nil? && entry.students.zero? %>
  <p id="push_plan_<%= entry.motive %>" class="px-1 text-sm text-mute"><%= t("teams.push_plans.show.none", motive: motive_label) %></p>
<% else %>
  <section id="push_plan_<%= entry.motive %>" class="rounded-ln bg-mist p-4" aria-label="<%= motive_label %>">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-medium text-ink"><%= motive_label %></h3>
      <span class="font-display text-2xl tabular-nums text-ink"><%= t("teams.push_plans.show.students", count: entry.students) %></span>
    </div>
    <% if entry.text %>
      <p class="mt-2 text-sm text-ink">« <%= entry.text %> »<% if entry.more_texts.positive? %> <span class="text-mute"><%= t("teams.push_plans.show.more_materials", count: entry.more_texts) %></span><% end %></p>
    <% end %>
    <% if entry.schools.any? %>
      <% first, rest = entry.schools.first(5), entry.schools.drop(5) %>
      <ul aria-label="<%= t("teams.push_plans.show.by_school") %>" class="mt-2 text-sm text-ink">
        <% first.each do |school, count| %>
          <li class="tabular-nums"><%= t("teams.push_plans.show.school_line", school:, count:) %></li>
        <% end %>
      </ul>
      <% if rest.any? %>
        <details class="mt-1 text-sm text-ink">
          <summary class="cursor-pointer text-mute"><%= t("teams.push_plans.show.more_schools", count: rest.size) %></summary>
          <ul aria-label="<%= t("teams.push_plans.show.by_school") %>">
            <% rest.each do |school, count| %>
              <li class="tabular-nums"><%= t("teams.push_plans.show.school_line", school:, count:) %></li>
            <% end %>
          </ul>
        </details>
      <% end %>
    <% end %>
    <% if entry.approval %>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <%= ui_badge t("teams.push_plans.show.approved"), tone: :success, icon: "check" %>
        <p class="text-sm text-ink tabular-nums"><%= t("teams.push_plans.show.approved_by", name: entry.approval.by_name, time: l(entry.approval.at, format: :hour_minute), count: entry.approval.count) %></p>
      </div>
    <% elsif !closed %>
      <%= form_with url: teams_push_approvals_path, method: :post, class: "mt-3",
                    data: { turbo_confirm: t("teams.push_approvals.create.confirm", motive: motive_label, count: entry.students) } do %>
        <%= hidden_field_tag :motive, entry.motive, id: nil %>
        <%= ui_button t("teams.push_approvals.create.approve"), type: :submit, variant: :primary, class: "w-full sm:w-auto" %>
      <% end %>
    <% end %>
  </section>
<% end %>
