<%# 🌐 UI · teams/crm/pedagogy_reports/retry — « Réessayer » dans le frame d'une génération : la nouvelle génération remplace l'ancien frame %>
<%# Rôle : fiche prête (synthèse) ou cycle de génération (attente, échec avec « Réessayer » vers cette même route POST) %>
<%# UDR  : 0160 (assistants du suivi) %>
<% if @generation.done? %>
  <%= turbo_stream.replace @frame, partial: "teams/crm/pedagogy_reports/synthesis", locals: { generation: @generation, school_public_id: @school_public_id } %>
<% else %>
  <%= turbo_stream.replace @frame, partial: "teams/crm/generations/generation",
                                   locals: { generation: @generation, retry_href: teams_school_pedagogy_reports_path(@school_public_id) } %>
<% end %>
