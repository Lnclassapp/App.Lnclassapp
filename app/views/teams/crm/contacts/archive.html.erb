<%# 🌐 UI · teams/crm/contacts/archive — confirmation « Retirer <nom> ? », lue à la demande en GET %>
<%# Rôle : servie dans le frame « modal » depuis le menu ⋮ du contact ; le contact est archivé, ses échanges gardent son nom ; sans frame, page complète utilisable %>
<%# UDR  : XXXX (bloc « Suivi » de la fiche établissement) §Contacts · patron de teams/schools/deactivation %>
<% page_title t(".title", name: @contact.full_name) %>
<% form_id = "archive-contact-form-#{@contact.public_id}" %>
<% unless turbo_frame_request? %>
  <%= link_to t(".back"), school_path(@school.public_id), class: "mb-4 inline-flex min-h-tap items-center text-sm font-medium text-brand-strong underline-offset-4 hover:underline" %>
<% end %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal id: "archive-contact-#{@contact.public_id}", size: :sm, open: true, title: t(".title", name: @contact.full_name) do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".confirm"), type: :submit, form: form_id, variant: :danger %>
    <% end %>
    <%= form_with url: teams_school_contact_path(@school.public_id, @contact.public_id), method: :delete, id: form_id do %>
      <p class="text-sm text-mute"><%= t(".warning") %></p>
    <% end %>
  <% end %>
<% end %>
