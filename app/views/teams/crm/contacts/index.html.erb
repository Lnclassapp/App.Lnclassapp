<%# 🌐 UI · teams/crm/contacts/index — sous-bloc « Contacts » de la fiche établissement %>
<%# Rôle : le frame school_crm_contacts (cible des Turbo Streams), contacts par nom avec « Appeler » et WhatsApp ; « Ajouter un contact » en modale ; vide = état vide %>
<%# UDR  : XXXX (bloc « Suivi » de la fiche établissement) %>
<%= turbo_frame_tag "school_crm_contacts" do %>
  <%= ui_card title: t(".title"), heading: :h3 do |card| %>
    <% if @contacts.empty? %>
      <%= ui_empty_state title: t(".empty.title"), description: t(".empty.description"), icon: "user-plus" %>
    <% else %>
      <ul role="list" class="divide-y divide-line">
        <%= render partial: "teams/crm/contacts/contact", collection: @contacts, as: :contact %>
      </ul>
    <% end %>
    <% card.footer do %>
      <%= ui_button t(".new"), href: new_teams_school_contact_path(@school.public_id), variant: :secondary, icon: "plus",
                    data: { turbo_frame: "modal" } %>
    <% end %>
  <% end %>
<% end %>
