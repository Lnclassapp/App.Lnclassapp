<%# 🌐 UI · teams/crm/home_follow_ups/show — carte « À relancer » de l'Accueil équipe %>
<%# Rôle : le frame team_home_follow_ups : le nombre de mes écoles à relancer, les trois premières avec leur première raison, un lien unique %>
<%# UDR  : 0168 (pipeline et relances) · vide : « Rien à relancer aujourd'hui » %>
<%= turbo_frame_tag "team_home_follow_ups" do %>
  <% if @count.zero? %>
    <%= ui_card title: t(".title"), icon: "bell-alert", class: "mb-5" do %>
      <p class="flex items-center gap-2 text-sm text-mute">
        <%= ui_icon "check-circle", variant: :mini, class: "text-success" %><%= t(".empty") %>
      </p>
    <% end %>
  <% else %>
    <%= ui_card title: t(".title"), icon: "bell-alert", href: teams_follow_ups_path, class: "mb-5" do %>
      <p data-count class="font-display text-3xl text-ink"><%= @count %></p>
      <ul class="mt-2 space-y-2">
        <% @rows.each do |row| %>
          <li class="flex flex-wrap items-center gap-2 text-sm text-ink">
            <%= row.school_name %>
            <%= ui_badge t("teams.crm.signals.reasons.#{row.reasons.first}"), tone: { overdue: :error, usage_lost: :warning, demo_stalled: :info, registered_idle: :brand }.fetch(row.reasons.first), size: :sm %>
          </li>
        <% end %>
      </ul>
      <% if @count > @rows.size %><p class="mt-2 text-sm text-mute"><%= t(".more", count: @count - @rows.size) %></p><% end %>
      <p class="mt-3 text-sm font-medium text-ink"><%= t(".see_all") %></p>
    <% end %>
  <% end %>
<% end %>
