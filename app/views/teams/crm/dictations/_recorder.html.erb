<%# 🌐 UI · teams/crm/dictations/_recorder — modale « Dicter un compte rendu » : enregistreur, refus du serveur, ou attente de l'assistant %>
<%# Rôle : le contrôleur voice-recorder porte les états (prêt, enregistrement, enregistré) ; avec `generation`, l'attente (ou la dictée déjà finie) remplace l'enregistreur ; « Saisir à la main » ouvre le formulaire vide %>
<%# UDR  : 0160 (assistants du suivi, « Compte rendu dicté ») · CA-26 : refus en 422, 3 min, 10 Mo, webm/ogg/mp4 %>
<%= ui_modal title: t(".title"), id: "dictation-modal", size: :md, open: true, document_title: page_title(t(".title")) do |modal| %>
  <div class="ui-dictation space-y-4">
    <% if generation&.done? %>
      <%= render "teams/crm/dictations/ready", generation:, school_public_id: %>
    <% elsif generation %>
      <%= render "teams/crm/generations/generation", generation:, retry_href: teams_school_dictation_path(school_public_id), retry_method: :post %>
    <% else %>
      <%= form_with url: teams_school_dictation_path(school_public_id), method: :post, multipart: true, id: "dictation-form", class: "space-y-4",
                    data: { controller: "voice-recorder", voice_recorder_max_seconds_value: 180,
                            voice_recorder_max_bytes_value: UseCases::Crm::SubmitDictation::MAX_BYTES,
                            voice_recorder_denied_message_value: t(".denied"), voice_recorder_too_big_message_value: t(".errors.too_large"),
                            voice_recorder_unsupported_message_value: t(".errors.unsupported_type") } do %>
        <p id="dictation-error" role="alert" data-voice-recorder-target="error" <%= "hidden" unless error %>
           class="rounded-ln bg-error-soft px-4 py-3 text-sm text-error"><%= t(".errors.#{error}") if error %></p>

        <div data-voice-recorder-target="idle" class="space-y-3">
          <p class="text-sm text-mute"><%= t(".hint") %></p>
          <%= ui_button t(".start"), variant: :primary, icon: "microphone", full: true, data: { voice_recorder_target: "start", action: "voice-recorder#start" } %>
        </div>

        <div data-voice-recorder-target="live" hidden class="flex flex-col items-center gap-4 py-2">
          <div class="flex items-center gap-3">
            <span class="size-3 rounded-full bg-error motion-safe:animate-pulse" aria-hidden="true"></span>
            <span role="timer" aria-live="off" data-voice-recorder-target="timer" class="font-display text-2xl">00:00</span>
            <span class="text-sm text-mute"><%= t(".max", max: "3:00") %></span>
          </div>
          <%= ui_button t(".stop"), variant: :danger, icon: "stop", full: true, data: { voice_recorder_target: "stop", action: "voice-recorder#stop" } %>
        </div>

        <div data-voice-recorder-target="done" hidden class="space-y-3">
          <audio controls data-voice-recorder-target="preview" class="w-full"></audio>
          <div class="flex flex-col gap-3 sm:flex-row-reverse">
            <%= ui_button t(".send"), type: :submit, variant: :primary, full: true, data: { voice_recorder_target: "send", turbo_submits_with: t(".sending") } %>
            <%= ui_button t(".retry"), variant: :ghost, full: true, data: { voice_recorder_target: "retry", action: "voice-recorder#retry" } %>
          </div>
        </div>

        <div data-voice-recorder-target="fallback" hidden class="space-y-2">
          <label for="dictation-audio" class="block text-sm font-medium"><%= t(".fallback") %></label>
          <input type="file" name="audio" id="dictation-audio" accept="audio/*" capture data-voice-recorder-target="input" data-action="change->voice-recorder#picked"
                 aria-describedby="dictation-error" class="block w-full text-sm">
        </div>
      <% end %>
    <% end %>

    <%# Rien d'enregistré par l'assistant : « Noter un échange » reste utilisable sans dictée (masqué quand le formulaire pré-rempli est là). %>
    <div data-hide-if-prefilled>
      <%= ui_button t(".manual"), href: new_teams_school_interaction_path(school_public_id), variant: :ghost, size: :sm, icon: "pencil-square",
                    data: { turbo_frame: "modal" } %>
    </div>
  </div>
<% end %>
