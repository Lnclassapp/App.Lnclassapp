<%# 🌐 UI · teams/crm/stages/_stage — étape affichée, motif de perte, responsable, et les deux modales de saisie %>
<%# Rôle : badge (libellé toujours écrit), indice « calculée » pour Inscrite et Active, « Changer l'étape » et « Changer le responsable » %>
<%# UDR  : XXXX (bloc « Suivi » de la fiche établissement) %>
<% stage = panel.stage.to_s %>
<%= ui_card title: t(".title"), heading: :h3 do |card| %>
  <div class="flex flex-wrap items-center gap-2">
    <%= ui_badge t("teams.crm.common.stages.#{stage}"), tone: t("teams.crm.common.stage_tones.#{stage}").to_sym, size: :md %>
    <% if Entities::Crm::Stage.computed?(panel.stage) %>
      <%= ui_info_tip t(".computed_tip"), label: t(".computed_label") %>
    <% end %>
  </div>
  <% if panel.stage == :lost && panel.account.lost_reason %>
    <p class="mt-1 text-sm text-mute"><%= t(".lost_reason", reason: t("teams.crm.common.lost_reasons.#{panel.account.lost_reason}")) %></p>
  <% end %>
  <p class="mt-4 text-sm">
    <span class="text-mute"><%= t(".owner") %></span>
    <% if panel.owner %>
      <span class="font-medium"><%= panel.owner.name %></span>
    <% else %>
      <span class="text-mute"><%= t(".no_owner") %></span>
    <% end %>
    <% if panel.owner_unavailable? %>
      <%= ui_badge t(".owner_unavailable"), tone: :warning, size: :sm %>
    <% end %>
  </p>
  <% card.footer do %>
    <div class="flex flex-wrap gap-3">
      <%= ui_modal title: t(".change_stage"), id: "crm-stage-modal", size: :sm, trigger: t(".change_stage"), trigger_variant: :secondary,
                   open: open == :stage do |modal| %>
        <% modal.footer do %>
          <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
          <%= ui_button t(".submit"), type: :submit, form: "crm-stage-form", icon: "check" %>
        <% end %>
        <%= render "teams/crm/stages/form", stage_form: %>
      <% end %>
      <%= ui_modal title: t(".change_owner"), id: "crm-owner-modal", size: :sm, trigger: t(".change_owner"), trigger_variant: :secondary,
                   open: open == :owner do |modal| %>
        <% modal.footer do %>
          <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
          <%= ui_button t(".submit"), type: :submit, form: "crm-owner-form", icon: "check" %>
        <% end %>
        <%= render "teams/crm/owners/form", owner_form:, panel: %>
      <% end %>
    </div>
  <% end %>
<% end %>
