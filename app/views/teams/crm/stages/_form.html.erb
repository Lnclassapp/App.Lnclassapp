<%# 🌐 UI · teams/crm/stages/_form — saisir l'étape : Prospect, Démo faite, Abonnée, Perdue (jamais Inscrite ni Active) et le motif %>
<%# Rôle : formulaire de la modale « Changer l'étape » ; erreurs sous les champs, saisie conservée %>
<%# UDR  : XXXX (bloc « Suivi » de la fiche établissement) %>
<%= form_with model: stage_form, scope: :stage, url: teams_school_stage_path(@school.public_id), method: :patch, id: "crm-stage-form", class: "space-y-5" do |form| %>
  <%= ui_radio_group form, :stage, label: t(".stage"), columns: 1,
                     choices: Entities::Crm::Stage::TYPEABLE.map { [ t("teams.crm.common.stages.#{it}"), it ] } %>
  <%= ui_field form, :lost_reason, as: :select, label: t(".lost_reason"), hint: t(".lost_reason_hint"), prompt: t(".prompt"),
               choices: Entities::Crm::Account::LOST_REASONS.map { [ t("teams.crm.common.lost_reasons.#{it}"), it ] } %>
<% end %>
