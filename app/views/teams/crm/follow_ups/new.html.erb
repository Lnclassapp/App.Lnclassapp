<%# 🌐 UI · teams/crm/follow_ups/new — « Nouvelle relance », servie dans le frame « modal » %>
<%# Rôle : hors frame, la même modale s'ouvre sur le shell ; échec re-rendu en 422 avec les erreurs et la saisie %>
<%# UDR  : 0162 (bloc « Suivi » de la fiche établissement) %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title"), id: "follow-up-modal", size: :md, open: true, document_title: page_title(t(".title")) do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "follow-up-form", icon: "check" %>
    <% end %>
    <%= render "teams/crm/follow_ups/form", url: teams_school_follow_ups_path(@school.public_id) %>
  <% end %>
<% end %>
