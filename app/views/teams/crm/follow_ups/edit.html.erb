<%# 🌐 UI · teams/crm/follow_ups/edit — « Réattribuer », servie dans le frame « modal » par FollowUpAssigneesController#edit %>
<%# Rôle : hors frame, la même modale s'ouvre sur le shell ; échec re-rendu en 422 avec l'erreur %>
<%# UDR  : 0168 (pipeline et relances) %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title"), id: "follow-up-assignee-modal", size: :sm, open: true, document_title: page_title(t(".title")) do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "follow-up-assignee-form", icon: "check" %>
    <% end %>
    <%= render "teams/crm/follow_ups/assignee_form", url: teams_follow_up_assignee_path(@follow_up.public_id) %>
  <% end %>
<% end %>
