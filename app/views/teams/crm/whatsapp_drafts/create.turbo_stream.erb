<%# 🌐 UI · teams/crm/whatsapp_drafts/create — remplit le frame whatsapp_draft de la modale « Message de relance » %>
<%# Rôle : brouillon prêt (partial _draft), cycle de génération (attente, échec avec « Réessayer » vers cette même route POST) ou refus d'un second brouillon en cours %>
<%# UDR  : XXXX (assistants du suivi) %>
<% if @unavailable %>
  <%= turbo_stream.update "whatsapp_draft" do %>
    <p class="text-sm text-error" role="alert"><%= t(".unavailable") %></p>
  <% end %>
<% elsif @generation.nil? %>
  <%= turbo_stream.update "whatsapp_draft" do %>
    <p class="text-sm text-mute" role="status"><%= t(".busy") %></p>
  <% end %>
<% elsif @generation.done? %>
  <%= turbo_stream.update "whatsapp_draft", partial: "teams/crm/whatsapp_drafts/draft", locals: { generation: @generation, school_public_id: nil } %>
<% else %>
  <%= turbo_stream.update "whatsapp_draft", partial: "teams/crm/generations/generation",
                                           locals: { generation: @generation, retry_href: teams_follow_up_whatsapp_draft_path(@follow_up.public_id) } %>
<% end %>
