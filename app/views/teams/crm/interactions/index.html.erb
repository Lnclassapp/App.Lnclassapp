<%# 🌐 UI · teams/crm/interactions/index — sous-bloc « Journal » de la fiche (frame school_crm_journal) et ses pages plus anciennes %>
<%# Rôle : 20 échanges par page, du plus récent au plus ancien ; la suite se charge au clic, dans son propre frame ; aucune modification ni suppression (CA-12) %>
<%# ADR  : 0128 (contexte crm) · UDR : 0162 (bloc « Suivi » de la fiche établissement) %>
<% older = capture do %>
  <% if @has_older %>
    <%= turbo_frame_tag "school_crm_journal_page_#{@page + 1}" do %>
      <%= link_to t(".older"), teams_school_interactions_path(@school.public_id, page: @page + 1),
                  class: "inline-flex min-h-12 items-center text-sm font-medium text-brand hover:underline" %>
    <% end %>
  <% end %>
<% end %>
<% list = capture do %>
  <ol role="list" class="divide-y divide-line">
    <%= render partial: "teams/crm/interactions/interaction", collection: @interactions, as: :interaction %>
  </ol>
  <%= older %>
<% end %>
<% if @page > 1 %>
  <%= turbo_frame_tag "school_crm_journal_page_#{@page}" do %><%= list %><% end %>
<% else %>
  <%= turbo_frame_tag "school_crm_journal" do %>
    <%= ui_card title: t(".title"), heading: :h3 do %>
      <div class="mb-4">
        <%= ui_button t(".new"), href: new_teams_school_interaction_path(@school.public_id), variant: :primary,
                                 icon: "pencil-square", data: { turbo_frame: "modal" } %>
      </div>
      <% if @interactions.empty? %>
        <%= ui_empty_state title: t(".empty.title"), description: t(".empty.description"), icon: "chat-bubble-left-right" %>
      <% else %>
        <%= list %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
