<%# 🌐 UI · teams/account_deletions/new — « Supprimer le compte » d'un élève, servie dans le frame « modal » %>
<%# Rôle : ce qui est effacé et ce qui reste, la date de la demande reçue par le support ; 422 dans la modale %>
<%# ADR  : 0036 (§4) · UDR : 0006, 0020, 0054 · succès : teams/account_deletions/create.turbo_stream %>
<% tab_title = page_title(t(".title", name: @account.display_name)) %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal title: t(".title", name: @account.display_name), id: "account-deletion-modal", size: :sm, open: true,
               document_title: tab_title do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".submit"), type: :submit, form: "account-deletion-form", variant: :danger, icon: "trash" %>
    <% end %>
    <div class="mb-5 space-y-2 text-sm text-mute">
      <p><%= t(".erased") %></p>
      <p><%= t(".kept") %></p>
    </div>
    <%= form_with model: @form, scope: :account_deletion, url: teams_account_deletion_path(@account.public_id),
                  id: "account-deletion-form", class: "space-y-5" do |form| %>
      <% if @form.errors[:base].any? %>
        <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
          <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
          <p><%= @form.errors[:base].to_sentence %></p>
        </div>
      <% end %>
      <%= ui_field form, :requested_on, as: :date, required: true, max: Date.current.iso8601, hint: t(".requested_on_hint") %>
    <% end %>
  <% end %>
<% end %>
