<%# 🌐 UI · teams/push_settings/_mode — une ligne de « Réglages » : libellé, exemple, case « Automatique » ou badge %>
<%# Rôle : la case est un formulaire autonome envoyé au changement (push-switch) ; désactivée hors admin ; remplacée en Turbo Stream %>
<%# ADR  : XXXX envois de notifications · UDR : XXXX écran notifications de l'équipe (§3.3, §3.9) %>
<%# locals: (mode:, can_manage:) -%>
<% motive = mode.motive %>
<% label = t("teams.push_settings.motives.#{motive}") %>
<li id="push_motive_<%= motive %>" class="flex items-center justify-between gap-4 py-3">
  <div class="min-w-0">
    <p class="font-medium text-ink"><%= label %></p>
    <p class="text-sm text-mute"><%= mode.example %></p>
    <% if Entities::Communication::PushMotive.automatable?(motive) %>
      <p id="push_motive_<%= motive %>_state" class="text-xs text-mute">
        <%= mode.automatic ? t("teams.push_settings.modes.state_on", date: l(mode.at, format: "%-d %b"), name: mode.by_name) : t("teams.push_settings.modes.state_off") %>
        <%= t("teams.push_settings.modes.admin_only") unless can_manage %>
      </p>
    <% end %>
  </div>
  <% if Entities::Communication::PushMotive.automatable?(motive) %>
    <%= form_with url: teams_push_motive_setting_path(motive), method: :patch, class: "shrink-0",
                  data: { controller: "push-switch", action: "turbo:submit-end->push-switch#done" } do %>
      <%= hidden_field_tag :automatic, "0", id: nil %>
      <label class="relative inline-flex min-h-tap min-w-tap cursor-pointer items-center justify-end">
        <span class="sr-only"><%= t("teams.push_settings.modes.automatic_label", motive: label) %></span>
        <%= check_box_tag :automatic, "1", mode.automatic, id: "push_motive_#{motive}_switch", role: "switch", disabled: !can_manage,
                          class: "peer sr-only", "aria-checked": mode.automatic.to_s, "aria-disabled": (!can_manage).to_s,
                          "aria-describedby": "push_motive_#{motive}_state", data: { action: "change->push-switch#submit" } %>
        <span aria-hidden="true" class="relative block h-7 w-12 rounded-full bg-line-strong transition-colors peer-checked:bg-brand peer-disabled:cursor-not-allowed peer-disabled:opacity-60 peer-focus-visible:ring-2 peer-focus-visible:ring-brand peer-focus-visible:ring-offset-2 after:absolute after:top-0.5 after:left-0.5 after:size-6 after:rounded-full after:bg-white after:transition-transform peer-checked:after:translate-x-5"></span>
      </label>
      <% if can_manage %>
        <noscript><%= ui_button t("teams.push_settings.modes.save"), type: :submit, variant: :secondary, size: :sm %></noscript>
      <% end %>
    <% end %>
  <% elsif motive == "announcement" %>
    <%= ui_badge t("teams.push_settings.modes.badges.announcement"), tone: :neutral %>
  <% else %>
    <%= ui_badge t("teams.push_settings.modes.badges.validate_daily"), tone: :neutral %>
  <% end %>
</li>
