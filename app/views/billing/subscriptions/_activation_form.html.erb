<%# 🌐 UI · billing/subscriptions/_activation_form — « J'ai ma carte » : saisie du code de 12 caractères %>
<%# Rôle : champ 48 px relié à son aide et à son erreur (role=alert, aria-invalid), la saisie reste en échec ; bouton plein largeur %>
<%# ADR  : 0126 (contexte billing, §4.2 et §4.4) · UDR : 0158 §3.5 %>
<%= ui_card title: t(".title") do %>
  <%= form_with url: billing_activation_path, id: "activation-form", class: "space-y-4" do |f| %>
    <div class="space-y-1.5">
      <%= f.label :code, t(".label"), class: "block text-sm font-medium text-ink" %>
      <%= f.text_field :code, value: code, placeholder: "XXXX-XXXX-XXXX", autocomplete: "off", autocapitalize: "characters",
                       spellcheck: false, inputmode: "text", maxlength: 20, required: true, data: { autofocus_target: ("field" if error) },
                       "aria-invalid": ("true" if error), "aria-describedby": ["activation-code-hint", ("activation-code-error" if error)].compact.join(" "),
                       class: class_names("min-h-tap w-full rounded-ln border bg-white px-4 font-mono text-lg tracking-widest text-ink uppercase placeholder:normal-case",
                                          error ? "border-error" : "border-line-strong") %>
      <p id="activation-code-hint" class="text-sm text-mute"><%= t(".hint") %></p>
      <% if error %>
        <p id="activation-code-error" role="alert" class="flex items-center gap-1.5 text-sm font-medium text-error">
          <%= ui_icon "exclamation-circle", variant: :mini, size: :sm %><%= error %>
        </p>
      <% end %>
    </div>
    <%= ui_button t(".submit"), type: :submit, full: true, class: "sm:w-auto", data: { turbo_submits_with: t(".submitting") } %>
  <% end %>
<% end %>
