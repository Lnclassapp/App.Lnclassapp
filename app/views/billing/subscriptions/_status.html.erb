<%# 🌐 UI · billing/subscriptions/_status — carte d'état de l'accès : gratuit, bloqué ou abonné %>
<%# Rôle : titre en h2, texte et icône décorative selon Entities::Billing::Access ; les montants et dates viennent de l'offre %>
<%# ADR  : cartes-activation (contexte billing, §4.5 et §4.8) · UDR : abonnement-eleve §3.3 %>
<% offer_text = { price: t("billing.price"), date: subscription_date(Entities::Billing::Offer::VALID_UNTIL) } %>
<% icon, tone, title, text = case access.status
   when :free then [ "gift", "bg-info-soft text-info", t(".free.title", count: access.days_left), t(".free.text", **offer_text) ]
   when :blocked then [ "lock-closed", "bg-warning-soft text-warning", t(".blocked.title"), t(".blocked.text", **offer_text) ]
   else [ "check-badge", "bg-success-soft text-success", t(".subscribed.title"), t(".subscribed.text", date: subscription_date(access.subscribed_until || Entities::Billing::Offer::VALID_UNTIL)) ]
   end %>
<%= ui_card do %>
  <div class="flex items-start gap-4">
    <span class="<%= class_names("grid size-12 shrink-0 place-items-center rounded-full", tone) %>"><%= ui_icon icon, size: :lg %></span>
    <div class="min-w-0">
      <h2 class="font-display text-xl leading-tight font-medium text-ink"><%= title %></h2>
      <p class="mt-1 text-mute"><%= text %></p>
    </div>
  </div>
<% end %>
