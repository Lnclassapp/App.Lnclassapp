<%# 🌐 UI · school/teacher_schools/_join_fields — rejoindre un établissement cherché en tapant (écran d'attente et « Mes établissements ») %>
<%# Rôle : un seul formulaire de rattachement pour les deux écrans (UDR-0099 §3.2) ; le champ établissement commun ; repli sans JavaScript en GET vers get_url %>
<%# ADR  : 0083, 0094, XXXX-recherche-etablissement · UDR : 0079 (§3.9), 0099 (§3.2), XXXX-champ-etablissement · Stimulus : school--school-search %>
<%# locals: (school_join:, get_url:, post_url:, submit_label:) -%>
<%# Repli sans JavaScript : la recherche revient en GET (school_q) et liste ses résultats, cochés puis envoyés par « Rejoindre ». %>
<form id="school-join-search" action="<%= get_url %>" method="get"></form>
<%= form_with model: school_join, scope: :school_join, url: post_url, id: "school-join-form", class: "flex flex-col gap-4" do |form| %>
  <% if school_join.errors[:base].any? %>
    <div role="alert" class="flex items-start gap-2 rounded-ln bg-error-soft px-4 py-3 text-sm font-medium text-error">
      <%= ui_icon "exclamation-circle", variant: :mini, size: :sm, class: "mt-0.5 shrink-0" %>
      <p><%= school_join.errors[:base].to_sentence %></p>
    </div>
  <% end %>
  <%= render "school/school_searches/field", scope: :school_join, **school_search_locals(school_join.school_public_id),
                                             error: school_error(school_join.errors), search_form: "school-join-search" %>
  <%= ui_button submit_label, type: :submit, variant: :primary, full: true %>
<% end %>
