<%# 🌐 UI · school/level_classrooms/index — frame « picker_classrooms » de la cascade élève : une grande case radio par classe active %>
<%# Rôle : nom de la classe, et « Complète » (radio désactivé) ; jamais d'effectif ni d'enseignant (IL-04) ; vide, introuvable, erreur ou cases %>
<%# ADR  : 0041, 0062, 0085 · UDR : 0081 (§3.3), 0091 (§3.1 : cases de 64 px, 2 puis 4 par ligne dès 700 px ; §3.6 : vrais radios, nombre annoncé) %>
<%# locals: (classrooms:, registration: nil, scope: :student_registration, rate_limited: false) -%>
<% page_title t(".page_title") %>
<% error = registration&.errors&.[](:classroom_public_id)&.first %>
<% error_id = "#{scope}_classroom_public_id_error" %>
<%# Le tiret qui ferme le « do » : sans liste, le frame reste vraiment vide (:empty), et l'étape montre « Choisis d'abord ton niveau. » (peer-empty). %>
<%= turbo_frame_tag "picker_classrooms", class: "peer block transition-opacity aria-busy:opacity-50", "aria-live": "polite",
                                         data: { "classroom--class-picker-target": "classrooms",
                                                 action: "turbo:frame-missing->classroom--class-picker#missing " \
                                                         "turbo:fetch-request-error->classroom--class-picker#missing " \
                                                         "turbo:frame-load->classroom--class-picker#sync" } do -%>
  <% if rate_limited %>
    <%= ui_error_state title: t("classroom.student_registrations.class_picker.load_error"),
                       message: t("classroom.student_registrations.class_picker.rate_limited"),
                       retry_href: request.fullpath, retry_label: t("classroom.student_registrations.class_picker.retry") %>
  <% elsif classrooms&.empty? %>
    <%= ui_empty_state title: t("classroom.student_registrations.class_picker.not_found_title"),
                       description: t("classroom.student_registrations.class_picker.not_found_description"), icon: "academic-cap" %>
  <% elsif classrooms %>
    <%= fields scope, model: registration do |fields| %>
      <p class="sr-only"><%= t("classroom.student_registrations.class_picker.classrooms_found", count: classrooms.size) %></p>
      <%# Les radios vivent dans le fieldset « Ta classe » de l'étape 3 (UDR-0091 §3.6), qui les nomme. %>
      <div class="grid grid-cols-2 gap-3 min-[700px]:grid-cols-4">
        <% classrooms.each do |classroom| %>
          <label class="<%= class_names("group relative flex min-h-16 flex-col justify-center gap-1 rounded-ln border border-line px-4 py-3",
                                        classroom.full ? "border-dashed opacity-60" : "bg-white text-ink transition has-checked:border-brand has-checked:bg-brand-soft has-checked:text-brand-strong") %>">
            <%# Le radio, sans apparence, couvre toute la case : le doigt, la souris et les flèches du clavier le trouvent. %>
            <%= fields.radio_button :classroom_public_id, classroom.public_id, required: true, disabled: classroom.full,
                                    class: class_names("absolute inset-0 appearance-none rounded-ln focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand",
                                                       { "cursor-pointer" => !classroom.full }),
                                    "aria-invalid": ("true" if error), "aria-describedby": (error_id if error),
                                    data: { action: "change->classroom--class-picker#sync" } %>
            <span class="pr-6 font-display text-lg leading-tight font-extrabold"><%= classroom.name %></span>
            <% if classroom.full %>
              <span><%= ui_badge t("classroom.student_registrations.class_picker.full"), tone: :neutral, size: :sm %></span>
            <% end %>
            <%= ui_icon "check-circle", class: "absolute top-3 right-3 hidden group-has-checked:block" %>
          </label>
        <% end %>
      </div>
    <% end %>
  <% end %>
  <% if error %>
    <p id="<%= error_id %>" class="mt-1.5 flex items-center gap-1.5 text-sm font-medium text-error">
      <%= ui_icon "exclamation-circle", variant: :mini, size: :sm %><%= error %>
    </p>
  <% end %>
<% end %>
