<%# 🌐 UI · school_admin/classrooms/show — page d'une classe pour la direction (DS-09, DS-10, FU-10, FU-21, FU-49, IL-12 à IL-14) %>
<%# Rôle : le lien de la classe, ses chiffres en trois tuiles, puis chaque élève présent (cherché pendant la frappe) : nouveau, voie, rendus / donnés, score, retrait %>
<%# ADR  : 0065, 0085 · UDR : 0005, 0049, 0052, 0054, 0074, 0081 (§3.6, §3.7) · le public_id d'un élève n'est que sur sa ligne, celle du geste (ADR-0085 §4.5) %>
<% classroom = @detail.classroom %>
<% roster = "classroom.classrooms.roster" %>
<% page_title classroom.name %>
<% content_for :nav_key, "home" %>
<% percent = lambda do |value|
     next t("school_admin.classrooms.percent", value:) unless value.nil?

     safe_join([ tag.span("—", aria: { hidden: true }), tag.span(t("school_admin.classrooms.not_computed"), class: "sr-only") ])
   end %>
<%# UDR-0074 §3.9 : le retour mène à la page du niveau de la classe, à son nom. %>
<%= ui_page_header title: classroom.name, subtitle: t(".subtitle", level: classroom.level_name, count: classroom.students_count),
                   back: { label: classroom.level_name, href: school_admin_level_path(classroom.level_slug) } %>

<%# UDR-0081 §3.6 : le bloc de la page de l'enseignant, au-dessus des trois tuiles ; « Changer le lien » le remplace par Turbo
    Stream. Permanent, à l'identifiant propre à la classe : la page re-demandée après un retrait (morphing) ne cache pas de
    nouveau « Copier le lien », que le contrôleur clipboard a montré à son arrivée. %>
<div id="classroom_link_block_<%= classroom.public_id %>" class="mb-5" data-turbo-permanent><%= render "classroom/classrooms/link", classroom: @detail.link %></div>

<ul id="classroom_figures" class="mb-5 grid grid-cols-3 gap-3">
  <% [ [ :assignments, classroom.assignments_count, nil ], [ :submission_rate, percent.call(classroom.submission_rate), :submission_rate ],
       [ :average, percent.call(classroom.average_percent), :average ] ].each do |key, value, tip| %>
    <li class="rounded-ln bg-mist px-3 py-4">
      <span class="block font-display text-2xl font-extrabold tabular-nums"><%= value %></span>
      <span class="block text-sm text-mute">
        <%= t(".figures.#{key}") %>
        <% if tip %>
          <%= ui_info_tip t("school_admin.classrooms.tips.#{tip}"), label: t(".figures.#{key}") %>
        <% end %>
      </span>
    </li>
  <% end %>
</ul>

<%= ui_card id: "classroom_students" do %>
  <%# UDR-0081 §3.7 : le titre de la liste de l'enseignant, compte des nouveaux compris ; après un retrait, le stream
      (classroom_students/destroy) le remplace et y met le focus, puis la page re-demandée remet le reste. %>
  <%= render "classroom/classrooms/roster_title", count: classroom.students_count, new_count: @detail.new_students_count %>
  <% if @detail.members.empty? %>
    <%= ui_empty_state title: t(".empty"), icon: "users" %>
  <% else %>
    <%= form_with scope: :student_work_search, url: school_admin_classroom_path(classroom.public_id), method: :get,
                  id: "student-work-search", class: "mb-4 flex items-end gap-3",
                  html: { role: "search", "aria-label": t(".search.label") },
                  data: { turbo_frame: "student_work_students", controller: "search" } do |form| %>
      <div class="min-w-0 flex-1">
        <%= ui_field form, :q, as: :search, label: t(".search.label"), name: "q", value: @search, autocomplete: "off",
                               data: { action: "search#queue" } %>
      </div>
      <%# Permanent, comme le bloc du lien : la page re-demandée après un retrait ne ré-affiche pas ce bouton, que le
          contrôleur search a caché à son arrivée ; sans JavaScript, il reste. %>
      <%= ui_button t(".search.submit"), type: :submit, variant: :secondary, id: "student-work-search-submit-#{classroom.public_id}",
                                         data: { search_target: "button", turbo_permanent: true } %>
      <%# UDR-0054 §3.9 : réponse non 2xx → le contrôleur search pose cet état dans le frame. %>
      <template data-search-target="error"><%= ui_error_state retry_href: "#" %></template>
    <% end %>

    <%= turbo_frame_tag "student_work_students", class: "block transition-opacity aria-busy:opacity-50" do %>
      <p aria-live="polite" class="mb-3 text-sm text-mute"><%= t(".search.count", count: @students.size) %></p>
      <% if @students.empty? %>
        <%= ui_empty_state title: t(".search.empty"), icon: "magnifying-glass" do %>
          <%= ui_button t(".search.clear"), href: school_admin_classroom_path(classroom.public_id), variant: :secondary,
                                            data: { turbo_frame: "_top" } %>
        <% end %>
      <% else %>
        <%# UDR-0081 §3.7, amendée le 2026-10-08 (challenger de la phase 5) : sous sm, chaque élève est une ligne empilée —
            nom, pastille et voie, puis ses chiffres libellés, le ⋮ à droite —, sans tableau à glisser ; à partir de sm, le tableau. %>
        <div class="relative overflow-x-auto">
          <table class="w-full text-left text-sm sm:min-w-xl">
            <caption class="sr-only"><%= t(".caption", classroom: classroom.name) %></caption>
            <thead class="border-b border-line text-xs text-mute max-sm:sr-only">
              <tr>
                <th scope="col" class="px-2 py-3 font-medium"><%= t(".columns.student") %></th>
                <th scope="col" class="px-2 py-3 text-right align-top font-medium"><%= t(".columns.submitted") %></th>
                <th scope="col" class="px-2 py-3 text-right align-top font-medium">
                  <%= t(".columns.average") %>
                  <%= ui_info_tip t("school_admin.classrooms.tips.student_average"), label: t(".columns.average") %>
                </th>
                <th scope="col" class="w-12 px-2 py-3"><span class="sr-only"><%= t(".columns.actions") %></span></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              <% @students.each do |student| %>
                <% remove_dialog = "remove-student-#{student.public_id}" %>
                <%# La ligne porte l'identifiant de la page de l'enseignant : le stream du retrait la retire (UDR-0081 §3.7). %>
                <tr id="student_<%= student.public_id %>" class="max-sm:grid max-sm:grid-cols-[1fr_auto] max-sm:gap-x-3 max-sm:py-3">
                  <th scope="row" class="px-2 py-3 font-medium text-ink max-sm:col-start-1 max-sm:py-0">
                    <%# UDR-0081 §3.7, amendée le 2026-10-08 : sous sm, la pastille passe sous le nom, sur la ligne de la voie
                        d'arrivée ; à partir de sm, elle reste à côté du nom. Rien pour la voie du code. %>
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      <p class="w-full sm:w-auto"><%= student.display_name %></p>
                      <% if student.newcomer %><span class="shrink-0"><%= ui_badge t("#{roster}.new"), tone: :brand, size: :sm %></span><% end %>
                      <% via = { "standard" => t("#{roster}.via.standard"), "link" => t("#{roster}.via.link") }[student.joined_via] %>
                      <% if via %><p class="text-xs font-normal text-mute sm:w-full"><%= via %></p><% end %>
                    </div>
                  </th>
                  <%# Sous sm, le libellé de la colonne précède le chiffre (data-label), sans changer le texte de la cellule. %>
                  <td data-label="<%= t(".columns.submitted") %>"
                      class="px-2 py-3 text-right tabular-nums max-sm:col-start-1 max-sm:pt-1 max-sm:pb-0 max-sm:text-left max-sm:text-xs max-sm:before:text-mute max-sm:before:content-[attr(data-label)_'_:_']">
                    <%= t(".submitted", count: student.work.submitted_count, total: classroom.assignments_count) %>
                  </td>
                  <td data-label="<%= t(".columns.average") %>"
                      class="px-2 py-3 text-right tabular-nums max-sm:col-start-1 max-sm:py-0 max-sm:text-left max-sm:text-xs max-sm:before:text-mute max-sm:before:content-[attr(data-label)_'_:_']"><%= percent.call(student.work.average_percent) %></td>
                  <td class="px-2 py-1 text-right max-sm:col-start-2 max-sm:row-span-3 max-sm:row-start-1 max-sm:self-center">
                    <%# UDR-0081 §3.7 : le menu ⋮ et la confirmation de la page de l'enseignant ; menu en position fixe, hors
                        du défilement du tableau (UDR-0042). %>
                    <%= ui_dropdown label: t("#{roster}.actions_label", name: student.display_name), id: "student-actions-#{student.public_id}",
                                    fixed: true do %>
                      <%= ui_dropdown_item t("#{roster}.remove"), dialog: remove_dialog, icon: "user-minus", tone: :danger %>
                    <% end %>
                    <%= ui_modal title: t("#{roster}.remove_title", name: student.display_name), id: remove_dialog, size: :sm do |modal| %>
                      <% modal.footer do %>
                        <%= ui_button t("#{roster}.cancel"), variant: :secondary, data: { action: "modal#close" } %>
                        <%= ui_button t("#{roster}.remove_confirm"), type: :submit, form: "#{remove_dialog}-form", variant: :danger,
                                                                     icon: "user-minus" %>
                      <% end %>
                      <p class="text-left text-sm text-mute"><%= t("#{roster}.remove_warning", name: student.display_name) %></p>
                      <%= form_with url: classroom_student_path(classroom.public_id, student.public_id), method: :delete,
                                    id: "#{remove_dialog}-form", data: { turbo_frame: "_top" } do %>
                      <% end %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
        <div class="mt-3 text-xs text-mute">
          <span aria-hidden="true">—</span> <%= t("school_admin.classrooms.legend.label") %>
          <%= ui_info_tip t("school_admin.classrooms.tips.missing"), label: t("school_admin.classrooms.legend.label") %>
        </div>
      <% end %>
    <% end %>
  <% end %>
<% end %>
