<%# 🌐 UI · school_admin/classrooms/index — accueil de la direction (AD-02 à AD-08, ID-10) %>
<%# Rôle : « Bonjour », bandeau d'arrivée, puis « Établissement », « Niveaux », « Annonces » (sans croix) et « Activité récente » (différée) %>
<%# ADR  : 0065, 0077, 0078 · UDR : 0052, 0070 (§3.3), 0071, 0074 (§3.2, §3.10, §3.11) · lecture seule : les sections ne portent que des liens %>
<% page_title t(".page_title") %>
<% content_for :nav_key, "home" %>
<%= ui_page_header title: t(".greeting", name: shell_user.first_name) %>

<% if @arrivals.any? %>
  <%# Le premier du mois s'écrit « 1er » (UDR-0056, comme departed_teachers/index). %>
  <% fmt = ->(time) { date = time.to_date; date.day == 1 ? "1er #{l(date, format: "%B %Y")}" : l(date, format: :long) } %>
  <div id="staff_arrivals" role="status" class="mb-6 rounded-ln bg-school/10 px-4 py-3 text-sm text-ink">
    <% @arrivals.each do |arrival| %>
      <p><%= t(".arrivals.line", name: arrival.name, date: fmt.(arrival.joined_at), via: t(".arrivals.via.#{arrival.joined_via}")) %></p>
    <% end %>
  </div>
<% end %>

<div class="grid gap-5">
  <%= render "school_card", home: @home %>
  <%= render "levels", home: @home %>
  <%# UDR-0074 §3.10 : en lecture seule, sans croix (décision du porteur du 2026-10-04) ; absent sans annonce lisible. %>
  <% if @announcements.any_readable? %>
    <%= render "communication/messages/carousel", carousel: @announcements, dismissible: false %>
  <% end %>
  <%= ui_card id: "direction_home_activity", title: t(".activity.title"), subtitle: t(".activity.subtitle"), icon: "bolt" do %>
    <%# UDR-0074 §3.11 : chargée après la page, par SchoolAdmin::ActivitiesController ; ses liens ouvrent la page entière. %>
    <%= turbo_frame_tag "direction_home_activity_feed", src: school_admin_activity_path, loading: :lazy, target: "_top" do %>
      <%= ui_loading_state variant: :skeleton %>
    <% end %>
  <% end %>
</div>
