<%# 🌐 UI · school_admin/staff_members/destroy — une direction retirée par une autre (ID-12) %>
<%# Rôle : toast, ligne retirée avec sa modale, places « par le code » recomptées (même balise que shared/_school_staff) %>
<%# ADR  : 0077 · UDR : 0006, 0070 (§3.4) %>
<%= turbo_stream_toast @notice, type: :success %>
<%= turbo_stream.remove "school_staff_#{@archived.staff.user_public_id}" %>
<%= turbo_stream.replace "school_staff_places" do %>
  <p id="school_staff_places" class="-mt-2 mb-2 text-sm text-mute">
    <%= t("shared.school_staff.subtitle", used: @by_code_count, cap: Entities::School::Staff::CODE_CAP) %>
  </p>
<% end %>
