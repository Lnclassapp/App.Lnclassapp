<%# 🌐 UI · school_admin/teachers/removal — confirmation « Retirer <nom> de l'établissement ? », lue à la demande (GD-14) %>
<%# Rôle : servie dans le frame « modal » depuis le menu ⋮ de la liste ; sans frame (sans JavaScript), page complète utilisable %>
<%# ADR  : 0067, 0071 · UDR : 0006, 0042, 0054, 0056 (amendement du 2026-10-04) %>
<% id = "remove-teacher-#{@teacher.public_id}" %>
<% page_title t(".title", name: @teacher.name) %>
<% content_for :nav_key, "teachers" %>
<%# Page complète seulement : le retour à la liste, puisque « Annuler » ne fait rien sans JavaScript (UDR-0054). %>
<% unless turbo_frame_request? %>
  <%= link_to t(".back"), school_admin_teachers_path, id: "back-to-teachers",
              class: "mb-4 inline-flex min-h-tap items-center text-sm font-medium text-brand-strong underline-offset-4 hover:underline" %>
<% end %>
<%# UDR-0054 §3.3 : une confirmation laisse l'onglet tel quel (pas de document_title) ; le focus va sur « Annuler ». %>
<%= turbo_frame_tag "modal" do %>
  <%= ui_modal id:, size: :sm, open: true, title: t(".title", name: @teacher.name) do |modal| %>
    <% modal.footer do %>
      <%= ui_button t(".cancel"), variant: :secondary, data: { action: "modal#close" } %>
      <%= ui_button t(".confirm"), type: :submit, variant: :danger, icon: "user-minus", form: "#{id}-form" %>
    <% end %>
    <p class="text-left text-sm text-mute"><%= t(".body", first_name: @teacher.first_name) %></p>
    <%= form_with url: school_admin_teacher_path(@teacher.public_id), method: :delete, id: "#{id}-form" do %><% end %>
  <% end %>
<% end %>
