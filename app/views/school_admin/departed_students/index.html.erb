<%# 🌐 UI · school_admin/departed_students/index — « Anciens élèves » de la direction (lot R de fonctions-espace-eleve) %>
<%# Rôle : chaque élève passé par l'établissement et absent de ses classes de l'année : dernière classe, devoirs rendus, score moyen %>
<%# ADR  : 0036, 0065 · UDR : 0052, 0054 (§3.2, §3.9) · aucun identifiant d'élève dans le HTML : les lignes sont numérotées %>
<% page_title t(".page_title") %>
<% content_for :nav_key, "student_work" %>
<% percent = lambda do |value|
     next t("school_admin.classrooms.percent", value:) unless value.nil?

     safe_join([ tag.span("—", aria: { hidden: true }), tag.span(t("school_admin.classrooms.not_computed"), class: "sr-only") ])
   end %>
<%= ui_page_header title: t(".title"), subtitle: @overview.school_name, back: { label: t(".back"), href: school_admin_classrooms_path } %>

<%= ui_card id: "departed_students" do %>
  <%= form_with url: school_admin_departed_students_path, method: :get, id: "departed-students-search", class: "mb-4 flex items-end gap-3",
                html: { role: "search", "aria-label": t(".search.label") },
                data: { turbo_frame: SchoolAdmin::DepartedStudentsController::LIST_FRAME, controller: "search" } do |form| %>
    <div class="min-w-0 flex-1">
      <%= label_tag "departed_students_q", t(".search.label"), class: "mb-1.5 block text-sm font-medium text-ink" %>
      <%= search_field_tag :q, @search, id: "departed_students_q", autocomplete: "off", data: { action: "search#queue" },
                           class: class_names(ComponentsHelper::FIELD_INPUT, ComponentsHelper::FIELD_STATES[:valid]) %>
    </div>
    <%= ui_button t(".search.submit"), type: :submit, variant: :secondary, data: { search_target: "button" } %>
    <template data-search-target="error"><%= ui_error_state retry_href: "#" %></template>
  <% end %>

  <%= turbo_frame_tag SchoolAdmin::DepartedStudentsController::LIST_FRAME, class: "block transition-opacity aria-busy:opacity-50" do %>
    <% if @overview.students.empty? %>
      <% if @search.present? %>
        <%= ui_empty_state title: t(".search.empty"), icon: "magnifying-glass" do %>
          <%= ui_button t(".search.clear"), href: school_admin_departed_students_path, variant: :secondary, data: { turbo_frame: "_top" } %>
        <% end %>
      <% else %>
        <%= ui_empty_state title: t(".empty.title"), description: t(".empty.description"), icon: "archive-box" %>
      <% end %>
    <% else %>
      <p aria-live="polite" class="mb-3 text-sm text-mute">
        <%= @overview.truncated ? t(".truncated", count: @overview.students.size) : t(".count", count: @overview.students.size) %>
      </p>
      <div class="relative overflow-x-auto">
        <table class="w-full min-w-xl text-left text-sm">
          <caption class="sr-only"><%= t(".caption") %></caption>
          <thead class="border-b border-line text-xs text-mute">
            <tr>
              <th scope="col" class="px-2 py-3 font-medium"><%= t(".columns.student") %></th>
              <th scope="col" class="px-2 py-3 font-medium"><%= t(".columns.classroom") %></th>
              <th scope="col" class="px-2 py-3 text-right align-top font-medium"><%= t(".columns.submitted") %></th>
              <th scope="col" class="px-2 py-3 text-right align-top font-medium">
                <%= t(".columns.average") %>
                <%= ui_info_tip t(".average_tip"), label: t(".columns.average") %>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% @overview.students.each_with_index do |student, index| %>
              <tr id="departed_student_<%= index %>">
                <th scope="row" class="px-2 py-3 font-medium text-ink"><%= student.display_name %></th>
                <td class="px-2 py-3">
                  <%= student.classroom_name %>
                  <span class="block text-xs text-mute"><%= t(".classroom_detail", level: student.level_name, year: student.school_year) %></span>
                </td>
                <td class="px-2 py-3 text-right tabular-nums"><%= student.submitted_count %></td>
                <td class="px-2 py-3 text-right tabular-nums"><%= percent.call(student.average_percent) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
<% end %>
