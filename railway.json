{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "preDeployCommand": ["bin/rails db:prepare db:seed"],
    "healthcheckPath": "/up",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE"
  }
}
